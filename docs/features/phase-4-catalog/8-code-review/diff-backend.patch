+package catalog
+
+import (
+	"log/slog"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/gofiber/fiber/v3/middleware/requestid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+)
+
+// SSR — экраны «Каталог»: товары (список/форма), заглушка услуг, управление категориями
+// (общее для обеих вкладок). Типы оборудования — отдельный SSR (equipmenttypes), но
+// делит с этим набором полосу вкладок (catalog-tabs partial + TabCounts).
+type SSR struct {
+	catSvc  *CategoryService
+	prodSvc *ProductService
+	svcSvc  *ServiceService
+	pool    *pgxpool.Pool
+	r       *ssr.Renderer
+	shell   ssr.ShellBuilder
+	status  *ssr.StatusPages
+	cat     ssrCategories
+}
+
+func NewSSR(catSvc *CategoryService, prodSvc *ProductService, svcSvc *ServiceService, pool *pgxpool.Pool, r *ssr.Renderer, shell ssr.ShellBuilder, status *ssr.StatusPages) *SSR {
+	return &SSR{catSvc: catSvc, prodSvc: prodSvc, svcSvc: svcSvc, pool: pool, r: r, shell: shell, status: status, cat: ssrCategories{svc: catSvc}}
+}
+
+// TabsVM — полоса вкладок каталога (шаблон web/ssr/_layout/templates/partials/catalog-tabs.html).
+type TabsVM struct {
+	Active   string // "services" | "products" | "equipment-types"
+	Services int
+	Products int
+	Types    int
+}
+
+// tabs — счётчики полосы вкладок; ошибка НЕ проглатывается молча (code review LOW#2) —
+// логируется с request_id, страница рендерится дальше с нулевыми счётчиками (не 500 из-за
+// вспомогательной подписи вкладки).
+func (h *SSR) tabs(c fiber.Ctx, active string) TabsVM {
+	cnt, err := LoadTabCounts(c.Context(), h.pool)
+	if err != nil {
+		slog.ErrorContext(c.Context(), "catalog: не удалось посчитать вкладки", "error", err, "request_id", requestid.FromContext(c))
+		return TabsVM{Active: active}
+	}
+	return TabsVM{Active: active, Services: cnt.Services, Products: cnt.Products, Types: cnt.Types}
+}
+
+var flashes = map[string]string{
+	"created":           "Товар создан",
+	"saved":             "Изменения сохранены",
+	"archived":          "Товар отправлен в архив",
+	"restored":          "Товар возвращён из архива",
+	"deleted":           "Товар удалён",
+	"service_created":   "Услуга создана",
+	"service_saved":     "Изменения сохранены",
+	"service_archived":  "Услуга отправлена в архив",
+	"service_restored":  "Услуга возвращена из архива",
+	"service_deleted":   "Услуга удалена",
+	"category_created":  "Категория создана",
+	"category_saved":    "Категория переименована",
+	"category_archived": "Категория отправлена в архив",
+	"category_restored": "Категория возвращена из архива",
+	"category_deleted":  "Категория удалена",
+}
diff --git a/internal/features/catalog/ssr_categories.go b/internal/features/catalog/ssr_categories.go
new file mode 100644
index 0000000..e2d6107
--- /dev/null
+++ b/internal/features/catalog/ssr_categories.go
@@ -0,0 +1,127 @@
+package catalog
+
+import (
+	"errors"
+	"net/url"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// ssrCategories — управление категориями встроено в экраны «Товары»/«Услуги» (левая
+// панель, task.md): создать/переименовать/архив/восстановить/удалить. Общий код для
+// обеих вкладок — редирект зависит от FormValue("kind").
+type ssrCategories struct {
+	svc *CategoryService
+}
+
+func redirectTab(kind string) string {
+	if kind == KindService {
+		return "/catalog/services"
+	}
+	return "/catalog/products"
+}
+
+// listCategoryPanel — категории вида kind (активные и архивные — панель управления
+// показывает все, «Показать архивные» списка товаров/услуг на панель не влияет).
+func (h *ssrCategories) list(c fiber.Ctx, kind string) ([]CategoryResponse, error) {
+	resp, err := h.svc.List(c.Context(), CategoryListQuery{Kind: kind, IncludeArchived: true, Limit: defaultLimit}, true)
+	if err != nil {
+		return nil, err
+	}
+	return resp.Items, nil
+}
+
+// createCategory — POST /catalog/categories.
+func (h *ssrCategories) create(c fiber.Ctx) error {
+	kind := c.FormValue("kind")
+	to := redirectTab(kind)
+	_, err := h.svc.Create(c.Context(), CategoryInput{Kind: kind, Name: c.FormValue("name")})
+	if err != nil {
+		return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?cat_error=" + url.QueryEscape(categoryErrCode(err)))
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?flash=category_created")
+}
+
+// rename — POST /catalog/categories/:id/rename.
+func (h *ssrCategories) rename(c fiber.Ctx) error {
+	kind := c.FormValue("kind")
+	to := redirectTab(kind)
+	_, err := h.svc.Rename(c.Context(), c.Params("id"), c.FormValue("name"))
+	if err != nil {
+		return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?cat_error=" + url.QueryEscape(categoryErrCode(err)))
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?flash=category_saved")
+}
+
+func (h *ssrCategories) archive(c fiber.Ctx) error { return h.setActive(c, false, "category_archived") }
+func (h *ssrCategories) restore(c fiber.Ctx) error { return h.setActive(c, true, "category_restored") }
+
+func (h *ssrCategories) setActive(c fiber.Ctx, active bool, flash string) error {
+	to := redirectTab(c.FormValue("kind"))
+	if err := h.svc.SetActive(c.Context(), c.Params("id"), active); err != nil {
+		return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?cat_error=" + url.QueryEscape(categoryErrCode(err)))
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?flash=" + flash)
+}
+
+// remove — POST /catalog/categories/:id/delete; используемая → редирект с ошибкой
+// (архивировать вместо удаления — кнопка «В архив» уже есть в панели).
+func (h *ssrCategories) remove(c fiber.Ctx) error {
+	to := redirectTab(c.FormValue("kind"))
+	if err := h.svc.Delete(c.Context(), c.Params("id")); err != nil {
+		return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?cat_error=" + url.QueryEscape(categoryErrCode(err)))
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To(to + "?flash=category_deleted")
+}
+
+// categoryErrCode — err → КОД (не готовый текст, code review LOW#1: cat_error раньше
+// уходил в URL и рендерился как есть — админ по чужой ссылке видел произвольный текст в
+// alert; теперь в query — только код из закрытого набора, текст — catErrorText() на
+// сервере, эталон flashes). Ошибка валидации name (required/too_long/invalid_text,
+// code review LOW#3) — код самого поля, не общее «unknown».
+func categoryErrCode(err error) string {
+	var app *errorspkg.AppError
+	if errors.As(err, &app) {
+		for _, f := range app.Fields {
+			if f.Name == "name" {
+				return f.Message
+			}
+		}
+	}
+	switch {
+	case errors.Is(err, ErrCategoryNameTaken):
+		return "name_taken"
+	case errors.Is(err, ErrCategoryInUse):
+		return "in_use"
+	case errors.Is(err, ErrCategoryNotFoundErr):
+		return "not_found"
+	default:
+		return "unknown"
+	}
+}
+
+// catErrorText — код cat_error (см. categoryErrCode) → текст под alert на странице
+// списка (ssr_products.go/ssr_services.go). Пустая строка на входе — пустая строка на
+// выходе (нет ошибки — нет alert).
+func catErrorText(code string) string {
+	switch code {
+	case "":
+		return ""
+	case msgRequired:
+		return "Укажите название"
+	case msgTooLong:
+		return "Слишком длинное название"
+	case msgInvalidText:
+		return "Недопустимые символы в названии"
+	case "name_taken":
+		return ErrCategoryNameTaken.Message
+	case "in_use":
+		return ErrCategoryInUse.Message
+	case "not_found":
+		return ErrCategoryNotFoundErr.Message
+	default:
+		return "Не удалось выполнить действие"
+	}
+}
