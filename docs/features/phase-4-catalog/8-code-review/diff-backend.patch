+		s.NotEqual(http.StatusInternalServerError, st, "%s → 500 недопустим", tc.name)
+		s.Equal(tc.message, s.fields(raw)[tc.field], "%s → %s", tc.name, raw)
+	}
+
+	for _, tc := range []struct {
