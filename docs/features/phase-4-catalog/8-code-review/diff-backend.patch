+package catalog
+
+import "time"
+
+// Wire-типы услуг — JSON snake_case (§API-1); Price *Amount — nil/JSON null = «по факту»
+// (task.md: «цена работы, пусто = "по факту"»).
+
+// ServiceProductResponse — строка комплекта услуги с денормализованными полями товара
+// (название/ед./цена — re-fetch-after-write, чтобы клиент не делал доп. запросы).
+type ServiceProductResponse struct {
+	ProductID string `json:"product_id"`
+	Name      string `json:"name"`
+	Unit      string `json:"unit"`
+	Price     Amount `json:"price"`
+	Qty       Amount `json:"qty"`
+}
+
+type ServiceResponse struct {
+	ID         string                   `json:"id"`
+	CategoryID string                   `json:"category_id"`
+	Name       string                   `json:"name"`
+	Price      *Amount                  `json:"price"`
+	IsActive   bool                     `json:"is_active"`
+	Products   []ServiceProductResponse `json:"products"`
+	CreatedAt  time.Time                `json:"created_at"`
+	UpdatedAt  time.Time                `json:"updated_at"`
+}
+
+type ServiceListResponse struct {
+	Items  []ServiceResponse `json:"items"`
+	Total  int               `json:"total"`
+	Limit  int               `json:"limit"`
+	Offset int               `json:"offset"`
+}
+
+// ServiceProductRequest — строка комплекта в теле POST/PUT (D10: дубли product_id
+// объединяются суммой qty на сервере, порядок и дедуп — ServiceInput.normalize()).
+type ServiceProductRequest struct {
+	ProductID string `json:"product_id"`
+	Qty       Amount `json:"qty"`
+}
+
+// ServiceCreateRequest — POST /api/v1/services. Price отсутствует/null — «по факту»;
+// is_active по умолчанию — true; пустой Products — допустим (task.md).
+type ServiceCreateRequest struct {
+	CategoryID string                  `json:"category_id"`
+	Name       string                  `json:"name"`
+	Price      *Amount                 `json:"price"`
+	Products   []ServiceProductRequest `json:"products"`
+}
+
+// ServiceUpdateRequest — PUT /api/v1/services/:id: полная замена карточки и комплекта
+// (is_active обязателен, как ProductUpdateRequest).
+type ServiceUpdateRequest struct {
+	CategoryID string                  `json:"category_id"`
+	Name       string                  `json:"name"`
+	Price      *Amount                 `json:"price"`
+	Products   []ServiceProductRequest `json:"products"`
+	IsActive   *bool                   `json:"is_active"`
+}
diff --git a/internal/features/catalog/services_handler.go b/internal/features/catalog/services_handler.go
new file mode 100644
index 0000000..0787fc9
--- /dev/null
+++ b/internal/features/catalog/services_handler.go
@@ -0,0 +1,99 @@
+package catalog
+
+import (
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// ServiceHandler — JSON API /api/v1/services (чтение — RequireAPI, мутации — +admin).
+type ServiceHandler struct {
+	svc *ServiceService
+}
+
+func NewServiceHandler(svc *ServiceService) *ServiceHandler { return &ServiceHandler{svc: svc} }
+
+// List — GET /api/v1/services?category_id=&q=&include_archived=&limit=&offset=.
+func (h *ServiceHandler) List(c fiber.Ctx) error {
+	limit, _ := strconv.Atoi(c.Query("limit"))
+	offset, _ := strconv.Atoi(c.Query("offset"))
+	includeArchived, _ := strconv.ParseBool(c.Query("include_archived"))
+	isAdmin := false
+	if p := middleware.CurrentPrincipal(c); p != nil {
+		isAdmin = p.IsAdmin()
+	}
+	resp, err := h.svc.List(c.Context(), ServiceListQuery{
+		CategoryID: c.Query("category_id"), Q: c.Query("q"), IncludeArchived: includeArchived, Limit: limit, Offset: offset,
+	}, isAdmin)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Get — GET /api/v1/services/:id.
+func (h *ServiceHandler) Get(c fiber.Ctx) error {
+	resp, err := h.svc.Get(c.Context(), c.Params("id"))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+func productsFromRequest(items []ServiceProductRequest) []ServiceProductInput {
+	out := make([]ServiceProductInput, len(items))
+	for i, it := range items {
+		out[i] = ServiceProductInput{ProductID: it.ProductID, Qty: it.Qty.String()}
+	}
+	return out
+}
+
+// Create — POST /api/v1/services (admin). is_active по умолчанию — true.
+func (h *ServiceHandler) Create(c fiber.Ctx) error {
+	var req ServiceCreateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	in := ServiceInput{CategoryID: req.CategoryID, Name: req.Name, Products: productsFromRequest(req.Products)}
+	if req.Price != nil {
+		in.HasPrice, in.Price = true, req.Price.String()
+	}
+	resp, err := h.svc.Create(c.Context(), in)
+	if err != nil {
+		return err
+	}
+	return c.Status(fiber.StatusCreated).JSON(resp)
+}
+
+// Update — PUT /api/v1/services/:id (admin; полная карточка+комплект, is_active обязателен).
+func (h *ServiceHandler) Update(c fiber.Ctx) error {
+	var req ServiceUpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	if req.IsActive == nil {
+		return errorspkg.Validation(errorspkg.Field{Name: "is_active", Message: msgRequired})
+	}
+	in := ServiceInput{
+		CategoryID: req.CategoryID, Name: req.Name, Products: productsFromRequest(req.Products), IsActive: *req.IsActive,
+	}
+	if req.Price != nil {
+		in.HasPrice, in.Price = true, req.Price.String()
+	}
+	resp, err := h.svc.Update(c.Context(), c.Params("id"), in)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Delete — DELETE /api/v1/services/:id (admin).
+func (h *ServiceHandler) Delete(c fiber.Ctx) error {
+	if err := h.svc.Delete(c.Context(), c.Params("id")); err != nil {
+		return err
+	}
+	return c.SendStatus(fiber.StatusNoContent)
+}
