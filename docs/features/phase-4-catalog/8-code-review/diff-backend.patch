+package catalog
+
+import "time"
+
+// Wire-типы категорий — JSON snake_case (§API-1); конверт списка {items,total,limit,offset}.
+
+// CategoryResponse — категория каталога. ItemCount — число товаров/услуг этого вида
+// в категории (панель слева).
+type CategoryResponse struct {
+	ID        string    `json:"id"`
+	Kind      string    `json:"kind"`
+	Name      string    `json:"name"`
+	IsActive  bool      `json:"is_active"`
+	ItemCount int       `json:"item_count"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+type CategoryListResponse struct {
+	Items  []CategoryResponse `json:"items"`
+	Total  int                `json:"total"`
+	Limit  int                `json:"limit"`
+	Offset int                `json:"offset"`
+}
+
+// CategoryCreateRequest — POST /api/v1/catalog-categories. is_active по умолчанию — true.
+type CategoryCreateRequest struct {
+	Kind string `json:"kind"`
+	Name string `json:"name"`
+}
+
+// CategoryUpdateRequest — PUT /api/v1/catalog-categories/:id: только переименование
+// (kind неизменяем, is_active — отдельные маршруты архива/восстановления).
+type CategoryUpdateRequest struct {
+	Name string `json:"name"`
+}
diff --git a/internal/features/catalog/categories_handler.go b/internal/features/catalog/categories_handler.go
new file mode 100644
index 0000000..37692c5
--- /dev/null
+++ b/internal/features/catalog/categories_handler.go
@@ -0,0 +1,79 @@
+package catalog
+
+import (
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// CategoryHandler — JSON API /api/v1/catalog-categories (чтение — RequireAPI, мутации —
+// +admin, гарды вешает routes.go).
+type CategoryHandler struct {
+	svc *CategoryService
+}
+
+func NewCategoryHandler(svc *CategoryService) *CategoryHandler { return &CategoryHandler{svc: svc} }
+
+// List — GET /api/v1/catalog-categories?kind=&include_archived=&limit=&offset=.
+func (h *CategoryHandler) List(c fiber.Ctx) error {
+	limit, _ := strconv.Atoi(c.Query("limit"))
+	offset, _ := strconv.Atoi(c.Query("offset"))
+	includeArchived, _ := strconv.ParseBool(c.Query("include_archived"))
+	isAdmin := false
+	if p := middleware.CurrentPrincipal(c); p != nil {
+		isAdmin = p.IsAdmin()
+	}
+	resp, err := h.svc.List(c.Context(), CategoryListQuery{
+		Kind: c.Query("kind"), IncludeArchived: includeArchived, Limit: limit, Offset: offset,
+	}, isAdmin)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Get — GET /api/v1/catalog-categories/:id.
+func (h *CategoryHandler) Get(c fiber.Ctx) error {
+	resp, err := h.svc.Get(c.Context(), c.Params("id"))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Create — POST /api/v1/catalog-categories (admin).
+func (h *CategoryHandler) Create(c fiber.Ctx) error {
+	var req CategoryCreateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Create(c.Context(), CategoryInput{Kind: req.Kind, Name: req.Name})
+	if err != nil {
+		return err
+	}
+	return c.Status(fiber.StatusCreated).JSON(resp)
+}
+
+// Update — PUT /api/v1/catalog-categories/:id (admin; переименование).
+func (h *CategoryHandler) Update(c fiber.Ctx) error {
+	var req CategoryUpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Rename(c.Context(), c.Params("id"), req.Name)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Delete — DELETE /api/v1/catalog-categories/:id (admin); используемая → 409 CATEGORY_IN_USE.
+func (h *CategoryHandler) Delete(c fiber.Ctx) error {
+	if err := h.svc.Delete(c.Context(), c.Params("id")); err != nil {
+		return err
+	}
+	return c.SendStatus(fiber.StatusNoContent)
+}
diff --git a/internal/features/catalog/categories_repo.go b/internal/features/catalog/categories_repo.go
new file mode 100644
index 0000000..ae1b341
--- /dev/null
+++ b/internal/features/catalog/categories_repo.go
@@ -0,0 +1,187 @@
+package catalog
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Category — repo-модель категории каталога.
+type Category struct {
+	ID        string
+	Kind      string
+	Name      string
+	IsActive  bool
+	ItemCount int
+	CreatedAt time.Time
+	UpdatedAt time.Time
+}
+
+type CategoryRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewCategoryRepo(pool *pgxpool.Pool) *CategoryRepo { return &CategoryRepo{pool: pool} }
+
+var (
+	ErrCategoryNotFound  = pgx.ErrNoRows
+	errCategoryNameTaken = errors.New("catalog: category name taken")
+	errCategoryInUse     = errors.New("catalog: category in use")
+)
+
+type CategoryListParams struct {
+	Kind            string // "" — оба вида
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+// List — kind пуст → оба вида (используется редко, экраны фильтруют по конкретному
+// виду); item_count считается по kind СТРОКИ (учитывая, что список может быть смешанным,
+// считаем через CASE).
+func (r *CategoryRepo) List(ctx context.Context, p CategoryListParams) ([]Category, int, error) {
+	var conds []string
+	var args []any
+	add := func(cond string, val any) {
+		args = append(args, val)
+		conds = append(conds, fmt.Sprintf(cond, len(args)))
+	}
+	if p.Kind != "" {
+		add("c.kind = $%d", p.Kind)
+	}
+	if !p.IncludeArchived {
+		conds = append(conds, "c.is_active")
+	}
+	where := ""
+	if len(conds) > 0 {
+		where = " WHERE " + strings.Join(conds, " AND ")
+	}
+
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM catalog_categories c`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	countExpr := `(CASE c.kind WHEN 'product' THEN (SELECT count(*) FROM products p WHERE p.category_id = c.id)
+		ELSE (SELECT count(*) FROM services s WHERE s.category_id = c.id) END)`
+	q := `SELECT c.id, c.kind, c.name, c.is_active, c.created_at, c.updated_at, ` + countExpr +
+		` FROM catalog_categories c` + where +
+		fmt.Sprintf(" ORDER BY lower(c.name), c.id LIMIT $%d OFFSET $%d", len(args)+1, len(args)+2)
+	rows, err := r.pool.Query(ctx, q, append(args, p.Limit, p.Offset)...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []Category{}
+	for rows.Next() {
+		var c Category
+		if err := rows.Scan(&c.ID, &c.Kind, &c.Name, &c.IsActive, &c.CreatedAt, &c.UpdatedAt, &c.ItemCount); err != nil {
+			return nil, 0, err
+		}
+		out = append(out, c)
+	}
+	return out, total, rows.Err()
+}
+
+// Get — id уже провалидирован как uuid сервисом.
+func (r *CategoryRepo) Get(ctx context.Context, id string) (*Category, error) {
+	var c Category
+	err := r.pool.QueryRow(ctx,
+		`SELECT id, kind, name, is_active, created_at, updated_at,
+			(CASE kind WHEN 'product' THEN (SELECT count(*) FROM products p WHERE p.category_id = catalog_categories.id)
+			ELSE (SELECT count(*) FROM services s WHERE s.category_id = catalog_categories.id) END)
+		 FROM catalog_categories WHERE id = $1::uuid`, id).
+		Scan(&c.ID, &c.Kind, &c.Name, &c.IsActive, &c.CreatedAt, &c.UpdatedAt, &c.ItemCount)
+	if err != nil {
+		return nil, err
+	}
+	return &c, nil
+}
+
+// Create — INSERT; 23505 (catalog_categories_kind_name_lower_uq) → errCategoryNameTaken.
+func (r *CategoryRepo) Create(ctx context.Context, kind, name string) (*Category, error) {
+	var c Category
+	c.Kind = kind
+	err := r.pool.QueryRow(ctx,
+		`INSERT INTO catalog_categories (kind, name) VALUES ($1, $2)
+		 RETURNING id, name, is_active, created_at, updated_at`,
+		kind, name).Scan(&c.ID, &c.Name, &c.IsActive, &c.CreatedAt, &c.UpdatedAt)
+	if err != nil {
+		return nil, mapUniqueViolation(err, errCategoryNameTaken)
+	}
+	c.ItemCount = 0
+	return &c, nil
+}
+
+// Rename — UPDATE name; ErrNoRows → ErrCategoryNotFound, 23505 → errCategoryNameTaken.
+func (r *CategoryRepo) Rename(ctx context.Context, id, name string) (*Category, error) {
+	var c Category
+	err := r.pool.QueryRow(ctx,
+		`UPDATE catalog_categories SET name = $2, updated_at = now() WHERE id = $1::uuid
+		 RETURNING id, kind, name, is_active, created_at, updated_at`,
+		id, name).Scan(&c.ID, &c.Kind, &c.Name, &c.IsActive, &c.CreatedAt, &c.UpdatedAt)
+	if err != nil {
+		return nil, mapUniqueViolation(err, errCategoryNameTaken)
+	}
+	cnt, err := r.itemCount(ctx, c.Kind, id)
+	if err != nil {
+		return nil, err
+	}
+	c.ItemCount = cnt
+	return &c, nil
+}
+
+// SetActive — SSR архив/восстановление.
+func (r *CategoryRepo) SetActive(ctx context.Context, id string, active bool) error {
+	tag, err := r.pool.Exec(ctx, `UPDATE catalog_categories SET is_active = $2, updated_at = now() WHERE id = $1::uuid`, id, active)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrCategoryNotFound
+	}
+	return nil
+}
+
+// Delete — RowsAffected 0 → ErrCategoryNotFound; FK-нарушение (RESTRICT из products/services)
+// → errCategoryInUse. Postgres на явный ON DELETE RESTRICT отдаёт 23001, а не 23503.
+func (r *CategoryRepo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM catalog_categories WHERE id = $1::uuid`, id)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && (pgErr.Code == "23503" || pgErr.Code == "23001") {
+			return errCategoryInUse
+		}
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrCategoryNotFound
+	}
+	return nil
+}
+
+func (r *CategoryRepo) itemCount(ctx context.Context, kind, id string) (int, error) {
+	var n int
+	err := r.pool.QueryRow(ctx, `SELECT count(*) FROM `+tableOf(kind)+` WHERE category_id = $1::uuid`, id).Scan(&n)
+	return n, err
+}
+
+func tableOf(kind string) string {
+	if kind == KindProduct {
+		return "products"
+	}
+	return "services"
+}
+
+// mapUniqueViolation — 23505 → target; прочие ошибки (в т.ч. pgx.ErrNoRows) — как есть.
+func mapUniqueViolation(err error, target error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "23505" {
+		return target
+	}
+	return err
+}
diff --git a/internal/features/catalog/categories_service.go b/internal/features/catalog/categories_service.go
