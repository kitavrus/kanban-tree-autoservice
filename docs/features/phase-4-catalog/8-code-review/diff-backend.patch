+// ---- code review Блокер 1: границы NUMERIC(12,2)/(12,3) для услуг → 400 по своему полю,
+// не 500. ----
+
+func (s *ServicesLiveSuite) TestService_NumericBoundaries400() {
+	cat := s.newCategory("service", "Границы NUMERIC услуг")
