+package catalog
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+var (
+	ErrCategoryNotFoundErr = errorspkg.New("CATEGORY_NOT_FOUND", http.StatusNotFound, "Категория не найдена")
+	ErrCategoryNameTaken   = errorspkg.New("CATEGORY_NAME_TAKEN", http.StatusConflict, "Такая категория уже есть")
+	ErrCategoryInUse       = errorspkg.New("CATEGORY_IN_USE", http.StatusConflict,
+		"Категория используется — удалить нельзя, отправьте её в архив")
+)
+
+// defaultLimit/maxLimit — 500: списки каталога используются как lookup (комбобоксы,
+// фильтры) — как у equipmenttypes.
+const (
+	defaultLimit = 500
+	maxLimit     = 500
+)
+
+type CategoryService struct {
+	repo *CategoryRepo
+}
+
+func NewCategoryService(pool *pgxpool.Pool) *CategoryService {
+	return &CategoryService{repo: NewCategoryRepo(pool)}
+}
+
+type CategoryListQuery struct {
+	Kind            string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+// List — !isAdmin форсирует IncludeArchived=false (как equipmenttypes ADR-004).
+func (s *CategoryService) List(ctx context.Context, q CategoryListQuery, isAdmin bool) (*CategoryListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = defaultLimit
+	}
+	limit = min(limit, maxLimit)
+	offset = max(offset, 0)
+	includeArchived := q.IncludeArchived && isAdmin
+
+	kind := strings.TrimSpace(q.Kind)
+	if kind != KindService && kind != KindProduct {
+		kind = ""
+	}
+	items, total, err := s.repo.List(ctx, CategoryListParams{Kind: kind, IncludeArchived: includeArchived, Limit: limit, Offset: offset})
+	if err != nil {
+		return nil, err
+	}
+	resp := &CategoryListResponse{Items: make([]CategoryResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, c := range items {
+		resp.Items[i] = toCategoryResponse(c)
+	}
+	return resp, nil
+}
+
+func (s *CategoryService) Get(ctx context.Context, id string) (*CategoryResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrCategoryNotFoundErr
+	}
+	c, err := s.repo.Get(ctx, id)
+	if errors.Is(err, ErrCategoryNotFound) {
+		return nil, ErrCategoryNotFoundErr
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toCategoryResponse(*c)
+	return &resp, nil
+}
+
+func (s *CategoryService) Create(ctx context.Context, in CategoryInput) (*CategoryResponse, error) {
+	in = in.normalize()
+	if f := in.validateCreate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	c, err := s.repo.Create(ctx, in.Kind, in.Name)
+	if errors.Is(err, errCategoryNameTaken) {
+		return nil, ErrCategoryNameTaken
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toCategoryResponse(*c)
+	return &resp, nil
+}
+
+// Rename — единственная мутация карточки категории (kind неизменяем).
+func (s *CategoryService) Rename(ctx context.Context, id, name string) (*CategoryResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrCategoryNotFoundErr
+	}
+	name = strings.TrimSpace(name)
+	if f := validateCategoryName(name); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	c, err := s.repo.Rename(ctx, id, name)
+	switch {
+	case errors.Is(err, ErrCategoryNotFound):
+		return nil, ErrCategoryNotFoundErr
+	case errors.Is(err, errCategoryNameTaken):
+		return nil, ErrCategoryNameTaken
+	case err != nil:
+		return nil, err
+	}
+	resp := toCategoryResponse(*c)
+	return &resp, nil
+}
+
+func (s *CategoryService) SetActive(ctx context.Context, id string, active bool) error {
+	if uuid.Validate(id) != nil {
+		return ErrCategoryNotFoundErr
+	}
+	if err := s.repo.SetActive(ctx, id, active); errors.Is(err, ErrCategoryNotFound) {
+		return ErrCategoryNotFoundErr
+	} else if err != nil {
+		return err
+	}
+	return nil
+}
+
+func (s *CategoryService) Delete(ctx context.Context, id string) error {
+	if uuid.Validate(id) != nil {
+		return ErrCategoryNotFoundErr
+	}
+	err := s.repo.Delete(ctx, id)
+	switch {
+	case errors.Is(err, ErrCategoryNotFound):
+		return ErrCategoryNotFoundErr
+	case errors.Is(err, errCategoryInUse):
+		return ErrCategoryInUse
+	default:
+		return err
+	}
+}
+
+func toCategoryResponse(c Category) CategoryResponse {
+	return CategoryResponse{
+		ID: c.ID, Kind: c.Kind, Name: c.Name, IsActive: c.IsActive,
+		ItemCount: c.ItemCount, CreatedAt: c.CreatedAt, UpdatedAt: c.UpdatedAt,
+	}
+}
diff --git a/internal/features/catalog/categories_validate.go b/internal/features/catalog/categories_validate.go
new file mode 100644
index 0000000..8d340ca
--- /dev/null
+++ b/internal/features/catalog/categories_validate.go
@@ -0,0 +1,65 @@
+package catalog
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Коды ошибок полей (details.fields[].message) — SSR переводит их в текст.
+const (
+	msgRequired    = "required"
+	msgTooLong     = "too_long"
+	msgInvalid     = "invalid"
+	msgInvalidText = "invalid_text"
+)
+
+// KindService/KindProduct — виды категорий каталога (D16).
+const (
+	KindService = "service"
+	KindProduct = "product"
+)
+
+const categoryNameMax = 100
+
+// CategoryInput — нормализованные поля категории.
+type CategoryInput struct {
+	Kind string
+	Name string
+}
+
+func (in CategoryInput) normalize() CategoryInput {
+	in.Kind = strings.TrimSpace(in.Kind)
+	in.Name = strings.TrimSpace(in.Name)
+	return in
+}
+
+// validateCreate — kind + name.
+func (in CategoryInput) validateCreate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	if in.Kind != KindService && in.Kind != KindProduct {
+		add("kind", msgInvalid)
+	}
+	f = append(f, validateCategoryName(in.Name)...)
+	return f
+}
+
+// validateRename — только name (PUT/rename).
+func validateCategoryName(name string) []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(fld, msg string) { f = append(f, errorspkg.Field{Name: fld, Message: msg}) }
+	switch n := utf8.RuneCountInString(name); {
+	case n == 0:
+		add("name", msgRequired)
+	case n > categoryNameMax:
+		add("name", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(name) {
+		add("name", msgInvalidText)
+	}
+	return f
+}
diff --git a/internal/features/catalog/categories_validate_test.go b/internal/features/catalog/categories_validate_test.go
new file mode 100644
index 0000000..0941852
--- /dev/null
+++ b/internal/features/catalog/categories_validate_test.go
@@ -0,0 +1,59 @@
+package catalog
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+func fieldsOf(fs []errorspkg.Field) map[string]string {
+	m := map[string]string{}
+	for _, f := range fs {
+		m[f.Name] = f.Message
+	}
+	return m
+}
+
+func TestCategoryInput_Normalize(t *testing.T) {
+	in := CategoryInput{Kind: "  product  ", Name: "  Фильтры  "}.normalize()
+	assert.Equal(t, "product", in.Kind)
+	assert.Equal(t, "Фильтры", in.Name)
+}
+
+func TestCategoryInput_ValidateCreate(t *testing.T) {
+	cases := []struct {
+		name  string
+		in    CategoryInput
+		field string
+		msg   string
+	}{
+		{"валидный product", CategoryInput{Kind: KindProduct, Name: "Расходники"}, "", ""},
+		{"валидный service", CategoryInput{Kind: KindService, Name: "Ремонт"}, "", ""},
+		{"kind пуст", CategoryInput{Kind: "", Name: "X"}, "kind", msgInvalid},
+		{"kind мусор", CategoryInput{Kind: "junk", Name: "X"}, "kind", msgInvalid},
+		{"имя пусто", CategoryInput{Kind: KindProduct, Name: ""}, "name", msgRequired},
+		{"имя из пробелов", CategoryInput{Kind: KindProduct, Name: "   "}, "name", msgRequired},
+		{"имя 100 — граница", CategoryInput{Kind: KindProduct, Name: strings.Repeat("я", 100)}, "", ""},
+		{"имя 101", CategoryInput{Kind: KindProduct, Name: strings.Repeat("я", 101)}, "name", msgTooLong},
+		{"NUL-байт", CategoryInput{Kind: KindProduct, Name: "X\u0000"}, "name", msgInvalidText},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := fieldsOf(tc.in.normalize().validateCreate())
+			if tc.field == "" {
+				assert.Empty(t, got)
+				return
+			}
+			assert.Equal(t, tc.msg, got[tc.field])
+		})
+	}
+}
+
+func TestValidateCategoryName(t *testing.T) {
+	assert.Empty(t, fieldsOf(validateCategoryName("Название")))
+	assert.Equal(t, map[string]string{"name": msgRequired}, fieldsOf(validateCategoryName("")))
+	assert.Equal(t, map[string]string{"name": msgTooLong}, fieldsOf(validateCategoryName(strings.Repeat("a", 101))))
+}
diff --git a/internal/features/catalog/products_dto.go b/internal/features/catalog/products_dto.go
new file mode 100644
index 0000000..f6b7c8d
--- /dev/null
+++ b/internal/features/catalog/products_dto.go
@@ -0,0 +1,58 @@
+package catalog
+
+import "time"
+
+// Wire-типы товаров — JSON snake_case (§API-1); NUMERIC-поля — Amount (число на wire,
+// строка внутри, без потери точности).
+
+type ProductResponse struct {
+	ID         string    `json:"id"`
+	CategoryID string    `json:"category_id"`
+	Name       string    `json:"name"`
+	SKU        string    `json:"sku"`
+	Unit       string    `json:"unit"`
+	Price      Amount    `json:"price"`
+	IsActive   bool      `json:"is_active"`
+	Stock      Amount    `json:"stock"`
+	MinStock   Amount    `json:"min_stock"`
+	Box        string    `json:"box"`
+	Place      string    `json:"place"`
+	CreatedAt  time.Time `json:"created_at"`
+	UpdatedAt  time.Time `json:"updated_at"`
+}
+
+type ProductListResponse struct {
+	Items  []ProductResponse `json:"items"`
+	Total  int               `json:"total"`
+	Limit  int               `json:"limit"`
+	Offset int               `json:"offset"`
+}
+
+// ProductCreateRequest — POST /api/v1/products. is_active по умолчанию — true.
+type ProductCreateRequest struct {
+	CategoryID string `json:"category_id"`
+	Name       string `json:"name"`
+	SKU        string `json:"sku"`
+	Unit       string `json:"unit"`
+	Price      Amount `json:"price"`
+	Stock      Amount `json:"stock"`
+	MinStock   Amount `json:"min_stock"`
+	Box        string `json:"box"`
+	Place      string `json:"place"`
+}
+
+// ProductUpdateRequest — PUT /api/v1/products/:id: полная замена карточки товара.
+// is_active обязателен (как equipmenttypes.TypeUpdateRequest) — архив/восстановление
+// доступны и напрямую через PUT, и отдельными SSR-маршрутами.
+type ProductUpdateRequest struct {
+	CategoryID string `json:"category_id"`
+	Name       string `json:"name"`
+	SKU        string `json:"sku"`
+	Unit       string `json:"unit"`
+	Price      Amount `json:"price"`
+	Stock      Amount `json:"stock"`
+	MinStock   Amount `json:"min_stock"`
+	Box        string `json:"box"`
+	Place      string `json:"place"`
+	IsActive   *bool  `json:"is_active"`
+}
diff --git a/internal/features/catalog/products_handler.go b/internal/features/catalog/products_handler.go
new file mode 100644
index 0000000..492019b
--- /dev/null
+++ b/internal/features/catalog/products_handler.go
@@ -0,0 +1,99 @@
+package catalog
+
+import (
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// ProductHandler — JSON API /api/v1/products (чтение — RequireAPI, мутации — +admin).
+type ProductHandler struct {
+	svc *ProductService
+}
+
+func NewProductHandler(svc *ProductService) *ProductHandler { return &ProductHandler{svc: svc} }
+
+// List — GET /api/v1/products?category_id=&q=&include_archived=&limit=&offset=.
+func (h *ProductHandler) List(c fiber.Ctx) error {
+	limit, _ := strconv.Atoi(c.Query("limit"))
+	offset, _ := strconv.Atoi(c.Query("offset"))
+	includeArchived, _ := strconv.ParseBool(c.Query("include_archived"))
+	isAdmin := false
+	if p := middleware.CurrentPrincipal(c); p != nil {
+		isAdmin = p.IsAdmin()
+	}
+	resp, err := h.svc.List(c.Context(), ProductListQuery{
+		CategoryID: c.Query("category_id"), Q: c.Query("q"), IncludeArchived: includeArchived, Limit: limit, Offset: offset,
+	}, isAdmin)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Get — GET /api/v1/products/:id.
+func (h *ProductHandler) Get(c fiber.Ctx) error {
+	resp, err := h.svc.Get(c.Context(), c.Params("id"))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+func inputFromCreate(req ProductCreateRequest) ProductInput {
+	return ProductInput{
+		CategoryID: req.CategoryID, Name: req.Name, SKU: req.SKU, Unit: req.Unit,
+		Price: req.Price.String(), Stock: req.Stock.String(), MinStock: req.MinStock.String(),
+		Box: req.Box, Place: req.Place,
+	}
+}
+
+// Create — POST /api/v1/products (admin). is_active по умолчанию — true; остаток при
+// создании в stock_movements не пишется (нет «старого» значения для дельты).
+func (h *ProductHandler) Create(c fiber.Ctx) error {
+	var req ProductCreateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Create(c.Context(), inputFromCreate(req))
+	if err != nil {
+		return err
+	}
+	return c.Status(fiber.StatusCreated).JSON(resp)
+}
+
+// Update — PUT /api/v1/products/:id (admin; полная карточка, is_active обязателен).
+func (h *ProductHandler) Update(c fiber.Ctx) error {
+	var req ProductUpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	if req.IsActive == nil {
+		return errorspkg.Validation(errorspkg.Field{Name: "is_active", Message: msgRequired})
+	}
+	userID := ""
+	if p := middleware.CurrentPrincipal(c); p != nil {
+		userID = p.ID
+	}
+	in := ProductInput{
+		CategoryID: req.CategoryID, Name: req.Name, SKU: req.SKU, Unit: req.Unit,
+		Price: req.Price.String(), Stock: req.Stock.String(), MinStock: req.MinStock.String(),
+		Box: req.Box, Place: req.Place, IsActive: *req.IsActive,
+	}
+	resp, err := h.svc.Update(c.Context(), c.Params("id"), userID, in)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Delete — DELETE /api/v1/products/:id (admin); используемый в комплекте → 409 PRODUCT_IN_USE.
+func (h *ProductHandler) Delete(c fiber.Ctx) error {
+	if err := h.svc.Delete(c.Context(), c.Params("id")); err != nil {
+		return err
+	}
+	return c.SendStatus(fiber.StatusNoContent)
+}
diff --git a/internal/features/catalog/products_repo.go b/internal/features/catalog/products_repo.go
new file mode 100644
index 0000000..eec18d7
--- /dev/null
+++ b/internal/features/catalog/products_repo.go
@@ -0,0 +1,239 @@
+package catalog
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Product — repo-модель товара. Numeric-поля читаются как text (`::text` в SELECT) —
+// без потери точности и без зависимости от decimal-библиотеки.
+type Product struct {
+	ID         string
+	CategoryID string
+	Name       string
+	SKU        string
+	Unit       string
+	Price      string
+	IsActive   bool
+	Stock      string
+	MinStock   string
+	Box        string
+	Place      string
+	CreatedAt  time.Time
+	UpdatedAt  time.Time
+}
+
+type ProductRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewProductRepo(pool *pgxpool.Pool) *ProductRepo { return &ProductRepo{pool: pool} }
+
+var (
+	ErrProductNotFound        = pgx.ErrNoRows
+	errProductInUse           = errors.New("catalog: product in use")
+	errProductCategoryInvalid = errors.New("catalog: product category invalid")
+	// errStockDeltaOutOfRange — переполнение qty_delta (см. Update ниже): PG 22003 на
+	// вставку в stock_movements, не на карточку товара — маппится отдельно от
+	// mapProductWriteErr (та ветка — про поля самой карточки).
+	errStockDeltaOutOfRange = errors.New("catalog: stock delta out of range")
+)
+
+const productColumns = `id, category_id, name, sku, unit, price::text, is_active, stock::text, min_stock::text, box, place, created_at, updated_at`
+
+func scanProduct(row pgx.Row) (*Product, error) {
+	var p Product
+	if err := row.Scan(&p.ID, &p.CategoryID, &p.Name, &p.SKU, &p.Unit, &p.Price, &p.IsActive,
+		&p.Stock, &p.MinStock, &p.Box, &p.Place, &p.CreatedAt, &p.UpdatedAt); err != nil {
+		return nil, err
+	}
+	return &p, nil
+}
+
+type ProductListParams struct {
+	CategoryID      string
+	Q               string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+// List — q ищет по name/sku/box/place (ILIKE); карточка неактивной категории всё
+// равно отдаёт товары (фильтр по товару, не по категории).
+func (r *ProductRepo) List(ctx context.Context, p ProductListParams) ([]Product, int, error) {
+	var conds []string
+	var args []any
+	add := func(cond string, val any) {
+		args = append(args, val)
+		conds = append(conds, fmt.Sprintf(cond, len(args)))
+	}
+	if p.CategoryID != "" {
+		add("category_id = $%d::uuid", p.CategoryID)
+	}
+	if !p.IncludeArchived {
+		conds = append(conds, "is_active")
+	}
+	if p.Q != "" {
+		like := "%" + sqlutil.EscapeLike(p.Q) + "%"
+		args = append(args, like)
+		n := len(args)
+		conds = append(conds, fmt.Sprintf("(name ILIKE $%d OR sku ILIKE $%d OR box ILIKE $%d OR place ILIKE $%d)", n, n, n, n))
+	}
+	where := ""
+	if len(conds) > 0 {
+		where = " WHERE " + strings.Join(conds, " AND ")
+	}
+
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM products`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	q := `SELECT ` + productColumns + ` FROM products` + where +
+		fmt.Sprintf(" ORDER BY lower(name), id LIMIT $%d OFFSET $%d", len(args)+1, len(args)+2)
+	rows, err := r.pool.Query(ctx, q, append(args, p.Limit, p.Offset)...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []Product{}
+	for rows.Next() {
+		pr, err := scanProduct(rows)
+		if err != nil {
+			return nil, 0, err
+		}
+		out = append(out, *pr)
+	}
+	return out, total, rows.Err()
+}
+
+func (r *ProductRepo) Get(ctx context.Context, id string) (*Product, error) {
+	return scanProduct(r.pool.QueryRow(ctx, `SELECT `+productColumns+` FROM products WHERE id = $1::uuid`, id))
+}
+
+// Create — категория обязана существовать и иметь kind='product' — проверяется одним
+// INSERT ... SELECT ... WHERE EXISTS: 0 строк без иной ошибки → errProductCategoryInvalid.
+func (r *ProductRepo) Create(ctx context.Context, in ProductInput) (*Product, error) {
+	row := r.pool.QueryRow(ctx, `
+		INSERT INTO products (category_id, name, sku, unit, price, stock, min_stock, box, place)
+		SELECT $1::uuid, $2, $3, $4, $5::numeric, $6::numeric, $7::numeric, $8, $9
+		WHERE EXISTS (SELECT 1 FROM catalog_categories WHERE id = $1::uuid AND kind = 'product')
+		RETURNING `+productColumns,
+		in.CategoryID, in.Name, in.SKU, in.Unit, in.Price, in.Stock, in.MinStock, in.Box, in.Place)
+	p, err := scanProduct(row)
+	if err != nil {
+		return nil, mapProductWriteErr(err, true)
+	}
+	return p, nil
+}
+
+// Update — полная замена карточки в одной транзакции: проверка категории, UPDATE,
+// и — если stock изменился — запись stock_movements(reason=manual, delta=новое-старое,
+// user) той же транзакцией (task.md: «delta=0 → записи нет»). Дельта считается в SQL
+// (NUMERIC - NUMERIC) — без конвертации через float64, без потери точности.
+func (r *ProductRepo) Update(ctx context.Context, id, userID string, in ProductInput) (*Product, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(ctx) //nolint:errcheck
+
+	var exists bool
+	if err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM catalog_categories WHERE id = $1::uuid AND kind = 'product')`,
+		in.CategoryID).Scan(&exists); err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, errProductCategoryInvalid
+	}
+
+	// oldStock — значение ДО записи, под блокировкой строки (FOR UPDATE): дельта
+	// считается относительно него, а не относительно уже применённого нового значения.
+	var oldStock string
+	if err := tx.QueryRow(ctx, `SELECT stock::text FROM products WHERE id = $1::uuid FOR UPDATE`, id).Scan(&oldStock); err != nil {
+		return nil, mapProductWriteErr(err, false)
+	}
+
+	row := tx.QueryRow(ctx, `
+		UPDATE products SET category_id = $2::uuid, name = $3, sku = $4, unit = $5, price = $6::numeric,
+			stock = $7::numeric, min_stock = $8::numeric, box = $9, place = $10, is_active = $11, updated_at = now()
+		WHERE id = $1::uuid
+		RETURNING `+productColumns,
+		id, in.CategoryID, in.Name, in.SKU, in.Unit, in.Price, in.Stock, in.MinStock, in.Box, in.Place, in.IsActive)
+	p, err := scanProduct(row)
+	if err != nil {
+		return nil, mapProductWriteErr(err, false)
+	}
+
+	// delta = новое-старое: оба конца уже провалидированы validateAmount(qtyScale), но
+	// РАЗНОСТЬ двух валидных значений у противоположных границ (напр. -999999999.999 →
+	// 999999999.999) сама может выйти за IntDigits колонки — 22003 здесь не «не должно
+	// случиться», а реальный, хоть и редкий, кейс (code review Блокер 1) → 400 на поле
+	// "stock", не 500.
+	if _, err := tx.Exec(ctx, `
+		INSERT INTO stock_movements (product_id, qty_delta, reason, user_id)
+		SELECT $1::uuid, $2::numeric - $3::numeric, 'manual', $4::uuid
+		WHERE ($2::numeric - $3::numeric) <> 0`,
+		id, in.Stock, oldStock, userID); err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && pgErr.Code == "22003" {
+			return nil, errStockDeltaOutOfRange
+		}
+		return nil, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return p, nil
+}
+
+func (r *ProductRepo) SetActive(ctx context.Context, id string, active bool) error {
+	tag, err := r.pool.Exec(ctx, `UPDATE products SET is_active = $2, updated_at = now() WHERE id = $1::uuid`, id, active)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrProductNotFound
+	}
+	return nil
+}
+
+// Delete — FK-нарушение (service_products RESTRICT) → errProductInUse.
+func (r *ProductRepo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM products WHERE id = $1::uuid`, id)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && (pgErr.Code == "23503" || pgErr.Code == "23001") {
+			return errProductInUse
+		}
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrProductNotFound
+	}
+	return nil
+}
+
+// mapProductWriteErr — 0 строк RETURNING: Create — категория невалидна (INSERT ...
+// WHERE EXISTS), Update — id не найден (категория уже проверена раньше отдельным
+// запросом, поэтому здесь всегда ErrProductNotFound). validateAmount() в валидаторе уже
+// не пускает price/stock/min_stock за пределы NUMERIC(12,2)/(12,3) до этой точки — 22003
+// здесь возможен только на непредвиденном пути; раньше он молча маппился на
+// errProductCategoryInvalid (400 по ЧУЖОМУ полю category_id, code review Блокер 1) —
+// теперь mapAmountOverflow не привязывает его к конкретному полю формы.
+func mapProductWriteErr(err error, isCreate bool) error {
+	if errors.Is(err, pgx.ErrNoRows) {
+		if isCreate {
+			return errProductCategoryInvalid
+		}
+		return ErrProductNotFound
+	}
+	return mapAmountOverflow(err)
+}
diff --git a/internal/features/catalog/products_service.go b/internal/features/catalog/products_service.go
new file mode 100644
index 0000000..1d717cd
--- /dev/null
+++ b/internal/features/catalog/products_service.go
@@ -0,0 +1,171 @@
+package catalog
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+var (
+	ErrProductNotFoundErr = errorspkg.New("PRODUCT_NOT_FOUND", http.StatusNotFound, "Товар не найден")
+	ErrProductInUse       = errorspkg.New("PRODUCT_IN_USE", http.StatusConflict,
+		"Товар используется в комплекте услуги — удалить нельзя, отправьте его в архив")
+	// errProductCategoryInvalid из репозитория маппится в 400 (поле category_id) —
+	// отдельного AppError-кода не заводим, категория — обычная валидация формы.
+)
+
+type ProductService struct {
+	repo *ProductRepo
+}
+
+func NewProductService(pool *pgxpool.Pool) *ProductService {
+	return &ProductService{repo: NewProductRepo(pool)}
+}
+
+type ProductListQuery struct {
+	CategoryID      string
+	Q               string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+const productLookupDefaultLimit = 50 // API §Лимиты task.md: default 50 / max 500
+
+// List — !isAdmin форсирует IncludeArchived=false (исполнитель видит только активные —
+// D19).
+func (s *ProductService) List(ctx context.Context, q ProductListQuery, isAdmin bool) (*ProductListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = productLookupDefaultLimit
+	}
+	limit = min(limit, maxLimit)
+	offset = max(offset, 0)
+	includeArchived := q.IncludeArchived && isAdmin
+
+	categoryID := q.CategoryID
+	if categoryID != "" && uuid.Validate(categoryID) != nil {
+		categoryID = "" // мусор в category_id — как без фильтра, не 500/404
+	}
+	query := strings.TrimSpace(q.Q)
+	if sqlutil.HasInvalidText(query) {
+		query = ""
+	}
+	items, total, err := s.repo.List(ctx, ProductListParams{
+		CategoryID: categoryID, Q: query, IncludeArchived: includeArchived, Limit: limit, Offset: offset,
+	})
+	if err != nil {
+		return nil, err
+	}
+	resp := &ProductListResponse{Items: make([]ProductResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, p := range items {
+		resp.Items[i] = toProductResponse(p)
+	}
+	return resp, nil
+}
+
+// Get — D19 «активные записи» относится к List (для исполнителя IncludeArchived
+// форсится в false); Get по конкретному id архив НЕ фильтрует ни для админа, ни для
+// исполнителя — as-is решение, зафиксировано по прецеденту equipmenttypes.Service.Get
+// (code review LOW#5, не блокер: осмысленный сценарий — открыть карточку архивной
+// записи по прямой ссылке из другого места экрана, а не «спрятать» её вовсе).
+func (s *ProductService) Get(ctx context.Context, id string) (*ProductResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrProductNotFoundErr
+	}
+	p, err := s.repo.Get(ctx, id)
+	if errors.Is(err, ErrProductNotFound) {
+		return nil, ErrProductNotFoundErr
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toProductResponse(*p)
+	return &resp, nil
+}
+
+func (s *ProductService) Create(ctx context.Context, in ProductInput) (*ProductResponse, error) {
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	p, err := s.repo.Create(ctx, in)
+	switch {
+	case errors.Is(err, errProductCategoryInvalid):
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "category_id", Message: msgInvalid})
+	case errors.Is(err, errAmountOutOfRange):
+		return nil, ErrAmountOutOfRange
+	case err != nil:
+		return nil, err
+	}
+	resp := toProductResponse(*p)
+	return &resp, nil
+}
+
+// Update — userID пишется в stock_movements при ручном изменении остатка (в той же
+// транзакции, что и UPDATE карточки — репозиторий).
+func (s *ProductService) Update(ctx context.Context, id, userID string, in ProductInput) (*ProductResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrProductNotFoundErr
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	p, err := s.repo.Update(ctx, id, userID, in)
+	switch {
+	case errors.Is(err, ErrProductNotFound):
+		return nil, ErrProductNotFoundErr
+	case errors.Is(err, errProductCategoryInvalid):
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "category_id", Message: msgInvalid})
+	case errors.Is(err, errStockDeltaOutOfRange):
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "stock", Message: msgTooLarge})
+	case errors.Is(err, errAmountOutOfRange):
+		return nil, ErrAmountOutOfRange
+	case err != nil:
+		return nil, err
+	}
+	resp := toProductResponse(*p)
+	return &resp, nil
+}
+
+func (s *ProductService) SetActive(ctx context.Context, id string, active bool) error {
+	if uuid.Validate(id) != nil {
+		return ErrProductNotFoundErr
+	}
+	if err := s.repo.SetActive(ctx, id, active); errors.Is(err, ErrProductNotFound) {
+		return ErrProductNotFoundErr
+	} else if err != nil {
+		return err
+	}
+	return nil
+}
+
+func (s *ProductService) Delete(ctx context.Context, id string) error {
+	if uuid.Validate(id) != nil {
+		return ErrProductNotFoundErr
+	}
+	err := s.repo.Delete(ctx, id)
+	switch {
+	case errors.Is(err, ErrProductNotFound):
+		return ErrProductNotFoundErr
+	case errors.Is(err, errProductInUse):
+		return ErrProductInUse
+	default:
+		return err
+	}
+}
+
+func toProductResponse(p Product) ProductResponse {
+	return ProductResponse{
+		ID: p.ID, CategoryID: p.CategoryID, Name: p.Name, SKU: p.SKU, Unit: p.Unit,
+		Price: Amount(p.Price), IsActive: p.IsActive, Stock: Amount(p.Stock), MinStock: Amount(p.MinStock),
+		Box: p.Box, Place: p.Place, CreatedAt: p.CreatedAt, UpdatedAt: p.UpdatedAt,
+	}
+}
diff --git a/internal/features/catalog/products_validate.go b/internal/features/catalog/products_validate.go
new file mode 100644
index 0000000..462c436
--- /dev/null
+++ b/internal/features/catalog/products_validate.go
@@ -0,0 +1,129 @@
+package catalog
+
+import (
+	"regexp"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Units — единицы измерения товара (прототип, UNITS). Пустая строка — «не указана».
+var Units = []string{"шт", "л", "м", "кг", "компл", "час"}
+
+func isValidUnit(u string) bool {
+	if u == "" {
+		return true
+	}
+	for _, v := range Units {
+		if v == u {
+			return true
+		}
+	}
+	return false
+}
+
+// decimalRe — целое/десятичное число, опциональный минус (для остатка), без ведущих
+// нулей (кроме самого "0"), без экспоненты — исключает мусор вида "1e400"/"NaN"/"Inf".
+var decimalRe = regexp.MustCompile(`^-?(0|[1-9]\d*)(\.\d+)?$`)
+
+const (
+	productNameMax = 200
+	skuMax         = 100
+	boxPlaceMax    = 100
+)
+
+// ProductInput — нормализованные поля товара (общие для API и SSR-формы).
+type ProductInput struct {
+	CategoryID string
+	Name       string
+	SKU        string
+	Unit       string
+	Price      string
+	Stock      string
+	MinStock   string
+	Box        string
+	Place      string
+	IsActive   bool
+}
+
+func normStr(s string) string { return strings.TrimSpace(s) }
+
+func normAmount(s string) string {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return "0"
+	}
+	return s
+}
+
+func (in ProductInput) normalize() ProductInput {
+	in.CategoryID = normStr(in.CategoryID)
+	in.Name = normStr(in.Name)
+	in.SKU = normStr(in.SKU)
+	in.Unit = normStr(in.Unit)
+	in.Box = normStr(in.Box)
+	in.Place = normStr(in.Place)
+	in.Price = normAmount(in.Price)
+	in.Stock = normAmount(in.Stock)
+	in.MinStock = normAmount(in.MinStock)
+	return in
+}
+
+// validate — ошибки полей после normalize(). allowNegativeStock — остаток товара может
+// быть отрицательным (D44/task.md «может быть < 0»), цена и минимум остатка — нет.
+func (in ProductInput) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	if in.CategoryID == "" {
+		add("category_id", msgRequired)
+	} else if uuid.Validate(in.CategoryID) != nil {
+		add("category_id", msgInvalid)
+	}
+
+	switch n := utf8.RuneCountInString(in.Name); {
+	case n == 0:
+		add("name", msgRequired)
+	case n > productNameMax:
+		add("name", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Name) {
+		add("name", msgInvalidText)
+	}
+
+	if utf8.RuneCountInString(in.SKU) > skuMax {
+		add("sku", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.SKU) {
+		add("sku", msgInvalidText)
+	}
+	if utf8.RuneCountInString(in.Box) > boxPlaceMax {
+		add("box", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Box) {
+		add("box", msgInvalidText)
+	}
+	if utf8.RuneCountInString(in.Place) > boxPlaceMax {
+		add("place", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Place) {
+		add("place", msgInvalidText)
+	}
+	if !isValidUnit(in.Unit) {
+		add("unit", msgInvalid)
+	}
+
+	addAmount := func(field, val string, scale amountScale, allowNegative bool) {
+		if code := validateAmount(val, scale, allowNegative); code != "" {
+			add(field, code)
+		}
+	}
+	addAmount("price", in.Price, priceScale, false)
+	addAmount("stock", in.Stock, qtyScale, true)
+	addAmount("min_stock", in.MinStock, qtyScale, false)
+	return f
+}
diff --git a/internal/features/catalog/products_validate_test.go b/internal/features/catalog/products_validate_test.go
new file mode 100644
index 0000000..db05c12
--- /dev/null
+++ b/internal/features/catalog/products_validate_test.go
@@ -0,0 +1,132 @@
+package catalog
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+)
+
+func validProductInput() ProductInput {
+	return ProductInput{
+		CategoryID: uuid.Must(uuid.NewV7()).String(), Name: "Фильтр масляный", SKU: "F-001",
+		Unit: "шт", Price: "199.90", Stock: "5", MinStock: "2", Box: "К-07", Place: "Стеллаж A",
+	}
+}
+
+func TestProductInput_Normalize(t *testing.T) {
+	in := ProductInput{
+		CategoryID: "  id  ", Name: "  Фильтр  ", SKU: " F1 ", Unit: " шт ",
+		Price: "  ", Stock: " 5 ", MinStock: "", Box: " К1 ", Place: " Полка ",
+	}.normalize()
+	assert.Equal(t, "id", in.CategoryID)
+	assert.Equal(t, "Фильтр", in.Name)
+	assert.Equal(t, "F1", in.SKU)
+	assert.Equal(t, "шт", in.Unit)
+	assert.Equal(t, "0", in.Price, "пустая цена нормализуется в 0")
+	assert.Equal(t, "5", in.Stock)
+	assert.Equal(t, "0", in.MinStock)
+	assert.Equal(t, "К1", in.Box)
+	assert.Equal(t, "Полка", in.Place)
+}
+
+func TestProductInput_Validate_HappyPath(t *testing.T) {
+	assert.Empty(t, fieldsOf(validProductInput().normalize().validate()))
+}
+
+func TestProductInput_Validate_CategoryID(t *testing.T) {
+	in := validProductInput()
+	in.CategoryID = ""
+	assert.Equal(t, map[string]string{"category_id": msgRequired}, fieldsOf(in.normalize().validate()))
+
+	in = validProductInput()
+	in.CategoryID = "not-a-uuid"
+	assert.Equal(t, map[string]string{"category_id": msgInvalid}, fieldsOf(in.normalize().validate()))
+}
+
+func TestProductInput_Validate_Name(t *testing.T) {
+	in := validProductInput()
+	in.Name = ""
+	assert.Equal(t, map[string]string{"name": msgRequired}, fieldsOf(in.normalize().validate()))
+
+	in = validProductInput()
+	in.Name = strings.Repeat("я", 200)
+	assert.Empty(t, fieldsOf(in.normalize().validate()), "200 рун — граница")
+
+	in = validProductInput()
+	in.Name = strings.Repeat("я", 201)
+	assert.Equal(t, map[string]string{"name": msgTooLong}, fieldsOf(in.normalize().validate()))
+
+	in = validProductInput()
+	in.Name = "Товар\u0000"
+	assert.Equal(t, map[string]string{"name": msgInvalidText}, fieldsOf(in.normalize().validate()))
+}
+
+func TestProductInput_Validate_Unit(t *testing.T) {
+	in := validProductInput()
+	in.Unit = ""
+	assert.Empty(t, fieldsOf(in.normalize().validate()), "пустая единица допустима")
+
+	in = validProductInput()
+	in.Unit = "тонна"
+	assert.Equal(t, map[string]string{"unit": msgInvalid}, fieldsOf(in.normalize().validate()))
+
+	for _, u := range Units {
+		in := validProductInput()
+		in.Unit = u
+		assert.Empty(t, fieldsOf(in.normalize().validate()), "единица %q из списка — ок", u)
+	}
+}
+
+func TestProductInput_Validate_Amounts(t *testing.T) {
+	cases := []struct {
+		name  string
+		mut   func(*ProductInput)
+		field string
+		code  string
+	}{
+		{"цена отрицательная", func(in *ProductInput) { in.Price = "-1" }, "price", msgInvalid},
+		{"цена мусор", func(in *ProductInput) { in.Price = "abc" }, "price", msgInvalidFormat},
+		{"цена экспонента — отклоняется", func(in *ProductInput) { in.Price = "1e5" }, "price", msgInvalidFormat},
+		{"цена NaN — отклоняется", func(in *ProductInput) { in.Price = "NaN" }, "price", msgInvalidFormat},
+		{"минимум отрицательный", func(in *ProductInput) { in.MinStock = "-0.5" }, "min_stock", msgInvalid},
+		{"остаток мусор", func(in *ProductInput) { in.Stock = "12.34.56" }, "stock", msgInvalidFormat},
+		// code review Блокер 1 — границы NUMERIC(12,2)/(12,3): переполнение и лишняя
+		// точность → 400 по СВОЕМУ полю, не молчаливое округление/500.
+		{"цена переполнение 1e10 форматом", func(in *ProductInput) { in.Price = "1e10" }, "price", msgInvalidFormat},
+		{"цена переполнение целой части", func(in *ProductInput) { in.Price = "12345678901" }, "price", msgTooLarge},
+		{"цена лишняя точность", func(in *ProductInput) { in.Price = "1.239" }, "price", msgTooPrecise},
+		{"остаток лишняя точность", func(in *ProductInput) { in.Stock = "0.0004" }, "stock", msgTooPrecise},
+		{"остаток переполнение целой части", func(in *ProductInput) { in.Stock = "1000000000" }, "stock", msgTooLarge},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			in := validProductInput()
+			tc.mut(&in)
+			got := fieldsOf(in.normalize().validate())
+			assert.Equal(t, tc.code, got[tc.field], "%v", got)
+		})
+	}
+}
+
+// D44/task.md: остаток товара может быть отрицательным (долг) — не ошибка.
+func TestProductInput_Validate_NegativeStockAllowed(t *testing.T) {
+	in := validProductInput()
+	in.Stock = "-3.5"
+	assert.Empty(t, fieldsOf(in.normalize().validate()))
+}
+
+func TestProductInput_Validate_SkuBoxPlaceTooLong(t *testing.T) {
+	in := validProductInput()
+	in.SKU = strings.Repeat("a", 101)
+	assert.Equal(t, map[string]string{"sku": msgTooLong}, fieldsOf(in.normalize().validate()))
+
+	in = validProductInput()
+	in.Box = strings.Repeat("a", 101)
+	assert.Equal(t, map[string]string{"box": msgTooLong}, fieldsOf(in.normalize().validate()))
+
+	in = validProductInput()
+	in.Place = strings.Repeat("a", 101)
+	assert.Equal(t, map[string]string{"place": msgTooLong}, fieldsOf(in.normalize().validate()))
+}
diff --git a/internal/features/catalog/routes.go b/internal/features/catalog/routes.go
new file mode 100644
index 0000000..6f222c0
--- /dev/null
+++ b/internal/features/catalog/routes.go
@@ -0,0 +1,72 @@
+package catalog
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+)
+
+// Register — JSON API /api/v1/catalog-categories, /api/v1/products (D19: !isAdmin —
+// только чтение активных записей, мутации — admin) + SSR-экраны /catalog/products,
+// /catalog/services (заглушка), управление категориями. /catalog — 303 на /catalog/services
+// (task.md: «/catalog → 303 /catalog/services»). При s == nil SSR-группы не регистрируются
+// (используется в тестах, где рендерер не нужен).
+func Register(app *fiber.App, api fiber.Router, a *middleware.Auth, catH *CategoryHandler, prodH *ProductHandler, svcH *ServiceHandler, s *SSR) {
+	admin := middleware.RequireAdmin(nil)
+
+	cg := api.Group("/catalog-categories", a.RequireAPI())
+	cg.Get("", catH.List)
+	cg.Post("", admin, catH.Create)
+	cg.Get("/:id", catH.Get)
+	cg.Put("/:id", admin, catH.Update)
+	cg.Delete("/:id", admin, catH.Delete)
+
+	pg := api.Group("/products", a.RequireAPI())
+	pg.Get("", prodH.List)
+	pg.Post("", admin, prodH.Create)
+	pg.Get("/:id", prodH.Get)
+	pg.Put("/:id", admin, prodH.Update)
+	pg.Delete("/:id", admin, prodH.Delete)
+
+	sg := api.Group("/services", a.RequireAPI())
+	sg.Get("", svcH.List)
+	sg.Post("", admin, svcH.Create)
+	sg.Get("/:id", svcH.Get)
+	sg.Put("/:id", admin, svcH.Update)
+	sg.Delete("/:id", admin, svcH.Delete)
+
+	if s == nil {
+		return
+	}
+	ssrAdmin := middleware.RequireAdmin(s.status.Forbidden)
+	app.Get("/catalog", a.RequireSSR(), ssrAdmin, func(c fiber.Ctx) error {
+		return c.Redirect().Status(fiber.StatusSeeOther).To("/catalog/services")
+	})
+
+	svc := app.Group("/catalog/services", a.RequireSSR(), ssrAdmin)
+	svc.Get("", s.servicesList)
+	svc.Get("/new", s.serviceFormNew)
+	svc.Post("", s.serviceCreate)
+	svc.Get("/:id", s.serviceFormEdit)
+	svc.Post("/:id", s.serviceUpdate)
+	svc.Post("/:id/archive", s.serviceArchive)
+	svc.Post("/:id/restore", s.serviceRestore)
+	svc.Post("/:id/delete", s.serviceRemove)
+
+	prod := app.Group("/catalog/products", a.RequireSSR(), ssrAdmin)
+	prod.Get("", s.productsList)
+	prod.Get("/new", s.productFormNew)
+	prod.Post("", s.productCreate)
+	prod.Get("/:id", s.productFormEdit)
+	prod.Post("/:id", s.productUpdate)
+	prod.Post("/:id/archive", s.productArchive)
+	prod.Post("/:id/restore", s.productRestore)
+	prod.Post("/:id/delete", s.productRemove)
+
+	cats := app.Group("/catalog/categories", a.RequireSSR(), ssrAdmin)
+	cats.Post("", s.cat.create)
+	cats.Post("/:id/rename", s.cat.rename)
+	cats.Post("/:id/archive", s.cat.archive)
+	cats.Post("/:id/restore", s.cat.restore)
+	cats.Post("/:id/delete", s.cat.remove)
+}
