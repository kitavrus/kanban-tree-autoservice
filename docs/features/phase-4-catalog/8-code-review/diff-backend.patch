+		field   string
+		message string
+	}{
+		{"цена 12345678901 — переполнение целой части", map[string]any{"price": 12345678901}, "price", "too_large"},
+		{"цена 1.239 — лишняя точность", map[string]any{"price": 1.239}, "price", "too_precise"},
