diff --git a/internal/features/catalog/services_repo.go b/internal/features/catalog/services_repo.go
new file mode 100644
index 0000000..72ee7a5
--- /dev/null
+++ b/internal/features/catalog/services_repo.go
@@ -0,0 +1,374 @@
+package catalog
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Service — repo-модель услуги (без комплекта — грузится отдельно ServiceProductRow,
+// re-fetch-after-write). Price == nil — «по факту» (NULL в БД).
+type Service struct {
+	ID         string
+	CategoryID string
+	Name       string
+	Price      *string
+	IsActive   bool
+	CreatedAt  time.Time
+	UpdatedAt  time.Time
+}
+
+// ServiceProductRow — строка комплекта с денормализованными полями товара (JOIN products).
+type ServiceProductRow struct {
+	ProductID string
+	Name      string
+	Unit      string
+	Price     string
+	Qty       string
+}
+
+type ServiceRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewServiceRepo(pool *pgxpool.Pool) *ServiceRepo { return &ServiceRepo{pool: pool} }
+
+var (
+	ErrServiceNotFound        = pgx.ErrNoRows
+	errServiceCategoryInvalid = errors.New("catalog: service category invalid")
+)
+
+// errServiceProductInvalid — строка комплекта ссылается на несуществующий/архивный товар
+// (task.md: «архивный/несуществующий товар → 400 по полю строки»).
+type errServiceProductInvalid struct{ Index int }
+
+func (e *errServiceProductInvalid) Error() string {
+	return fmt.Sprintf("catalog: service product invalid at index %d", e.Index)
+}
+
+const serviceColumns = `id, category_id, name, price::text, is_active, created_at, updated_at`
+
+func scanService(row pgx.Row) (*Service, error) {
+	var s Service
+	if err := row.Scan(&s.ID, &s.CategoryID, &s.Name, &s.Price, &s.IsActive, &s.CreatedAt, &s.UpdatedAt); err != nil {
+		return nil, err
+	}
+	return &s, nil
+}
+
+type ServiceListParams struct {
+	CategoryID      string
+	Q               string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+// List — q ищет по названию услуги (в отличие от товаров — нет артикула/коробки/места).
+func (r *ServiceRepo) List(ctx context.Context, p ServiceListParams) ([]Service, int, error) {
+	var conds []string
+	var args []any
+	add := func(cond string, val any) {
+		args = append(args, val)
+		conds = append(conds, fmt.Sprintf(cond, len(args)))
+	}
+	if p.CategoryID != "" {
+		add("category_id = $%d::uuid", p.CategoryID)
+	}
+	if !p.IncludeArchived {
+		conds = append(conds, "is_active")
+	}
+	if p.Q != "" {
+		add("name ILIKE $%d", "%"+sqlutil.EscapeLike(p.Q)+"%")
+	}
+	where := ""
+	if len(conds) > 0 {
+		where = " WHERE " + strings.Join(conds, " AND ")
+	}
+
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM services`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	q := `SELECT ` + serviceColumns + ` FROM services` + where +
+		fmt.Sprintf(" ORDER BY lower(name), id LIMIT $%d OFFSET $%d", len(args)+1, len(args)+2)
+	rows, err := r.pool.Query(ctx, q, append(args, p.Limit, p.Offset)...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []Service{}
+	for rows.Next() {
+		s, err := scanService(rows)
+		if err != nil {
+			return nil, 0, err
+		}
+		out = append(out, *s)
+	}
+	return out, total, rows.Err()
+}
+
+func (r *ServiceRepo) Get(ctx context.Context, id string) (*Service, error) {
+	return scanService(r.pool.QueryRow(ctx, `SELECT `+serviceColumns+` FROM services WHERE id = $1::uuid`, id))
+}
+
+// Products — комплект услуги, порядок по position (SSR/API — «Название ×qty»).
+func (r *ServiceRepo) Products(ctx context.Context, serviceID string) ([]ServiceProductRow, error) {
+	rows, err := r.pool.Query(ctx, `
+		SELECT sp.product_id, p.name, p.unit, p.price::text, sp.qty::text
+		FROM service_products sp JOIN products p ON p.id = sp.product_id
+		WHERE sp.service_id = $1::uuid ORDER BY sp.position`, serviceID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []ServiceProductRow{}
+	for rows.Next() {
+		var row ServiceProductRow
+		if err := rows.Scan(&row.ProductID, &row.Name, &row.Unit, &row.Price, &row.Qty); err != nil {
+			return nil, err
+		}
+		out = append(out, row)
+	}
+	return out, rows.Err()
+}
+
+// ProductsBatch — комплекты сразу для набора услуг (Sec 18/Серьёзное 1 — N+1: раньше
+// ServiceService.List дёргал Products() на КАЖДУЮ услугу страницы отдельно, до 501
+// round-trip на limit=500; здесь — один запрос WHERE service_id = ANY($1::uuid[]),
+// группировка в Go, эталон — clients phonesBatch).
+func (r *ServiceRepo) ProductsBatch(ctx context.Context, serviceIDs []string) (map[string][]ServiceProductRow, error) {
+	out := map[string][]ServiceProductRow{}
+	if len(serviceIDs) == 0 {
+		return out, nil
+	}
+	rows, err := r.pool.Query(ctx, `
+		SELECT sp.service_id::text, sp.product_id, p.name, p.unit, p.price::text, sp.qty::text
+		FROM service_products sp JOIN products p ON p.id = sp.product_id
+		WHERE sp.service_id = ANY($1::uuid[]) ORDER BY sp.service_id, sp.position`, serviceIDs)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var serviceID string
+		var row ServiceProductRow
+		if err := rows.Scan(&serviceID, &row.ProductID, &row.Name, &row.Unit, &row.Price, &row.Qty); err != nil {
+			return nil, err
+		}
+		out[serviceID] = append(out[serviceID], row)
+	}
+	return out, rows.Err()
+}
+
+// existingServiceProductIDs — product_id, УЖЕ присутствующие в комплекте этой услуги (до
+// правки) — грандфазер-набор для checkProducts на Update (code review Medium#2).
+func existingServiceProductIDs(ctx context.Context, tx pgx.Tx, serviceID string) (map[string]bool, error) {
+	out := map[string]bool{}
+	rows, err := tx.Query(ctx, `SELECT product_id::text FROM service_products WHERE service_id = $1::uuid`, serviceID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		out[id] = true
+	}
+	return out, rows.Err()
+}
+
+// validActiveProductIDs — активные товары из набора id, одним запросом (ANY($1::uuid[])).
+func validActiveProductIDs(ctx context.Context, tx pgx.Tx, ids []string) (map[string]bool, error) {
+	valid := map[string]bool{}
+	if len(ids) == 0 {
+		return valid, nil
+	}
+	rows, err := tx.Query(ctx, `SELECT id::text FROM products WHERE id = ANY($1::uuid[]) AND is_active`, ids)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		valid[id] = true
+	}
+	return valid, rows.Err()
+}
+
+// checkProducts — первая строка со ссылкой на несуществующий/архивный товар → индекс.
+// grandfathered — product_id, уже присутствовавшие в ТЕКУЩЕМ комплекте этой услуги (nil
+// на Create — там прошлого комплекта не существует): для них is_active НЕ проверяется —
+// существование уже гарантировано FK service_products.product_id (code review Medium#2:
+// task.md запрещает архивный товар «при добавлении» в комплект, не при пересохранении уже
+// существующей строки — иначе PRODUCT_IN_USE → архив делает услугу несохраняемой вовсе).
+func checkProducts(ctx context.Context, tx pgx.Tx, products []ServiceProductInput, grandfathered map[string]bool) error {
+	ids := make([]string, 0, len(products))
+	for _, p := range products {
+		if grandfathered[p.ProductID] {
+			continue
+		}
+		ids = append(ids, p.ProductID)
+	}
+	valid, err := validActiveProductIDs(ctx, tx, ids)
+	if err != nil {
+		return err
+	}
+	for i, p := range products {
+		if grandfathered[p.ProductID] {
+			continue
+		}
+		if !valid[p.ProductID] {
+			return &errServiceProductInvalid{Index: i}
+		}
+	}
+	return nil
+}
+
+// replaceServiceProducts — DELETE+INSERT всего комплекта (проще диффа, product_id RESTRICT
+// не мешает — FK защищает удаление самого товара, не строк service_products).
+func replaceServiceProducts(ctx context.Context, tx pgx.Tx, serviceID string, products []ServiceProductInput) error {
+	if _, err := tx.Exec(ctx, `DELETE FROM service_products WHERE service_id = $1::uuid`, serviceID); err != nil {
+		return err
+	}
+	for i, p := range products {
+		if _, err := tx.Exec(ctx,
+			`INSERT INTO service_products (service_id, product_id, qty, position) VALUES ($1::uuid, $2::uuid, $3::numeric, $4)`,
+			serviceID, p.ProductID, p.Qty, i); err != nil {
+			// qty ограничен validateAmount(qtyScale) до дедупа и mergeProducts()
+			// проверяет сумму дублей — 22003 здесь непредвиденный путь, страховка
+			// (code review Блокер 1).
+			return mapAmountOverflow(err)
+		}
+	}
+	return nil
+}
+
+func servicePriceArg(in ServiceInput) *string {
+	if !in.HasPrice {
+		return nil
+	}
+	return &in.Price
+}
+
+// Create — категория (kind=service) + все товары комплекта активны, одной транзакцией.
+func (r *ServiceRepo) Create(ctx context.Context, in ServiceInput) (*Service, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(ctx) //nolint:errcheck
+
+	var exists bool
+	if err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM catalog_categories WHERE id = $1::uuid AND kind = 'service')`,
+		in.CategoryID).Scan(&exists); err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, errServiceCategoryInvalid
+	}
+	if err := checkProducts(ctx, tx, in.Products, nil); err != nil {
+		return nil, err
+	}
+
+	row := tx.QueryRow(ctx, `
+		INSERT INTO services (category_id, name, price)
+		VALUES ($1::uuid, $2, $3::numeric)
+		RETURNING `+serviceColumns,
+		in.CategoryID, in.Name, servicePriceArg(in))
+	s, err := scanService(row)
+	if err != nil {
+		// price ограничен validateAmount(priceScale) в валидаторе — 22003 здесь
+		// непредвиденный путь, страховка (code review Блокер 1).
+		return nil, mapAmountOverflow(err)
+	}
+	if err := replaceServiceProducts(ctx, tx, s.ID, in.Products); err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return s, nil
+}
+
+// Update — полная замена карточки + комплекта (DELETE+INSERT), одной транзакцией.
+func (r *ServiceRepo) Update(ctx context.Context, id string, in ServiceInput) (*Service, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(ctx) //nolint:errcheck
+
+	var exists bool
+	if err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM catalog_categories WHERE id = $1::uuid AND kind = 'service')`,
+		in.CategoryID).Scan(&exists); err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, errServiceCategoryInvalid
+	}
+	grandfathered, err := existingServiceProductIDs(ctx, tx, id)
+	if err != nil {
+		return nil, err
+	}
+	if err := checkProducts(ctx, tx, in.Products, grandfathered); err != nil {
+		return nil, err
+	}
+
+	row := tx.QueryRow(ctx, `
+		UPDATE services SET category_id = $2::uuid, name = $3, price = $4::numeric, is_active = $5, updated_at = now()
+		WHERE id = $1::uuid
+		RETURNING `+serviceColumns,
+		id, in.CategoryID, in.Name, servicePriceArg(in), in.IsActive)
+	s, err := scanService(row)
+	if err != nil {
+		if errors.Is(err, pgx.ErrNoRows) {
+			return nil, ErrServiceNotFound
+		}
+		// price ограничен validateAmount(priceScale) в валидаторе — 22003 здесь
+		// непредвиденный путь, страховка (code review Блокер 1).
+		return nil, mapAmountOverflow(err)
+	}
+	if err := replaceServiceProducts(ctx, tx, id, in.Products); err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return s, nil
+}
+
+func (r *ServiceRepo) SetActive(ctx context.Context, id string, active bool) error {
+	tag, err := r.pool.Exec(ctx, `UPDATE services SET is_active = $2, updated_at = now() WHERE id = $1::uuid`, id, active)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrServiceNotFound
+	}
+	return nil
+}
+
+// Delete — «используется в заказах» появится в фазе 5/6 (stock_movements.task_id пока
+// NULL-only, task.md); сейчас простой DELETE, CASCADE подчищает service_products.
+func (r *ServiceRepo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM services WHERE id = $1::uuid`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrServiceNotFound
+	}
+	return nil
+}
diff --git a/internal/features/catalog/services_service.go b/internal/features/catalog/services_service.go
new file mode 100644
index 0000000..68b91b9
--- /dev/null
+++ b/internal/features/catalog/services_service.go
@@ -0,0 +1,226 @@
+package catalog
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+var ErrServiceNotFoundErr = errorspkg.New("SERVICE_NOT_FOUND", http.StatusNotFound, "Услуга не найдена")
+
+type ServiceService struct {
+	repo *ServiceRepo
+}
+
+func NewServiceService(pool *pgxpool.Pool) *ServiceService {
+	return &ServiceService{repo: NewServiceRepo(pool)}
+}
+
+type ServiceListQuery struct {
+	CategoryID      string
+	Q               string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+const serviceLookupDefaultLimit = 50 // API §Лимиты task.md: default 50 / max 500
+
+// List — !isAdmin форсирует IncludeArchived=false (исполнитель видит только активные —
+// D19). Комплекты всех услуг страницы — ОДНИМ запросом (repo.ProductsBatch,
+// WHERE service_id = ANY($1)) — code review Sec 18/Серьёзное 1: раньше toResponse дёргал
+// repo.Products на КАЖДУЮ услугу отдельно (N+1: до 501 round-trip на limit=500).
+func (s *ServiceService) List(ctx context.Context, q ServiceListQuery, isAdmin bool) (*ServiceListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = serviceLookupDefaultLimit
+	}
+	limit = min(limit, maxLimit)
+	offset = max(offset, 0)
+	includeArchived := q.IncludeArchived && isAdmin
+
+	categoryID := q.CategoryID
+	if categoryID != "" && uuid.Validate(categoryID) != nil {
+		categoryID = ""
+	}
+	query := strings.TrimSpace(q.Q)
+	if sqlutil.HasInvalidText(query) {
+		query = ""
+	}
+	items, total, err := s.repo.List(ctx, ServiceListParams{
+		CategoryID: categoryID, Q: query, IncludeArchived: includeArchived, Limit: limit, Offset: offset,
+	})
+	if err != nil {
+		return nil, err
+	}
+	ids := make([]string, len(items))
+	for i, sv := range items {
+		ids[i] = sv.ID
+	}
+	productsByService, err := s.repo.ProductsBatch(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	resp := &ServiceListResponse{Items: make([]ServiceResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, sv := range items {
+		resp.Items[i] = toServiceResponse(sv, productsByService[sv.ID])
+	}
+	return resp, nil
+}
+
+// Get — as-is: архив не фильтрует ни для кого (D19 «активные записи» — про List), по
+// прецеденту equipmenttypes.Service.Get (code review LOW#5).
+func (s *ServiceService) Get(ctx context.Context, id string) (*ServiceResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrServiceNotFoundErr
+	}
+	sv, err := s.repo.Get(ctx, id)
+	if errors.Is(err, ErrServiceNotFound) {
+		return nil, ErrServiceNotFoundErr
+	}
+	if err != nil {
+		return nil, err
+	}
+	r, err := s.toResponse(ctx, *sv)
+	if err != nil {
+		return nil, err
+	}
+	return &r, nil
+}
+
+// prepareProducts — validate() построчно (индексы = исходные строки, форма их и
+// перерисует при ошибке), затем mergeProducts() дедупликация суммой qty (только над уже
+// валидными строками, code review Medium#3).
+func prepareProducts(in ServiceInput) (ServiceInput, error) {
+	if f := in.validate(); len(f) > 0 {
+		return in, errorspkg.Validation(f...)
+	}
+	merged, mergeErrs := mergeProducts(in.Products)
+	if len(mergeErrs) > 0 {
+		return in, errorspkg.Validation(mergeErrs...)
+	}
+	in.Products = merged
+	return in, nil
+}
+
+func (s *ServiceService) Create(ctx context.Context, in ServiceInput) (*ServiceResponse, error) {
+	in = in.normalize()
+	in, err := prepareProducts(in)
+	if err != nil {
+		return nil, err
+	}
+	sv, err := s.repo.Create(ctx, in)
+	if err != nil {
+		return nil, mapServiceWriteErr(err)
+	}
+	r, err := s.toResponse(ctx, *sv)
+	if err != nil {
+		return nil, err
+	}
+	return &r, nil
+}
+
+// Update — полная замена карточки+комплекта (last-write-wins, D28 — нет version).
+// Товар, уже присутствовавший в ТЕКУЩЕМ комплекте этой услуги, допустим даже архивным
+// (repo.Update передаёт id услуги дальше для чтения «старого» комплекта в транзакции) —
+// code review Medium#2: task.md запрещает архивный «при добавлении», не при пересохранении
+// уже существующей строки (иначе любое сохранение услуги, чей товар с тех пор
+// заархивирован по прецеденту PRODUCT_IN_USE, стало бы невозможным).
+func (s *ServiceService) Update(ctx context.Context, id string, in ServiceInput) (*ServiceResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrServiceNotFoundErr
+	}
+	in = in.normalize()
+	in, err := prepareProducts(in)
+	if err != nil {
+		return nil, err
+	}
+	sv, err := s.repo.Update(ctx, id, in)
+	if errors.Is(err, ErrServiceNotFound) {
+		return nil, ErrServiceNotFoundErr
+	}
+	if err != nil {
+		return nil, mapServiceWriteErr(err)
+	}
+	r, err := s.toResponse(ctx, *sv)
+	if err != nil {
+		return nil, err
+	}
+	return &r, nil
+}
+
+func (s *ServiceService) SetActive(ctx context.Context, id string, active bool) error {
+	if uuid.Validate(id) != nil {
+		return ErrServiceNotFoundErr
+	}
+	if err := s.repo.SetActive(ctx, id, active); errors.Is(err, ErrServiceNotFound) {
+		return ErrServiceNotFoundErr
+	} else if err != nil {
+		return err
+	}
+	return nil
+}
+
+// Delete — «используется в заказах» — проверка появится в фазе 5/6 (как D26 у клиентов,
+// task.md); сейчас — простое удаление.
+func (s *ServiceService) Delete(ctx context.Context, id string) error {
+	if uuid.Validate(id) != nil {
+		return ErrServiceNotFoundErr
+	}
+	err := s.repo.Delete(ctx, id)
+	if errors.Is(err, ErrServiceNotFound) {
+		return ErrServiceNotFoundErr
+	}
+	return err
+}
+
+// mapServiceWriteErr — категория/строка комплекта невалидны → 400 по конкретному полю
+// (task.md: «архивный/несуществующий товар → 400 по полю строки»); 22003 — страховка,
+// не должна встречаться после validateAmount() в validate()/mergeProducts() (code review
+// Блокер 1).
+func mapServiceWriteErr(err error) error {
+	switch {
+	case errors.Is(err, errServiceCategoryInvalid):
+		return errorspkg.Validation(errorspkg.Field{Name: "category_id", Message: msgInvalid})
+	case errors.Is(err, errAmountOutOfRange):
+		return ErrAmountOutOfRange
+	}
+	var pe *errServiceProductInvalid
+	if errors.As(err, &pe) {
+		return errorspkg.Validation(errorspkg.Field{Name: fmt.Sprintf("products[%d].product_id", pe.Index), Message: msgInvalid})
+	}
+	return err
+}
+
+// toResponse — комплект дозагружается отдельным запросом (re-fetch-after-write —
+// репозиторий не возвращает JOIN-поля товаров из транзакции записи). Для списков —
+// toServiceResponse напрямую с батч-загруженными rows (см. List выше, N+1).
+func (s *ServiceService) toResponse(ctx context.Context, sv Service) (ServiceResponse, error) {
+	rows, err := s.repo.Products(ctx, sv.ID)
+	if err != nil {
+		return ServiceResponse{}, err
+	}
+	return toServiceResponse(sv, rows), nil
+}
+
+func toServiceResponse(sv Service, rows []ServiceProductRow) ServiceResponse {
+	resp := ServiceResponse{
+		ID: sv.ID, CategoryID: sv.CategoryID, Name: sv.Name, IsActive: sv.IsActive,
+		Products: make([]ServiceProductResponse, len(rows)), CreatedAt: sv.CreatedAt, UpdatedAt: sv.UpdatedAt,
+	}
+	if sv.Price != nil {
+		a := Amount(*sv.Price)
+		resp.Price = &a
+	}
+	for i, row := range rows {
+		resp.Products[i] = ServiceProductResponse{ProductID: row.ProductID, Name: row.Name, Unit: row.Unit, Price: Amount(row.Price), Qty: Amount(row.Qty)}
+	}
+	return resp
+}
diff --git a/internal/features/catalog/services_validate.go b/internal/features/catalog/services_validate.go
new file mode 100644
index 0000000..a0f397d
--- /dev/null
+++ b/internal/features/catalog/services_validate.go
@@ -0,0 +1,148 @@
+package catalog
+
+import (
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+const serviceNameMax = 200
+
+// ServiceProductInput — строка комплекта (product_id + qty, нормализованные строки).
+type ServiceProductInput struct {
+	ProductID string
+	Qty       string
+}
+
+// ServiceInput — нормализованные поля услуги. HasPrice=false — «по факту» (NULL в БД).
+// Products — ИСХОДНЫЕ (не смерженные) строки: дедупликация — отдельный шаг mergeProducts(),
+// вызываемый ТОЛЬКО после успешного validate() (code review Medium#3 — дедуп ДО валидации
+// принимал мусор как 0 и отрицательные как компенсирующие: [{p,"abc"},{p,"2"}]→"2.000",
+// [{p,"-5"},{p,"6"}]→"1.000" проходили; экспонента "1e5" обходила decimalRe через
+// big.Rat.SetString, который её прекрасно понимает).
+type ServiceInput struct {
+	CategoryID string
+	Name       string
+	HasPrice   bool
+	Price      string
+	Products   []ServiceProductInput
+	IsActive   bool
+}
+
+// sumAmount — точное десятичное сложение (big.Rat, не float64 — без потери точности,
+// CLAUDE.md §Уроки). Вызывается ТОЛЬКО из mergeProducts() над уже провалидированными
+// (decimalRe-совместимыми) строками — здесь не нужно защищаться от мусора/экспоненты.
+func sumAmount(a, b string) string {
+	ra, ok := new(big.Rat).SetString(a)
+	if !ok {
+		ra = new(big.Rat)
+	}
+	rb, ok := new(big.Rat).SetString(b)
+	if !ok {
+		rb = new(big.Rat)
+	}
+	return new(big.Rat).Add(ra, rb).FloatString(3)
+}
+
+// normalize — trim полей комплекта БЕЗ дедупликации (code review Medium#3: дедуп —
+// отдельный шаг mergeProducts(), после validate()); пустые строки (SSR row-list добавил
+// строку, но ничего не выбрано) отбрасываются здесь — на них нет смысла заводить ошибку.
+func (in ServiceInput) normalize() ServiceInput {
+	in.CategoryID = normStr(in.CategoryID)
+	in.Name = normStr(in.Name)
+	if in.HasPrice {
+		in.Price = strings.TrimSpace(in.Price)
+		if in.Price == "" {
+			in.HasPrice = false
+		}
+	}
+
+	rows := make([]ServiceProductInput, 0, len(in.Products))
+	for _, p := range in.Products {
+		pid, qty := strings.TrimSpace(p.ProductID), strings.TrimSpace(p.Qty)
+		if pid == "" && qty == "" {
+			continue
+		}
+		rows = append(rows, ServiceProductInput{ProductID: pid, Qty: qty})
+	}
+	in.Products = rows
+	return in
+}
+
+// validate — построчная валидация КАЖДОЙ исходной (ещё не смерженной) строки комплекта;
+// индексы ошибок products[i].* — позиция в in.Products ПОСЛЕ normalize() (trim + отброс
+// пустых), НО ДО mergeProducts() — форма при ошибке перерисовывает именно этот список
+// (ssr_services.go serviceFormFrom вызывает только normalize()), индексы совпадают 1:1.
+func (in ServiceInput) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	if in.CategoryID == "" {
+		add("category_id", msgRequired)
+	} else if uuid.Validate(in.CategoryID) != nil {
+		add("category_id", msgInvalid)
+	}
+
+	switch n := utf8.RuneCountInString(in.Name); {
+	case n == 0:
+		add("name", msgRequired)
+	case n > serviceNameMax:
+		add("name", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Name) {
+		add("name", msgInvalidText)
+	}
+
+	if in.HasPrice {
+		if code := validateAmount(in.Price, priceScale, false); code != "" {
+			add("price", code)
+		}
+	}
+
+	for i, p := range in.Products {
+		pf := fmt.Sprintf("products[%d].product_id", i)
+		qf := fmt.Sprintf("products[%d].qty", i)
+		if p.ProductID == "" || uuid.Validate(p.ProductID) != nil {
+			add(pf, msgInvalid)
+		}
+		if code := validateAmount(p.Qty, qtyScale, false); code != "" {
+			add(qf, code)
+		} else if v, _ := strconv.ParseFloat(p.Qty, 64); v <= 0 {
+			add(qf, msgInvalid)
+		}
+	}
+	return f
+}
+
+// mergeProducts — дедуп по product_id суммой qty (D10), порядок — по первому вхождению.
+// ВЫЗЫВАТЬ ТОЛЬКО после validate() без ошибок — каждая исходная строка уже гарантированно
+// decimalRe-валидна и >0, sumAmount() не может получить мусор на вход. Сумма дублей всё
+// равно проверяется на переполнение qtyScale (редкий кейс: две валидные строки у верхней
+// границы, ~5e8 + ~5e8) — ошибка на общее поле "products" (не products[i] — после мержа
+// индекс уже не соответствует ни одной из исходных строк формы, которые видит пользователь;
+// маппинг «какая из исходных строк виновата» здесь не имеет смысла, т.к. виноваты обе).
+func mergeProducts(rows []ServiceProductInput) ([]ServiceProductInput, []errorspkg.Field) {
+	merged := make([]ServiceProductInput, 0, len(rows))
+	index := map[string]int{}
+	for _, p := range rows {
+		if i, ok := index[p.ProductID]; ok {
+			merged[i].Qty = sumAmount(merged[i].Qty, p.Qty)
+			continue
+		}
+		index[p.ProductID] = len(merged)
+		merged = append(merged, p)
+	}
+	for _, p := range merged {
+		if code := validateAmount(p.Qty, qtyScale, false); code != "" {
+			return nil, []errorspkg.Field{{Name: "products", Message: code}}
+		}
+	}
+	return merged, nil
+}
diff --git a/internal/features/catalog/services_validate_test.go b/internal/features/catalog/services_validate_test.go
new file mode 100644
index 0000000..02a7b97
--- /dev/null
+++ b/internal/features/catalog/services_validate_test.go
@@ -0,0 +1,225 @@
+package catalog
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+)
+
+func validServiceInput() ServiceInput {
+	return ServiceInput{
+		CategoryID: uuid.Must(uuid.NewV7()).String(), Name: "Замена двигателя",
+		HasPrice: true, Price: "1500",
+	}
+}
+
+func TestServiceInput_Normalize_TrimsAndPrice(t *testing.T) {
+	in := ServiceInput{CategoryID: "  id  ", Name: "  Услуга  ", HasPrice: true, Price: "  "}.normalize()
+	assert.Equal(t, "id", in.CategoryID)
+	assert.Equal(t, "Услуга", in.Name)
+	assert.False(t, in.HasPrice, "пустая строка цены после trim — «по факту»")
+
+	in2 := ServiceInput{CategoryID: "id", Name: "X", HasPrice: true, Price: "  1500.50  "}.normalize()
+	assert.True(t, in2.HasPrice)
+	assert.Equal(t, "1500.50", in2.Price)
+}
+
+// code review Medium#3: normalize() больше НЕ дедуплицирует комплект — только trim и
+// отброс пустых строк; дубли объединяет отдельный шаг mergeProducts(), вызываемый только
+// после успешного validate() (см. TestMergeProducts_* ниже).
+func TestServiceInput_Normalize_KeepsDuplicateRows(t *testing.T) {
+	p1 := uuid.Must(uuid.NewV7()).String()
+	p2 := uuid.Must(uuid.NewV7()).String()
+	in := ServiceInput{
+		CategoryID: "c", Name: "X",
+		Products: []ServiceProductInput{
+			{ProductID: p1, Qty: "1.5"},
+			{ProductID: p2, Qty: "2"},
+			{ProductID: p1, Qty: "0.5"},
+		},
+	}.normalize()
+	assert.Len(t, in.Products, 3, "дедуп — отдельный шаг, не normalize()")
+	assert.Equal(t, p1, in.Products[0].ProductID)
+	assert.Equal(t, "1.5", in.Products[0].Qty)
+	assert.Equal(t, p1, in.Products[2].ProductID)
+	assert.Equal(t, "0.5", in.Products[2].Qty)
+}
+
+// Пустая строка комплекта (row-list добавил строку, но товар не выбран) отбрасывается.
+func TestServiceInput_Normalize_DropsEmptyRow(t *testing.T) {
+	in := ServiceInput{CategoryID: "c", Name: "X", Products: []ServiceProductInput{{ProductID: "", Qty: ""}}}.normalize()
+	assert.Empty(t, in.Products)
+}
+
+func TestServiceInput_Validate_HappyPath(t *testing.T) {
+	assert.Empty(t, fieldsOf(validServiceInput().normalize().validate()))
+}
+
+// «По факту» (без цены) — валидная услуга.
+func TestServiceInput_Validate_NoPriceIsFine(t *testing.T) {
+	in := validServiceInput()
+	in.HasPrice = false
+	assert.Empty(t, fieldsOf(in.normalize().validate()))
+}
+
+func TestServiceInput_Validate_CategoryID(t *testing.T) {
+	in := validServiceInput()
+	in.CategoryID = ""
+	assert.Equal(t, map[string]string{"category_id": msgRequired}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.CategoryID = "not-a-uuid"
+	assert.Equal(t, map[string]string{"category_id": msgInvalid}, fieldsOf(in.normalize().validate()))
+}
+
+func TestServiceInput_Validate_Name(t *testing.T) {
+	in := validServiceInput()
+	in.Name = ""
+	assert.Equal(t, map[string]string{"name": msgRequired}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Name = strings.Repeat("я", 200)
+	assert.Empty(t, fieldsOf(in.normalize().validate()), "200 рун — граница")
+
+	in = validServiceInput()
+	in.Name = strings.Repeat("я", 201)
+	assert.Equal(t, map[string]string{"name": msgTooLong}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Name = "Услуга\u0000"
+	assert.Equal(t, map[string]string{"name": msgInvalidText}, fieldsOf(in.normalize().validate()))
+}
+
+// code review Блокер 1: границы NUMERIC(12,2) для цены — переполнение/лишняя точность →
+// 400 по СВОЕМУ полю, не молчаливое округление (1.239→1.24) и не 500 (22003).
+func TestServiceInput_Validate_Price(t *testing.T) {
+	cases := []struct {
+		name  string
+		price string
+		code  string
+	}{
+		{"отрицательная", "-1", msgInvalid},
+		{"мусор", "abc", msgInvalidFormat},
+		{"экспонента", "1e5", msgInvalidFormat},
+		{"переполнение целой части", "12345678901", msgTooLarge},
+		{"переполнение форматом", "1e10", msgInvalidFormat},
+		{"лишняя точность", "1.239", msgTooPrecise},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			in := validServiceInput()
+			in.Price = tc.price
+			assert.Equal(t, map[string]string{"price": tc.code}, fieldsOf(in.normalize().validate()))
+		})
+	}
+
+	in := validServiceInput()
+	in.Price = "0"
+	assert.Empty(t, fieldsOf(in.normalize().validate()), "цена 0 допустима (≥0)")
+}
+
+// qty ≤ 0 → 400 (task.md); мусор в product_id → 400 по конкретной строке; границы
+// NUMERIC(12,3) для qty — code review Блокер 1.
+func TestServiceInput_Validate_ProductsRows(t *testing.T) {
+	pid := uuid.Must(uuid.NewV7()).String()
+
+	in := validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "0"}}
+	assert.Equal(t, map[string]string{"products[0].qty": msgInvalid}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "-1"}}
+	assert.Equal(t, map[string]string{"products[0].qty": msgInvalid}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: "not-a-uuid", Qty: "1"}}
+	assert.Equal(t, map[string]string{"products[0].product_id": msgInvalid}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "abc"}}
+	assert.Equal(t, map[string]string{"products[0].qty": msgInvalidFormat}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "0.0001"}}
+	assert.Equal(t, map[string]string{"products[0].qty": msgTooPrecise}, fieldsOf(in.normalize().validate()))
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "1000000000"}}
+	assert.Equal(t, map[string]string{"products[0].qty": msgTooLarge}, fieldsOf(in.normalize().validate()))
+
+	// пустой комплект допустим (task.md).
+	in = validServiceInput()
+	assert.Empty(t, fieldsOf(in.normalize().validate()))
+
+	// две валидные строки — ок, индексы ошибок считаются по позиции в списке ДО
+	// дедупликации (code review Medium#3 — форма перерисовывает именно этот список).
+	pid2 := uuid.Must(uuid.NewV7()).String()
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "1"}, {ProductID: pid2, Qty: "0"}}
+	assert.Equal(t, map[string]string{"products[1].qty": msgInvalid}, fieldsOf(in.normalize().validate()))
+}
+
+func TestSumAmount_ExactDecimal(t *testing.T) {
+	assert.Equal(t, "0.300", sumAmount("0.1", "0.2"), "без потери точности float64")
+	assert.Equal(t, "3.000", sumAmount("1", "2"))
+}
+
+// code review Medium#3 — регрессии дедупа ДО валидации (исправлено): раньше
+// [{p,"abc"},{p,"2"}] давал "2.000" (мусор трактовался как 0), [{p,"-5"},{p,"6"}] давал
+// "1.000" (отрицательное как компенсирующее, а не 400), [{p,"1e5"},{p,"1"}] давал
+// "100001.000" (экспонента обходила decimalRe через big.Rat.SetString). Теперь validate()
+// отклоняет КАЖДУЮ исходную строку ДО mergeProducts() — mergeProducts() получает на вход
+// только валидные строки.
+func TestServiceInput_Validate_RejectsBeforeMerge(t *testing.T) {
+	pid := uuid.Must(uuid.NewV7()).String()
+
+	in := validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "abc"}, {ProductID: pid, Qty: "2"}}
+	got := fieldsOf(in.normalize().validate())
+	assert.Equal(t, msgInvalidFormat, got["products[0].qty"], "мусор в первой строке — 400, не 0 после мержа")
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "-5"}, {ProductID: pid, Qty: "6"}}
+	got = fieldsOf(in.normalize().validate())
+	assert.Equal(t, msgInvalid, got["products[0].qty"], "отрицательная строка — 400, не «компенсируется» суммой")
+
+	in = validServiceInput()
+	in.Products = []ServiceProductInput{{ProductID: pid, Qty: "1e5"}, {ProductID: pid, Qty: "1"}}
+	got = fieldsOf(in.normalize().validate())
+	assert.Equal(t, msgInvalidFormat, got["products[0].qty"], "экспонента — 400, не сумма 100001.000")
+}
+
+func TestMergeProducts_SumsDuplicatesAfterValidation(t *testing.T) {
+	p1 := uuid.Must(uuid.NewV7()).String()
+	p2 := uuid.Must(uuid.NewV7()).String()
+	rows := []ServiceProductInput{
+		{ProductID: p1, Qty: "1.5"},
+		{ProductID: p2, Qty: "2"},
+		{ProductID: p1, Qty: "0.5"},
+	}
+	merged, errs := mergeProducts(rows)
+	assert.Empty(t, errs)
+	assert.Len(t, merged, 2)
+	assert.Equal(t, p1, merged[0].ProductID)
+	assert.Equal(t, "2.000", merged[0].Qty, "1.5+0.5 без потери точности")
+	assert.Equal(t, p2, merged[1].ProductID)
+	assert.Equal(t, "2", merged[1].Qty, "без дублей — как было")
+}
+
+// Сумма дублей у верхней границы qtyScale переполняет IntDigits — 400 на общее поле
+// "products" (не products[i] — после мержа индекс не соответствует ни одной исходной
+// строке, code review Медиум#3 — «сумма тоже проверяется на верхнюю границу»).
+func TestMergeProducts_OverflowOnSum(t *testing.T) {
+	p1 := uuid.Must(uuid.NewV7()).String()
+	rows := []ServiceProductInput{
+		{ProductID: p1, Qty: "999999999"},
+		{ProductID: p1, Qty: "999999999"},
+	}
+	merged, errs := mergeProducts(rows)
+	assert.Nil(t, merged)
+	assert.Len(t, errs, 1)
+	assert.Equal(t, "products", errs[0].Name)
+	assert.Equal(t, msgTooLarge, errs[0].Message)
+}
