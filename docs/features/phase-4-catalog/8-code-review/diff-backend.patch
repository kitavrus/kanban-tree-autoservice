index 0000000..f52a833
--- /dev/null
+++ b/internal/features/catalog/amount.go
@@ -0,0 +1,41 @@
+package catalog
+
+import "errors"
+
+// Amount — денежная/количественная величина NUMERIC. В Go хранится строкой (без потери
+// точности — float64 не годится для точных денежных сумм), на wire — JSON-числом без
+// кавычек (CLAUDE.md §Уроки проекта: «NUMERIC в Go — строкой/decimal без потери точности,
+// JSON — число»). Пустая строка на входе/выходе трактуется как "0".
+type Amount string
+
+// errAmountNotNumber — присланное значение не JSON-число (строка/объект/массив).
+var errAmountNotNumber = errors.New("catalog: amount must be a JSON number")
+
+func (a Amount) MarshalJSON() ([]byte, error) {
+	s := string(a)
+	if s == "" {
+		s = "0"
+	}
+	return []byte(s), nil
+}
+
+func (a *Amount) UnmarshalJSON(b []byte) error {
+	s := string(b)
+	if s == "null" {
+		*a = ""
+		return nil
+	}
+	if len(s) == 0 || s[0] == '"' || s[0] == '{' || s[0] == '[' {
+		return errAmountNotNumber
+	}
+	*a = Amount(s)
+	return nil
+}
+
+// String — как хранится (для передачи в SQL как text-параметр с явным ::numeric cast).
+func (a Amount) String() string {
+	if a == "" {
+		return "0"
+	}
+	return string(a)
+}
diff --git a/internal/features/catalog/amount_validate.go b/internal/features/catalog/amount_validate.go
new file mode 100644
index 0000000..a29c56e
--- /dev/null
+++ b/internal/features/catalog/amount_validate.go
@@ -0,0 +1,78 @@
+package catalog
+
+import (
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/jackc/pgx/v5/pgconn"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Коды ошибок диапазона/точности NUMERIC-полей (code review Блокер 1 — TD-4 «границы →
+// 400, не 500»; msgInvalid/msgRequired/msgTooLong/msgInvalidText — categories_validate.go).
+const (
+	msgInvalidFormat = "invalid_format" // не число вовсе: мусор, экспонента, NaN/Inf
+	msgTooPrecise    = "too_precise"    // больше знаков после запятой, чем допускает scale колонки
+	msgTooLarge      = "too_large"      // целая часть длиннее, чем допускает precision-scale колонки
+)
+
+// amountScale — предел целой/дробной части для конкретной NUMERIC(precision,scale)
+// колонки (migrations/0004_catalog.up.sql). IntDigits = precision - scale — сколько цифр
+// допустимо ДО точки, иначе PG вернёт 22003 numeric_value_out_of_range на INSERT/UPDATE.
+type amountScale struct {
+	IntDigits  int
+	FracDigits int
+}
+
+var (
+	priceScale = amountScale{IntDigits: 10, FracDigits: 2} // NUMERIC(12,2): products.price, services.price
+	qtyScale   = amountScale{IntDigits: 9, FracDigits: 3}  // NUMERIC(12,3): products.stock/min_stock, service_products.qty
+)
+
+// validateAmount — decimalRe уже отсекает всё, что не «-?(0|[1-9]\d*)(\.\d+)?» (экспонента,
+// NaN/Inf, произвольный мусор — invalid_format). Дальше — величина целой части (иначе PG
+// молча не округляет, а падает 22003 — без этой проверки на входе получили бы 500) и
+// точность дробной части (PG НЕ отклоняет лишние знаки — он их МОЛЧА обрезает при записи;
+// без этой проверки цена 1.239 стала бы 1.24 без единого сообщения пользователю).
+// Пустая строка — валидно.
+func validateAmount(val string, scale amountScale, allowNegative bool) string {
+	if !decimalRe.MatchString(val) {
+		return msgInvalidFormat
+	}
+	digits := val
+	if strings.HasPrefix(val, "-") {
+		if !allowNegative {
+			return msgInvalid
+		}
+		digits = val[1:]
+	}
+	intPart, fracPart, _ := strings.Cut(digits, ".")
+	if len(fracPart) > scale.FracDigits {
+		return msgTooPrecise
+	}
+	if len(intPart) > scale.IntDigits {
+		return msgTooLarge
+	}
+	return ""
+}
+
+// errAmountOutOfRange/ErrAmountOutOfRange — страховка от 500 на PG 22003, которую
+// validateAmount() обязан предотвращать на входе для всех известных полей; остаётся
+// защитным дном на непредвиденный путь (не привязан к конкретному полю формы — репозиторий
+// на уровне RETURNING не знает, какая именно колонка переполнилась).
+var (
+	errAmountOutOfRange = errors.New("catalog: amount out of range")
+	ErrAmountOutOfRange = errorspkg.New("AMOUNT_OUT_OF_RANGE", http.StatusBadRequest, "Введённое число слишком велико для этого поля")
+)
+
+// mapAmountOverflow — 22003 numeric_value_out_of_range → errAmountOutOfRange (repo
+// sentinel, без HTTP — это знает только service-слой), иначе err как есть.
+func mapAmountOverflow(err error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "22003" {
+		return errAmountOutOfRange
+	}
+	return err
+}
