+            <select name="product_id" class="form-select" data-testid="service-product-select">
+              <option value="">— выбрать товар —</option>
+              {{ range .ProductOptions }}<option value="{{ .ID }}" data-hint="{{ .Hint }}">{{ .Name }}{{ if not .IsActive }} (архив){{ end }}</option>{{ end }}
+            </select>
+          </div>
+          <div style="max-width:140px">
+            <input type="number" name="qty" min="0" step="0.001" class="form-control" placeholder="Кол-во" data-testid="service-product-qty">
+          </div>
+          <button type="button" class="btn btn-outline-secondary" data-row-del aria-label="Удалить строку" data-testid="service-product-del">×</button>
+        </div>
+      </template>
+    </div>
+    <button type="button" class="btn btn-outline-secondary btn-sm mt-2 mb-3" data-row-add="products-rows" data-testid="service-product-add">+ Товар</button>
+    <div class="d-flex gap-2">
+      <button type="submit" class="btn btn-primary" data-testid="service-save">Сохранить</button>
+      <a href="/catalog/services" class="btn btn-outline-secondary">Отмена</a>
+      {{ if not .IsNew }}
+      <button type="submit" form="service-archive-form" class="btn btn-outline-secondary ms-auto" data-testid="service-archive">{{ if .IsActive }}В архив{{ else }}Вернуть{{ end }}</button>
+      {{ end }}
+    </div>
+  </div>
+</form>
+{{ if not .IsNew }}
+<form id="service-archive-form" method="post" action="/catalog/services/{{ .ID }}/{{ if .IsActive }}archive{{ else }}restore{{ end }}" class="d-none" aria-hidden="true">
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+</form>
+<form method="post" action="/catalog/services/{{ .ID }}/delete" class="mt-3" data-testid="service-delete-form" data-once>
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+  <button type="submit" class="btn btn-link text-danger p-0" data-testid="service-delete" data-confirm="Удалить услугу «{{ .Name }}»? Отменить нельзя.">Удалить</button>
+</form>
+{{ end }}
+{{ end }}
+{{ define "scripts" }}
+<script src="/assets/ssr-shared/js/row-list.js"></script>
+<script>
+/* data-once на самой форме — маркер для читателя разметки; глобальный делегированный
+   обработчик (ui-dialog.js) слушает НАСТОЯЩЕЕ событие 'submit', которое form.submit()
+   ниже НЕ создаёт (WHATWG: HTMLFormElement.submit() событие submit не генерирует — этим
+   и пользуется ui-dialog.js, чтобы не зациклиться на form[data-confirm]). Поэтому
+   двойной клик после подтверждения блокируем здесь же — отключением кнопки. */
+document.querySelectorAll('[data-confirm]').forEach(function (btn) {
+  btn.addEventListener('click', async function (e) {
+    e.preventDefault();
+    if (btn.disabled) return;
+    if (await KT.uiConfirm(btn.getAttribute('data-confirm'))) {
+      btn.disabled = true;
+      btn.closest('form').submit();
+    }
+  });
+});
+</script>
+{{ end }}
