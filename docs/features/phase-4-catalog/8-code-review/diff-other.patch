+  <a href="/catalog/equipment-types" class="tab-link{{ if eq .Active "equipment-types" }} active{{ end }}" data-testid="catalog-tab-equipment-types"{{ if eq .Active "equipment-types" }} aria-current="page"{{ end }}>🔧 Типы оборудования <span class="count">{{ .Types }}</span></a>
