+// requested / cancelled. Строки уходят каскадом FK, stock_movements.transfer_id и
+// equipment.active_transfer_id (единицы заявки) — SET NULL. Возвращает статус удалённого.
+func (r *Repo) Delete(ctx context.Context, id int64, version int) (string, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return "", err
