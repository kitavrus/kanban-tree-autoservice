+package board
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// AttachmentRepo — метаданные вложений заказа (task_attachments, миграция 0007). Свой pool,
+// без блокировки заказа: вложения не трогают склад/итоги/version заказа (как журнал работ).
+// FK-проверка INSERT берёт KEY SHARE на tasks — параллельный DELETE заказа (FOR UPDATE)
+// дожидается либо, наоборот, INSERT падает 23503 (→ errNotFound).
+type AttachmentRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewAttachmentRepo(pool *pgxpool.Pool) *AttachmentRepo { return &AttachmentRepo{pool: pool} }
+
+// attachmentRow — строка task_attachments (+ имя автора для карточки).
+type attachmentRow struct {
+	ID           string
+	TaskID       int64
+	Kind         string
+	OriginalName string
+	ContentType  string
+	Size         int64
+	StorageKey   string
+	UserID       string
+	AuthorName   string
+	CreatedAt    time.Time
+}
+
+// TaskExists — заказ есть (проверка ДО чтения файла из тела запроса: несуществующий заказ
+// не должен заставлять сервер писать сотни мегабайт на диск).
+func (r *AttachmentRepo) TaskExists(ctx context.Context, taskID int64) (bool, error) {
+	var ok bool
+	err := r.pool.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM tasks WHERE id = $1)`, taskID).Scan(&ok)
+	return ok, err
+}
+
+// Insert — 23503 на task_id (заказ удалён между TaskExists и INSERT) → errNotFound.
+func (r *AttachmentRepo) Insert(ctx context.Context, in attachmentRow) (string, error) {
+	var id string
+	err := r.pool.QueryRow(ctx, `
+		INSERT INTO task_attachments (task_id, kind, original_name, content_type, size, storage_key, user_id)
+		VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING id`,
+		in.TaskID, in.Kind, in.OriginalName, in.ContentType, in.Size, in.StorageKey, in.UserID).Scan(&id)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && pgErr.Code == "23503" && pgErr.ConstraintName == "task_attachments_task_id_fkey" {
+			return "", errNotFound
+		}
+		return "", err
+	}
+	return id, nil
+}
+
+const attachmentSelectSQL = `
+	SELECT a.id, a.task_id, a.kind, a.original_name, a.content_type, a.size, a.storage_key, a.user_id, u.name, a.created_at
+	FROM task_attachments a JOIN users u ON u.id = a.user_id`
+
+func scanAttachment(row pgx.Row, a *attachmentRow) error {
+	return row.Scan(&a.ID, &a.TaskID, &a.Kind, &a.OriginalName, &a.ContentType, &a.Size, &a.StorageKey,
+		&a.UserID, &a.AuthorName, &a.CreatedAt)
+}
+
+// Get — одна строка по id. 0 → errNotFound.
+func (r *AttachmentRepo) Get(ctx context.Context, id string) (*attachmentRow, error) {
+	var a attachmentRow
+	err := scanAttachment(r.pool.QueryRow(ctx, attachmentSelectSQL+` WHERE a.id = $1`, id), &a)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &a, nil
+}
+
+// List — вложения заказа в порядке загрузки (карточка, AC фазы 7).
+func (r *AttachmentRepo) List(ctx context.Context, taskID int64) ([]attachmentRow, error) {
+	rows, err := r.pool.Query(ctx, attachmentSelectSQL+` WHERE a.task_id = $1 ORDER BY a.created_at, a.id`, taskID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []attachmentRow
+	for rows.Next() {
+		var a attachmentRow
+		if err := scanAttachment(rows, &a); err != nil {
+			return nil, err
+		}
+		out = append(out, a)
+	}
+	return out, rows.Err()
+}
+
+// Delete — после проверки прав (сервис). 0 строк → errNotFound (параллельное удаление).
+func (r *AttachmentRepo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM task_attachments WHERE id = $1`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// attachmentKeysTx — ключи файлов заказа внутри транзакции удаления заказа (строки уйдут
+// каскадом FK, файлы удаляет сервис ПОСЛЕ commit). Заказ уже под FOR UPDATE — новый
+// INSERT вложения ждёт commit и падает 23503, так что список полон.
+func attachmentKeysTx(ctx context.Context, tx pgx.Tx, taskID int64) ([]string, error) {
+	rows, err := tx.Query(ctx, `SELECT storage_key FROM task_attachments WHERE task_id = $1`, taskID)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowTo[string])
+}
diff --git a/internal/features/board/attachments_service.go b/internal/features/board/attachments_service.go
new file mode 100644
index 0000000..7450448
--- /dev/null
+++ b/internal/features/board/attachments_service.go
@@ -0,0 +1,195 @@
+package board
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"log/slog"
+
+	"github.com/google/uuid"
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+
+	"github.com/kitavrus/kanban-tree/internal/filestore"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Вложения заказа (фаза 7, D21). Доступ — по правам карточки фазы 6 (D19: любой
+// авторизованный — admin и executor); удаление — автор или admin. Ответ мутаций — тот же
+// конверт {card, warnings}, что у row-мутаций карточки (re-fetch-after-write).
+
+// attachmentFileURL — отдача файла (GET, проверка сессии).
+func attachmentFileURL(id string) string { return "/api/v1/attachments/" + id + "/file" }
+
+func toCardAttachments(a Actor, rows []attachmentRow) []CardAttachment {
+	out := make([]CardAttachment, 0, len(rows))
+	for _, r := range rows {
+		out = append(out, CardAttachment{
+			ID: r.ID, Kind: r.Kind, OriginalName: r.OriginalName, ContentType: r.ContentType, Size: r.Size,
+			UserID: r.UserID, AuthorName: r.AuthorName, CreatedAt: r.CreatedAt,
+			URL:       attachmentFileURL(r.ID),
+			CanDelete: a.IsAdmin || r.UserID == a.ID,
+		})
+	}
+	return out
+}
+
+var errFilesUnavailable = errors.New("board: attachment file store is not configured")
+
+// UploadAttachment — POST /api/v1/tasks/:id/attachments (поток файла из multipart). Порядок:
+// заказ есть → сигнатура (первые 512 байт) → поток в FileStore под uuid-ключом с лимитом
+// по виду → строка в БД; любой сбой после записи файла — файл удаляется.
+func (s *CardService) UploadAttachment(ctx context.Context, a Actor, taskID, name string, body io.Reader) (*OrderCardMutationResponse, error) {
+	id, ok := parseTaskID(taskID)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	if s.files == nil {
+		return nil, errFilesUnavailable
+	}
+
+	ctx, span := otel.Tracer("board").Start(ctx, "attachments.upload")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id))
+
+	exists, err := s.attachments.TaskExists(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, ErrTaskNotFound
+	}
+
+	head := make([]byte, attachmentSniffLen)
+	n, err := io.ReadFull(body, head)
+	if err != nil && !errors.Is(err, io.ErrUnexpectedEOF) && !errors.Is(err, io.EOF) {
+		return nil, errorspkg.BadRequest("Не удалось прочитать файл")
+	}
+	head = head[:n]
+	if n == 0 {
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "file", Message: "Файл пустой"})
+	}
+	kind, contentType, ok := sniffAttachment(head)
+	if !ok {
+		return nil, ErrAttachmentTypeUnsupported
+	}
+	span.SetAttributes(attribute.String("kind", kind))
+
+	key := filestore.NewKey()
+	size, err := s.files.Put(ctx, key, io.MultiReader(bytes.NewReader(head), body), attachmentLimit(kind))
+	if errors.Is(err, filestore.ErrTooLarge) {
+		return nil, attachmentTooLarge(kind)
+	}
+	if err != nil {
+		return nil, err
+	}
+	span.SetAttributes(attribute.Int64("size", size))
+
+	_, err = s.attachments.Insert(ctx, attachmentRow{
+		TaskID: id, Kind: kind, OriginalName: sanitizeAttachmentName(name), ContentType: contentType,
+		Size: size, StorageKey: key, UserID: a.ID,
+	})
+	if err != nil {
+		s.removeFile(ctx, key)
+		if errors.Is(err, errNotFound) {
+			return nil, ErrTaskNotFound
+		}
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, id, ReconcileResult{Warnings: []StockWarning{}})
+}
+
+// DeleteAttachment — DELETE /api/v1/attachments/:id: 404 → 403 (не автор и не admin) →
+// строка удаляется → файл удаляется ПОСЛЕ (ошибка файла логируется, не валит операцию).
+func (s *CardService) DeleteAttachment(ctx context.Context, a Actor, id string) (*OrderCardMutationResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrAttachmentNotFound
+	}
+
+	ctx, span := otel.Tracer("board").Start(ctx, "attachments.delete")
+	defer span.End()
+
+	row, err := s.attachments.Get(ctx, id)
+	if errors.Is(err, errNotFound) {
+		return nil, ErrAttachmentNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	span.SetAttributes(attribute.Int64("task_id", row.TaskID))
+	if !a.IsAdmin && row.UserID != a.ID {
+		return nil, ErrAttachmentForbidden
+	}
+
+	if err := s.attachments.Delete(ctx, id); err != nil {
+		if errors.Is(err, errNotFound) {
+			return nil, ErrAttachmentNotFound
+		}
+		return nil, err
+	}
+	s.removeFile(ctx, row.StorageKey)
+
+	resp, err := s.cardMutation(ctx, a, row.TaskID, ReconcileResult{Warnings: []StockWarning{}})
+	if errors.Is(err, ErrTaskNotFound) {
+		// заказ удалён параллельно — вложение всё равно удалено; сущность пути — вложение
+		return nil, ErrAttachmentNotFound
+	}
+	return resp, err
+}
+
+// AttachmentFile — метаданные + открытый файл для GET /api/v1/attachments/:id/file.
+// Вызывающий закрывает File.
+type AttachmentFile struct {
+	Kind         string
+	OriginalName string
+	ContentType  string
+	File         io.ReadSeekCloser
+	Info         filestore.Info
+}
+
+// OpenAttachment — доступ по правам карточки (любой авторизованный, D19). Строка есть, а
+// файла на диске нет (удалён руками/потерян) → 404 + warn в лог.
+func (s *CardService) OpenAttachment(ctx context.Context, _ Actor, id string) (*AttachmentFile, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrAttachmentNotFound
+	}
+	if s.files == nil {
+		return nil, errFilesUnavailable
+	}
+	row, err := s.attachments.Get(ctx, id)
+	if errors.Is(err, errNotFound) {
+		return nil, ErrAttachmentNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	f, info, err := s.files.Open(ctx, row.StorageKey)
+	if errors.Is(err, filestore.ErrNotFound) {
+		slog.WarnContext(ctx, "attachment file missing on storage", "attachment_id", id, "storage_key", row.StorageKey)
+		return nil, ErrAttachmentNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &AttachmentFile{Kind: row.Kind, OriginalName: row.OriginalName, ContentType: row.ContentType, File: f, Info: info}, nil
+}
+
+// removeFile — удаление файла вне транзакции; ошибка только логируется (строка уже
+// удалена/не создана — осиротевший файл безопасен, операция пользователя успешна).
+func (s *CardService) removeFile(ctx context.Context, key string) {
+	removeAttachmentFiles(ctx, s.files, []string{key})
+}
+
+func removeAttachmentFiles(ctx context.Context, fs filestore.FileStore, keys []string) {
+	if fs == nil {
+		return
+	}
+	// Операция пользователя уже завершена: отмена запроса не должна оставлять файлы.
+	ctx = context.WithoutCancel(ctx)
+	for _, k := range keys {
+		if err := fs.Delete(ctx, k); err != nil {
+			slog.ErrorContext(ctx, "attachment file delete failed", "storage_key", k, "err", err)
+		}
+	}
+}
diff --git a/internal/features/board/attachments_validate.go b/internal/features/board/attachments_validate.go
new file mode 100644
index 0000000..676275f
--- /dev/null
+++ b/internal/features/board/attachments_validate.go
@@ -0,0 +1,199 @@
+package board
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// Вложения заказа (фаза 7, D21): тип определяется ТОЛЬКО по содержимому (сигнатуре), не по
+// расширению/заголовку клиента; лимиты — по виду.
+const (
+	AttachmentKindPhoto = "photo"
+	AttachmentKindVideo = "video"
+	AttachmentKindPDF   = "pdf"
+
+	mb = int64(1) << 20
+	// AttachmentMaxPhoto/Video/PDF — лимиты размера файла по виду (D21).
+	AttachmentMaxPhoto = 20 * mb
+	AttachmentMaxVideo = 500 * mb
+	AttachmentMaxPDF   = 20 * mb
+	// AttachmentUploadMaxBody — лимит тела multipart-запроса загрузки: максимальный файл +
+	// запас на заголовки частей/boundary. Прочие роуты — прежний 4 МБ (middleware.BodyLimit).
+	AttachmentUploadMaxBody = AttachmentMaxVideo + mb
+
+	// attachmentSniffLen — сколько байт начала файла читает детектор (как http.DetectContentType).
+	attachmentSniffLen = 512
+	attachmentNameMax  = 255
+)
+
+// attachmentLimit — лимит размера по виду.
+func attachmentLimit(kind string) int64 {
+	switch kind {
+	case AttachmentKindVideo:
+		return AttachmentMaxVideo
+	case AttachmentKindPDF:
+		return AttachmentMaxPDF
+	default:
+		return AttachmentMaxPhoto
+	}
+}
+
+// attachmentLimitMessage — понятный текст 413 по виду файла.
+func attachmentLimitMessage(kind string) string {
+	switch kind {
+	case AttachmentKindVideo:
+		return "Видео больше 500 МБ — загрузить нельзя"
+	case AttachmentKindPDF:
+		return "PDF больше 20 МБ — загрузить нельзя"
+	default:
+		return "Фото больше 20 МБ — загрузить нельзя"
+	}
+}
+
+// sniffAttachment — вид и Content-Type по первым байтам файла. ok=false — тип не
+// поддерживается (HTML/SVG/архивы/исполняемые/HEIC и т.п. → 400). SVG намеренно не фото:
+// это XML с возможным скриптом.
+func sniffAttachment(head []byte) (kind, contentType string, ok bool) {
+	if ct, isQT := sniffQuickTime(head); isQT {
+		return AttachmentKindVideo, ct, true
+	}
+	ct := http.DetectContentType(head)
+	switch ct {
+	case "image/jpeg", "image/png", "image/gif", "image/webp":
+		return AttachmentKindPhoto, ct, true
+	case "video/mp4", "video/webm":
+		return AttachmentKindVideo, ct, true
+	case "application/pdf":
+		return AttachmentKindPDF, ct, true
+	}
+	return "", "", false
+}
+
+// sniffQuickTime — ISO-BMFF `ftyp` с major brand "qt  " (MOV с iPhone): стандартный
+// http.DetectContentType его не распознаёт (узнаёт только бренды mp4*).
+func sniffQuickTime(head []byte) (string, bool) {
+	if len(head) < 12 || !bytes.Equal(head[4:8], []byte("ftyp")) {
+		return "", false
+	}
+	if bytes.Equal(head[8:12], []byte("qt  ")) {
+		return "video/quicktime", true
+	}
+	return "", false
+}
+
+// sanitizeAttachmentName — отображаемое имя файла: только базовое имя (без каталогов),
+// без управляющих и format-символов (Cf, в т.ч. bidi), валидный UTF-8, ≤255 рун; пустое → "file". В путь на диске
+// имя не попадает никогда (ключ хранения — uuid).
+func sanitizeAttachmentName(name string) string {
+	if i := strings.LastIndexAny(name, `/\`); i >= 0 {
+		name = name[i+1:]
+	}
+	name = strings.ToValidUTF8(name, "")
+	name = strings.Map(func(r rune) rune {
+		// Cf — bidi/format-символы (U+202E и др.): подмена отображаемого имени
+		// («photo\u202Egpj.exe»), в имени файла не нужны.
+		if unicode.IsControl(r) || unicode.Is(unicode.Cf, r) || r == utf8.RuneError {
+			return -1
+		}
+		return r
+	}, name)
+	name = strings.TrimSpace(name)
+	if utf8.RuneCountInString(name) > attachmentNameMax {
+		name = string([]rune(name)[:attachmentNameMax])
+	}
+	if name == "" || name == "." || name == ".." {
+		return "file"
+	}
+	return name
+}
+
+// contentDisposition — inline + filename (ASCII) + filename* (UTF-8, RFC 6266/
+// 5987): ASCII-фолбэк без кавычек/обратных слэшей/не-ASCII, точное имя — в filename*.
+func contentDisposition(name string) string {
+	var ascii strings.Builder
+	for _, r := range name {
+		if r < 0x20 || r > 0x7e || r == '"' || r == '\\' || r == '%' || r == ';' {
+			ascii.WriteByte('_')
+			continue
+		}
+		ascii.WriteRune(r)
+	}
+	return fmt.Sprintf(`inline; filename="%s"; filename*=UTF-8''%s`, ascii.String(), rfc5987Encode(name))
+}
+
+// rfc5987Encode — attr-char остаются как есть, прочие байты UTF-8 — %XX.
+func rfc5987Encode(s string) string {
+	const attrChars = "!#$&+-.^_`|~"
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strings.IndexByte(attrChars, c) >= 0 {
+			b.WriteByte(c)
+			continue
+		}
+		fmt.Fprintf(&b, "%%%02X", c)
+	}
+	return b.String()
+}
+
+// byteRange — один диапазон [Start, Start+Length).
+type byteRange struct {
+	Start, Length int64
+}
+
+// parseRange — заголовок Range по семантике http.ServeContent для ОДНОГО диапазона:
+// ok=false, err=nil — Range нет/не bytes/несколько диапазонов → отдаём файл целиком (RFC
+// 7233 разрешает игнорировать Range); err != nil — синтаксически битый либо
+// неудовлетворимый диапазон → 416.
+func parseRange(h string, size int64) (byteRange, bool, error) {
+	if h == "" {
+		return byteRange{}, false, nil
+	}
+	const prefix = "bytes="
+	if !strings.HasPrefix(h, prefix) {
+		return byteRange{}, false, nil
+	}
+	spec := strings.TrimSpace(h[len(prefix):])
+	if strings.Contains(spec, ",") {
+		return byteRange{}, false, nil
+	}
+	startS, endS, found := strings.Cut(spec, "-")
+	if !found {
+		return byteRange{}, false, errInvalidRange
+	}
+	startS, endS = strings.TrimSpace(startS), strings.TrimSpace(endS)
+	if startS == "" {
+		// суффикс: последние N байт
+		n, err := strconv.ParseInt(endS, 10, 64)
+		if err != nil || n <= 0 || size == 0 {
+			return byteRange{}, false, errInvalidRange
+		}
+		if n > size {
+			n = size
+		}
+		return byteRange{Start: size - n, Length: n}, true, nil
+	}
+	start, err := strconv.ParseInt(startS, 10, 64)
+	if err != nil || start < 0 || start >= size {
+		return byteRange{}, false, errInvalidRange
+	}
+	end := size - 1
+	if endS != "" {
+		e, err := strconv.ParseInt(endS, 10, 64)
+		if err != nil || e < start {
+			return byteRange{}, false, errInvalidRange
+		}
+		if e < end {
+			end = e
+		}
+	}
+	return byteRange{Start: start, Length: end - start + 1}, true, nil
+}
+
+var errInvalidRange = errors.New("board: invalid range")
diff --git a/internal/features/board/attachments_validate_test.go b/internal/features/board/attachments_validate_test.go
new file mode 100644
index 0000000..1e31ba6
--- /dev/null
+++ b/internal/features/board/attachments_validate_test.go
@@ -0,0 +1,174 @@
+package board
+
+import (
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/valyala/fasthttp"
+)
+
+// Сигнатуры тест-файлов (минимальные валидные заголовки форматов).
+var (
+	sigPNG  = []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	sigJPEG = []byte("\xff\xd8\xff\xe0\x00\x10JFIF\x00")
+	sigGIF  = []byte("GIF89a\x01\x00\x01\x00")
+	sigWEBP = []byte("RIFF\x24\x00\x00\x00WEBPVP8 ")
+	sigMP4  = []byte("\x00\x00\x00\x18ftypmp42\x00\x00\x00\x00mp42isom")
+	sigMOV  = []byte("\x00\x00\x00\x14ftypqt  \x00\x00\x00\x00qt  ")
+	sigWEBM = []byte("\x1a\x45\xdf\xa3\x9f\x42\x86\x81\x01")
+	sigPDF  = []byte("%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
+)
+
+func TestSniffAttachment_Supported(t *testing.T) {
+	cases := []struct {
+		name string
+		head []byte
+		kind string
+		ct   string
+	}{
+		{"png", sigPNG, AttachmentKindPhoto, "image/png"},
+		{"jpeg", sigJPEG, AttachmentKindPhoto, "image/jpeg"},
+		{"gif", sigGIF, AttachmentKindPhoto, "image/gif"},
+		{"webp", sigWEBP, AttachmentKindPhoto, "image/webp"},
+		{"mp4", sigMP4, AttachmentKindVideo, "video/mp4"},
+		{"mov", sigMOV, AttachmentKindVideo, "video/quicktime"},
+		{"webm", sigWEBM, AttachmentKindVideo, "video/webm"},
+		{"pdf", sigPDF, AttachmentKindPDF, "application/pdf"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			kind, ct, ok := sniffAttachment(c.head)
+			require.True(t, ok)
+			assert.Equal(t, c.kind, kind)
+			assert.Equal(t, c.ct, ct)
+		})
+	}
+}
+
+func TestSniffAttachment_Rejected(t *testing.T) {
+	for name, head := range map[string][]byte{
+		"html":  []byte("<!DOCTYPE html><html><script>alert(1)</script>"),
+		"svg":   []byte(`<?xml version="1.0"?><svg xmlns="http://www.w3.org/2000/svg"><script/></svg>`),
+		"zip":   []byte("PK\x03\x04\x14\x00\x00\x00"),
+		"exe":   []byte("MZ\x90\x00\x03\x00\x00\x00"),
+		"text":  []byte("просто текст, переименованный в .jpg"),
+		"empty": {},
+		"heic":  []byte("\x00\x00\x00\x18ftypheic\x00\x00\x00\x00mif1heic"),
+	} {
+		_, _, ok := sniffAttachment(head)
+		assert.False(t, ok, name)
+	}
+}
+
+func TestAttachmentLimit(t *testing.T) {
+	assert.EqualValues(t, 20<<20, attachmentLimit(AttachmentKindPhoto))
+	assert.EqualValues(t, 500<<20, attachmentLimit(AttachmentKindVideo))
+	assert.EqualValues(t, 20<<20, attachmentLimit(AttachmentKindPDF))
+	assert.Greater(t, AttachmentUploadMaxBody, AttachmentMaxVideo)
+	for _, k := range []string{AttachmentKindPhoto, AttachmentKindVideo, AttachmentKindPDF} {
+		assert.NotEmpty(t, attachmentLimitMessage(k))
+	}
+}
+
+func TestSanitizeAttachmentName(t *testing.T) {
+	assert.Equal(t, "фото.jpg", sanitizeAttachmentName("фото.jpg"))
+	assert.Equal(t, "passwd", sanitizeAttachmentName("../../etc/passwd"))
+	assert.Equal(t, "evil.png", sanitizeAttachmentName(`C:\Users\x\evil.png`))
+	assert.Equal(t, "ab.png", sanitizeAttachmentName("a\x00\r\nb.png"))
+	assert.Equal(t, "file", sanitizeAttachmentName("   "))
+	assert.Equal(t, "file", sanitizeAttachmentName(".."))
+	assert.Equal(t, "ok", sanitizeAttachmentName("o\xffk"))
+	assert.Equal(t, "photogpj.exe", sanitizeAttachmentName("photo\u202Egpj.exe"), "RLO (bidi) убран")
+	assert.Equal(t, "ab.png", sanitizeAttachmentName("a\u2066\u200Bb\uFEFF.png"), "isolate/zero-width/BOM убраны")
+	long := sanitizeAttachmentName(strings.Repeat("я", 300))
+	assert.Equal(t, 255, len([]rune(long)))
+}
+
+func TestContentDisposition(t *testing.T) {
+	assert.Equal(t, `inline; filename="a.pdf"; filename*=UTF-8''a.pdf`, contentDisposition("a.pdf"))
+	got := contentDisposition(`отчёт "1";.pdf`)
+	assert.True(t, strings.HasPrefix(got, `inline; filename="_____ _1__.pdf"; filename*=UTF-8''`), got)
+	assert.Contains(t, got, "%D0%BE%D1%82%D1%87%D1%91%D1%82%20%221%22%3B.pdf")
+	assert.NotContains(t, got, "\n")
+}
+
+func TestParseRange(t *testing.T) {
+	const size = 100
+	cases := []struct {
+		h      string
+		ok     bool
+		bad    bool
+		start  int64
+		length int64
+	}{
+		{h: ""},
+		{h: "items=0-1"},
+		{h: "bytes=0-1,5-6"}, // multi — целиком
+		{h: "bytes=0-9", ok: true, start: 0, length: 10},
+		{h: "bytes=90-", ok: true, start: 90, length: 10},
+		{h: "bytes=95-1000", ok: true, start: 95, length: 5},
+		{h: "bytes=-10", ok: true, start: 90, length: 10},
+		{h: "bytes=-1000", ok: true, start: 0, length: 100},
+		{h: "bytes=100-", bad: true},
+		{h: "bytes=5-2", bad: true},
+		{h: "bytes=abc", bad: true},
+		{h: "bytes=-0", bad: true},
+		{h: "bytes=x-5", bad: true},
+	}
+	for _, c := range cases {
+		r, ok, err := parseRange(c.h, size)
+		if c.bad {
+			assert.ErrorIs(t, err, errInvalidRange, c.h)
+			continue
+		}
+		require.NoError(t, err, c.h)
+		assert.Equal(t, c.ok, ok, c.h)
+		if c.ok {
+			assert.Equal(t, byteRange{Start: c.start, Length: c.length}, r, c.h)
+		}
+	}
+}
+
+func TestIsAttachmentUpload(t *testing.T) {
+	app := fiber.New()
+	cases := []struct {
+		method, path string
+		want         bool
+	}{
+		{fiber.MethodPost, "/api/v1/tasks/12/attachments", true},
+		{fiber.MethodPost, "/api/v1/tasks/12/attachments/", true},
+		{fiber.MethodPost, "/API/V1/Tasks/12/Attachments", true},
+		{fiber.MethodGet, "/api/v1/tasks/12/attachments", false},
+		{fiber.MethodPost, "/api/v1/tasks/12", false},
+		{fiber.MethodPost, "/api/v1/tasks//attachments", false},
+		{fiber.MethodPost, "/api/v1/tasks/12/equipment", false},
+		{fiber.MethodPost, "/api/v1/tasks/12/attachments/x", false},
+		{fiber.MethodPost, "/api/v1/attachments", false},
+	}
+	for _, c := range cases {
+		fctx := &fasthttp.RequestCtx{}
+		fctx.Request.Header.SetMethod(c.method)
+		fctx.Request.SetRequestURI(c.path)
+		ctx := app.AcquireCtx(fctx)
+		assert.Equal(t, c.want, IsAttachmentUpload(ctx), c.method+" "+c.path)
+		app.ReleaseCtx(ctx)
+	}
+}
+
+func TestCapReader(t *testing.T) {
+	exact := &capReader{r: strings.NewReader("12345"), left: 5}
+	b, err := io.ReadAll(exact)
+	require.NoError(t, err)
+	assert.Equal(t, "12345", string(b))
+	assert.False(t, exact.exceeded, "ровно лимит — допустимо")
+
+	over := &capReader{r: strings.NewReader("123456"), left: 5}
+	b, err = io.ReadAll(over)
+	assert.ErrorIs(t, err, errBodyCapExceeded)
+	assert.Equal(t, "12345", string(b))
+	assert.True(t, over.exceeded)
+}
