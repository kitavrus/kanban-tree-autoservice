diff --git a/migrations/0007_task_attachments.up.sql b/migrations/0007_task_attachments.up.sql
new file mode 100644
index 0000000..89133f7
--- /dev/null
+++ b/migrations/0007_task_attachments.up.sql
@@ -0,0 +1,15 @@
+-- Вложения заказа (фаза 7, D21): фото/видео/PDF. Сами файлы — в FileStore (локальный диск,
+-- UPLOADS_DIR), здесь только метаданные; storage_key — uuid, НЕ имя пользователя.
+CREATE TABLE task_attachments (
+    id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    task_id       bigint NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
+    kind          text NOT NULL CHECK (kind IN ('photo', 'video', 'pdf')),
+    original_name text NOT NULL CHECK (char_length(original_name) BETWEEN 1 AND 255),
+    content_type  text NOT NULL,
+    size          bigint NOT NULL CHECK (size > 0),
+    storage_key   text NOT NULL UNIQUE,
+    user_id       uuid NOT NULL REFERENCES users(id) ON DELETE RESTRICT,  -- ADR-007: пользователи не удаляются
+    created_at    timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX task_attachments_task_created_idx ON task_attachments (task_id, created_at);
+CREATE INDEX task_attachments_user_id_idx ON task_attachments (user_id);
