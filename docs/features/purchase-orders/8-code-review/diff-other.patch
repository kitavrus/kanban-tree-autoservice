+.so-footer { position: sticky; bottom: 0; z-index: 5; background: var(--bs-body-bg); border-top: 1px solid var(--bs-border-color); padding: .75rem 0; margin-top: .75rem; }
+.so-card { cursor: pointer; overflow-wrap: anywhere; }
