+	resp = s.execA.Request(http.MethodGet, "/purchases/"+theirs.ID, nil, nil)
+	resp.Body.Close()
+	s.Equal(404, resp.StatusCode)
+
+	st, raw = s.execA.Do(http.MethodDelete, poAPI+"/"+mine.ID, dto.ReasonRequest{Version: mine.Version, Reason: ptr("x")})
