diff --git a/internal/features/board/pdf_kit.go b/internal/features/board/pdf_kit.go
new file mode 100644
index 0000000..d16a1a5
--- /dev/null
+++ b/internal/features/board/pdf_kit.go
@@ -0,0 +1,24 @@
+package board
+
+import "github.com/go-pdf/fpdf"
+
+// Общий PDF-набор для печатных форм других фич (purchase-orders §6.11/§6.16, DS-014): тот же
+// способ, что акт выдачи — встроенные шрифты DejaVu (кириллица) и строка таблицы с переносом.
+
+// PDFFont — имя семейства шрифтов документа NewPDFDoc ("" — обычный, "B" — жирный).
+const PDFFont = pdfFont
+
+// NewPDFDoc — A4 книжный, поля 15 мм, автоперенос страниц, шрифты DejaVu подключены.
+func NewPDFDoc() *fpdf.Fpdf {
+	pdf := fpdf.New("P", "mm", "A4", "")
+	pdf.SetMargins(15, 15, 15)
+	pdf.SetAutoPageBreak(true, 15)
+	pdf.AddUTF8FontFromBytes(pdfFont, "", pdfFontRegular)
+	pdf.AddUTF8FontFromBytes(pdfFont, "B", pdfFontBold)
+	return pdf
+}
+
+// PDFTableRow — строка таблицы с переносом текста (см. pdfTableRow).
+func PDFTableRow(pdf *fpdf.Fpdf, widths []float64, aligns []string, cells []string, header bool) {
+	pdfTableRow(pdf, widths, aligns, cells, header)
+}
diff --git a/internal/features/board/stock_repo.go b/internal/features/board/stock_repo.go
index 1279a48..92ba22f 100644
--- a/internal/features/board/stock_repo.go
+++ b/internal/features/board/stock_repo.go
@@ -20,15 +20,7 @@ import (
 // входит; с ненулевым — входит строкой с is_deleted = true (остаток, появившийся после
 // удаления, не теряется из вида). $FORCE — товар, строка которого нужна независимо от
 // остатка: ответ ручной корректировки, обнулившей остаток удалённого товара.
-const stockPendingCTETemplate = `
-WITH pending AS (
-    SELECT sp.product_id, sum(sp.qty) AS qty
-    FROM subtask_products sp
-    JOIN subtasks s ON s.id = sp.subtask_id
-    JOIN tasks t    ON t.id = s.task_id
-    JOIN columns c  ON c.id = t.column_id
-    WHERE NOT c.consumes_stock AND NOT c.is_final AND t.deleted_at IS NULL
-    GROUP BY sp.product_id),
+const stockPendingCTETemplate = PendingCTE + `,
 rows AS (
     SELECT p.id, p.deleted_at IS NOT NULL AS is_deleted, p.name, p.unit, p.box, p.place,
            p.stock, p.min_stock,
@@ -42,6 +34,32 @@ rows AS (
        OR (p.deleted_at IS NOT NULL AND (p.stock <> 0$FORCE)))
 `
 
+// PendingCTE — «WITH pending AS (…)»: потребность в товаре ещё не взятых в работу заказов
+// (колонка не consumes_stock и не финальная, заказ не удалён). Единый источник расчёта для
+// «Остатков» и подсказки дефицита закупок (purchase-orders §6.10, DS-064); экспортирован
+// без изменения поведения /stock (DS-005).
+const PendingCTE = `
+WITH pending AS (
+    SELECT sp.product_id, sum(sp.qty) AS qty
+    FROM subtask_products sp
+    JOIN subtasks s ON s.id = sp.subtask_id
+    JOIN tasks t    ON t.id = s.task_id
+    JOIN columns c  ON c.id = t.column_id
+    WHERE NOT c.consumes_stock AND NOT c.is_final AND t.deleted_at IS NULL
+    GROUP BY sp.product_id)`
+
+// PendingTasksSQL — заказы клиентов, дающие pending по товарам $1 (uuid[]): тот же фильтр,
+// что у PendingCTE (purchase-orders §6.10 items[].tasks[]).
+const PendingTasksSQL = `
+SELECT DISTINCT sp.product_id::text, t.id, t.title
+FROM subtask_products sp
+JOIN subtasks s ON s.id = sp.subtask_id
+JOIN tasks t    ON t.id = s.task_id
+JOIN columns c  ON c.id = t.column_id
