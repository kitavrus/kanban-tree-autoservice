+package models
+
+import "time"
+
+// PurchaseOrderItem — строка заказа (§4.2) с вычисленными флагами.
+type PurchaseOrderItem struct {
+	ID                 string
+	OrderID            string
+	ProductID          string
+	Position           int
+	Qty                string
+	Reason             string
+	Name               string
+	Sku                string
+	Unit               string
+	SupplierQty        *string
+	SupplierPrice      *string
+	SupplierNote       string
+	SupplierAnsweredAt *time.Time
+	CustomerChangedAt  *time.Time
+	Version            int64
+
+	// LineAmount — supplier_qty × supplier_price, округление до 0.01 (DS-009); nil — нет цены.
+	LineAmount *string
+	// HasDiscrepancy — ответ задан и «Соберу» ≠ «Просим» (§6.3).
+	HasDiscrepancy bool
+	// CustomerChanged — «Изменено заказчиком» действует: правка после отправки, поставщик ещё
+	// не ответил заново (DS-048).
+	CustomerChanged bool
+}
+
+// ItemInput — строка из запроса создания/правки (уже провалидирована и сведена по
+// product_id сервисом). ID == "" — новая строка.
+type ItemInput struct {
+	ID        string
+	ProductID string
+	Qty       string
+	Reason    string
+}
+
+// ExistingItem — строка заказа в момент правки (сверка §6.4).
+type ExistingItem struct {
+	ID        string
+	ProductID string
+	Qty       string
+	Reason    string
+}
+
+// SupplierAnswer — ответ поставщика по строке (§6.14).
+type SupplierAnswer struct {
+	Version       int64
+	SupplierQty   *string
+	SupplierPrice *string
+	SupplierNote  string
+}
+
+// AnswerState — строка в момент ответа поставщика: вход проверок §6.14/§6.15.
+type AnswerState struct {
+	ItemID        string
+	Version       int64
+	SupplierQty   *string
+	SupplierPrice *string
+}
diff --git a/internal/features/purchase-orders/models/purchase_orders.go b/internal/features/purchase-orders/models/purchase_orders.go
new file mode 100644
index 0000000..d95cfa0
--- /dev/null
+++ b/internal/features/purchase-orders/models/purchase_orders.go
@@ -0,0 +1,87 @@
+// Package models — строки БД закупок (§4.1–§4.2) в том виде, в каком их читает repository.
+// Числа numeric — строки (::text из БД, без потери точности); суммы вычисляются в SQL
+// (DS-071) и не хранятся.
+package models
+
+import "time"
+
+// PurchaseOrder — шапка заказа с вычисленными полями для списка/карточки.
+type PurchaseOrder struct {
+	ID            string
+	Number        int64
+	SupplierID    *string
+	SupplierName  string // '' у Базара
+	SupplierPhone string
+	Status        string
+	Note          string
+	NoteChangedAt *time.Time
+	Version       int64
+	CreatedBy     string
+	CreatedByName string
+	CreatedAt     time.Time
+	UpdatedAt     time.Time
+	SentAt        *time.Time
+	ReadyAt       *time.Time
+	PickedUpAt    *time.Time
+	CancelledAt   *time.Time
+	CancelReason  *string
+
+	// SupplierHasLogin — у поставщика есть активный вход (DS-059).
+	SupplierHasLogin bool
+	// ItemsCount / AnsweredCount / TotalAmount / IsChanged — агрегаты строк (§6.1, §6.12).
+	ItemsCount    int
+	AnsweredCount int
+	TotalAmount   *string
+	IsChanged     bool
+	NoteChanged   bool
+
+	Items []PurchaseOrderItem
+}
+
+// Head — заблокированная (FOR UPDATE/SHARE) шапка: вход проверок переходов §5.
+type Head struct {
+	ID               string
+	Number           int64
+	SupplierID       *string
+	Status           string
+	Version          int64
+	CreatedBy        string
+	Note             string
+	SentAt           *time.Time
+	ItemsCount       int
+	SupplierHasLogin bool
+	// SupplierAvailable — поставщик активен и не удалён (строка поставщика взята FOR SHARE в той
+	// же транзакции, DS-043); у Базара — true.
+	SupplierAvailable bool
+}
+
+// IsBazaar — заказ без поставщика (DS-006).
+func (h Head) IsBazaar() bool { return h.SupplierID == nil }
+
+// Suggestion — строка дефицита §6.10.
+type Suggestion struct {
+	ProductID    string
+	Name         string
+	Sku          string
+	Unit         string
+	Stock        string
+	MinStock     string
+	Pending      string
+	ToOrder      string
+	Reason       string
+	Tasks        []SuggestionTask
+	InOpenOrders []OpenOrderRef
+}
+
+// SuggestionTask — заказ клиента, дающий pending.
+type SuggestionTask struct {
+	ID    int64
+	Title string
+}
+
+// OpenOrderRef — «уже в открытом заказе З-0012 — 5 шт.» (DS-004).
+type OpenOrderRef struct {
+	ID     string
+	Number int64
+	Qty    string
+}
diff --git a/internal/features/purchase-orders/repository/migration_integration_test.go b/internal/features/purchase-orders/repository/migration_integration_test.go
new file mode 100644
index 0000000..874e0bc
--- /dev/null
+++ b/internal/features/purchase-orders/repository/migration_integration_test.go
@@ -0,0 +1,91 @@
+//go:build integration
+
+package repository_test
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// PurchaseOrdersMigrationSuite — миграция 0019 (docs/features/purchase-orders/draft-spec.md §4,
+// TS-008): up/down на чистой БД; после up — роль supplier ⇔ supplier_id (users_supplier_chk),
+// Базар не бывает sent/ready, номер — из sequence; down убирает таблицы и роль.
+type PurchaseOrdersMigrationSuite struct {
+	testutil.BaseSuite
+}
+
+func TestPurchaseOrdersMigrationSuite(t *testing.T) {
+	suite.Run(t, new(PurchaseOrdersMigrationSuite))
+}
+
+func migrationsURL() string {
+	_, f, _, _ := runtime.Caller(0)
+	return "file://" + filepath.Join(filepath.Dir(f), "..", "..", "..", "..", "migrations")
+}
+
+func (s *PurchaseOrdersMigrationSuite) tableExists(name string) bool {
+	var ok bool
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = $1)`, name).Scan(&ok))
+	return ok
+}
+
+func (s *PurchaseOrdersMigrationSuite) TestTS008_Migration0019_UpDown() {
+	ctx := context.Background()
+	mig, err := migrate.New(migrationsURL(), s.DSN)
+	s.Require().NoError(err)
+	defer func() { _, _ = mig.Close() }()
+
+	s.Require().True(s.tableExists("purchase_orders"))
+	var supplierID, adminID string
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO suppliers (name) VALUES ('Миграция') RETURNING id::text`).Scan(&supplierID))
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO users (login, password_hash, name, role) VALUES ('po-mig-admin', 'x', 'А', 'admin') RETURNING id::text`).Scan(&adminID))
+
+	// CHECK users_supplier_chk (DS-007).
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (login, password_hash, name, role) VALUES ('po-mig-1', 'x', 'x', 'supplier')`)
+	s.Error(err, "supplier без supplier_id")
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (login, password_hash, name, role, supplier_id) VALUES ('po-mig-2', 'x', 'x', 'executor', $1::uuid)`, supplierID)
+	s.Error(err, "executor с supplier_id")
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (login, password_hash, name, role, supplier_id) VALUES ('po-mig-3', 'x', 'x', 'supplier', $1::uuid)`, supplierID)
+	s.NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (login, password_hash, name, role) VALUES ('po-mig-4', 'x', 'x', 'root')`)
+	s.Error(err, "роль вне списка")
+
+	// CHECK purchase_orders_bazaar_chk, cancel_chk; sequence.
+	_, err = s.Pool.Exec(ctx, `INSERT INTO purchase_orders (created_by, status) VALUES ($1::uuid, 'ready')`, adminID)
+	s.Error(err, "Базар в ready")
+	_, err = s.Pool.Exec(ctx, `INSERT INTO purchase_orders (created_by, status) VALUES ($1::uuid, 'cancelled')`, adminID)
+	s.Error(err, "cancelled без причины")
+	var n1, n2 int64
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO purchase_orders (created_by) VALUES ($1::uuid) RETURNING number`, adminID).Scan(&n1))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO purchase_orders (created_by) VALUES ($1::uuid) RETURNING number`, adminID).Scan(&n2))
+	s.Equal(n1+1, n2)
+	_, err = s.Pool.Exec(ctx, `UPDATE purchase_orders SET deleted_at = now(), deleted_by = $1::uuid, delete_reason = 'x', status = 'cancelled',
+		cancelled_at = now(), cancelled_by = $1::uuid, cancel_reason = 'y' WHERE number = $2`, adminID, n1)
+	s.Error(err, "удалённым может быть только черновик")
+
+	// down → таблиц и роли нет; повторный up — чистый.
+	s.Require().NoError(mig.Migrate(18))
+	s.False(s.tableExists("purchase_orders"))
+	s.False(s.tableExists("purchase_order_items"))
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (login, password_hash, name, role) VALUES ('po-mig-5', 'x', 'x', 'supplier')`)
+	s.Error(err, "после down роли supplier нет")
+	if err := mig.Up(); err != nil && !errors.Is(err, migrate.ErrNoChange) {
+		s.Require().NoError(err)
+	}
+	s.True(s.tableExists("purchase_orders"))
+	var n3 int64
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO purchase_orders (created_by) VALUES ($1::uuid) RETURNING number`, adminID).Scan(&n3))
+	s.EqualValues(1, n3, "sequence создана заново")
+}
diff --git a/internal/features/purchase-orders/repository/queries.go b/internal/features/purchase-orders/repository/queries.go
new file mode 100644
index 0000000..37a43d9
--- /dev/null
+++ b/internal/features/purchase-orders/repository/queries.go
@@ -0,0 +1,191 @@
+package repository
+
+// SQL закупок (§4–§6). Числа numeric читаются ::text (без потери точности); суммы строк —
+// round(supplier_qty × supplier_price, 2), итог — сумма строк с ценой (DS-009, DS-071).
+
+// orderColumns — шапка + агрегаты строк; алиасы: o — заказ, s — поставщик, u — автор.
+const orderColumns = `
+o.id::text, o.number, o.supplier_id::text, coalesce(s.name, ''), coalesce(s.phone, ''),
+o.status, o.note, o.note_changed_at, o.version,
+o.created_by::text, coalesce(nullif(u.name, ''), u.login), o.created_at, o.updated_at,
+o.sent_at, o.ready_at, o.picked_up_at, o.cancelled_at, o.cancel_reason,
+EXISTS (SELECT 1 FROM users su WHERE su.supplier_id = o.supplier_id AND su.role = 'supplier' AND su.is_active),
+(SELECT count(*) FROM purchase_order_items i WHERE i.order_id = o.id),
+(SELECT count(*) FROM purchase_order_items i WHERE i.order_id = o.id AND i.supplier_qty IS NOT NULL),
+(SELECT sum(round(i.supplier_qty * i.supplier_price, 2)) FROM purchase_order_items i
+  WHERE i.order_id = o.id AND i.supplier_qty IS NOT NULL AND i.supplier_price IS NOT NULL)::text,
+(o.note_changed_at IS NOT NULL AND o.sent_at IS NOT NULL AND o.note_changed_at > o.sent_at),
+EXISTS (SELECT 1 FROM purchase_order_items i WHERE i.order_id = o.id AND i.customer_changed_at IS NOT NULL
+  AND (i.supplier_answered_at IS NULL OR i.supplier_answered_at < i.customer_changed_at))`
+
+const orderFrom = `
+FROM purchase_orders o
+LEFT JOIN suppliers s ON s.id = o.supplier_id
+JOIN users u ON u.id = o.created_by`
+
+// listWhere — $1 статус (NULL — все), $2 автор (NULL — все: admin; executor — он сам, DS-060).
+const listWhere = `
+WHERE o.deleted_at IS NULL
+  AND ($1::text IS NULL OR o.status = $1)
+  AND ($2::uuid IS NULL OR o.created_by = $2)`
+
+const listSQL = `SELECT ` + orderColumns + orderFrom + listWhere + `
+ORDER BY o.created_at DESC, o.id
+LIMIT $3 OFFSET $4`
+
+const countSQL = `SELECT count(*) FROM purchase_orders o` + listWhere
+
+// getSQL — карточка: $1 id, $2 автор (NULL — любой).
+const getSQL = `SELECT ` + orderColumns + orderFrom + `
+WHERE o.id = $1::uuid AND o.deleted_at IS NULL AND ($2::uuid IS NULL OR o.created_by = $2)`
+
+// supplierWhere — кабинет: $1 поставщик из сессии, только sent/ready/picked_up (DS-019).
+const supplierWhere = `
+WHERE o.supplier_id = $1::uuid AND o.deleted_at IS NULL
+  AND o.status IN ('sent', 'ready', 'picked_up')`
+
+const supplierListSQL = `SELECT ` + orderColumns + orderFrom + supplierWhere + `
+  AND ($2::text IS NULL OR o.status = $2)
+ORDER BY (o.status = 'sent') DESC, o.sent_at DESC NULLS LAST, o.id
+LIMIT $3 OFFSET $4`
+
+const supplierCountSQL = `SELECT count(*) FROM purchase_orders o` + supplierWhere + `
+  AND ($2::text IS NULL OR o.status = $2)`
+
+const supplierGetSQL = `SELECT ` + orderColumns + orderFrom + supplierWhere + `
+  AND o.id = $2::uuid`
+
+// itemsSQL — строки заказов $1 (uuid[]) по порядку.
+const itemsSQL = `
+SELECT i.id::text, i.order_id::text, i.product_id::text, i.position, i.qty::text, i.reason,
+       i.name, i.sku, i.unit, i.supplier_qty::text, i.supplier_price::text, i.supplier_note,
+       i.supplier_answered_at, i.customer_changed_at, i.version,
+       round(i.supplier_qty * i.supplier_price, 2)::text,
+       (i.supplier_qty IS NOT NULL AND i.supplier_qty <> i.qty),
+       (i.customer_changed_at IS NOT NULL
+        AND (i.supplier_answered_at IS NULL OR i.supplier_answered_at < i.customer_changed_at))
+FROM purchase_order_items i
+WHERE i.order_id = ANY($1::uuid[])
+ORDER BY i.order_id, i.position, i.id`
+
+// headSQL — шапка под блокировкой (переходы §5, правка §6.4); $1 id, $2 поставщик (NULL —
+// любой). LOCK — FOR UPDATE либо FOR SHARE.
+const headSQL = `
+SELECT o.id::text, o.number, o.supplier_id::text, o.status, o.version, o.created_by::text, o.note, o.sent_at,
+       (SELECT count(*) FROM purchase_order_items i WHERE i.order_id = o.id),
+       EXISTS (SELECT 1 FROM users su WHERE su.supplier_id = o.supplier_id AND su.role = 'supplier' AND su.is_active)
+FROM purchase_orders o
+WHERE o.id = $1::uuid AND o.deleted_at IS NULL AND ($2::uuid IS NULL OR o.supplier_id = $2)
+`
+
+const existingItemsSQL = `
+SELECT id::text, product_id::text, qty::text, reason
+FROM purchase_order_items WHERE order_id = $1::uuid ORDER BY position, id FOR UPDATE`
+
+// productsSQL — снимок активных, не удалённых запчастей $1 (uuid[]) (DS-021, DS-055).
+const productsSQL = `
+SELECT id::text, name, sku, unit FROM products
+WHERE id = ANY($1::uuid[]) AND is_active AND deleted_at IS NULL`
+
+// supplierLockSQL — строка поставщика FOR SHARE + «активен и не удалён» (DS-043).
+const supplierLockSQL = `
+SELECT is_active AND deleted_at IS NULL FROM suppliers WHERE id = $1::uuid FOR SHARE`
+
+const supplierAvailableSQL = `
+SELECT 1 FROM suppliers WHERE id = $1::uuid AND is_active AND deleted_at IS NULL FOR SHARE`
+
+const insertOrderSQL = `
+INSERT INTO purchase_orders (supplier_id, note, created_by) VALUES ($1::uuid, $2, $3::uuid)
+RETURNING id::text`
+
+// insertItemSQL — $6 = true: заказ уже отправлялся → «Изменено заказчиком» (DS-048).
+const insertItemSQL = `
+INSERT INTO purchase_order_items (order_id, product_id, position, qty, reason, name, sku, unit, customer_changed_at)
+VALUES ($1::uuid, $2::uuid, $3, $4::numeric, $5, $7, $8, $9, CASE WHEN $6 THEN now() END)`
+
+const deleteMissingItemsSQL = `
+DELETE FROM purchase_order_items WHERE order_id = $1::uuid AND NOT (id = ANY($2::uuid[]))`
+
+// updateItemQtySQL — смена количества сбрасывает ответ строки (DS-034, DS-048).
+const updateItemQtySQL = `
+UPDATE purchase_order_items SET
+  qty = $3::numeric, reason = coalesce(nullif($4, ''), reason), position = $5,
+  supplier_qty = NULL, supplier_price = NULL, supplier_note = '',
+  customer_changed_at = CASE WHEN $6 THEN now() ELSE customer_changed_at END,
+  version = version + 1
+WHERE id = $1::uuid AND order_id = $2::uuid`
+
+const updateItemPosSQL = `
+UPDATE purchase_order_items SET reason = coalesce(nullif($3, ''), reason), position = $4
+WHERE id = $1::uuid AND order_id = $2::uuid`
+
+// updateHeadSQL — правка §6.4; в sent изменение примечания ставит note_changed_at (DS-048).
+const updateHeadSQL = `
+UPDATE purchase_orders SET
+  note_changed_at = CASE WHEN status = 'sent' AND note <> $2 THEN now() ELSE note_changed_at END,
+  note = $2, version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const refreshSnapshotSQL = `
+UPDATE purchase_order_items i SET name = p.name, sku = p.sku, unit = p.unit
+FROM products p WHERE i.order_id = $1::uuid AND p.id = i.product_id`
+
+const sendSQL = `
+UPDATE purchase_orders SET status = 'sent', sent_by = $2::uuid, sent_at = now(),
+  version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const recallSQL = `
+UPDATE purchase_orders SET status = 'draft', version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const pickUpSQL = `
+UPDATE purchase_orders SET status = 'picked_up', picked_up_by = $2::uuid, picked_up_at = now(),
+  version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const cancelSQL = `
+UPDATE purchase_orders SET status = 'cancelled', cancelled_by = $2::uuid, cancelled_at = now(),
+  cancel_reason = $3, version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const softDeleteSQL = `
+UPDATE purchase_orders SET deleted_at = now(), deleted_by = $2::uuid, delete_reason = $3,
+  version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const restoreSQL = `
+UPDATE purchase_orders SET deleted_at = NULL, deleted_by = NULL, delete_reason = NULL, updated_at = now()
+WHERE id = $1::uuid AND deleted_at IS NOT NULL`
+
+const readySQL = `
+UPDATE purchase_orders SET status = 'ready', ready_by = $2::uuid, ready_at = now(),
+  version = version + 1, updated_at = now()
+WHERE id = $1::uuid`
+
+const answerStatesSQL = `
+SELECT id::text, version, supplier_qty::text, supplier_price::text
+FROM purchase_order_items WHERE order_id = $1::uuid ORDER BY position, id`
+
+const answerItemSQL = `
+SELECT id::text, version, supplier_qty::text, supplier_price::text
+FROM purchase_order_items WHERE id = $1::uuid AND order_id = $2::uuid FOR UPDATE`
+
+const answerSQL = `
+UPDATE purchase_order_items SET
+  supplier_qty = $3::numeric, supplier_price = $4::numeric, supplier_note = $5,
+  supplier_answered_by = $6::uuid, supplier_answered_at = now(), version = version + 1
+WHERE id = $1::uuid AND order_id = $2::uuid`
+
+const orderTotalSQL = `
+SELECT sum(round(supplier_qty * supplier_price, 2))::text FROM purchase_order_items
+WHERE order_id = $1::uuid AND supplier_qty IS NOT NULL AND supplier_price IS NOT NULL`
+
+// openOrdersSQL — «уже в открытом заказе» (sent/ready, не удалён; DS-049): $1 запчасти, $2 автор
+// (NULL — все: admin; executor — свои, DS-078).
+const openOrdersSQL = `
+SELECT i.product_id::text, o.id::text, o.number, i.qty::text
+FROM purchase_order_items i JOIN purchase_orders o ON o.id = i.order_id
+WHERE i.product_id = ANY($1::uuid[]) AND o.status IN ('sent', 'ready') AND o.deleted_at IS NULL
+  AND ($2::uuid IS NULL OR o.created_by = $2)
+ORDER BY o.number`
diff --git a/internal/features/purchase-orders/repository/repository.go b/internal/features/purchase-orders/repository/repository.go
new file mode 100644
index 0000000..e5db1da
--- /dev/null
+++ b/internal/features/purchase-orders/repository/repository.go
@@ -0,0 +1,659 @@
+// Package repository — доступ к purchase_orders / purchase_order_items (pgx/v5).
+//
+// Конкурентность (§3, DS-032): каждая правка и каждый переход читают шапку заказа под
+// блокировкой строки (FOR UPDATE; ответ поставщика — FOR SHARE) в одной транзакции и
+// передают её в check — бизнес-правила (статус, версия, владелец) решает service. Второй
+// конкурентный запрос ждёт блокировку и видит уже новый статус/версию → 409. Порядок
+// блокировок везде один: заказ, затем строки — без взаимоблокировок.
+package repository
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/internal/features/board"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/models"
+)
+
+var (
+	// ErrNotFound — заказа/строки нет (или удалён, или не виден по фильтру владельца).
+	ErrNotFound = errors.New("purchase-orders: not found")
+	// ErrNotDeleted — восстановление не удалённого заказа.
+	ErrNotDeleted = errors.New("purchase-orders: not deleted")
+	// ErrSupplierUnavailable — поставщик не найден, в архиве или удалён (§6.2).
+	ErrSupplierUnavailable = errors.New("purchase-orders: supplier unavailable")
+)
+
+// ProductsUnavailableError — запчасти новых строк не найдены, в архиве или удалены (DS-055).
+type ProductsUnavailableError struct {
+	ProductIDs map[string]bool
+}
+
+func (e *ProductsUnavailableError) Error() string { return "purchase-orders: products unavailable" }
+
+// HeadCheck — проверка шапки под блокировкой (service): ошибка — откат без изменений.
+type HeadCheck func(h models.Head) error
+
+// UpdateCheck — проверка правки §6.4: шапка и текущие строки заказа.
+type UpdateCheck func(h models.Head, existing []models.ExistingItem) error
+
+// AnswerCheck — проверка ответа поставщика §6.14: шапка и строка.
+type AnswerCheck func(h models.Head, item models.AnswerState) error
+
+// ReadyCheck — проверка «Собрано» §6.15: шапка и все строки.
+type ReadyCheck func(h models.Head, items []models.AnswerState) error
+
+type Repository struct {
+	pool *pgxpool.Pool
+}
+
+func New(pool *pgxpool.Pool) *Repository { return &Repository{pool: pool} }
+
+// ListFilter — список §6.1: Status "" — все; CreatedBy "" — все (admin).
+type ListFilter struct {
+	Status    string
+	CreatedBy string
+	Limit     int
+	Offset    int
+}
+
+func nullable(s string) *string {
+	if s == "" {
+		return nil
+	}
+	return &s
+}
+
+func scanOrder(row pgx.Row) (*models.PurchaseOrder, error) {
+	var o models.PurchaseOrder
+	var changedItems bool
+	err := row.Scan(&o.ID, &o.Number, &o.SupplierID, &o.SupplierName, &o.SupplierPhone,
+		&o.Status, &o.Note, &o.NoteChangedAt, &o.Version,
+		&o.CreatedBy, &o.CreatedByName, &o.CreatedAt, &o.UpdatedAt,
+		&o.SentAt, &o.ReadyAt, &o.PickedUpAt, &o.CancelledAt, &o.CancelReason,
+		&o.SupplierHasLogin, &o.ItemsCount, &o.AnsweredCount, &o.TotalAmount,
+		&o.NoteChanged, &changedItems)
+	if err != nil {
+		return nil, err
+	}
+	o.IsChanged = o.NoteChanged || changedItems
+	return &o, nil
+}
+
+func (r *Repository) queryOrders(ctx context.Context, q string, args ...any) ([]models.PurchaseOrder, error) {
+	rows, err := r.pool.Query(ctx, q, args...)
+	if err != nil {
+		return nil, fmt.Errorf("purchase-orders list: %w", err)
+	}
+	defer rows.Close()
+	out := []models.PurchaseOrder{}
+	for rows.Next() {
+		o, err := scanOrder(rows)
+		if err != nil {
+			return nil, fmt.Errorf("purchase-orders list scan: %w", err)
+		}
+		out = append(out, *o)
+	}
+	return out, rows.Err()
+}
+
+// List — §6.1, без строк (агрегаты в шапке).
+func (r *Repository) List(ctx context.Context, f ListFilter) ([]models.PurchaseOrder, int, error) {
+	var total int
+	if err := r.pool.QueryRow(ctx, countSQL, nullable(f.Status), nullable(f.CreatedBy)).Scan(&total); err != nil {
+		return nil, 0, fmt.Errorf("purchase-orders count: %w", err)
+	}
+	out, err := r.queryOrders(ctx, listSQL, nullable(f.Status), nullable(f.CreatedBy), f.Limit, f.Offset)
+	return out, total, err
+}
+
+// Get — карточка §6.3 со строками; createdBy "" — любой автор.
+func (r *Repository) Get(ctx context.Context, id, createdBy string) (*models.PurchaseOrder, error) {
+	return r.getOne(ctx, getSQL, id, nullable(createdBy))
+}
+
+// SupplierList — кабинет §6.12: заказы поставщика supplierID в sent/ready/picked_up.
+func (r *Repository) SupplierList(ctx context.Context, supplierID, status string, limit, offset int) ([]models.PurchaseOrder, int, error) {
+	var total int
+	if err := r.pool.QueryRow(ctx, supplierCountSQL, supplierID, nullable(status)).Scan(&total); err != nil {
+		return nil, 0, fmt.Errorf("purchase-orders supplier count: %w", err)
+	}
+	out, err := r.queryOrders(ctx, supplierListSQL, supplierID, nullable(status), limit, offset)
+	return out, total, err
+}
+
+// SupplierGet — карточка кабинета §6.13 (только видимые статусы своего поставщика).
+func (r *Repository) SupplierGet(ctx context.Context, supplierID, id string) (*models.PurchaseOrder, error) {
+	return r.getOne(ctx, supplierGetSQL, supplierID, id)
+}
+
+func (r *Repository) getOne(ctx context.Context, q string, args ...any) (*models.PurchaseOrder, error) {
+	o, err := scanOrder(r.pool.QueryRow(ctx, q, args...))
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, fmt.Errorf("purchase-orders get: %w", err)
+	}
+	items, err := r.items(ctx, o.ID)
+	if err != nil {
+		return nil, err
+	}
+	o.Items = items
+	return o, nil
+}
+
+func (r *Repository) items(ctx context.Context, orderID string) ([]models.PurchaseOrderItem, error) {
+	rows, err := r.pool.Query(ctx, itemsSQL, []string{orderID})
+	if err != nil {
+		return nil, fmt.Errorf("purchase-orders items: %w", err)
+	}
+	defer rows.Close()
+	out := []models.PurchaseOrderItem{}
+	for rows.Next() {
+		var it models.PurchaseOrderItem
+		if err := rows.Scan(&it.ID, &it.OrderID, &it.ProductID, &it.Position, &it.Qty, &it.Reason,
+			&it.Name, &it.Sku, &it.Unit, &it.SupplierQty, &it.SupplierPrice, &it.SupplierNote,
+			&it.SupplierAnsweredAt, &it.CustomerChangedAt, &it.Version,
+			&it.LineAmount, &it.HasDiscrepancy, &it.CustomerChanged); err != nil {
+			return nil, fmt.Errorf("purchase-orders items scan: %w", err)
+		}
+		out = append(out, it)
+	}
+	return out, rows.Err()
+}
+
+// ---- транзакции ----
+
+func (r *Repository) inTx(ctx context.Context, fn func(tx pgx.Tx) error) error {
+	tx, err := r.pool.Begin(ctx)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+	if err := fn(tx); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
+
+// lockHead — шапка под блокировкой lock ("FOR UPDATE OF o" / "FOR SHARE OF o"); supplierID ""
+// — любой поставщик.
+func lockHead(ctx context.Context, tx pgx.Tx, id, supplierID, lock string) (models.Head, error) {
+	var h models.Head
+	err := tx.QueryRow(ctx, headSQL+lock, id, nullable(supplierID)).Scan(&h.ID, &h.Number, &h.SupplierID, &h.Status,
+		&h.Version, &h.CreatedBy, &h.Note, &h.SentAt, &h.ItemsCount, &h.SupplierHasLogin)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return h, ErrNotFound
+	}
+	if err != nil {
+		return h, fmt.Errorf("purchase-orders lock: %w", err)
+	}
+	h.SupplierAvailable, err = lockSupplier(ctx, tx, h.SupplierID)
+	return h, err
+}
+
+// lockSupplier — строка поставщика FOR SHARE до конца транзакции + «активен и не удалён»
+// (DS-043): архив/удаление поставщика (suppliers, FOR UPDATE) ждёт эту транзакцию либо она —
+// его, и видит уже архивного. nil (Базар) — доступен.
+func lockSupplier(ctx context.Context, tx pgx.Tx, supplierID *string) (bool, error) {
+	if supplierID == nil {
+		return true, nil
+	}
+	var ok bool
+	err := tx.QueryRow(ctx, supplierLockSQL, *supplierID).Scan(&ok)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("purchase-orders supplier lock: %w", err)
+	}
+	return ok, nil
+}
+
+const (
+	forUpdate = "FOR UPDATE OF o"
+	forShare  = "FOR SHARE OF o"
+)
+
+type productSnap struct{ name, sku, unit string }
+
+// products — снимок активных запчастей новых строк; недоступные → ProductsUnavailableError.
+func products(ctx context.Context, tx pgx.Tx, lines []models.ItemInput) (map[string]productSnap, error) {
+	var ids []string
+	for _, l := range lines {
+		if l.ID == "" {
+			ids = append(ids, l.ProductID)
+		}
+	}
+	out := map[string]productSnap{}
+	if len(ids) == 0 {
+		return out, nil
+	}
+	rows, err := tx.Query(ctx, productsSQL, ids)
+	if err != nil {
+		return nil, fmt.Errorf("purchase-orders products: %w", err)
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id string
+		var p productSnap
+		if err := rows.Scan(&id, &p.name, &p.sku, &p.unit); err != nil {
+			return nil, err
+		}
+		out[id] = p
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	missing := map[string]bool{}
+	for _, id := range ids {
+		if _, ok := out[id]; !ok {
+			missing[id] = true
+		}
+	}
+	if len(missing) > 0 {
+		return nil, &ProductsUnavailableError{ProductIDs: missing}
+	}
+	return out, nil
+}
+
+func insertItem(ctx context.Context, tx pgx.Tx, orderID string, pos int, l models.ItemInput, p productSnap, changed bool) error {
+	_, err := tx.Exec(ctx, insertItemSQL, orderID, l.ProductID, pos, l.Qty, l.Reason, changed, p.name, p.sku, p.unit)
+	if err != nil {
+		return fmt.Errorf("purchase-orders insert item: %w", err)
+	}
+	return nil
+}
+
+// Create — черновик §6.2: шапка + строки в одной транзакции (§4.1).
+func (r *Repository) Create(ctx context.Context, createdBy string, supplierID *string, note string, lines []models.ItemInput) (string, error) {
+	var id string
+	err := r.inTx(ctx, func(tx pgx.Tx) error {
+		if supplierID != nil {
+			var one int
+			err := tx.QueryRow(ctx, supplierAvailableSQL, *supplierID).Scan(&one)
+			if errors.Is(err, pgx.ErrNoRows) {
+				return ErrSupplierUnavailable
+			}
+			if err != nil {
+				return err
+			}
+		}
+		snaps, err := products(ctx, tx, lines)
+		if err != nil {
+			return err
+		}
+		if err := tx.QueryRow(ctx, insertOrderSQL, supplierID, note, createdBy).Scan(&id); err != nil {
+			return fmt.Errorf("purchase-orders insert: %w", err)
+		}
+		for i, l := range lines {
+			if err := insertItem(ctx, tx, id, i, l, snaps[l.ProductID], false); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	return id, err
+}
+
+// Update — правка §6.4: строки сверяются с lines (новые — INSERT, отсутствующие — DELETE,
+// изменённые — UPDATE); в уже отправлявшемся заказе изменённые и новые строки сбрасывают
+// ответ и получают «Изменено заказчиком» (DS-034, DS-048).
+func (r *Repository) Update(ctx context.Context, id, note string, lines []models.ItemInput, check UpdateCheck) error {
+	return r.inTx(ctx, func(tx pgx.Tx) error {
+		h, err := lockHead(ctx, tx, id, "", forUpdate)
+		if err != nil {
+			return err
+		}
+		existing, err := existingItems(ctx, tx, id)
+		if err != nil {
+			return err
+		}
+		if err := check(h, existing); err != nil {
+			return err
+		}
+		byID := make(map[string]models.ExistingItem, len(existing))
+		for _, e := range existing {
+			byID[e.ID] = e
+		}
+		keep := []string{}
+		for _, l := range lines {
+			if l.ID != "" {
+				keep = append(keep, l.ID)
+			}
+		}
+		if _, err := tx.Exec(ctx, deleteMissingItemsSQL, id, keep); err != nil {
+			return fmt.Errorf("purchase-orders delete items: %w", err)
+		}
+		snaps, err := products(ctx, tx, lines)
+		if err != nil {
+			return err
+		}
+		wasSent := h.SentAt != nil
+		for i, l := range lines {
+			if l.ID == "" {
+				if err := insertItem(ctx, tx, id, i, l, snaps[l.ProductID], wasSent); err != nil {
+					return err
+				}
+				continue
+			}
+			q, args := updateItemPosSQL, []any{l.ID, id, l.Reason, i}
+			if byID[l.ID].Qty != l.Qty {
+				q, args = updateItemQtySQL, []any{l.ID, id, l.Qty, l.Reason, i, wasSent}
+			}
+			if _, err := tx.Exec(ctx, q, args...); err != nil {
+				return fmt.Errorf("purchase-orders update item: %w", err)
+			}
+		}
+		if _, err := tx.Exec(ctx, updateHeadSQL, id, note); err != nil {
+			return fmt.Errorf("purchase-orders update: %w", err)
+		}
+		return nil
+	})
+}
+
+func existingItems(ctx context.Context, tx pgx.Tx, id string) ([]models.ExistingItem, error) {
+	rows, err := tx.Query(ctx, existingItemsSQL, id)
+	if err != nil {
+		return nil, fmt.Errorf("purchase-orders existing items: %w", err)
+	}
+	defer rows.Close()
+	var out []models.ExistingItem
+	for rows.Next() {
+		var e models.ExistingItem
+		if err := rows.Scan(&e.ID, &e.ProductID, &e.Qty, &e.Reason); err != nil {
+			return nil, err
+		}
+		out = append(out, e)
+	}
+	return out, rows.Err()
+}
+
+// transition — переход под блокировкой шапки: check, затем statements по порядку.
+func (r *Repository) transition(ctx context.Context, id string, check HeadCheck, stmts ...stmt) error {
+	return r.inTx(ctx, func(tx pgx.Tx) error {
+		h, err := lockHead(ctx, tx, id, "", forUpdate)
+		if err != nil {
+			return err
+		}
+		if err := check(h); err != nil {
+			return err
+		}
+		for _, s := range stmts {
+			if _, err := tx.Exec(ctx, s.sql, s.args...); err != nil {
+				return fmt.Errorf("purchase-orders transition: %w", err)
+			}
+		}
+		return nil
+	})
+}
+
+type stmt struct {
+	sql  string
+	args []any
+}
+
+// Send — draft → sent (§6.6): снимок name/sku/unit обновляется (DS-054).
+func (r *Repository) Send(ctx context.Context, id, actorID string, check HeadCheck) error {
+	return r.transition(ctx, id, check, stmt{refreshSnapshotSQL, []any{id}}, stmt{sendSQL, []any{id, actorID}})
+}
+
+// Recall — sent → draft (§6.7): ответы сохраняются (DS-035).
+func (r *Repository) Recall(ctx context.Context, id string, check HeadCheck) error {
+	return r.transition(ctx, id, check, stmt{recallSQL, []any{id}})
+}
+
+// PickUp — → picked_up (§6.8): остатки не меняются (DS-010).
+func (r *Repository) PickUp(ctx context.Context, id, actorID string, check HeadCheck) error {
+	return r.transition(ctx, id, check, stmt{pickUpSQL, []any{id, actorID}})
+}
+
+// Cancel — → cancelled (§6.9).
+func (r *Repository) Cancel(ctx context.Context, id, actorID, reason string, check HeadCheck) error {
+	return r.transition(ctx, id, check, stmt{cancelSQL, []any{id, actorID, reason}})
+}
+
+// SoftDelete — мягкое удаление черновика (§6.5).
+func (r *Repository) SoftDelete(ctx context.Context, id, actorID, reason string, check HeadCheck) error {
+	return r.transition(ctx, id, check, stmt{softDeleteSQL, []any{id, actorID, reason}})
+}
+
+// ErrRestoreSupplierUnavailable — восстановление черновика архивного/удалённого поставщика
+// вернуло бы ему незакрытую закупку (DS-043).
+var ErrRestoreSupplierUnavailable = errors.New("purchase-orders: restore supplier unavailable")
+
+// Restore — восстановление из раздела «Удалённые» (DS-072): строка заказа FOR UPDATE, строка
+// поставщика FOR SHARE и проверка «активен и не удалён» в одной транзакции (DS-043).
+func (r *Repository) Restore(ctx context.Context, id string) error {
+	return r.inTx(ctx, func(tx pgx.Tx) error {
+		var supplierID *string
+		var deleted bool
+		err := tx.QueryRow(ctx, `SELECT supplier_id::text, deleted_at IS NOT NULL FROM purchase_orders
+			WHERE id = $1::uuid FOR UPDATE`, id).Scan(&supplierID, &deleted)
+		if errors.Is(err, pgx.ErrNoRows) {
+			return ErrNotFound
+		}
+		if err != nil {
+			return fmt.Errorf("purchase-orders restore: %w", err)
+		}
+		if !deleted {
+			return ErrNotDeleted
+		}
+		ok, err := lockSupplier(ctx, tx, supplierID)
+		if err != nil {
+			return err
+		}
+		if !ok {
+			return ErrRestoreSupplierUnavailable
+		}
+		if _, err := tx.Exec(ctx, restoreSQL, id); err != nil {
+			return fmt.Errorf("purchase-orders restore: %w", err)
+		}
+		return nil
+	})
+}
+
+// Purge — физическое удаление (служебная уборка автотестов, soft-delete-core DS-027);
+// строки — каскадом (DS-070).
+func (r *Repository) Purge(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM purchase_orders WHERE id = $1::uuid`, id)
+	if err != nil {
+		return fmt.Errorf("purchase-orders purge: %w", err)
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrNotFound
+	}
+	return nil
+}
+
+// ---- кабинет поставщика ----
+
+// Answer — ответ по строке §6.14: шапка FOR SHARE (против одновременных переходов), строка
+// FOR UPDATE (версия строки). Возвращает обновлённую строку и итог заказа.
+func (r *Repository) Answer(ctx context.Context, supplierID, orderID, itemID, actorID string, a models.SupplierAnswer, check AnswerCheck) (*models.PurchaseOrderItem, *string, error) {
+	err := r.inTx(ctx, func(tx pgx.Tx) error {
+		h, err := lockHead(ctx, tx, orderID, supplierID, forShare)
+		if err != nil {
+			return err
+		}
+		var st models.AnswerState
+		err = tx.QueryRow(ctx, answerItemSQL, itemID, orderID).Scan(&st.ItemID, &st.Version, &st.SupplierQty, &st.SupplierPrice)
+		if errors.Is(err, pgx.ErrNoRows) {
+			return ErrNotFound
+		}
+		if err != nil {
+			return fmt.Errorf("purchase-orders answer item: %w", err)
+		}
+		if err := check(h, st); err != nil {
+			return err
+		}
+		_, err = tx.Exec(ctx, answerSQL, itemID, orderID, a.SupplierQty, a.SupplierPrice, a.SupplierNote, actorID)
+		if err != nil {
+			return fmt.Errorf("purchase-orders answer: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	items, err := r.items(ctx, orderID)
+	if err != nil {
+		return nil, nil, err
+	}
+	var total *string
+	if err := r.pool.QueryRow(ctx, orderTotalSQL, orderID).Scan(&total); err != nil {
+		return nil, nil, err
+	}
+	for i := range items {
+		if items[i].ID == itemID {
+			return &items[i], total, nil
+		}
+	}
+	return nil, nil, ErrNotFound
+}
+
+// Ready — «Собрано» §6.15 (sent → ready) под блокировкой шапки своего поставщика.
+func (r *Repository) Ready(ctx context.Context, supplierID, id, actorID string, check ReadyCheck) error {
+	return r.inTx(ctx, func(tx pgx.Tx) error {
+		h, err := lockHead(ctx, tx, id, supplierID, forUpdate)
+		if err != nil {
+			return err
+		}
+		rows, err := tx.Query(ctx, answerStatesSQL, id)
+		if err != nil {
+			return err
+		}
+		var states []models.AnswerState
+		for rows.Next() {
+			var st models.AnswerState
+			if err := rows.Scan(&st.ItemID, &st.Version, &st.SupplierQty, &st.SupplierPrice); err != nil {
+				rows.Close()
+				return err
+			}
+			states = append(states, st)
+		}
+		rows.Close()
+		if err := rows.Err(); err != nil {
+			return err
+		}
+		if err := check(h, states); err != nil {
+			return err
+		}
+		if _, err := tx.Exec(ctx, readySQL, id, actorID); err != nil {
+			return fmt.Errorf("purchase-orders ready: %w", err)
+		}
+		return nil
+	})
+}
+
+// ---- подсказка дефицита §6.10 ----
+
+// suggestionsSQL — to_order = max(0, pending + min_stock − stock); pending — общий CTE «Остатков»
+// (board.PendingCTE, DS-064). $1 тип (NULL — все), $2 limit, $3 offset.
+const suggestionsSQL = board.PendingCTE + `,
+deficit AS (
+    SELECT p.id, p.name, p.sku, p.unit, p.stock, p.min_stock, coalesce(pd.qty, 0) AS pending,
+           coalesce(pd.qty, 0) + p.min_stock - p.stock AS to_order,
+           CASE WHEN coalesce(pd.qty, 0) > p.stock THEN 'for_orders' ELSE 'below_min' END AS reason
+    FROM products p LEFT JOIN pending pd ON pd.product_id = p.id
+    WHERE p.is_active AND p.deleted_at IS NULL)
+SELECT id::text, name, sku, unit, stock::text, min_stock::text, pending::text, to_order::text, reason,
+       count(*) OVER ()
+FROM deficit
+WHERE to_order > 0 AND ($1::text IS NULL OR reason = $1)
+ORDER BY (reason = 'for_orders') DESC, lower(name), id
+LIMIT $2 OFFSET $3`
+
+// Suggestions — строки дефицита; createdBy "" — «уже в открытом заказе» по всем заказам
+// (admin), иначе только по заказам этого автора (executor, DS-078).
+func (r *Repository) Suggestions(ctx context.Context, reason, createdBy string, limit, offset int) ([]models.Suggestion, int, error) {
+	rows, err := r.pool.Query(ctx, suggestionsSQL, nullable(reason), limit, offset)
+	if err != nil {
+		return nil, 0, fmt.Errorf("purchase-orders suggestions: %w", err)
+	}
+	out := []models.Suggestion{}
+	total := 0
+	for rows.Next() {
+		var s models.Suggestion
+		if err := rows.Scan(&s.ProductID, &s.Name, &s.Sku, &s.Unit, &s.Stock, &s.MinStock, &s.Pending,
+			&s.ToOrder, &s.Reason, &total); err != nil {
+			rows.Close()
+			return nil, 0, err
+		}
+		out = append(out, s)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return nil, 0, err
+	}
+	if len(out) == 0 {
+		return out, 0, nil
+	}
+	ids := make([]string, len(out))
+	idx := make(map[string]int, len(out))
+	for i := range out {
+		ids[i] = out[i].ProductID
+		idx[out[i].ProductID] = i
+	}
+	trows, err := r.pool.Query(ctx, board.PendingTasksSQL, ids)
+	if err != nil {
+		return nil, 0, fmt.Errorf("purchase-orders suggestion tasks: %w", err)
+	}
+	for trows.Next() {
+		var pid string
+		var t models.SuggestionTask
+		if err := trows.Scan(&pid, &t.ID, &t.Title); err != nil {
+			trows.Close()
+			return nil, 0, err
+		}
+		out[idx[pid]].Tasks = append(out[idx[pid]].Tasks, t)
+	}
+	trows.Close()
+	if err := trows.Err(); err != nil {
+		return nil, 0, err
+	}
+	orows, err := r.pool.Query(ctx, openOrdersSQL, ids, nullable(createdBy))
+	if err != nil {
+		return nil, 0, fmt.Errorf("purchase-orders open orders: %w", err)
+	}
+	defer orows.Close()
+	for orows.Next() {
+		var pid string
+		var ref models.OpenOrderRef
+		if err := orows.Scan(&pid, &ref.ID, &ref.Number, &ref.Qty); err != nil {
+			return nil, 0, err
+		}
+		out[idx[pid]].InOpenOrders = append(out[idx[pid]].InOpenOrders, ref)
+	}
+	return out, total, orows.Err()
+}
+
+// SupplierOption — получатель в выпадающем списке «Новый заказ» (§8.2).
+type SupplierOption struct {
+	ID   string
+	Name string
+}
+
+// ActiveSuppliers — активные, не удалённые поставщики по алфавиту (§8.2).
+func (r *Repository) ActiveSuppliers(ctx context.Context) ([]SupplierOption, error) {
+	rows, err := r.pool.Query(ctx,
+		`SELECT id::text, name FROM suppliers WHERE is_active AND deleted_at IS NULL ORDER BY lower(name), id`)
+	if err != nil {
+		return nil, fmt.Errorf("purchase-orders suppliers: %w", err)
+	}
+	defer rows.Close()
+	out := []SupplierOption{}
+	for rows.Next() {
+		var o SupplierOption
+		if err := rows.Scan(&o.ID, &o.Name); err != nil {
+			return nil, err
+		}
+		out = append(out, o)
+	}
+	return out, rows.Err()
+}
diff --git a/internal/features/purchase-orders/service/checks_test.go b/internal/features/purchase-orders/service/checks_test.go
new file mode 100644
