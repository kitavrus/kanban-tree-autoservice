@@ -0,0 +1,84 @@
+package handler
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/kitavrus/kanban-tree/internal/config"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/models"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/repository"
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+)
+
+// chdirRoot — шаблоны адресуются от корня модуля (как у бинаря).
+func chdirRoot(t *testing.T) {
+	t.Helper()
+	dir, err := os.Getwd()
+	require.NoError(t, err)
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			break
+		}
+		parent := filepath.Dir(dir)
+		require.NotEqual(t, parent, dir, "go.mod не найден")
+		dir = parent
+	}
+	t.Chdir(dir)
+}
+
+// Экраны §8.1–§8.3, §8.6–§8.7 собираются в общем layout проекта (сайдбар/шапка — base из
+// web/ssr/_layout), своих layout'ов у фичи нет.
+func TestPagesRenderInSharedShell(t *testing.T) {
+	chdirRoot(t)
+	r, err := ssr.NewRenderer(Root, ssr.SharedRoot)
+	require.NoError(t, err)
+	shell := ssr.Shell{Title: "Закупки", User: ssr.Viewer{Name: "Админ", Role: "admin", Timezone: "Asia/Almaty"}, IsAdmin: true,
+		Menu: ssr.BuildMenu(map[string]bool{"/purchases": true}, true, nil)}
+	pages := map[string]any{
+		"list":          ListVM{Shell: shell, Statuses: statusOptions([]string{"draft", "sent"})},
+		"new":           NewVM{Shell: shell, Suppliers: []repository.SupplierOption{{ID: "1", Name: "АвтоДеталь"}}, Bazaar: "Базар"},
+		"view":          ViewVM{Shell: shell, ID: "x", IsAdmin: true},
+		"supplier-list": ListVM{Shell: ssr.Shell{Menu: ssr.SupplierMenu(), IsSupplier: true}, FirmName: "Мастерская", FirmPhone: "+7"},
+		"supplier-view": ViewVM{Shell: ssr.Shell{Menu: ssr.SupplierMenu(), IsSupplier: true}, ID: "x"},
+	}
+	for name, vm := range pages {
+		var buf bytes.Buffer
+		require.NoError(t, r.Render(&buf, name, "base", vm), name)
+		html := buf.String()
+		assert.Contains(t, html, `data-testid="sidebar"`, name)
+		assert.Contains(t, html, "/assets/ssr-shared/js/", name)
+	}
+	var buf bytes.Buffer
+	require.NoError(t, r.Render(&buf, "supplier-view", "base", ViewVM{Shell: ssr.Shell{Menu: ssr.SupplierMenu(), IsSupplier: true, User: ssr.Viewer{Name: "Ерлан", Role: "supplier"}}}))
+	assert.Contains(t, buf.String(), `data-testid="so-not-found"`)
+	assert.Contains(t, buf.String(), "Поставщик", "подпись роли в сайдбаре")
+}
+
+func sp(s string) *string { return &s }
+
+// PDF §8.4: Базар — колонка ☐, после ответа поставщика — цены и итог; экземпляр поставщика.
+func TestRenderOrderPDF(t *testing.T) {
+	sup := "s"
+	now := time.Now()
+	o := &models.PurchaseOrder{Number: 13, Status: "draft", Note: "до 17:00", CreatedAt: now,
+		Items: []models.PurchaseOrderItem{{Name: "Фильтр масляный", Sku: "OC-90", Qty: "4.000", Unit: "шт"}}}
+	firm := config.FirmInfo{Name: "СТО", Phone: "+7 700"}
+	for _, mode := range []pdfMode{pdfOurs, pdfSupplier} {
+		body, err := renderOrderPDF(o, mode, firm, "Asia/Almaty")
+		require.NoError(t, err)
+		assert.True(t, bytes.HasPrefix(body, []byte("%PDF")))
+	}
+	o.SupplierID = &sup
+	o.AnsweredCount = 1
+	o.TotalAmount = sp("9800.00")
+	o.Items[0].SupplierQty, o.Items[0].SupplierPrice, o.Items[0].LineAmount = sp("4.000"), sp("2450.00"), sp("9800.00")
+	body, err := renderOrderPDF(o, pdfOurs, firm, "Asia/Almaty")
+	require.NoError(t, err)
+	assert.True(t, bytes.HasPrefix(body, []byte("%PDF")))
+}
diff --git a/internal/features/purchase-orders/handler/ssr.go b/internal/features/purchase-orders/handler/ssr.go
new file mode 100644
index 0000000..51f8ca3
--- /dev/null
+++ b/internal/features/purchase-orders/handler/ssr.go
@@ -0,0 +1,120 @@
+package handler
+
+import (
+	"errors"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/constants"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/repository"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/service"
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Root — шаблоны экранов закупок и кабинета поставщика относительно корня модуля. Layout —
+// общий shell проекта (web/ssr/_layout, ssr.SharedRoot), своего base.html у фичи нет.
+const Root = "web/ssr/purchase-orders/templates"
+
+// SSR — экраны §8.1–§8.3 (admin, executor) и §8.6–§8.7 (supplier) + PDF §6.11/§6.16.
+type SSR struct {
+	svc    *service.Service
+	r      *ssr.Renderer
+	shell  ssr.ShellBuilder
+	status *ssr.StatusPages
+}
+
+func NewSSR(svc *service.Service, r *ssr.Renderer, shell ssr.ShellBuilder, status *ssr.StatusPages) *SSR {
+	return &SSR{svc: svc, r: r, shell: shell, status: status}
+}
+
+// StatusOption — пункт фильтра статуса.
+type StatusOption struct {
+	Value, Title string
+}
+
+// ListVM — §8.1 / §8.6: оболочка, данные грузит JS.
+type ListVM struct {
+	Shell     ssr.Shell
+	Statuses  []StatusOption
+	FirmName  string
+	FirmPhone string
+}
+
+// NewVM — §8.2: получатели из SSR, дефицит — JS (§6.10).
+type NewVM struct {
+	Shell     ssr.Shell
+	Suppliers []repository.SupplierOption
+	Bazaar    string
+}
+
+// ViewVM — §8.3 / §8.7: id заказа; карточку грузит JS.
+type ViewVM struct {
+	Shell     ssr.Shell
+	ID        string
+	IsAdmin   bool
+	FirmName  string
+	FirmPhone string
+}
+
+func statusOptions(list []string) []StatusOption {
+	out := make([]StatusOption, 0, len(list))
+	for _, s := range list {
+		out = append(out, StatusOption{Value: s, Title: constants.StatusTitles[s]})
+	}
+	return out
+}
+
+// list — GET /purchases.
+func (s *SSR) list(c fiber.Ctx) error {
+	return s.r.Page(c, "list", ListVM{Shell: s.shell.Build(c, "Закупки"), Statuses: statusOptions(constants.Statuses)})
+}
+
+// newOrder — GET /purchases/new.
+func (s *SSR) newOrder(c fiber.Ctx) error {
+	sups, err := s.svc.ActiveSuppliers(c.Context())
+	if err != nil {
+		return err
+	}
+	return s.r.Page(c, "new", NewVM{Shell: s.shell.Build(c, "Новый заказ"), Suppliers: sups, Bazaar: "Базар (покупаем сами)"})
+}
+
+// notFound — 404-страница для «нет/удалён/чужой» (§6.3, §6.11), иначе ошибка как есть.
+func (s *SSR) notFound(c fiber.Ctx, err error) error {
+	if errors.Is(err, errorspkg.ErrPurchaseOrderNotFound) {
+		return s.status.NotFound(c)
+	}
+	return err
+}
+
+// view — GET /purchases/:id: чужой (executor) или удалённый — 404-страница (DS-060).
+func (s *SSR) view(c fiber.Ctx) error {
+	a := actor(c)
+	o, err := s.svc.Model(c.Context(), a, c.Params("id"))
+	if err != nil {
+		return s.notFound(c, err)
+	}
+	return s.r.Page(c, "view", ViewVM{Shell: s.shell.Build(c, "Заказ "+constants.NumberDisplay(o.Number)), ID: o.ID, IsAdmin: a.Role == service.RoleAdmin})
+}
+
+// supplierList — GET /supplier/orders (§8.6).
+func (s *SSR) supplierList(c fiber.Ctx) error {
+	f := s.svc.Firm()
+	return s.r.Page(c, "supplier-list", ListVM{Shell: s.shell.Build(c, "Заказы"),
+		Statuses: statusOptions(constants.SupplierStatuses), FirmName: f.Name, FirmPhone: f.Phone})
+}
+
+// supplierView — GET /supplier/orders/:id (§8.7): чужой/черновик/отменён — «Заказ не найден».
+func (s *SSR) supplierView(c fiber.Ctx) error {
+	f := s.svc.Firm()
+	o, err := s.svc.SupplierModel(c.Context(), actor(c), c.Params("id"))
+	if errors.Is(err, errorspkg.ErrPurchaseOrderNotFound) {
+		c.Status(fiber.StatusNotFound)
+		return s.r.Page(c, "supplier-view", ViewVM{Shell: s.shell.Build(c, "Заказ не найден"), FirmName: f.Name, FirmPhone: f.Phone})
+	}
+	if err != nil {
+		return err
+	}
+	return s.r.Page(c, "supplier-view", ViewVM{Shell: s.shell.Build(c, "Заказ "+constants.NumberDisplay(o.Number)),
+		ID: o.ID, FirmName: f.Name, FirmPhone: f.Phone})
+}
diff --git a/internal/features/purchase-orders/mappers/mappers.go b/internal/features/purchase-orders/mappers/mappers.go
new file mode 100644
index 0000000..cc78068
--- /dev/null
+++ b/internal/features/purchase-orders/mappers/mappers.go
@@ -0,0 +1,117 @@
+// Package mappers — конвертация строк БД (models) в wire-типы API (dto). Время — UTC
+// (DS-033): показ в поясе смотрящего делает клиент (KT.time) и PDF (timezone.Format).
+package mappers
+
+import (
+	"time"
+
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/constants"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/models"
+	"github.com/kitavrus/kanban-tree/internal/features/purchase-orders/models/dto"
+)
+
+func utc(t *time.Time) *time.Time {
+	if t == nil {
+		return nil
+	}
+	u := t.UTC()
+	return &u
+}
+
+// RecipientName — поставщик или «Базар (сами)» (§6.1).
+func RecipientName(o *models.PurchaseOrder) string {
+	if o.SupplierID == nil {
+		return constants.BazaarName
+	}
+	return o.SupplierName
+}
+
+// ToListItem — строка списка §6.1.
+func ToListItem(o *models.PurchaseOrder) dto.ListItem {
+	return dto.ListItem{
+		ID: o.ID, Number: o.Number, NumberDisplay: constants.NumberDisplay(o.Number),
+		SupplierID: o.SupplierID, RecipientName: RecipientName(o), Status: o.Status,
+		ItemsCount: o.ItemsCount, TotalAmount: o.TotalAmount, CreatedByName: o.CreatedByName,
+		CreatedAt: o.CreatedAt.UTC(), SentAt: utc(o.SentAt), PickedUpAt: utc(o.PickedUpAt),
+	}
+}
+
+// ToOrder — карточка §6.3. can_edit — статус draft/sent (чужие executor'у не отдаются вовсе).
+func ToOrder(o *models.PurchaseOrder) *dto.Order {
+	out := &dto.Order{
+		ID: o.ID, Number: o.Number, NumberDisplay: constants.NumberDisplay(o.Number),
+		Status: o.Status, Version: o.Version, SupplierID: o.SupplierID,
+		RecipientName: RecipientName(o), RecipientPhone: o.SupplierPhone,
+		SupplierHasLogin: o.SupplierHasLogin, Note: o.Note,
+		CanEdit:       o.Status == constants.StatusDraft || o.Status == constants.StatusSent,
+		CreatedByName: o.CreatedByName, CreatedAt: o.CreatedAt.UTC(),
+		SentAt: utc(o.SentAt), ReadyAt: utc(o.ReadyAt), PickedUpAt: utc(o.PickedUpAt),
+		CancelledAt: utc(o.CancelledAt), CancelReason: o.CancelReason,
+		Items: make([]dto.OrderItem, 0, len(o.Items)), TotalAmount: o.TotalAmount,
+	}
+	if o.SupplierID == nil {
+		out.RecipientPhone = ""
+	}
+	for i := range o.Items {
+		it := &o.Items[i]
+		out.Items = append(out.Items, dto.OrderItem{
+			ID: it.ID, ProductID: it.ProductID, Name: it.Name, Sku: it.Sku, Unit: it.Unit,
+			Qty: it.Qty, Reason: it.Reason, SupplierQty: it.SupplierQty, SupplierPrice: it.SupplierPrice,
+			SupplierNote: it.SupplierNote, LineAmount: it.LineAmount, HasDiscrepancy: it.HasDiscrepancy,
+			CustomerChanged: it.CustomerChanged, Version: it.Version,
+		})
+	}
+	return out
+}
+
+// ToSupplierListItem — §6.12.
+func ToSupplierListItem(o *models.PurchaseOrder) dto.SupplierListItem {
+	return dto.SupplierListItem{
+		ID: o.ID, NumberDisplay: constants.NumberDisplay(o.Number), Status: o.Status,
+		SentAt: utc(o.SentAt), ItemsCount: o.ItemsCount, AnsweredCount: o.AnsweredCount,
+		TotalAmount: o.TotalAmount, IsChanged: o.IsChanged,
+	}
+}
+
+// ToSupplierItem — строка кабинета §6.13 (без reason/product_id, DS-046).
+func ToSupplierItem(it *models.PurchaseOrderItem) dto.SupplierItem {
+	return dto.SupplierItem{
+		ID: it.ID, Name: it.Name, Sku: it.Sku, Unit: it.Unit, Qty: it.Qty,
+		SupplierQty: it.SupplierQty, SupplierPrice: it.SupplierPrice, SupplierNote: it.SupplierNote,
+		LineAmount: it.LineAmount, CustomerChanged: it.CustomerChanged, Version: it.Version,
+	}
+}
+
+// ToSupplierOrder — карточка кабинета §6.13.
+func ToSupplierOrder(o *models.PurchaseOrder, firmName, firmPhone string) *dto.SupplierOrder {
+	out := &dto.SupplierOrder{
+		ID: o.ID, NumberDisplay: constants.NumberDisplay(o.Number), Status: o.Status,
+		SentAt: utc(o.SentAt), Note: o.Note, NoteChanged: o.NoteChanged,
+		FirmName: firmName, FirmPhone: firmPhone, CanAnswer: o.Status == constants.StatusSent,
+		Items: make([]dto.SupplierItem, 0, len(o.Items)), TotalAmount: o.TotalAmount,
+	}
+	for i := range o.Items {
+		out.Items = append(out.Items, ToSupplierItem(&o.Items[i]))
+	}
+	return out
+}
+
+// ToSuggestion — строка дефицита §6.10; checked = false, если запчасть уже в открытом заказе
+// (DS-004, DS-049).
+func ToSuggestion(s *models.Suggestion) dto.Suggestion {
+	out := dto.Suggestion{
+		ProductID: s.ProductID, Name: s.Name, Sku: s.Sku, Unit: s.Unit, Stock: s.Stock,
+		MinStock: s.MinStock, Pending: s.Pending, ToOrder: s.ToOrder, Reason: s.Reason,
+		Tasks: []dto.SuggestionTask{}, InOpenOrders: []dto.OpenOrderRef{},
+		Checked: len(s.InOpenOrders) == 0,
+	}
+	if s.Reason == constants.ReasonForOrders {
+		for _, t := range s.Tasks {
+			out.Tasks = append(out.Tasks, dto.SuggestionTask{ID: t.ID, Title: t.Title})
+		}
+	}
+	for _, r := range s.InOpenOrders {
+		out.InOpenOrders = append(out.InOpenOrders, dto.OpenOrderRef{ID: r.ID, NumberDisplay: constants.NumberDisplay(r.Number), Qty: r.Qty})
+	}
+	return out
+}
diff --git a/internal/features/purchase-orders/models/dto/enums_test.go b/internal/features/purchase-orders/models/dto/enums_test.go
