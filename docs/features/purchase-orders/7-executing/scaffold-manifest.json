  "tests": {
    "e2e": [
      {
        "id": "TS-014",
        "title": "Полный круг закупки у поставщика — экраны §8.2, §8.3, §8.6, §8.7 — DS-011, DS-008",
        "source": "TS-014",
        "negative": "«Собрано» с пустой строкой → строка подсвечена, статус s:sent"
      },
      {
        "id": "TS-015",
        "title": "Базар — экраны §8.2, §8.3, §8.4 — DS-058",
        "source": "TS-015",
        "negative": "POST send через API → 409"
      },
      {
        "id": "TS-016",
        "title": "Правка отправленного заказа — экраны §8.3, §8.7 — DS-034, DS-048",
        "source": "TS-016",
        "negative": "мы правим после «Собрано» → тост «Поставщик уже собрал заказ — правка недоступна»"
      },
      {
        "id": "TS-017",
        "title": "Отозвать и отправить снова — экраны §8.3, §8.6 — DS-035",
        "source": "TS-017",
        "negative": "«Отозвать» после «Собрано» → тост «Поставщик уже собрал заказ — отозвать нельзя»"
      },
      {
        "id": "TS-018",
        "title": "Отмена с причиной — экраны §8.3, §8.6 — DS-036, DS-041",
        "source": "TS-018",
        "negative": "прямой URL /supplier/orders/:id → «Заказ не найден»"
      },
      {
        "id": "TS-019",
        "title": "Подсказка «уже в открытом заказе» — экран §8.2 — DS-004, DS-049",
        "source": "TS-019",
        "negative": "запчасть только в черновике → подсказки нет, галочка стоит"
      },
      {
        "id": "TS-020",
        "title": "Поставщик заперт в кабинете — экраны §8.6, §8.7 — DS-017, DS-018",
        "source": "TS-020",
        "negative": "чужой заказ по URL → «Заказ не найден»"
      },
      {
        "id": "TS-021",
        "title": "Кабинет на телефоне — экран §8.7, вьюпорты 360×640 / 768 / 1280, светлая и тёмная темы — DS-031",
        "source": "TS-021",
        "negative": "длинное название запчасти не ломает вёрстку"
      },
      {
        "id": "TS-022",
        "title": "Экраны «Закупки» на узком экране — §8.1–§8.3, один вьюпорт ~360px — DS-031",
        "source": "TS-022",
        "negative": "длинное имя поставщика не выталкивает кнопки за край"
      },
      {
        "id": "TS-023",
        "title": "Учётка поставщика — экран §8.5 — DS-025, DS-044",
        "source": "TS-023",
        "negative": "executor открывает /users → 403-страница"
      },
      {
        "id": "TS-024",
        "title": "Executor видит только свои заказы — экраны §8.1, §8.3, §8.2 — DS-051, DS-060, DS-078",
        "source": "TS-024",
        "negative": "прямой POST cancel чужого → 404"
      },
      {
        "id": "TS-025",
        "title": "Архив поставщика с открытым заказом — существующий экран «Поставщики» — DS-043",
        "source": "TS-025",
        "negative": "после «Забрали» — архив проходит"
      },
      {
        "id": "TS-026",
        "title": "Удаление и восстановление черновика — экраны §8.3 и «Удалённые» — DS-037, DS-072",
        "source": "TS-026",
        "negative": "у отправленного заказа кнопки «Удалить» нет, API → 409"
      }
    ],
    "fixtures": [
      "Сид e2e (e2e/fixtures + Go-сид live-тестов): поставщик «АвтоДеталь Плюс» с активной учёткой supplier",
      "Заказы-закупки в каждом статусе (draft / sent с частичным ответом / ready / picked_up / cancelled / ",
      "Существующие хелперы входа e2e: добавить роль supplier; payload'ы хелперов типизировать wire-типами ",
      "Существующие live-тесты, создающие пользователей (internal/features/users/_live_test.go), и проверки"
    ]
  },
