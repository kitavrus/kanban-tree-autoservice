+    await ep.goto(`assignee=${exec.id}`);
+    await expect(ep.row(sub)).toBeVisible();
+    await expect
+      .poll(() => page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth))
+      .toBeLessThanOrEqual(0);
+  });
+});
