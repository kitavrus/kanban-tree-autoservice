diff --git a/web/ssr/executorpayouts/templates/pages/list.html b/web/ssr/executorpayouts/templates/pages/list.html
new file mode 100644
index 0000000..9d5cc40
--- /dev/null
+++ b/web/ssr/executorpayouts/templates/pages/list.html
@@ -0,0 +1,43 @@
+{{ define "content" }}
+<div id="ep" data-testid="ep-root" data-is-admin="{{ if .IsAdmin }}true{{ else }}false{{ end }}">
+  <div class="d-flex flex-wrap align-items-center gap-2 mb-3" data-testid="ep-filters">
+    <select class="form-select form-select-sm" id="ep-filter-assignee" data-testid="ep-filter-assignee" style="max-width:220px" aria-label="Исполнитель">
+      <option value="all">Все исполнители</option>
+      <option value="me">Мои</option>
+    </select>
+    <select class="form-select form-select-sm" id="ep-filter-status" data-testid="ep-filter-status" style="max-width:190px" aria-label="Статус выплаты">
+      <option value="all">Выплата: все</option>
+      <option value="unpaid">Не выплачено</option>
+      <option value="paid">Выплачено</option>
+    </select>
+    <div class="form-check mb-0">
+      <input type="checkbox" class="form-check-input" id="ep-filter-only-done" data-testid="ep-filter-only-done">
+      <label class="form-check-label small" for="ep-filter-only-done">Только выполненные</label>
+    </div>
+    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
+      <span class="small text-body-secondary" id="ep-selected-count" data-testid="ep-selected-count">Выбрано: 0</span>
+      <button type="button" class="btn btn-primary btn-sm" id="ep-mark-paid" data-testid="ep-mark-paid" disabled>Отметить выплаченными</button>
+      <button type="button" class="btn btn-outline-secondary btn-sm" id="ep-mark-unpaid" data-testid="ep-mark-unpaid" disabled>Снять отметку</button>
+    </div>
+  </div>
+
+  <div class="alert alert-danger d-none" id="ep-error" data-testid="ep-error" role="alert"></div>
+  <div class="alert alert-secondary d-none" id="ep-info" data-testid="ep-info" role="status"></div>
+
+  <div class="card mb-3">
+    <div class="card-body py-2 d-flex flex-wrap gap-4">
+      <div>К выплате: <strong id="ep-total-to-pay" data-testid="ep-total-to-pay">0.00</strong></div>
+      <div>Выплачено: <strong id="ep-total-paid" data-testid="ep-total-paid">0.00</strong></div>
+    </div>
+  </div>
+
+  <div id="ep-groups" data-testid="ep-groups"></div>
