+
+type subtaskFx struct {
+	status   string
+	assignee string // "" — без исполнителя
+	price    string // "" — по факту
+	payout   string // "" — не задана
+	paid     bool
+	position int
+}
+
+func nullable(v string) *string {
+	if v == "" {
+		return nil
+	}
+	return &v
+}
