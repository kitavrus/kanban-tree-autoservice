+func (s *ExecutorPayoutsLiveSuite) fields(body []byte) map[string]string {
+	e := s.errOf(body)
+	s.Require().NotNil(e.Details, string(body))
+	m := map[string]string{}
+	for _, f := range e.Details.Fields {
+		m[f.Name] = f.Message
+	}
+	return m
