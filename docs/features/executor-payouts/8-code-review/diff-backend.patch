+	s.Equal([]int64{unpaidTask, mixedTask}, payoutKeys(s.payoutBoard(base+"&executor_paid=unpaid")))
+	s.Equal([]int64{paidTask}, payoutKeys(s.payoutBoard(base+"&executor_paid=paid")))
