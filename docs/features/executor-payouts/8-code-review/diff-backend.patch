+package executorpayouts
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Handler — JSON API /api/v1/executor-payouts: доступно и admin, и executor (D62).
+type Handler struct {
+	svc *Service
+}
+
+func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }
+
+func actorOf(c fiber.Ctx) Actor {
+	p := middleware.CurrentPrincipal(c)
+	return Actor{ID: p.ID, IsAdmin: p.IsAdmin()}
+}
+
+func listQuery(c fiber.Ctx) ListQuery {
+	return ListQuery{
+		Assignee: c.Query("assignee"), Status: c.Query("status"), OnlyDone: c.Query("only_done"),
+		Limit: c.Query("limit"), Offset: c.Query("offset"),
+	}
+}
+
+// List — GET /api/v1/executor-payouts?assignee=&status=&only_done=&limit=&offset=.
+func (h *Handler) List(c fiber.Ctx) error {
+	resp, err := h.svc.List(c.Context(), actorOf(c), listQuery(c))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Summary — GET /api/v1/executor-payouts/summary (те же фильтры).
+func (h *Handler) Summary(c fiber.Ctx) error {
+	resp, err := h.svc.Summary(c.Context(), actorOf(c), listQuery(c))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Mark — POST /api/v1/executor-payouts/mark.
+func (h *Handler) Mark(c fiber.Ctx) error {
+	var req MarkRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Mark(c.Context(), req)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// UpdatePayout — PUT /api/v1/executor-payouts/:id (id — uuid услуги).
+func (h *Handler) UpdatePayout(c fiber.Ctx) error {
+	var req PayoutUpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.UpdatePayout(c.Context(), c.Params("id"), req)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
diff --git a/internal/features/executorpayouts/migration_integration_test.go b/internal/features/executorpayouts/migration_integration_test.go
new file mode 100644
index 0000000..58f6685
--- /dev/null
+++ b/internal/features/executorpayouts/migration_integration_test.go
@@ -0,0 +1,153 @@
+//go:build integration
+
+package executorpayouts_test
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// ExecutorPayoutsMigrationSuite — TS-018: миграция 0011 (docs/plan.md D63). На 0010
+// заводится услуга заказа; up → у неё is_executor_paid=false, дата и сумма NULL, CHECK
+// суммы ≥ 0 и частичный индекс на месте; down → колонки и индекс сняты, услуга цела.
+type ExecutorPayoutsMigrationSuite struct {
+	testutil.BaseSuite
+}
+
+func TestExecutorPayoutsMigrationSuite(t *testing.T) {
+	suite.Run(t, new(ExecutorPayoutsMigrationSuite))
+}
+
+const (
+	epmAdminID  = "aaaaaaaa-0011-4011-8011-000000000001"
+	epmClientID = "bbbbbbbb-0011-4011-8011-000000000001"
+)
+
+var epmColumns = []string{"is_executor_paid", "executor_paid_at", "executor_payout"}
+
+func migrationsURL() string {
+	_, f, _, _ := runtime.Caller(0)
+	return "file://" + filepath.Join(filepath.Dir(f), "..", "..", "..", "migrations")
+}
+
+func (s *ExecutorPayoutsMigrationSuite) columnExists(column string) bool {
+	var ok bool
+	s.Require().NoError(s.Pool.QueryRow(context.Background(), `
+		SELECT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'subtasks' AND column_name = $1)`,
+		column).Scan(&ok))
+	return ok
+}
+
+func (s *ExecutorPayoutsMigrationSuite) indexExists(name string) bool {
+	var ok bool
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT EXISTS (SELECT 1 FROM pg_indexes WHERE tablename = 'subtasks' AND indexname = $1)`, name).Scan(&ok))
+	return ok
+}
+
+func (s *ExecutorPayoutsMigrationSuite) TestTS018_UpAddsPayoutColumns_DownDropsThem() {
+	ctx := context.Background()
+	mig, err := migrate.New(migrationsURL(), s.DSN)
+	s.Require().NoError(err)
+	defer func() { _, _ = mig.Close() }()
+
+	s.Require().NoError(mig.Migrate(10))
+	defer func() {
+		// вернуть схему на последнюю версию при любом исходе (на ней уже — ErrNoChange).
+		if err := mig.Up(); err != nil && !errors.Is(err, migrate.ErrNoChange) {
+			s.Require().NoError(err)
+		}
+	}()
+	for _, c := range epmColumns {
+		s.False(s.columnExists(c), "на 0010 колонки subtasks.%s ещё нет", c)
+	}
+
+	// --- данные «до выплат» (схема 0010) ---
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (id, login, password_hash, name, role) VALUES ($1, 'epm-admin', 'x', 'Admin', 'admin')`, epmAdminID)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO clients (id, company_name) VALUES ($1, 'EPM Co')`, epmClientID)
+	s.Require().NoError(err)
+	var columnID, svcCat, serviceID, subtaskID string
+	var taskID int64
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT id::text FROM columns ORDER BY position, id LIMIT 1`).Scan(&columnID))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO catalog_categories (kind, name) VALUES ('service', 'EPM S') RETURNING id`).Scan(&svcCat))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO services (category_id, name) VALUES ($1, 'EPM услуга') RETURNING id`, svcCat).Scan(&serviceID))
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO tasks (column_id, client_id, title, position, created_by) VALUES ($1, $2, 'EPM', 1024, $3) RETURNING id`,
+		columnID, epmClientID, epmAdminID).Scan(&taskID))
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO subtasks (task_id, service_id, status, assignee_id, price) VALUES ($1, $2, 'done', $3, 1500) RETURNING id`,
+		taskID, serviceID, epmAdminID).Scan(&subtaskID))
+
+	// --- up 0011 ---
+	s.Require().NoError(mig.Migrate(11))
+	for _, c := range epmColumns {
+		s.True(s.columnExists(c), "subtasks.%s добавлена", c)
+	}
+	s.True(s.indexExists("subtasks_executor_unpaid_idx"))
+
+	var paid bool
+	var paidAt, payout *string
+	var price string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`SELECT is_executor_paid, executor_paid_at::text, executor_payout::text, price::text FROM subtasks WHERE id = $1`, subtaskID).
+		Scan(&paid, &paidAt, &payout, &price))
+	s.False(paid, "существующая услуга — не выплачена (DEFAULT false)")
+	s.Nil(paidAt)
+	s.Nil(payout)
+	s.Equal("1500.00", price, "цена для клиента не тронута")
+
+	// NOT NULL флага; сумма — NUMERIC(12,2) ≥ 0, NULL допустим.
+	_, err = s.Pool.Exec(ctx, `UPDATE subtasks SET is_executor_paid = NULL WHERE id = $1`, subtaskID)
+	s.Error(err, "is_executor_paid NOT NULL")
+	_, err = s.Pool.Exec(ctx, `UPDATE subtasks SET executor_payout = -0.01 WHERE id = $1`, subtaskID)
+	s.Error(err, "CHECK executor_payout >= 0")
+	_, err = s.Pool.Exec(ctx, `UPDATE subtasks SET executor_payout = 10000000000 WHERE id = $1`, subtaskID)
+	s.Error(err, "NUMERIC(12,2): 10 цифр целой части")
+	_, err = s.Pool.Exec(ctx,
+		`UPDATE subtasks SET is_executor_paid = true, executor_paid_at = now(), executor_payout = 1234.567 WHERE id = $1`, subtaskID)
+	s.Require().NoError(err)
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT executor_payout::text FROM subtasks WHERE id = $1`, subtaskID).Scan(&payout))
+	s.Equal("1234.57", *payout, "масштаб 2 знака")
+	_, err = s.Pool.Exec(ctx, `UPDATE subtasks SET executor_payout = 0 WHERE id = $1`, subtaskID)
+	s.Require().NoError(err, "0 — допустимая сумма")
+
+	// удаление сотрудника не упирается в выплаченную услугу (assignee_id ON DELETE SET NULL, D63).
+	var tmpUser string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO users (login, password_hash, name, role) VALUES ('epm-exec', 'x', 'Exec', 'executor') RETURNING id`).Scan(&tmpUser))
+	_, err = s.Pool.Exec(ctx, `UPDATE subtasks SET assignee_id = $2 WHERE id = $1`, subtaskID, tmpUser)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `DELETE FROM users WHERE id = $1`, tmpUser)
+	s.Require().NoError(err)
+	var assignee *string
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT assignee_id::text, is_executor_paid FROM subtasks WHERE id = $1`, subtaskID).Scan(&assignee, &paid))
+	s.Nil(assignee)
+	s.True(paid)
+
+	// --- down → 0010 ---
+	s.Require().NoError(mig.Migrate(10))
+	for _, c := range epmColumns {
+		s.False(s.columnExists(c), "subtasks.%s снята", c)
+	}
+	s.False(s.indexExists("subtasks_executor_unpaid_idx"))
+	var status string
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT status, price::text FROM subtasks WHERE id = $1`, subtaskID).Scan(&status, &price))
+	s.Equal("done", status, "услуга пережила откат")
+	s.Equal("1500.00", price)
+
+	// --- повторный up: миграция накатывается заново поверх данных ---
+	s.Require().NoError(mig.Migrate(11))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT is_executor_paid FROM subtasks WHERE id = $1`, subtaskID).Scan(&paid))
+	s.False(paid, "после down/up отметки сброшены")
+}
diff --git a/internal/features/executorpayouts/repo.go b/internal/features/executorpayouts/repo.go
new file mode 100644
index 0000000..12acc88
--- /dev/null
+++ b/internal/features/executorpayouts/repo.go
@@ -0,0 +1,244 @@
+package executorpayouts
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+// fieldsError — ошибки полей, найденные под транзакцией (услуга не найдена / без
+// исполнителя); сервис превращает их в 400 VALIDATION.
+type fieldsError struct{ Fields []errorspkg.Field }
+
+func (e *fieldsError) Error() string { return "executorpayouts: invalid fields" }
+
+// errNotFound — услуги нет либо она без исполнителя (не элемент отчёта).
+var errNotFound = errors.New("executorpayouts: not found")
+
+type Repo struct {
+	pool *pgxpool.Pool
+}
+
+func NewRepo(pool *pgxpool.Pool) *Repo { return &Repo{pool: pool} }
+
+// payoutWhereSQL — общий фильтр списка и итогов: только услуги с исполнителем (JOIN users),
+// $1 — исполнитель, $2 — статус выплаты, $3 — только выполненные.
+const payoutWhereSQL = `
+WHERE ($1::uuid IS NULL OR s.assignee_id = $1)
+  AND ($2::boolean IS NULL OR s.is_executor_paid = $2)
+  AND (NOT $3::boolean OR s.status = 'done')`
+
+// List — услуги с исполнителем под фильтром; total — отдельным count (не зависит от
+// limit/offset, в т.ч. на странице за пределами выдачи).
+func (r *Repo) List(ctx context.Context, f Filter) ([]PayoutItem, int, error) {
+	var total int
+	if err := r.pool.QueryRow(ctx, `
+SELECT count(*) FROM subtasks s JOIN users u ON u.id = s.assignee_id`+payoutWhereSQL,
+		f.AssigneeID, f.Paid, f.OnlyDone).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+
+	rows, err := r.pool.Query(ctx, payoutItemSelectSQL+payoutWhereSQL+`
+ORDER BY u.name, u.id, s.task_id, s.position, s.id
+LIMIT $4 OFFSET $5`, f.AssigneeID, f.Paid, f.OnlyDone, f.Limit, f.Offset)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+
+	out := []PayoutItem{}
+	for rows.Next() {
+		it, err := scanPayoutItem(rows)
+		if err != nil {
+			return nil, 0, err
+		}
+		out = append(out, it)
+	}
+	return out, total, rows.Err()
+}
+
+// payoutItemSelectSQL — строка отчёта: услуга с исполнителем (JOIN users отсекает услуги
+// без исполнителя) + заказ/клиент/услуга каталога.
+const payoutItemSelectSQL = `
+SELECT s.id::text, s.task_id, t.title, cl.company_name, sv.name, s.status, u.id::text, u.name,
+       s.price::text, s.executor_payout::text, s.is_executor_paid, s.executor_paid_at
+FROM subtasks s
+JOIN users u     ON u.id = s.assignee_id
+JOIN tasks t     ON t.id = s.task_id
+JOIN clients cl  ON cl.id = t.client_id
+JOIN services sv ON sv.id = s.service_id`
+
+func scanPayoutItem(row pgx.Row) (PayoutItem, error) {
+	var it PayoutItem
+	var price, payout sql.NullString
+	if err := row.Scan(&it.SubtaskID, &it.TaskID, &it.TaskTitle, &it.ClientName, &it.ServiceName, &it.Status,
+		&it.AssigneeID, &it.AssigneeName, &price, &payout, &it.IsExecutorPaid, &it.ExecutorPaidAt); err != nil {
+		return it, err
+	}
+	if price.Valid {
+		v := numeric.Amount(price.String)
+		it.Price = &v
+	}
+	if payout.Valid {
+		v := numeric.Amount(payout.String)
+		it.ExecutorPayout = &v
+	}
+	return it, nil
+}
+
+// UpdatePayout — правка ТОЛЬКО суммы выплаты услуги (D72); payout nil → NULL. Lock Order
+// как у Mark и board (tasks → subtasks): заказ услуги FOR UPDATE, затем сама услуга. Услуги
+// нет или она без исполнителя (не элемент отчёта) → errNotFound, ничего не меняется.
+// Возвращает строку отчёта, прочитанную в той же транзакции после записи.
+func (r *Repo) UpdatePayout(ctx context.Context, id string, payout *string) (*PayoutItem, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+
+	if _, err := tx.Exec(ctx, `
+SELECT t.id FROM tasks t
+WHERE t.id = (SELECT s.task_id FROM subtasks s WHERE s.id = $1::uuid) FOR UPDATE`, id); err != nil {
+		return nil, err
+	}
+	var hasAssignee bool
+	err = tx.QueryRow(ctx, `SELECT s.assignee_id IS NOT NULL FROM subtasks s WHERE s.id = $1::uuid FOR UPDATE`, id).Scan(&hasAssignee)
+	if errors.Is(err, pgx.ErrNoRows) || (err == nil && !hasAssignee) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	if _, err := tx.Exec(ctx, `
+UPDATE subtasks SET executor_payout = $2::numeric, updated_at = now() WHERE id = $1::uuid`, id, payout); err != nil {
+		return nil, err
+	}
+	it, err := scanPayoutItem(tx.QueryRow(ctx, payoutItemSelectSQL+` WHERE s.id = $1::uuid`, id))
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return &it, nil
+}
+
+// Summary — итоги по исполнителям под тем же фильтром. Сумма без заданной выплаты — 0
+// (COALESCE, D64); Go десятичной арифметики не делает — считает SQL.
+func (r *Repo) Summary(ctx context.Context, f Filter) ([]PayoutSummaryItem, int, error) {
+	var total int
+	if err := r.pool.QueryRow(ctx, `
+SELECT count(DISTINCT s.assignee_id) FROM subtasks s JOIN users u ON u.id = s.assignee_id`+payoutWhereSQL,
+		f.AssigneeID, f.Paid, f.OnlyDone).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+
+	rows, err := r.pool.Query(ctx, `
+SELECT u.id::text, u.name,
+       (count(*) FILTER (WHERE NOT s.is_executor_paid))::int,
+       (count(*) FILTER (WHERE s.is_executor_paid))::int,
+       round(coalesce(sum(coalesce(s.executor_payout, 0)) FILTER (WHERE NOT s.is_executor_paid), 0), 2)::text,
+       round(coalesce(sum(coalesce(s.executor_payout, 0)) FILTER (WHERE s.is_executor_paid), 0), 2)::text
+FROM subtasks s
+JOIN users u ON u.id = s.assignee_id`+payoutWhereSQL+`
+GROUP BY u.id, u.name
+ORDER BY u.name, u.id
+LIMIT $4 OFFSET $5`, f.AssigneeID, f.Paid, f.OnlyDone, f.Limit, f.Offset)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+
+	out := []PayoutSummaryItem{}
+	for rows.Next() {
+		var it PayoutSummaryItem
+		var toPay, paid string
+		if err := rows.Scan(&it.AssigneeID, &it.AssigneeName, &it.UnpaidCount, &it.PaidCount, &toPay, &paid); err != nil {
+			return nil, 0, err
+		}
+		it.ToPay, it.Paid = numeric.Amount(toPay), numeric.Amount(paid)
+		out = append(out, it)
+	}
+	return out, total, rows.Err()
+}
+
+// Mark — массовая отметка/снятие выплаты, атомарно (D70): одна транзакция, любая ошибка
+// по любой услуге откатывает всё. Lock Order согласован с board (tasks → subtasks):
+// сначала заказы затронутых услуг по возрастанию id, затем сами услуги по id.
+// Найденные под блокировкой проблемы — *fieldsError по индексам ids: услуги нет →
+// not_found; отметка true у услуги без исполнителя → no_assignee (снять отметку можно и без
+// исполнителя). executor_paid_at — now() при переходе false→true, NULL при снятии; услуги,
+// уже стоящие в нужном состоянии, не трогаются (дата прежней отметки сохраняется).
+func (r *Repo) Mark(ctx context.Context, ids []string, paid bool) (int, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return 0, err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+
+	if _, err := tx.Exec(ctx, `
+SELECT t.id FROM tasks t
+WHERE t.id IN (SELECT s.task_id FROM subtasks s WHERE s.id = ANY($1::text[]::uuid[]))
+ORDER BY t.id FOR UPDATE`, ids); err != nil {
+		return 0, err
+	}
+
+	rows, err := tx.Query(ctx, `
+SELECT s.id::text, s.assignee_id IS NOT NULL FROM subtasks s
+WHERE s.id = ANY($1::text[]::uuid[]) ORDER BY s.id FOR UPDATE`, ids)
+	if err != nil {
+		return 0, err
+	}
+	hasAssignee := make(map[string]bool, len(ids))
+	for rows.Next() {
+		var id string
+		var ok bool
+		if err := rows.Scan(&id, &ok); err != nil {
+			rows.Close()
+			return 0, err
+		}
+		hasAssignee[id] = ok
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return 0, err
+	}
+
+	var fields []errorspkg.Field
+	for i, id := range ids {
+		assigned, found := hasAssignee[id]
+		switch {
+		case !found:
+			fields = append(fields, errorspkg.Field{Name: fmt.Sprintf("subtask_ids[%d]", i), Message: msgNotFound})
+		case paid && !assigned:
+			fields = append(fields, errorspkg.Field{Name: fmt.Sprintf("subtask_ids[%d]", i), Message: msgNoAssignee})
+		}
+	}
+	if len(fields) > 0 {
+		return 0, &fieldsError{Fields: fields}
+	}
+
+	tag, err := tx.Exec(ctx, `
+UPDATE subtasks SET is_executor_paid = $2,
+       executor_paid_at = CASE WHEN $2 THEN now() ELSE NULL END, updated_at = now()
+WHERE id = ANY($1::text[]::uuid[]) AND is_executor_paid <> $2`, ids, paid)
+	if err != nil {
+		return 0, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return 0, err
+	}
+	return int(tag.RowsAffected()), nil
+}
