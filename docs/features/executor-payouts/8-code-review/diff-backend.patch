+package executorpayouts
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+)
+
+// Root — шаблоны экрана «Выплаты» относительно корня модуля.
+const Root = "web/ssr/executorpayouts/templates"
+
+// SSR — экран-отчёт «Выплаты» (D69): группы «исполнитель → его услуги», итоги и массовую
+// отметку рисует js/executor-payouts.js поверх JSON API (как «Остатки»/«Перемещения»).
+type SSR struct {
+	r     *ssr.Renderer
+	shell ssr.ShellBuilder
+}
+
+func NewSSR(r *ssr.Renderer, shell ssr.ShellBuilder) *SSR {
+	return &SSR{r: r, shell: shell}
+}
+
+// PageVM — оболочка + роль: executor по умолчанию видит «мои» услуги, admin — все.
+type PageVM struct {
+	Shell   ssr.Shell
+	IsAdmin bool
+}
+
+// page — GET /executor-payouts.
+func (h *SSR) page(c fiber.Ctx) error {
+	sh := h.shell.Build(c, "Выплаты")
+	return h.r.Page(c, "list", PageVM{Shell: sh, IsAdmin: sh.IsAdmin})
+}
diff --git a/internal/features/executorpayouts/validate.go b/internal/features/executorpayouts/validate.go
new file mode 100644
index 0000000..4956816
--- /dev/null
+++ b/internal/features/executorpayouts/validate.go
@@ -0,0 +1,201 @@
+package executorpayouts
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+// payoutScale — NUMERIC(12,2) колонки subtasks.executor_payout: те же границы, что у
+// executor_payout в PUT /subtasks/:id (board).
+var payoutScale = numeric.Scale{IntDigits: 10, FracDigits: 2}
+
+// Коды ошибок полей (details.fields[].message) — клиент переводит их в текст.
+const (
+	msgRequired  = "required"
+	msgInvalid   = "invalid"
+	msgTooMany   = "too_many"
+	msgDuplicate = "duplicate"
+	msgNotFound  = "not_found"
+	// msgNoAssignee — отметить выплату можно только у услуги с исполнителем (D65).
+	msgNoAssignee = "no_assignee"
+)
+
+// Значения query-фильтров (те же слова, что у фильтров доски: paid=all|paid|unpaid,
+// assignee=me|all|<uuid>).
+const (
+	StatusAll    = "all"
+	StatusPaid   = "paid"
+	StatusUnpaid = "unpaid"
+
+	AssigneeMe  = "me"
+	AssigneeAll = "all"
+)
+
+var Statuses = []string{StatusAll, StatusPaid, StatusUnpaid}
+
+const (
+	defaultLimit = 200
+	maxLimit     = 1000
+	// markMax — верхняя граница subtask_ids одного запроса массовой отметки.
+	markMax = 500
+)
+
+// Actor — вызывающий пользователь: нужен для дефолта фильтра assignee по роли (D69).
+type Actor struct {
+	ID      string
+	IsAdmin bool
+}
+
+// ListQuery — сырые query-параметры GET /executor-payouts и /executor-payouts/summary.
+type ListQuery struct {
+	Assignee, Status, OnlyDone, Limit, Offset string
+}
+
+// Filter — разобранные фильтры. AssigneeID nil — все исполнители; Paid nil — любой статус
+// выплаты.
+type Filter struct {
+	AssigneeID *string
+	Paid       *bool
+	OnlyDone   bool
+	Limit      int
+	Offset     int
+}
+
+// parseFilter — разбор и валидация query (мусор → 400 по полю, не тихий clamp). assignee
+// отсутствует → executor видит «мои», admin — все (D69, аналог D19 доски).
+func parseFilter(q ListQuery, a Actor) (Filter, error) {
+	var f Filter
+	var fields []errorspkg.Field
+	add := func(name string) { fields = append(fields, errorspkg.Field{Name: name, Message: msgInvalid}) }
+
+	assignee := strings.TrimSpace(q.Assignee)
+	switch {
+	case assignee == "":
+		if !a.IsAdmin {
+			id := a.ID
+			f.AssigneeID = &id
+		}
+	case assignee == AssigneeMe:
+		id := a.ID
+		f.AssigneeID = &id
+	case assignee == AssigneeAll:
+		f.AssigneeID = nil
+	case uuid.Validate(assignee) == nil:
+		f.AssigneeID = &assignee
+	default:
+		add("assignee")
+	}
+
+	switch q.Status {
+	case "", StatusAll:
+		f.Paid = nil
+	case StatusPaid:
+		v := true
+		f.Paid = &v
+	case StatusUnpaid:
+		v := false
+		f.Paid = &v
+	default:
+		add("status")
+	}
+
+	switch q.OnlyDone {
+	case "", "false":
+		f.OnlyDone = false
+	case "true":
+		f.OnlyDone = true
+	default:
+		add("only_done")
+	}
+
+	f.Limit = defaultLimit
+	if q.Limit != "" {
+		n, err := strconv.Atoi(q.Limit)
+		if err != nil || n < 1 || n > maxLimit {
+			add("limit")
+		} else {
+			f.Limit = n
+		}
+	}
+	if q.Offset != "" {
+		n, err := strconv.Atoi(q.Offset)
+		if err != nil || n < 0 {
+			add("offset")
+		} else {
+			f.Offset = n
+		}
+	}
+
+	if len(fields) > 0 {
+		return Filter{}, errorspkg.Validation(fields...)
+	}
+	return f, nil
+}
+
+// normalize — trim + канонический вид uuid (нижний регистр, с дефисами): Postgres отдаёт
+// uuid именно так, а сверка найденных строк с запрошенными и поиск дублей идут по строке.
+// Не-uuid остаётся как есть — его отсеет validate().
+func (in MarkRequest) normalize() MarkRequest {
+	ids := make([]string, len(in.SubtaskIDs))
+	for i, id := range in.SubtaskIDs {
+		id = strings.TrimSpace(id)
+		if u, err := uuid.Parse(id); err == nil {
+			id = u.String()
+		}
+		ids[i] = id
+	}
+	in.SubtaskIDs = ids
+	return in
+}
+
+// validate — формат тела после normalize(); существование услуг и наличие исполнителя —
+// под транзакцией (repo.Mark).
+func (in MarkRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	switch {
+	case len(in.SubtaskIDs) == 0:
+		add("subtask_ids", msgRequired)
+	case len(in.SubtaskIDs) > markMax:
+		add("subtask_ids", msgTooMany)
+	default:
+		seen := make(map[string]bool, len(in.SubtaskIDs))
+		for i, id := range in.SubtaskIDs {
+			name := fmt.Sprintf("subtask_ids[%d]", i)
+			switch {
+			case id == "":
+				add(name, msgRequired)
+			case uuid.Validate(id) != nil:
+				add(name, msgInvalid)
+			case seen[id]:
+				add(name, msgDuplicate)
+			}
+			seen[id] = true
+		}
+	}
+	if in.IsExecutorPaid == nil {
+		add("is_executor_paid", msgRequired)
+	}
+	return f
+}
+
+// validate — executor_payout обязателен (поля нет → required); null допустим (очистить);
+// число — NUMERIC(12,2) ≥ 0 (коды pkg/numeric: invalid_format / too_precise / too_large / …).
+func (in PayoutUpdateRequest) validate() []errorspkg.Field {
+	if !in.ExecutorPayout.Set {
+		return []errorspkg.Field{{Name: "executor_payout", Message: msgRequired}}
+	}
+	if in.ExecutorPayout.Value != nil {
+		if code := in.ExecutorPayout.Value.Validate(payoutScale, false); code != "" {
+			return []errorspkg.Field{{Name: "executor_payout", Message: code}}
+		}
+	}
+	return nil
+}
diff --git a/internal/features/executorpayouts/validate_test.go b/internal/features/executorpayouts/validate_test.go
new file mode 100644
index 0000000..053461e
--- /dev/null
+++ b/internal/features/executorpayouts/validate_test.go
@@ -0,0 +1,210 @@
+package executorpayouts
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+// Юнит-тесты отчёта «Выплаты» (TS-020): разбор фильтров и валидация тела массовой отметки.
+
+const (
+	idA = "11111111-1111-1111-1111-111111111111"
+	idB = "22222222-2222-2222-2222-222222222222"
+)
+
+var (
+	adminActor    = Actor{ID: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", IsAdmin: true}
+	executorActor = Actor{ID: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", IsAdmin: false}
+)
+
+func fieldMap(f []errorspkg.Field) map[string]string {
+	m := map[string]string{}
+	for _, x := range f {
+		if _, ok := m[x.Name]; !ok {
+			m[x.Name] = x.Message
+		}
+	}
+	return m
+}
+
+func validationFields(t *testing.T, err error) map[string]string {
+	t.Helper()
+	var ae *errorspkg.AppError
+	require.True(t, errors.As(err, &ae), "ожидалась *errorspkg.AppError, получено %v", err)
+	assert.Equal(t, "VALIDATION", ae.Code)
+	return fieldMap(ae.Fields)
+}
+
+func boolPtr(v bool) *bool { return &v }
+
+// TS-020/TS-012: без assignee — executor видит «мои», admin — все (D69).
+func TestTS020_ParseFilter_DefaultsByRole(t *testing.T) {
+	f, err := parseFilter(ListQuery{}, executorActor)
+	require.NoError(t, err)
+	require.NotNil(t, f.AssigneeID)
+	assert.Equal(t, executorActor.ID, *f.AssigneeID)
+	assert.Nil(t, f.Paid)
+	assert.False(t, f.OnlyDone)
+	assert.Equal(t, defaultLimit, f.Limit)
+	assert.Equal(t, 0, f.Offset)
+
+	f, err = parseFilter(ListQuery{}, adminActor)
+	require.NoError(t, err)
+	assert.Nil(t, f.AssigneeID)
+}
+
+// TS-020/TS-012: assignee=me|all|<uuid> — явное значение сильнее роли.
+func TestTS020_ParseFilter_Assignee(t *testing.T) {
+	f, err := parseFilter(ListQuery{Assignee: AssigneeAll}, executorActor)
+	require.NoError(t, err)
+	assert.Nil(t, f.AssigneeID, "executor может смотреть всех")
+
+	f, err = parseFilter(ListQuery{Assignee: AssigneeMe}, adminActor)
+	require.NoError(t, err)
+	require.NotNil(t, f.AssigneeID)
+	assert.Equal(t, adminActor.ID, *f.AssigneeID)
+
+	f, err = parseFilter(ListQuery{Assignee: " " + idA + " "}, adminActor)
+	require.NoError(t, err)
+	require.NotNil(t, f.AssigneeID)
+	assert.Equal(t, idA, *f.AssigneeID)
+}
+
+// TS-020/TS-012: status и only_done.
+func TestTS020_ParseFilter_StatusAndOnlyDone(t *testing.T) {
+	f, err := parseFilter(ListQuery{Status: StatusPaid, OnlyDone: "true"}, adminActor)
+	require.NoError(t, err)
+	require.NotNil(t, f.Paid)
+	assert.True(t, *f.Paid)
+	assert.True(t, f.OnlyDone)
+
+	f, err = parseFilter(ListQuery{Status: StatusUnpaid, OnlyDone: "false"}, adminActor)
+	require.NoError(t, err)
+	require.NotNil(t, f.Paid)
+	assert.False(t, *f.Paid)
+	assert.False(t, f.OnlyDone)
+
+	f, err = parseFilter(ListQuery{Status: StatusAll}, adminActor)
+	require.NoError(t, err)
+	assert.Nil(t, f.Paid)
+}
+
+// TS-020/TS-012: мусор в любом параметре → VALIDATION по полю (все поля разом).
+func TestTS020_ParseFilter_Invalid(t *testing.T) {
+	_, err := parseFilter(ListQuery{Assignee: "nobody", Status: "done", OnlyDone: "1", Limit: "0", Offset: "-1"}, adminActor)
+	got := validationFields(t, err)
+	for _, name := range []string{"assignee", "status", "only_done", "limit", "offset"} {
+		assert.Equal(t, msgInvalid, got[name], name)
+	}
+
+	_, err = parseFilter(ListQuery{Limit: fmt.Sprint(maxLimit + 1)}, adminActor)
+	assert.Equal(t, msgInvalid, validationFields(t, err)["limit"])
+	_, err = parseFilter(ListQuery{Limit: "abc"}, adminActor)
+	assert.Equal(t, msgInvalid, validationFields(t, err)["limit"])
+
+	f, err := parseFilter(ListQuery{Limit: fmt.Sprint(maxLimit), Offset: "7"}, adminActor)
+	require.NoError(t, err)
+	assert.Equal(t, maxLimit, f.Limit)
+	assert.Equal(t, 7, f.Offset)
+}
+
+// TS-020/TS-016: валидное тело; uuid приводится к каноническому виду (trim + lower).
+func TestTS020_MarkRequestValidate_OK(t *testing.T) {
+	in := MarkRequest{SubtaskIDs: []string{" " + strings.ToUpper(idA) + " ", idB}, IsExecutorPaid: boolPtr(false)}.normalize()
+	assert.Empty(t, in.validate())
+	assert.Equal(t, []string{idA, idB}, in.SubtaskIDs)
+}
+
+// TS-020/TS-016: пустой список / нет флага.
+func TestTS020_MarkRequestValidate_Required(t *testing.T) {
+	got := fieldMap(MarkRequest{}.normalize().validate())
+	assert.Equal(t, msgRequired, got["subtask_ids"])
+	assert.Equal(t, msgRequired, got["is_executor_paid"])
+
+	got = fieldMap(MarkRequest{SubtaskIDs: []string{}, IsExecutorPaid: boolPtr(true)}.normalize().validate())
+	assert.Equal(t, msgRequired, got["subtask_ids"])
+	assert.NotContains(t, got, "is_executor_paid")
+}
+
+// TS-020/TS-016: битый uuid, пустая строка, дубль (в т.ч. в другом регистре) — по индексу.
+func TestTS020_MarkRequestValidate_InvalidItems(t *testing.T) {
+	in := MarkRequest{
+		SubtaskIDs:     []string{idA, "not-a-uuid", "  ", strings.ToUpper(idA), idB},
+		IsExecutorPaid: boolPtr(true),
+	}.normalize()
+	got := fieldMap(in.validate())
+	assert.Equal(t, map[string]string{
+		"subtask_ids[1]": msgInvalid,
+		"subtask_ids[2]": msgRequired,
+		"subtask_ids[3]": msgDuplicate,
+	}, got)
+}
+
+// TS-020/TS-016: граница размера списка — markMax допустим, markMax+1 → too_many.
+func TestTS020_MarkRequestValidate_TooMany(t *testing.T) {
+	ids := make([]string, markMax+1)
+	for i := range ids {
+		ids[i] = fmt.Sprintf("00000000-0000-0000-0000-%012d", i)
+	}
+	got := fieldMap(MarkRequest{SubtaskIDs: ids, IsExecutorPaid: boolPtr(true)}.normalize().validate())
+	assert.Equal(t, map[string]string{"subtask_ids": msgTooMany}, got)
+
+	assert.Empty(t, MarkRequest{SubtaskIDs: ids[:markMax], IsExecutorPaid: boolPtr(true)}.normalize().validate())
+}
+
+func decodePayout(t *testing.T, body string) (PayoutUpdateRequest, error) {
+	t.Helper()
+	var in PayoutUpdateRequest
+	err := json.Unmarshal([]byte(body), &in)
+	return in, err
+}
+
+// TS-031: тело PUT /executor-payouts/:id — поле обязательно; null и число ≥ 0 валидны.
+func TestTS031_PayoutUpdateRequestValidate(t *testing.T) {
+	in, err := decodePayout(t, `{}`)
+	require.NoError(t, err)
+	assert.Equal(t, map[string]string{"executor_payout": msgRequired}, fieldMap(in.validate()))
+
+	in, err = decodePayout(t, `{"executor_payout": null}`)
+	require.NoError(t, err)
+	assert.True(t, in.ExecutorPayout.Set)
+	assert.Nil(t, in.ExecutorPayout.Value)
+	assert.Empty(t, in.validate(), "null — очистить сумму")
+
+	for _, ok := range []string{"0", "0.01", "1500.50", "9999999999.99"} {
+		in, err = decodePayout(t, `{"executor_payout": `+ok+`}`)
+		require.NoError(t, err, ok)
+		assert.Empty(t, in.validate(), ok)
+		require.NotNil(t, in.ExecutorPayout.Value)
+		assert.Equal(t, ok, in.ExecutorPayout.Value.String())
+	}
+
+	for raw, want := range map[string]string{
+		"1.234":       numeric.MsgTooPrecise,
+		"10000000000": numeric.MsgTooLarge,
+		"1e3":         numeric.MsgInvalidFormat,
+		"true":        numeric.MsgInvalidFormat, // литерал проходит разбор тела, отсекается форматом
+	} {
+		in, err = decodePayout(t, `{"executor_payout": `+raw+`}`)
+		require.NoError(t, err, raw)
+		assert.Equal(t, want, fieldMap(in.validate())["executor_payout"], raw)
+	}
+	in, err = decodePayout(t, `{"executor_payout": -1}`)
+	require.NoError(t, err)
+	assert.NotEmpty(t, fieldMap(in.validate())["executor_payout"], "отрицательная сумма")
+
+	// не число — ошибка разбора тела (хендлер отвечает 400 BAD_REQUEST).
+	for _, bad := range []string{`"abc"`, `{}`, `[1]`} {
+		_, err = decodePayout(t, `{"executor_payout": `+bad+`}`)
+		assert.Error(t, err, bad)
+	}
+}
