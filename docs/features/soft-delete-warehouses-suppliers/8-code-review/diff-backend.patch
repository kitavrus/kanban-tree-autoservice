+// без блокировки, после фиксации увеличила бы количество и увела бы удалённый склад в долг.
+func (s *OrderCardLiveSuite) TestRace_QtyIncreaseWaitsForWarehouseDelete() {
+	m := uuid.NewString()[:8]
+	w := s.whNew("SD-гонка кол-во " + m)
