-		"Действие недоступно в текущем статусе перемещения")
-	ErrStockOverflow = errorspkg.New("STOCK_OVERFLOW", http.StatusConflict,
-		"Остаток выходит за допустимый диапазон")
-)
-
-const (
-	defaultLimit = 50
-	maxLimit     = 500
-)
-
-type Service struct {
-	repo *Repo
-}
-
-func NewService(pool *pgxpool.Pool) *Service { return &Service{repo: NewRepo(pool)} }
-
-type ListQuery struct {
-	Status, WarehouseID string
-	Limit, Offset       int
-}
-
-func (s *Service) List(ctx context.Context, q ListQuery) (*TransferListResponse, error) {
-	var f []errorspkg.Field
-	if q.Status != "" && !isStatus(q.Status) {
-		f = append(f, errorspkg.Field{Name: "status", Message: msgInvalid})
-	}
-	if q.WarehouseID != "" && uuid.Validate(q.WarehouseID) != nil {
-		f = append(f, errorspkg.Field{Name: "warehouse_id", Message: msgInvalid})
-	}
-	if len(f) > 0 {
-		return nil, errorspkg.Validation(f...)
-	}
-	limit, offset := q.Limit, q.Offset
-	if limit <= 0 {
-		limit = defaultLimit
-	}
-	limit = min(limit, maxLimit)
-	offset = max(offset, 0)
-	items, total, err := s.repo.List(ctx, ListParams{Status: q.Status, WarehouseID: q.WarehouseID, Limit: limit, Offset: offset})
-	if err != nil {
-		return nil, err
-	}
-	return &TransferListResponse{Items: items, Total: total, Limit: limit, Offset: offset}, nil
-}
-
-func (s *Service) Get(ctx context.Context, rawID string) (*TransferResponse, error) {
-	id, err := parseID(rawID)
-	if err != nil {
-		return nil, err
-	}
-	t, err := s.repo.Get(ctx, id)
-	return t, mapErr(err)
-}
-
-func (s *Service) Create(ctx context.Context, in Input, userID string, send bool) (*TransferResponse, error) {
-	in = in.normalize()
-	if f := in.validate(); len(f) > 0 {
-		return nil, errorspkg.Validation(f...)
-	}
-	t, err := s.repo.Create(ctx, in, userID, send)
-	return t, mapErr(err)
-}
-
-func (s *Service) Update(ctx context.Context, rawID string, in Input, version *int) (*TransferResponse, error) {
-	id, err := parseID(rawID)
-	if err != nil {
-		return nil, err
-	}
-	in = in.normalize()
-	f := in.validate()
-	if version == nil {
-		f = append(f, errorspkg.Field{Name: "version", Message: msgRequired})
-	}
-	if len(f) > 0 {
-		return nil, errorspkg.Validation(f...)
-	}
-	t, err := s.repo.Update(ctx, id, in, *version)
-	return t, mapErr(err)
-}
-
-func (s *Service) Send(ctx context.Context, rawID string, version *int, userID string) (*TransferResponse, error) {
-	id, err := parseIDVersion(rawID, version)
-	if err != nil {
-		return nil, err
-	}
-	t, err := s.repo.Send(ctx, id, *version, userID)
-	return t, mapErr(err)
-}
-
-func (s *Service) Receive(ctx context.Context, rawID string, version *int, items []ReceiveItemInput, userID string) (*TransferResponse, error) {
-	id, err := parseIDVersion(rawID, version)
-	if err != nil {
-		return nil, err
-	}
-	t, err := s.repo.Receive(ctx, id, *version, items, userID)
-	return t, mapErr(err)
-}
-
-func (s *Service) Cancel(ctx context.Context, rawID string, version *int, userID string) (*TransferResponse, error) {
-	id, err := parseIDVersion(rawID, version)
-	if err != nil {
-		return nil, err
-	}
-	t, err := s.repo.Cancel(ctx, id, *version, userID)
-	return t, mapErr(err)
-}
-
-// parseID — #N перемещения: положительное целое, иначе 404 (как битый uuid у справочников).
-func parseID(raw string) (int64, error) {
-	id, err := strconv.ParseInt(raw, 10, 64)
-	if err != nil || id <= 0 {
-		return 0, ErrTransferNotFound
-	}
-	return id, nil
-}
-
-func parseIDVersion(raw string, version *int) (int64, error) {
-	id, err := parseID(raw)
-	if err != nil {
-		return 0, err
-	}
-	if version == nil {
-		return 0, errorspkg.Validation(errorspkg.Field{Name: "version", Message: msgRequired})
-	}
-	return id, nil
-}
-
-func isStatus(v string) bool {
-	for _, s := range Statuses {
-		if s == v {
-			return true
-		}
-	}
-	return false
-}
-
-func mapErr(err error) error {
-	var fe *fieldsError
-	switch {
-	case err == nil:
-		return nil
-	case errors.Is(err, errNotFound):
-		return ErrTransferNotFound
-	case errors.Is(err, errVersion):
-		return ErrVersionConflict
-	case errors.Is(err, errStatus):
-		return ErrStatusConflict
-	case errors.Is(err, errOverflow):
-		return ErrStockOverflow
-	case errors.As(err, &fe):
-		return errorspkg.Validation(fe.Fields...)
-	}
-	return err
-}
