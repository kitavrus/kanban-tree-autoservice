+// Abuse case 1 (§3): executor не видит «Перемещения» — 403 на API и SSR, нет пункта меню.
+func (s *TransfersLiveSuite) TestExecutorForbidden() {
+	s.SeedUser("st-exec", "password1", "Перемещения Исп", "executor", true)
+	exec := s.NewBrowser()
+	exec.Login("st-exec", "password1")
+	for _, cs := range []struct {
+		method, path string
+		body         any
+	}{
+		{http.MethodGet, "/api/v1/transfers", nil},
+		{http.MethodPost, "/api/v1/transfers", map[string]any{}},
+		{http.MethodGet, "/api/v1/transfers/1", nil},
+		{http.MethodPut, "/api/v1/transfers/1", map[string]any{}},
+		{http.MethodPost, "/api/v1/transfers/1/send", map[string]any{"version": 1}},
+		{http.MethodPost, "/api/v1/transfers/1/receive", map[string]any{"version": 1}},
+		{http.MethodPost, "/api/v1/transfers/1/cancel", map[string]any{"version": 1}},
+	} {
+		st, raw := exec.Do(cs.method, cs.path, cs.body)
+		s.Equal(http.StatusForbidden, st, "%s %s → %s", cs.method, cs.path, raw)
+	}
+	resp := exec.Request(http.MethodGet, "/transfers", nil, nil)
+	resp.Body.Close()
+	s.Equal(http.StatusForbidden, resp.StatusCode)
+
+	resp = exec.Request(http.MethodGet, "/", nil, nil)
+	body, err := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	s.Require().NoError(err)
+	s.NotContains(string(body), `href="/transfers"`, "executor не видит пункт «Перемещения»")
+
+	anon := s.NewBrowser()
+	st, raw := anon.Do(http.MethodGet, "/api/v1/transfers", nil)
+	s.Equal(http.StatusUnauthorized, st, string(raw))
+}
