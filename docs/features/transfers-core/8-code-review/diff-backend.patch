+	// клиент без заказов, но с единицей, у которой есть документы: каскадное удаление
+	// оборудования запрещено тем же правилом — 409, не 500; клиент и единица на месте.
+	st, raw = s.admin.Do(http.MethodDelete, "/api/v1/clients/"+c.ID, nil)
+	s.Require().Equal(http.StatusConflict, st, string(raw))
+	s.Equal("EQUIPMENT_HAS_TRANSFERS", s.errOf(raw).Code)
+	st, _ = s.admin.Do(http.MethodGet, "/api/v1/equipment/"+e.ID, nil)
+	s.Equal(http.StatusOK, st)
+}
