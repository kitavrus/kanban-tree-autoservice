+func (s *ClientsLiveSuite) TestTS018_DeleteEquipmentWithTransfers() {
+	ctx := s.T().Context()
+	almaty, moscow := s.warehouseByName("Алматы"), s.warehouseByName("Москва")
+	c := s.newClient("Клиент Удаление С Перемещениями")
