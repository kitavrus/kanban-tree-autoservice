-// lockTransfer — FOR UPDATE строки перемещения (первая блокировка транзакции, D50: затем
-// product_stock); version сверяется ДО статуса — устаревшая форма получает 409 version.
-func lockTransfer(ctx context.Context, tx pgx.Tx, id int64, version int, allowed ...string) (lockedTransfer, error) {
-	var st lockedTransfer
-	var cur int
-	err := tx.QueryRow(ctx, `
-SELECT status, from_warehouse_id::text, to_warehouse_id::text, version FROM stock_transfers WHERE id = $1 FOR UPDATE`, id).
-		Scan(&st.status, &st.from, &st.to, &cur)
-	if errors.Is(err, pgx.ErrNoRows) {
-		return st, errNotFound
-	}
-	if err != nil {
-		return st, err
-	}
-	if cur != version {
-		return st, errVersion
-	}
-	for _, a := range allowed {
-		if st.status == a {
-			return st, nil
-		}
-	}
-	return st, errStatus
-}
