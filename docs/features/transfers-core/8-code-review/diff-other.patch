diff --git a/web/ssr/transfers/templates/pages/list.html b/web/ssr/transfers/templates/pages/list.html
new file mode 100644
index 0000000..19e6945
--- /dev/null
+++ b/web/ssr/transfers/templates/pages/list.html
@@ -0,0 +1,82 @@
+{{ define "content" }}
+<div id="st" data-testid="st-root">
+  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
+    <!-- Панель фильтров (§8.1 п.2): комбинация — «И» -->
+    <div class="d-flex flex-wrap align-items-center gap-2" data-testid="st-filters">
+      <select class="form-select form-select-sm" id="st-filter-status" data-testid="st-filter-status" style="max-width:170px" aria-label="Статус">
+        <option value="">Все статусы</option>
+        <option value="requested">Заявка</option>
+        <option value="in_transit">В пути</option>
+        <option value="received">Получено</option>
+        <option value="cancelled">Отменён</option>
+      </select>
+      <select class="form-select form-select-sm" id="st-filter-warehouse" data-testid="st-filter-warehouse" style="max-width:210px" aria-label="Склад">
+        <option value="">Все склады</option>
+        {{ range .Warehouses }}<option value="{{ .ID }}" data-active="{{ .IsActive }}" data-name="{{ .Name }}">{{ .Name }}{{ if not .IsActive }} (архив){{ end }}</option>
+        {{ end }}
+      </select>
+      <button type="button" class="btn btn-outline-secondary btn-sm" id="st-filter-reset" data-testid="st-filter-reset">Сбросить</button>
+    </div>
+    <button type="button" class="btn btn-primary btn-sm ms-auto" id="st-new" data-testid="st-new">Новое перемещение</button>
+  </div>
+
+  <div class="row g-3">
+    <!-- Список документов (master) -->
+    <div class="col-lg-5">
+      <div class="list-group" id="st-list" data-testid="st-list"></div>
+      <div class="empty-state d-none" id="st-empty" data-testid="st-empty">
+        <div class="mb-2">Перемещений нет</div>
+        <button type="button" class="btn btn-primary btn-sm" data-st-new data-testid="st-empty-new">Новое перемещение</button>
+      </div>
+      <div class="d-flex align-items-center gap-2 mt-2">
+        <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="st-more" data-testid="st-more">Показать ещё</button>
+        <span class="text-body-secondary small d-none" id="st-shown" data-testid="st-shown"></span>
+      </div>
+    </div>
+
+    <!-- Документ (detail) -->
+    <div class="col-lg-7">
+      <div class="card" id="st-detail" data-testid="st-detail">
+        <div class="card-body">
+          <div class="text-body-secondary" id="st-placeholder" data-testid="st-placeholder">Выберите перемещение</div>
+          <div class="d-none" id="st-card"></div>
+        </div>
+      </div>
+      <p class="text-body-secondary small mt-2">При отправке товары списываются со склада отправления и числятся «в пути», оборудование клиентов — «в пути» по документу; при приёмке товары приходуют на склад назначения по факту (недостача — потеря при перемещении), оборудование принимается целиком. Отмена отправленного перемещения возвращает всё на склад отправления.</p>
+    </div>
+  </div>
+</div>
+
+<!-- Тосты (DS-052): правый верхний угол, 5 секунд -->
+<div class="toast-container position-fixed top-0 end-0 p-3" id="st-toasts" style="z-index:1090;max-width:min(380px,100vw)" aria-live="polite"></div>
+
+<!-- Модалка «Приёмка» (§8.1 п.6): факт — только по товарным строкам (DS-037) -->
+<div class="modal fade" id="st-receive-modal" tabindex="-1" aria-hidden="true" data-testid="st-receive-modal">
+  <div class="modal-dialog modal-lg">
+    <form class="modal-content" id="st-receive-form" novalidate>
+      <div class="modal-header">
+        <h2 class="modal-title fs-5">Приёмка</h2>
+        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
+      </div>
+      <div class="modal-body">
+        <div class="alert alert-danger d-none" id="st-receive-error" data-testid="st-receive-error"></div>
+        <p class="text-body-secondary small">Укажите фактически полученное количество товаров. Недостача будет списана как потеря при перемещении. Оборудование принимается целиком.</p>
+        <div class="table-responsive">
+          <table class="table align-middle mb-0">
+            <thead><tr><th>Наименование</th><th>Отправлено</th><th style="width:170px">Факт</th></tr></thead>
+            <tbody id="st-receive-tbody"></tbody>
+          </table>
+        </div>
+      </div>
+      <div class="modal-footer">
+        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
+        <button type="submit" class="btn btn-primary" id="st-receive-confirm" data-testid="st-receive-confirm">Принять</button>
+      </div>
+    </form>
+  </div>
+</div>
+{{ end }}
