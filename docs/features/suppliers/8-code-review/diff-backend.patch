+++ b/internal/features/suppliers/migration_integration_test.go
@@ -0,0 +1,149 @@
+//go:build integration
+
+package suppliers_test
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// SuppliersMigrationSuite — миграция 0012 (docs/features/suppliers/draft-spec.md §4.1,
+// DS-007; часть TS-020 — «уникальность без регистра и с пробелами по краям, включая
+// архивные» держит индекс suppliers_name_lower_uq). down → таблицы нет; up → таблица,
+// дефолты, уникальный индекс, CHECK'и длины; повторный down/up чистый.
+type SuppliersMigrationSuite struct {
+	testutil.BaseSuite
+}
+
+func TestSuppliersMigrationSuite(t *testing.T) {
+	suite.Run(t, new(SuppliersMigrationSuite))
+}
+
+func migrationsURL() string {
+	_, f, _, _ := runtime.Caller(0)
+	return "file://" + filepath.Join(filepath.Dir(f), "..", "..", "..", "migrations")
+}
+
+func (s *SuppliersMigrationSuite) tableExists() bool {
+	var ok bool
+	s.Require().NoError(s.Pool.QueryRow(context.Background(), `SELECT to_regclass('suppliers') IS NOT NULL`).Scan(&ok))
+	return ok
+}
+
+func (s *SuppliersMigrationSuite) pgCode(err error) string {
+	var pgErr *pgconn.PgError
+	s.Require().True(errors.As(err, &pgErr), "ожидалась ошибка PostgreSQL: %v", err)
+	return pgErr.Code
+}
+
+func (s *SuppliersMigrationSuite) TestTS020_Migration0012_UpDown() {
+	ctx := context.Background()
+	mig, err := migrate.New(migrationsURL(), s.DSN)
+	s.Require().NoError(err)
+	defer func() { _, _ = mig.Close() }()
+
+	s.Require().NoError(mig.Migrate(11))
+	// Вернуть схему на последнюю версию; пока 0012 — последняя, Up() отвечает ErrNoChange.
+	defer func() {
+		if err := mig.Up(); !errors.Is(err, migrate.ErrNoChange) {
+			s.Require().NoError(err)
+		}
+	}()
+	s.False(s.tableExists(), "до 0012 таблицы suppliers нет")
+
+	// --- up 0012 ---
+	s.Require().NoError(mig.Migrate(12))
+	s.True(s.tableExists())
+
+	// колонки и типы — §4.1.
+	rows, err := s.Pool.Query(ctx, `
+		SELECT column_name, data_type, is_nullable FROM information_schema.columns
+		WHERE table_name = 'suppliers' ORDER BY ordinal_position`)
+	s.Require().NoError(err)
+	type col struct{ name, typ, nullable string }
+	var cols []col
+	for rows.Next() {
+		var c col
+		s.Require().NoError(rows.Scan(&c.name, &c.typ, &c.nullable))
+		cols = append(cols, c)
+	}
+	rows.Close()
+	s.Require().NoError(rows.Err())
+	s.Equal([]col{
+		{"id", "uuid", "NO"},
+		{"name", "text", "NO"},
+		{"contact_name", "text", "NO"},
+		{"phone", "text", "NO"},
+		{"address", "text", "NO"},
+		{"note", "text", "NO"},
+		{"is_active", "boolean", "NO"},
+		{"created_at", "timestamp with time zone", "NO"},
+		{"updated_at", "timestamp with time zone", "NO"},
+	}, cols)
+
+	// дефолты: только название — остальное заполняет БД.
+	var id, contact, phone, address, note string
+	var active, stamped bool
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO suppliers (name) VALUES ('ООО Миграция')
+		 RETURNING id::text, contact_name, phone, address, note, is_active, created_at IS NOT NULL AND updated_at IS NOT NULL`).
+		Scan(&id, &contact, &phone, &address, &note, &active, &stamped))
+	s.Len(id, 36)
+	s.Equal("", contact)
+	s.Equal("", phone)
+	s.Equal("", address)
+	s.Equal("", note)
+	s.True(active)
+	s.True(stamped)
+
+	// уникальность названия: регистр + пробелы по краям, включая архивные.
+	_, err = s.Pool.Exec(ctx, `INSERT INTO suppliers (name) VALUES ('  ооо МИГРАЦИЯ ')`)
+	s.Equal("23505", s.pgCode(err))
+	_, err = s.Pool.Exec(ctx, `UPDATE suppliers SET is_active = false WHERE id = $1::uuid`, id)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO suppliers (name) VALUES ('ооо миграция')`)
+	s.Equal("23505", s.pgCode(err), "архивный поставщик тоже занимает название")
+	var idx string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`SELECT indexdef FROM pg_indexes WHERE tablename = 'suppliers' AND indexname = 'suppliers_name_lower_uq'`).Scan(&idx))
+	s.Contains(idx, "UNIQUE")
+
+	// CHECK'и: пустое название и превышение длины не проходят мимо сервиса.
+	for _, q := range []struct {
+		sql string
+		arg string
+	}{
+		{`INSERT INTO suppliers (name) VALUES ($1)`, "   "},
+		{`INSERT INTO suppliers (name) VALUES ($1)`, strings.Repeat("я", 201)},
+		{`INSERT INTO suppliers (name, contact_name) VALUES ('CHK-1', $1)`, strings.Repeat("я", 201)},
+		{`INSERT INTO suppliers (name, phone) VALUES ('CHK-2', $1)`, strings.Repeat("1", 51)},
+		{`INSERT INTO suppliers (name, address) VALUES ('CHK-3', $1)`, strings.Repeat("я", 501)},
+		{`INSERT INTO suppliers (name, note) VALUES ('CHK-4', $1)`, strings.Repeat("я", 1001)},
+	} {
+		_, err = s.Pool.Exec(ctx, q.sql, q.arg)
+		s.Equal("23514", s.pgCode(err), q.sql)
+	}
+	_, err = s.Pool.Exec(ctx, `INSERT INTO suppliers (name, contact_name, phone, address, note) VALUES ($1, $2, $3, $4, $5)`,
+		strings.Repeat("я", 200), strings.Repeat("я", 200), strings.Repeat("1", 50), strings.Repeat("я", 500), strings.Repeat("я", 1000))
+	s.Require().NoError(err, "границы длины валидны")
+
+	// --- down → 0011: таблица удалена; up снова поднимается чисто (пустой) ---
+	s.Require().NoError(mig.Migrate(11))
+	s.False(s.tableExists())
+	s.Require().NoError(mig.Migrate(12))
+	var cnt int
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT count(*) FROM suppliers`).Scan(&cnt))
+	s.Equal(0, cnt)
+}
diff --git a/internal/features/suppliers/repo.go b/internal/features/suppliers/repo.go
new file mode 100644
index 0000000..67077be
--- /dev/null
+++ b/internal/features/suppliers/repo.go
@@ -0,0 +1,124 @@
+package suppliers
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Supplier — поставщик (repo-модель, DS-007).
+type Supplier struct {
+	ID          string
+	Name        string
+	ContactName string
+	Phone       string
+	Address     string
+	Note        string
+	IsActive    bool
+	CreatedAt   time.Time
+	UpdatedAt   time.Time
+}
+
+type Repo struct {
+	pool *pgxpool.Pool
+}
+
+func NewRepo(pool *pgxpool.Pool) *Repo { return &Repo{pool: pool} }
+
+var (
+	ErrNotFound      = pgx.ErrNoRows
+	errNameDuplicate = errors.New("suppliers: name duplicate")
+)
+
+const columns = `id, name, contact_name, phone, address, note, is_active, created_at, updated_at`
+
+func scan(row pgx.Row) (*Supplier, error) {
+	var s Supplier
+	if err := row.Scan(&s.ID, &s.Name, &s.ContactName, &s.Phone, &s.Address, &s.Note,
+		&s.IsActive, &s.CreatedAt, &s.UpdatedAt); err != nil {
+		return nil, err
+	}
+	return &s, nil
+}
+
+// ListParams — фильтры списка: IsActive == nil — все; Q — подстрока названия без регистра.
+type ListParams struct {
+	IsActive      *bool
+	Q             string
+	Limit, Offset int
+}
+
+// List — активные раньше архивных, затем по названию (§6.1).
+func (r *Repo) List(ctx context.Context, p ListParams) ([]Supplier, int, error) {
+	where := " WHERE true"
+	var args []any
+	if p.IsActive != nil {
+		args = append(args, *p.IsActive)
+		where += " AND is_active = $" + strconv.Itoa(len(args))
+	}
+	if p.Q != "" {
+		args = append(args, "%"+sqlutil.EscapeLike(p.Q)+"%")
+		where += " AND name ILIKE $" + strconv.Itoa(len(args))
+	}
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM suppliers`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	args = append(args, p.Limit, p.Offset)
+	rows, err := r.pool.Query(ctx, `SELECT `+columns+` FROM suppliers`+where+
+		` ORDER BY is_active DESC, lower(name), id LIMIT $`+strconv.Itoa(len(args)-1)+` OFFSET $`+strconv.Itoa(len(args)), args...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []Supplier{}
+	for rows.Next() {
+		s, err := scan(rows)
+		if err != nil {
+			return nil, 0, err
+		}
+		out = append(out, *s)
+	}
+	return out, total, rows.Err()
+}
+
+// Create — 23505 (suppliers_name_lower_uq) → errNameDuplicate.
+func (r *Repo) Create(ctx context.Context, in Input) (*Supplier, error) {
+	s, err := scan(r.pool.QueryRow(ctx,
+		`INSERT INTO suppliers (name, contact_name, phone, address, note)
+		 VALUES ($1, $2, $3, $4, $5) RETURNING `+columns,
+		in.Name, in.ContactName, in.Phone, in.Address, in.Note))
+	if err != nil {
+		return nil, mapNameConflict(err)
+	}
+	return s, nil
+}
+
+// Update — все поля + is_active, last-write-wins (DS-043); ErrNoRows → ErrNotFound
+// (сервис маппит).
+func (r *Repo) Update(ctx context.Context, id string, in Input) (*Supplier, error) {
+	s, err := scan(r.pool.QueryRow(ctx,
+		`UPDATE suppliers SET name = $2, contact_name = $3, phone = $4, address = $5, note = $6,
+		        is_active = $7, updated_at = now()
+		 WHERE id = $1::uuid RETURNING `+columns,
+		id, in.Name, in.ContactName, in.Phone, in.Address, in.Note, in.IsActive))
+	if err != nil {
+		return nil, mapNameConflict(err)
+	}
+	return s, nil
+}
+
+func mapNameConflict(err error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "23505" {
+		return errNameDuplicate
+	}
+	return err
+}
diff --git a/internal/features/suppliers/routes.go b/internal/features/suppliers/routes.go
new file mode 100644
