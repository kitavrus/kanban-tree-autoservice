+	s.Require().Len(got.Items, 1)
+	s.True(got.Items[0].EquipmentIsDeleted, "строка отменённого документа — с пометкой")
+	s.Equal("at_client||", s.unitLoc(cancelledUnit), "отменённый документ единицу не занимает")
+}
