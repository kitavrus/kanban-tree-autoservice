diff --git a/internal/features/board/subtask_logs_repo.go b/internal/features/board/subtask_logs_repo.go
new file mode 100644
index 0000000..f1e10f9
--- /dev/null
+++ b/internal/features/board/subtask_logs_repo.go
@@ -0,0 +1,89 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// SubtaskLogRepo — журнал работ услуги (design-sql.md §Subtask Log Queries). Свой pool
+// (не tx): «Журнал: без блокировки заказа» (design-sql.md §Lock Order) — FK-проверка на
+// INSERT берёт KEY SHARE на subtasks, цикла с DELETE услуги (tasks→subtasks) нет.
+type SubtaskLogRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewSubtaskLogRepo(pool *pgxpool.Pool) *SubtaskLogRepo { return &SubtaskLogRepo{pool: pool} }
+
+// SubtaskTaskID — владелец-заказ услуги, без блокировки (нужен сервису для сборки
+// Re-fetch-after-write ответа). 0 строк → errNotFound (ErrSubtaskNotFound).
+func (r *SubtaskLogRepo) SubtaskTaskID(ctx context.Context, subtaskID string) (int64, error) {
+	var taskID int64
+	err := r.pool.QueryRow(ctx, `SELECT task_id FROM subtasks WHERE id = $1`, subtaskID).Scan(&taskID)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return 0, errNotFound
+	}
+	return taskID, err
+}
+
+// Insert — design-sql.md §Subtask Log Queries. 23503 на subtask_id (услуга удалена между
+// запросами) → errNotFound (LV-174).
+func (r *SubtaskLogRepo) Insert(ctx context.Context, subtaskID, userID, text string) (string, error) {
+	var id string
+	err := r.pool.QueryRow(ctx, `INSERT INTO subtask_logs (subtask_id, user_id, text) VALUES ($1, $2, $3) RETURNING id`,
+		subtaskID, userID, text).Scan(&id)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
+			return "", errNotFound
+		}
+		return "", err
+	}
+	return id, nil
+}
+
+// LogOwner — автор записи + task_id для проверки прав (D27) и Re-fetch-after-write.
+type LogOwner struct {
+	UserID string
+	TaskID int64
+}
+
+// Owner — design-sql.md §Subtask Log Queries (второй запрос). 0 → errNotFound
+// (SUBTASK_LOG_NOT_FOUND).
+func (r *SubtaskLogRepo) Owner(ctx context.Context, id string) (*LogOwner, error) {
+	var o LogOwner
+	err := r.pool.QueryRow(ctx, `
+		SELECT l.user_id, s.task_id FROM subtask_logs l JOIN subtasks s ON s.id = l.subtask_id WHERE l.id = $1`, id).
+		Scan(&o.UserID, &o.TaskID)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	return &o, err
+}
+
+// Update — после проверки прав (сервис). 0 строк → errNotFound.
+func (r *SubtaskLogRepo) Update(ctx context.Context, id, text string) error {
+	tag, err := r.pool.Exec(ctx, `UPDATE subtask_logs SET text = $2, updated_at = now() WHERE id = $1`, id, text)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// Delete — после проверки прав (сервис). 0 строк → errNotFound.
+func (r *SubtaskLogRepo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM subtask_logs WHERE id = $1`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
