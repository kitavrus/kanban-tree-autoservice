+func (s *OrderCardLiveSuite) getCard(b *testutil.Browser, id int64) (int, orderCardDTO, []byte) {
+	st, raw := b.Do(http.MethodGet, fmt.Sprintf("/api/v1/tasks/%d/card", id), nil)
+	var c orderCardDTO
+	if st == http.StatusOK {
+		s.Require().NoError(json.Unmarshal(raw, &c), string(raw))
+	}
+	return st, c, raw
+}
