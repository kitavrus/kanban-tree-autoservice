+//go:build integration
+
+package board_test
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// SubtaskProductsPositionSuite — IT-020 (design-sql.md §Subtask Logs Migration, ADR-103):
+// down до 0005 (столбца position ещё нет) → 3 строки subtask_products одной услуги без
+// position → up (0006) → backfill row_number() по (subtask_id ORDER BY product_id, id) —
+// position 1..3, без нулей/дублей.
+type SubtaskProductsPositionSuite struct {
+	testutil.BaseSuite
+}
+
+func TestSubtaskProductsPositionSuite(t *testing.T) {
+	suite.Run(t, new(SubtaskProductsPositionSuite))
+}
+
+const (
+	sppAdminID  = "aaaaaaaa-1111-1111-1111-111111111111"
+	sppClientID = "bbbbbbbb-1111-1111-1111-111111111111"
+	sppColumnID = "cccccccc-1111-1111-1111-111111111111"
+)
+
+func (s *SubtaskProductsPositionSuite) SetupSuite() {
+	s.BaseSuite.SetupSuite()
+	ctx := context.Background()
+	_, err := s.Pool.Exec(ctx, `INSERT INTO users (id, login, password_hash, name, role) VALUES
+		($1, 'spp-admin', 'x', 'Admin', 'admin') ON CONFLICT (id) DO NOTHING`, sppAdminID)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO clients (id, company_name) VALUES ($1, 'SPP Co')
+		ON CONFLICT (id) DO NOTHING`, sppClientID)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO columns (id, name, color, is_final, consumes_stock, position) VALUES
+		($1, 'Новые', '#94A3B8', false, false, 1) ON CONFLICT (id) DO NOTHING`, sppColumnID)
+	s.Require().NoError(err)
+}
+
+// migrateRoot — каталог migrations/ (репозиторный корень, три уровня вверх от board/).
+func migrateRoot() string {
+	_, f, _, _ := runtime.Caller(0)
+	return "file://" + filepath.Join(filepath.Dir(f), "..", "..", "..", "migrations")
+}
+
+func (s *SubtaskProductsPositionSuite) TestSubtaskProductsPosition_BackfillOnMigrate() {
+	ctx := context.Background()
+
+	mig, err := migrate.New(migrateRoot(), s.DSN)
+	s.Require().NoError(err)
+	defer func() { _, _ = mig.Close() }()
+
+	// down до 0005 — 0006 откатывается: subtask_logs дропается, subtask_products.position
+	// исчезает (IT-020, CM-1 MVP down).
+	s.Require().NoError(mig.Steps(-1))
+
+	var categoryID string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO catalog_categories (kind, name) VALUES ('service', 'SPP Services ' || gen_random_uuid()) RETURNING id`,
+	).Scan(&categoryID))
+	var serviceID string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO services (category_id, name) VALUES ($1, 'SPP Service') RETURNING id`, categoryID,
+	).Scan(&serviceID))
+	var prodCategoryID string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO catalog_categories (kind, name) VALUES ('product', 'SPP Products ' || gen_random_uuid()) RETURNING id`,
+	).Scan(&prodCategoryID))
+
+	var taskID int64
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO tasks (column_id, client_id, title, position, created_by)
+		 VALUES ($1, $2, 'SPP Task', 1024, $3) RETURNING id`, sppColumnID, sppClientID, sppAdminID,
+	).Scan(&taskID))
+	var subtaskID string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO subtasks (task_id, service_id) VALUES ($1, $2) RETURNING id`, taskID, serviceID,
+	).Scan(&subtaskID))
+
+	// 3 товара одной услуги, вставлены до появления колонки position (её ещё нет на 0005).
+	productIDs := make([]string, 3)
+	for i := range productIDs {
+		var productID string
+		s.Require().NoError(s.Pool.QueryRow(ctx,
+			`INSERT INTO products (category_id, name) VALUES ($1, $2) RETURNING id`,
+			prodCategoryID, fmt.Sprintf("SPP Product %d", i),
+		).Scan(&productID))
+		productIDs[i] = productID
+		_, err := s.Pool.Exec(ctx,
+			`INSERT INTO subtask_products (subtask_id, product_id, qty) VALUES ($1, $2, 1)`,
+			subtaskID, productID)
+		s.Require().NoError(err)
+	}
+
+	// up — снова 0006: ADD COLUMN position + backfill row_number().
+	s.Require().NoError(mig.Steps(1))
+
+	rows, err := s.Pool.Query(ctx,
+		`SELECT position FROM subtask_products WHERE subtask_id = $1 ORDER BY position`, subtaskID)
+	s.Require().NoError(err)
+	defer rows.Close()
+
+	var positions []int
+	for rows.Next() {
+		var p int
+		s.Require().NoError(rows.Scan(&p))
+		positions = append(positions, p)
+	}
+	s.Require().NoError(rows.Err())
+
+	s.Equal([]int{1, 2, 3}, positions, "backfill row_number() — 1..N без нулей/дублей (ADR-103)")
+}
diff --git a/internal/features/board/subtask_products_repo.go b/internal/features/board/subtask_products_repo.go
new file mode 100644
index 0000000..cd17e15
--- /dev/null
+++ b/internal/features/board/subtask_products_repo.go
@@ -0,0 +1,85 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// SubtaskProductRepo — товары услуги (design-sql.md §Subtask Parent/Lock/Subtask Product
+// Queries). Без pool: мутации всегда под LockTask+Lock Subtask (Lock Order).
+type SubtaskProductRepo struct{}
+
+func NewSubtaskProductRepo() *SubtaskProductRepo { return &SubtaskProductRepo{} }
+
+// ParentOf — design-sql.md §Subtask Parent Query (второй запрос): task_id + subtask_id
+// владельца строки товара. 0 → errNotFound (SUBTASK_PRODUCT_NOT_FOUND).
+func (r *SubtaskProductRepo) ParentOf(ctx context.Context, tx pgx.Tx, id string) (taskID int64, subtaskID string, err error) {
+	err = tx.QueryRow(ctx, `
+		SELECT s.task_id, sp.subtask_id FROM subtask_products sp JOIN subtasks s ON s.id = sp.subtask_id
+		WHERE sp.id = $1`, id).Scan(&taskID, &subtaskID)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return 0, "", errNotFound
+	}
+	return taskID, subtaskID, err
+}
+
+// Lock — design-sql.md §Lock Subtask Query (второй запрос), ПОСЛЕ SubtaskRepo.Lock
+// (Lock Order). 0 → errNotFound.
+func (r *SubtaskProductRepo) Lock(ctx context.Context, tx pgx.Tx, id, subtaskID string) error {
+	var got string
+	err := tx.QueryRow(ctx, `SELECT id FROM subtask_products WHERE id = $1 AND subtask_id = $2 FOR UPDATE`, id, subtaskID).Scan(&got)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return errNotFound
+	}
+	return err
+}
+
+// ProductState — существование + is_active товара (400 различает «не найден»/«в архиве»).
+func (r *SubtaskProductRepo) ProductState(ctx context.Context, tx pgx.Tx, id string) (exists, active bool, err error) {
+	err = tx.QueryRow(ctx, `SELECT true, is_active FROM products WHERE id = $1`, id).Scan(&exists, &active)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return false, false, nil
+	}
+	return exists, active, err
+}
+
+// Insert — design-sql.md §Subtask Product Queries: цена копируется из ТЕКУЩЕЙ
+// products.price (AC-008). 0 строк (товар не найден/архивен — гонка) → errNotFound.
+func (r *SubtaskProductRepo) Insert(ctx context.Context, tx pgx.Tx, subtaskID, productID, qty string) (string, error) {
+	var id string
+	err := tx.QueryRow(ctx, `
+		INSERT INTO subtask_products (subtask_id, product_id, qty, price, position)
+		SELECT $1, p.id, $3::numeric, p.price, coalesce((SELECT max(position) FROM subtask_products WHERE subtask_id = $1), 0) + 1
+		FROM products p WHERE p.id = $2 AND p.is_active
+		RETURNING id`, subtaskID, productID, qty).Scan(&id)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return "", errNotFound
+	}
+	return id, err
+}
+
+// Update — LWW (D28): полная замена qty/price. price=nil → NULL («без цены», итог 0).
+func (r *SubtaskProductRepo) Update(ctx context.Context, tx pgx.Tx, id, qty string, price *string) error {
+	tag, err := tx.Exec(ctx, `UPDATE subtask_products SET qty = $2::numeric, price = $3::numeric WHERE id = $1`, id, qty, price)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// Delete — 0 строк → errNotFound (идемпотентность DELETE — повтор тоже 404, LV-173).
+func (r *SubtaskProductRepo) Delete(ctx context.Context, tx pgx.Tx, id string) error {
+	tag, err := tx.Exec(ctx, `DELETE FROM subtask_products WHERE id = $1`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
