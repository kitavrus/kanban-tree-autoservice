@@ -0,0 +1,112 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/google/uuid"
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// CreateLog — POST /api/v1/subtasks/:id/logs (AC-012): без блокировки заказа (журнал
+// склад не трогает, design-sql.md §Lock Order).
+func (s *CardService) CreateLog(ctx context.Context, a Actor, subtaskID string, in SubtaskLogRequest) (*OrderCardMutationResponse, error) {
+	if uuid.Validate(subtaskID) != nil {
+		return nil, ErrSubtaskNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	ctx, span := otel.Tracer("board").Start(ctx, "subtask_logs.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.String("subtask_id", subtaskID), attribute.String("op", "create"))
+
+	taskID, err := s.logs.SubtaskTaskID(ctx, subtaskID)
+	if errors.Is(err, errNotFound) {
+		return nil, ErrSubtaskNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	span.SetAttributes(attribute.Int64("task_id", taskID))
+
+	if _, err := s.logs.Insert(ctx, subtaskID, a.ID, in.Text); err != nil {
+		if errors.Is(err, errNotFound) {
+			return nil, ErrSubtaskNotFound
+		}
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, taskID, ReconcileResult{Warnings: []StockWarning{}})
+}
+
+// UpdateLog — PUT /api/v1/subtask-logs/:id (D27, AC-012): 404 (родитель/строка) →
+// 403 SUBTASK_LOG_FORBIDDEN (автор ≠ актор И актор не admin) → запись.
+func (s *CardService) UpdateLog(ctx context.Context, a Actor, id string, in SubtaskLogRequest) (*OrderCardMutationResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrSubtaskLogNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	ctx, span := otel.Tracer("board").Start(ctx, "subtask_logs.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.String("op", "update"))
+
+	owner, err := s.logs.Owner(ctx, id)
+	if errors.Is(err, errNotFound) {
+		return nil, ErrSubtaskLogNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	span.SetAttributes(attribute.Int64("task_id", owner.TaskID))
+	if !a.IsAdmin && owner.UserID != a.ID {
+		return nil, ErrSubtaskLogForbidden
+	}
+
+	if err := s.logs.Update(ctx, id, in.Text); err != nil {
+		if errors.Is(err, errNotFound) {
+			return nil, ErrSubtaskLogNotFound
+		}
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, owner.TaskID, ReconcileResult{Warnings: []StockWarning{}})
+}
+
+// DeleteLog — DELETE /api/v1/subtask-logs/:id (D27, AC-012).
+func (s *CardService) DeleteLog(ctx context.Context, a Actor, id string) (*OrderCardMutationResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrSubtaskLogNotFound
+	}
+
+	ctx, span := otel.Tracer("board").Start(ctx, "subtask_logs.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.String("op", "delete"))
+
+	owner, err := s.logs.Owner(ctx, id)
+	if errors.Is(err, errNotFound) {
+		return nil, ErrSubtaskLogNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	span.SetAttributes(attribute.Int64("task_id", owner.TaskID))
+	if !a.IsAdmin && owner.UserID != a.ID {
+		return nil, ErrSubtaskLogForbidden
+	}
+
+	if err := s.logs.Delete(ctx, id); err != nil {
+		if errors.Is(err, errNotFound) {
+			return nil, ErrSubtaskLogNotFound
+		}
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, owner.TaskID, ReconcileResult{Warnings: []StockWarning{}})
+}
diff --git a/internal/features/board/subtask_logs_validate.go b/internal/features/board/subtask_logs_validate.go
new file mode 100644
index 0000000..4b0e449
--- /dev/null
+++ b/internal/features/board/subtask_logs_validate.go
@@ -0,0 +1,27 @@
+package board
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// subtaskLogTextMax — design-errors.md §Validation Fields (`text`, trim 1..4000).
+const subtaskLogTextMax = 4000
+
+func (in SubtaskLogRequest) normalize() SubtaskLogRequest {
+	in.Text = strings.TrimSpace(in.Text)
+	return in
+}
+
+func (in SubtaskLogRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	switch n := utf8.RuneCountInString(in.Text); {
+	case n == 0:
+		f = append(f, errorspkg.Field{Name: "text", Message: msgRequired})
+	case n > subtaskLogTextMax:
+		f = append(f, errorspkg.Field{Name: "text", Message: msgTooLong})
+	}
+	return f
+}
