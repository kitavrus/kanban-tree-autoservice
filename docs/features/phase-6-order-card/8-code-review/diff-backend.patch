+package board
+
+import (
+	"strings"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+func (in SubtaskProductCreateRequest) normalize() SubtaskProductCreateRequest {
+	in.ProductID = strings.TrimSpace(in.ProductID)
+	return in
+}
+
+// validate — формат product_id + qty (обязателен, >0, Scale 9/3); существование/is_active
+// product_id — сервис (design-errors.md §Validation Fields).
+func (in SubtaskProductCreateRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	switch {
+	case in.ProductID == "":
+		add("product_id", msgRequired)
+	case uuid.Validate(in.ProductID) != nil:
+		add("product_id", msgInvalid)
+	}
+
+	if in.Qty == nil {
+		add("qty", msgRequired)
+	} else if code := in.Qty.Validate(qtyScale, false); code != "" {
+		add("qty", code)
+	} else if isZeroAmount(*in.Qty) {
+		add("qty", msgNotPositive)
+	}
+	return f
+}
+
+// normalize — числовые поля не нуждаются в trim; метод — для единообразия контракта
+// Row Requests (normalize()/validate() на каждом типе, design-go-layers.md §DTO Row
+// Requests).
+func (in SubtaskProductUpdateRequest) normalize() SubtaskProductUpdateRequest { return in }
+
+// validate — PUT: полная замена (LWW) — qty обязателен и >0 (как при создании), price —
+// NULL допустим («без цены», итог 0).
+func (in SubtaskProductUpdateRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	if in.Qty == nil {
+		add("qty", msgRequired)
+	} else if code := in.Qty.Validate(qtyScale, false); code != "" {
+		add("qty", code)
+	} else if isZeroAmount(*in.Qty) {
+		add("qty", msgNotPositive)
+	}
+
+	if in.Price != nil {
+		if code := in.Price.Validate(priceScale, false); code != "" {
+			add("price", code)
+		}
+	}
+	return f
+}
diff --git a/internal/features/board/subtasks_repo.go b/internal/features/board/subtasks_repo.go
new file mode 100644
index 0000000..f0151f9
--- /dev/null
+++ b/internal/features/board/subtasks_repo.go
@@ -0,0 +1,120 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// SubtaskRepo — услуги заказа (design-sql.md §Subtask Parent/Lock/Insert/Update/Delete
+// Query). Без pool: все методы принимают чужую tx — мутации всегда под LockTask
+// (Lock Order ADR-104/ADR-100: columns→tasks→subtasks→subtask_products→products).
+type SubtaskRepo struct{}
+
+func NewSubtaskRepo() *SubtaskRepo { return &SubtaskRepo{} }
+
+// SubtaskState — строка services под FOR UPDATE (design-sql.md §Lock Subtask Query).
+type SubtaskState struct {
+	ID         string
+	Status     string
+	AssigneeID *string
+}
+
+// TaskIDOf — design-sql.md §Subtask Parent Query (первый запрос): владелец-заказ услуги.
+// 0 строк → errNotFound (ErrSubtaskNotFound).
+func (r *SubtaskRepo) TaskIDOf(ctx context.Context, tx pgx.Tx, id string) (int64, error) {
+	var taskID int64
+	err := tx.QueryRow(ctx, `SELECT task_id FROM subtasks WHERE id = $1`, id).Scan(&taskID)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return 0, errNotFound
+	}
+	return taskID, err
+}
+
+// Lock — design-sql.md §Lock Subtask Query (первый запрос): FOR UPDATE ПОСЛЕ LockTask
+// (Lock Order). 0 строк (удалена/перенесена параллельно) → errNotFound.
+func (r *SubtaskRepo) Lock(ctx context.Context, tx pgx.Tx, id string, taskID int64) (*SubtaskState, error) {
+	var st SubtaskState
+	err := tx.QueryRow(ctx, `SELECT id, status, assignee_id::text FROM subtasks WHERE id = $1 AND task_id = $2 FOR UPDATE`,
+		id, taskID).Scan(&st.ID, &st.Status, &st.AssigneeID)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	return &st, err
+}
+
+// ServiceState — существование + is_active услуги (400 различает «не найдена»/«в архиве»,
+// design-errors.md §Validation Fields).
+func (r *SubtaskRepo) ServiceState(ctx context.Context, tx pgx.Tx, id string) (exists, active bool, err error) {
+	err = tx.QueryRow(ctx, `SELECT true, is_active FROM services WHERE id = $1`, id).Scan(&exists, &active)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return false, false, nil
+	}
+	return exists, active, err
+}
+
+// Insert — design-sql.md §Insert Subtask Query (первая половина): услуга + позиция в
+// конец. 0 строк (услуга не найдена/архивна — гонка после ServiceState) → errNotFound.
+func (r *SubtaskRepo) Insert(ctx context.Context, tx pgx.Tx, taskID int64, serviceID string) (string, error) {
+	var id string
+	err := tx.QueryRow(ctx, `
+		INSERT INTO subtasks (task_id, service_id, price, position)
+		SELECT $1, sv.id, sv.price, coalesce((SELECT max(position) FROM subtasks WHERE task_id = $1), 0) + 1
+		FROM services sv WHERE sv.id = $2 AND sv.is_active
+		RETURNING id`, taskID, serviceID).Scan(&id)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return "", errNotFound
+	}
+	return id, err
+}
+
+// CopyKit — design-sql.md §Insert Subtask Query (вторая половина): типовой комплект
+// товаров услуги, цена — ТЕКУЩАЯ products.price на момент добавления (AC-008), не
+// service_products (там своей цены нет).
+func (r *SubtaskRepo) CopyKit(ctx context.Context, tx pgx.Tx, subtaskID, serviceID string) error {
+	_, err := tx.Exec(ctx, `
+		INSERT INTO subtask_products (subtask_id, product_id, qty, price, position)
+		SELECT $1, spr.product_id, spr.qty, p.price, row_number() OVER (ORDER BY spr.position, spr.product_id)
+		FROM service_products spr JOIN products p ON p.id = spr.product_id
+		WHERE spr.service_id = $2`, subtaskID, serviceID)
+	return err
+}
+
+// subtaskUpdateRow — параметры Update (design-go-layers.md §Repository Interface).
+type subtaskUpdateRow struct {
+	Status      string
+	AssigneeID  *string
+	DueDate     *string
+	Price       *string
+	EquipmentID *string
+}
+
+// Update — design-sql.md §Update Subtask Query. 0 строк (удалена параллельно) →
+// errNotFound.
+func (r *SubtaskRepo) Update(ctx context.Context, tx pgx.Tx, id string, in subtaskUpdateRow) error {
+	tag, err := tx.Exec(ctx, `
+		UPDATE subtasks SET status = $2, assignee_id = $3::uuid, due_date = $4::date,
+		       price = $5::numeric, equipment_id = $6::uuid, updated_at = now()
+		WHERE id = $1`, id, in.Status, in.AssigneeID, in.DueDate, in.Price, in.EquipmentID)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// Delete — design-sql.md §Delete Subtask Query: CASCADE subtask_products/subtask_logs
+// (FK ON DELETE CASCADE, миграция 0005/0006). 0 строк → errNotFound.
+func (r *SubtaskRepo) Delete(ctx context.Context, tx pgx.Tx, id string) error {
+	tag, err := tx.Exec(ctx, `DELETE FROM subtasks WHERE id = $1`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
diff --git a/internal/features/board/subtasks_service.go b/internal/features/board/subtasks_service.go
new file mode 100644
index 0000000..66d9cb2
--- /dev/null
+++ b/internal/features/board/subtasks_service.go
@@ -0,0 +1,227 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// CreateSubtask — POST /api/v1/tasks/:id/subtasks (AC-007/AC-008): финальная колонка —
+// 409 SUBTASK_FINAL_COLUMN; услуга не найдена/в архиве — 400 field service_id; иначе
+// Insert (позиция в конец) + CopyKit (типовой комплект по ТЕКУЩЕЙ цене товара) +
+// Reconcile (design-sql.md §Lock Order: «Мутации услуг/товаров... Reconcile при изменении
+// состава товаров»).
+func (s *CardService) CreateSubtask(ctx context.Context, a Actor, taskID string, in SubtaskCreateRequest) (*OrderCardMutationResponse, error) {
+	id, ok := parseTaskID(taskID)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "subtasks.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id), attribute.String("op", "create"))
+
+	var reconcile ReconcileResult
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		_, col, err := s.lockRowsScope(spanCtx, tx, id)
+		if err != nil {
+			return err
+		}
+		if col.IsFinal {
+			return ErrSubtaskFinalColumn
+		}
+
+		exists, active, err := s.subtasks.ServiceState(spanCtx, tx, in.ServiceID)
+		if err != nil {
+			return err
+		}
+		if !exists {
+			return errorspkg.Validation(errorspkg.Field{Name: "service_id", Message: msgNotFound})
+		}
+		if !active {
+			return errorspkg.Validation(errorspkg.Field{Name: "service_id", Message: msgArchived})
+		}
+
+		subtaskID, err := s.subtasks.Insert(spanCtx, tx, id, in.ServiceID)
+		if err != nil {
+			if errors.Is(err, errNotFound) {
+				// гонка: услуга стала неактивной/удалена между ServiceState и Insert.
+				return errorspkg.Validation(errorspkg.Field{Name: "service_id", Message: msgNotFound})
+			}
+			return err
+		}
+		span.SetAttributes(attribute.String("subtask_id", subtaskID))
+		if err := s.subtasks.CopyKit(spanCtx, tx, subtaskID, in.ServiceID); err != nil {
+			return err
+		}
+
+		res, err := s.engine.Reconcile(spanCtx, tx, id, col.ConsumesStock, a.ID)
+		if err != nil {
+			return err
+		}
+		reconcile = res
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, id, reconcile)
+}
+
+// UpdateSubtask — PUT /api/v1/subtasks/:id (LWW, AC-007/AC-011): done→не-done в финальной
+// колонке — 409 SUBTASK_FINAL_COLUMN; assignee_id — активный пользователь, ТОЛЬКО при
+// смене значения (SD-007); equipment_id — единица из оборудования ЭТОГО заказа. БЕЗ
+// Reconcile (состав товаров не меняется) — под тем же lockRowsScope (ADR-100).
+func (s *CardService) UpdateSubtask(ctx context.Context, a Actor, subtaskID string, in SubtaskUpdateRequest) (*OrderCardMutationResponse, error) {
+	if uuid.Validate(subtaskID) != nil {
+		return nil, ErrSubtaskNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "subtasks.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.String("subtask_id", subtaskID), attribute.String("op", "update"))
+
+	var taskID int64
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		tid, err := s.subtasks.TaskIDOf(spanCtx, tx, subtaskID)
+		if errors.Is(err, errNotFound) {
+			return ErrSubtaskNotFound
+		}
+		if err != nil {
+			return err
+		}
+		taskID = tid
+		span.SetAttributes(attribute.Int64("task_id", tid))
+
+		_, col, err := s.lockRowsScopeFor(spanCtx, tx, tid, ErrSubtaskNotFound)
+		if err != nil {
+			return err
+		}
+
+		cur, err := s.subtasks.Lock(spanCtx, tx, subtaskID, tid)
+		if errors.Is(err, errNotFound) {
+			return ErrSubtaskNotFound
+		}
+		if err != nil {
+			return err
+		}
+
+		if col.IsFinal && cur.Status == SubtaskStatusDone && in.Status != SubtaskStatusDone {
+			return ErrSubtaskFinalColumn
+		}
+
+		assigneeID := nilIfEmpty(in.AssigneeID)
+		if !samePtr(cur.AssigneeID, assigneeID) && assigneeID != nil {
+			ok, err := s.tasks.ActiveAssigneeExists(spanCtx, tx, *assigneeID)
+			if err != nil {
+				return err
+			}
+			if !ok {
+				return errorspkg.Validation(errorspkg.Field{Name: "assignee_id", Message: msgNotFound})
+			}
+		}
+
+		equipmentID := nilIfEmpty(in.EquipmentID)
+		if equipmentID != nil {
+			attached, err := s.equipment.Attached(spanCtx, tx, tid, *equipmentID)
+			if err != nil {
+				return err
+			}
+			if !attached {
+				return errorspkg.Validation(errorspkg.Field{Name: "equipment_id", Message: msgNotInOrder})
+			}
+		}
+
+		var priceStr *string
+		if in.Price != nil {
+			v := in.Price.String()
+			priceStr = &v
+		}
+
+		if err := s.subtasks.Update(spanCtx, tx, subtaskID, subtaskUpdateRow{
+			Status: in.Status, AssigneeID: assigneeID, DueDate: nilIfEmpty(in.DueDate),
+			Price: priceStr, EquipmentID: equipmentID,
+		}); err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrSubtaskNotFound
+			}
+			return err
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, taskID, ReconcileResult{Warnings: []StockWarning{}})
+}
+
+// DeleteSubtask — DELETE /api/v1/subtasks/:id (AC-007/AC-010): без ограничения по
+// финальной колонке (design-errors.md §Error Mapping — SUBTASK_FINAL_COLUMN только на
+// Create/PUT). CASCADE товары/журнал — Reconcile возвращает списанное на склад.
+func (s *CardService) DeleteSubtask(ctx context.Context, a Actor, subtaskID string) (*OrderCardMutationResponse, error) {
+	if uuid.Validate(subtaskID) != nil {
+		return nil, ErrSubtaskNotFound
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "subtasks.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.String("subtask_id", subtaskID), attribute.String("op", "delete"))
+
+	var taskID int64
+	var reconcile ReconcileResult
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		tid, err := s.subtasks.TaskIDOf(spanCtx, tx, subtaskID)
+		if errors.Is(err, errNotFound) {
+			return ErrSubtaskNotFound
+		}
+		if err != nil {
+			return err
+		}
+		taskID = tid
+		span.SetAttributes(attribute.Int64("task_id", tid))
+
+		_, col, err := s.lockRowsScopeFor(spanCtx, tx, tid, ErrSubtaskNotFound)
+		if err != nil {
+			return err
+		}
+
+		if _, err := s.subtasks.Lock(spanCtx, tx, subtaskID, tid); err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrSubtaskNotFound
+			}
+			return err
+		}
+
+		if err := s.subtasks.Delete(spanCtx, tx, subtaskID); err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrSubtaskNotFound
+			}
+			return err
+		}
+
+		res, err := s.engine.Reconcile(spanCtx, tx, tid, col.ConsumesStock, a.ID)
+		if err != nil {
+			return err
+		}
+		reconcile = res
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, taskID, reconcile)
+}
diff --git a/internal/features/board/subtasks_validate.go b/internal/features/board/subtasks_validate.go
new file mode 100644
index 0000000..3cbf5fc
--- /dev/null
+++ b/internal/features/board/subtasks_validate.go
@@ -0,0 +1,122 @@
+package board
+
+import (
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+// msgArchived/msgNotInOrder/msgNotPositive — коды полей фазы 6 (design-errors.md
+// §Validation Fields: «в архиве» / «нет в оборудовании заказа» / «должно быть больше 0»).
+const (
+	msgArchived   = "archived"
+	msgNotInOrder = "not_in_order"
+	msgNotPositive = "not_positive"
+)
+
+// priceScale/qtyScale — NUMERIC(12,2)/(12,3): subtasks.price, subtask_products.price
+// (Scale 10/2) и subtask_products.qty (Scale 9/3) (design-errors.md §Validation Fields).
+// Отдельная декларация в board (не импорт из catalog, ADR-101 — фичи друг от друга не
+// зависят).
+var (
+	priceScale = numeric.Scale{IntDigits: 10, FracDigits: 2}
+	qtyScale   = numeric.Scale{IntDigits: 9, FracDigits: 3}
+)
+
+func (in SubtaskCreateRequest) normalize() SubtaskCreateRequest {
+	in.ServiceID = strings.TrimSpace(in.ServiceID)
+	return in
+}
+
+// validate — формат service_id; существование/is_active — сервис (design-errors.md:
+// «404 — только id в пути», ссылки из тела — VALIDATION).
+func (in SubtaskCreateRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	switch {
+	case in.ServiceID == "":
+		f = append(f, errorspkg.Field{Name: "service_id", Message: msgRequired})
+	case uuid.Validate(in.ServiceID) != nil:
+		f = append(f, errorspkg.Field{Name: "service_id", Message: msgInvalid})
+	}
+	return f
+}
+
+// normalize — trim строковых указателей; пустая строка внутри указателя — «нет значения»
+// для сервиса (nilIfEmpty, эталон tasks_validate.go).
+func (in SubtaskUpdateRequest) normalize() SubtaskUpdateRequest {
+	in.Status = strings.TrimSpace(in.Status)
+	if in.AssigneeID != nil {
+		v := strings.TrimSpace(*in.AssigneeID)
+		in.AssigneeID = &v
+	}
+	if in.DueDate != nil {
+		v := strings.TrimSpace(*in.DueDate)
+		in.DueDate = &v
+	}
+	if in.EquipmentID != nil {
+		v := strings.TrimSpace(*in.EquipmentID)
+		in.EquipmentID = &v
+	}
+	return in
+}
+
+// validate — формат полей после normalize(); существование assignee_id/принадлежность
+// equipment_id заказу — сервис (design-errors.md §Validation Fields).
+func (in SubtaskUpdateRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	switch {
+	case in.Status == "":
+		add("status", msgRequired)
+	case !isSubtaskStatus(in.Status):
+		add("status", msgInvalid)
+	}
+
+	if in.AssigneeID != nil && *in.AssigneeID != "" && uuid.Validate(*in.AssigneeID) != nil {
+		add("assignee_id", msgInvalid)
+	}
+
+	if in.DueDate != nil && *in.DueDate != "" {
+		if _, err := time.Parse(dateLayout, *in.DueDate); err != nil {
+			add("due_date", msgInvalidDate)
+		}
+	}
+
+	if in.Price != nil {
+		if code := in.Price.Validate(priceScale, false); code != "" {
+			add("price", code)
+		}
+	}
+
+	if in.EquipmentID != nil && *in.EquipmentID != "" && uuid.Validate(*in.EquipmentID) != nil {
+		add("equipment_id", msgInvalid)
+	}
+	return f
+}
+
+func isSubtaskStatus(v string) bool {
+	for _, s := range SubtaskStatuses {
+		if s == v {
+			return true
+		}
+	}
+	return false
+}
+
+// isZeroAmount — decimalRe (pkg/numeric) уже гарантирует чистый десятичный формат без
+// знака (для qty allowNegative=false отрицательное отсекается раньше в Validate) — «0»
+// проверяется как отсутствие значащих цифр, кроме '0'/'.' (design-errors.md: qty «>0»,
+// сам numeric.Amount.Validate допускает 0 как валидное неотрицательное значение).
+func isZeroAmount(a numeric.Amount) bool {
+	for _, ch := range string(a) {
+		if ch != '0' && ch != '.' {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/features/board/task_equipment_repo.go b/internal/features/board/task_equipment_repo.go
new file mode 100644
index 0000000..cbcd3cf
--- /dev/null
+++ b/internal/features/board/task_equipment_repo.go
@@ -0,0 +1,123 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// TaskEquipmentRepo — оборудование заказа (design-sql.md §Task Equipment Queries,
+// §Foreign Equipment Query). Без pool: все методы принимают чужую tx (мутации всегда под
+// LockTask, ADR-104).
+type TaskEquipmentRepo struct{}
+
+func NewTaskEquipmentRepo() *TaskEquipmentRepo { return &TaskEquipmentRepo{} }
+
+// EquipmentClient — владелец единицы (для сравнения с tasks.client_id, AC-004).
+func (r *TaskEquipmentRepo) EquipmentClient(ctx context.Context, tx pgx.Tx, equipmentID string) (string, error) {
+	var clientID string
+	err := tx.QueryRow(ctx, `SELECT client_id FROM equipment WHERE id = $1`, equipmentID).Scan(&clientID)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return "", errNotFound
+	}
+	return clientID, err
+}
+
+// Insert — идемпотентно (ON CONFLICT DO NOTHING): повторный POST той же единицы — 201 без
+// изменений, не ошибка (design-errors.md §Validation Fields).
+func (r *TaskEquipmentRepo) Insert(ctx context.Context, tx pgx.Tx, taskID int64, in TaskEquipmentCreateRequest) error {
+	_, err := tx.Exec(ctx, `
+		INSERT INTO task_equipment (task_id, equipment_id, completeness, condition) VALUES ($1, $2, $3, $4)
+		ON CONFLICT (task_id, equipment_id) DO NOTHING`,
+		taskID, in.EquipmentID, in.Completeness, in.Condition)
+	return err
+}
+
+// Update — 0 строк → errNotFound (ErrTaskEquipmentNotFound).
+func (r *TaskEquipmentRepo) Update(ctx context.Context, tx pgx.Tx, taskID int64, equipmentID string, in TaskEquipmentUpdateRequest) error {
+	tag, err := tx.Exec(ctx, `
+		UPDATE task_equipment SET completeness = $3, condition = $4 WHERE task_id = $1 AND equipment_id = $2`,
+		taskID, equipmentID, in.Completeness, in.Condition)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// UsedBy — незавершённые/все услуги заказа, где выбрана эта единица оборудования
+// (design-sql.md: «удаление единицы»). Непустой результат → 409 TASK_EQUIPMENT_IN_USE.
+func (r *TaskEquipmentRepo) UsedBy(ctx context.Context, tx pgx.Tx, taskID int64, equipmentID string) ([]OpenSubtask, error) {
+	rows, err := tx.Query(ctx, `
+		SELECT s.id, sv.name, s.status FROM subtasks s JOIN services sv ON sv.id = s.service_id
+		WHERE s.task_id = $1 AND s.equipment_id = $2 ORDER BY s.position, s.id`, taskID, equipmentID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []OpenSubtask{}
+	for rows.Next() {
+		var o OpenSubtask
+		if err := rows.Scan(&o.ID, &o.ServiceName, &o.Status); err != nil {
+			return nil, err
+		}
+		out = append(out, o)
+	}
+	return out, rows.Err()
+}
+
+// Delete — 0 строк → errNotFound (ErrTaskEquipmentNotFound).
+func (r *TaskEquipmentRepo) Delete(ctx context.Context, tx pgx.Tx, taskID int64, equipmentID string) error {
+	tag, err := tx.Exec(ctx, `DELETE FROM task_equipment WHERE task_id = $1 AND equipment_id = $2`, taskID, equipmentID)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// Attached — единица уже принята в заказ (design-errors.md §Validation Fields: `subtasks.
+// equipment_id` — «NULL или единица из task_equipment этого заказа», используется
+// валидатором услуги в фазе 03).
+func (r *TaskEquipmentRepo) Attached(ctx context.Context, tx pgx.Tx, taskID int64, equipmentID string) (bool, error) {
+	var exists bool
+	err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM task_equipment WHERE task_id = $1 AND equipment_id = $2)`,
+		taskID, equipmentID).Scan(&exists)
+	return exists, err
+}
+
+// ForeignInUse — design-sql.md §Foreign Equipment Query: смена client_id заказа — открытые
+// (по позиции) услуги с оборудованием ПРЕЖНЕГО клиента.
+func (r *TaskEquipmentRepo) ForeignInUse(ctx context.Context, tx pgx.Tx, taskID int64, clientID string) ([]OpenSubtask, error) {
+	rows, err := tx.Query(ctx, `
+		SELECT s.id, sv.name, s.status
+		FROM subtasks s JOIN services sv ON sv.id = s.service_id JOIN equipment e ON e.id = s.equipment_id
+		WHERE s.task_id = $1 AND e.client_id <> $2 ORDER BY s.position, s.id`, taskID, clientID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []OpenSubtask{}
+	for rows.Next() {
+		var o OpenSubtask
+		if err := rows.Scan(&o.ID, &o.ServiceName, &o.Status); err != nil {
+			return nil, err
+		}
+		out = append(out, o)
+	}
+	return out, rows.Err()
+}
+
+// DeleteForeign — чужие (после смены клиента) task_equipment убираются из заказа молча
+// (design-sql.md §Foreign Equipment Query).
+func (r *TaskEquipmentRepo) DeleteForeign(ctx context.Context, tx pgx.Tx, taskID int64, clientID string) error {
+	_, err := tx.Exec(ctx, `
+		DELETE FROM task_equipment te USING equipment e
+		WHERE te.task_id = $1 AND e.id = te.equipment_id AND e.client_id <> $2`, taskID, clientID)
+	return err
+}
diff --git a/internal/features/board/task_equipment_service.go b/internal/features/board/task_equipment_service.go
new file mode 100644
index 0000000..ec6857f
--- /dev/null
+++ b/internal/features/board/task_equipment_service.go
@@ -0,0 +1,133 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// AddEquipment — POST /api/v1/tasks/:id/equipment (AC-004/AC-005): LockTask (без колонки —
+// design-sql.md §Lock Order, оборудование её не читает), проверка принадлежности клиенту
+// заказа, Insert идемпотентно.
+func (s *CardService) AddEquipment(ctx context.Context, a Actor, taskID string, in TaskEquipmentCreateRequest) (*OrderCardMutationResponse, error) {
+	id, ok := parseTaskID(taskID)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "task_equipment.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id), attribute.String("op", "add"))
+
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		task, err := s.tasks.LockTask(spanCtx, tx, id)
+		if err != nil {
+			return taskLockError(err)
+		}
+
+		clientID, err := s.equipment.EquipmentClient(spanCtx, tx, in.EquipmentID)
+		if errors.Is(err, errNotFound) {
+			return errorspkg.Validation(errorspkg.Field{Name: "equipment_id", Message: msgNotFound})
+		}
+		if err != nil {
+			return err
+		}
+		if clientID != task.ClientID {
+			return errorspkg.Validation(errorspkg.Field{Name: "equipment_id", Message: msgForeignClient})
+		}
+
+		return s.equipment.Insert(spanCtx, tx, id, in)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, id, ReconcileResult{Warnings: []StockWarning{}})
+}
+
+// UpdateEquipment — PUT /api/v1/tasks/:id/equipment/:equipment_id. equipment_id — path,
+// не тело: невалидный формат/отсутствующая строка → 404 (design-errors.md: «404 — только
+// id в пути»).
+func (s *CardService) UpdateEquipment(ctx context.Context, a Actor, taskID, equipmentID string, in TaskEquipmentUpdateRequest) (*OrderCardMutationResponse, error) {
+	id, ok := parseTaskID(taskID)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	if uuid.Validate(equipmentID) != nil {
+		return nil, ErrTaskEquipmentNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "task_equipment.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id), attribute.String("op", "update"))
+
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		if _, err := s.tasks.LockTask(spanCtx, tx, id); err != nil {
+			return taskLockError(err)
+		}
+		if err := s.equipment.Update(spanCtx, tx, id, equipmentID, in); err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrTaskEquipmentNotFound
+			}
+			return err
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, id, ReconcileResult{Warnings: []StockWarning{}})
+}
+
+// RemoveEquipment — DELETE /api/v1/tasks/:id/equipment/:equipment_id. Единица выбрана в
+// открытых услугах заказа → 409 TASK_EQUIPMENT_IN_USE + details.subtasks (AC-004).
+func (s *CardService) RemoveEquipment(ctx context.Context, a Actor, taskID, equipmentID string) (*OrderCardMutationResponse, error) {
+	id, ok := parseTaskID(taskID)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	if uuid.Validate(equipmentID) != nil {
+		return nil, ErrTaskEquipmentNotFound
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "task_equipment.mutate")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id), attribute.String("op", "remove"))
+
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		if _, err := s.tasks.LockTask(spanCtx, tx, id); err != nil {
+			return taskLockError(err)
+		}
+		open, err := s.equipment.UsedBy(spanCtx, tx, id, equipmentID)
+		if err != nil {
+			return err
+		}
+		if len(open) > 0 {
+			return ErrTaskEquipmentInUse.WithDetail("subtasks", open)
+		}
+		if err := s.equipment.Delete(spanCtx, tx, id, equipmentID); err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrTaskEquipmentNotFound
+			}
+			return err
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, id, ReconcileResult{Warnings: []StockWarning{}})
+}
