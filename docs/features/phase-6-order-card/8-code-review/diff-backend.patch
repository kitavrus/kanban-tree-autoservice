+func (s *OrderCardLiveSuite) newClient(company string) string {
+	var id string
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`INSERT INTO clients (company_name) VALUES ($1) RETURNING id`, company).Scan(&id))
+	return id
+}
