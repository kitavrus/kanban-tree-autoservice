+++ b/e2e/fixtures/board-types.ts
@@ -0,0 +1,100 @@
+// Wire-типы доски — 1:1 по json-тегам DTO (source: internal/features/board/*_dto.go,
+// §TD-6.2). Amount-поля (StockWarning.stock/min_stock) — numeric.Amount, в TS number|string.
+
+export type StockWarning = {
+  product_id: string;
+  name: string;
+  stock: number | string;
+  min_stock: number | string;
+  kind: 'negative' | 'below_min';
+};
+
+export type Column = {
+  id: string;
+  name: string;
+  color: string;
+  is_final: boolean;
+  consumes_stock: boolean;
+  position: number;
+  tasks_count: number;
+};
+
+export type NewColumn = {
+  name: string;
+  color: string;
+  is_final: boolean;
+  consumes_stock: boolean;
+  position?: number | null;
+};
+
+export type ColumnMutationResponse = { column: Column; warnings: StockWarning[] };
+
+export type TaskCard = {
+  id: number;
+  column_id: string;
+  client_id: string;
+  client_name: string;
+  title: string;
+  assignee_id: string | null;
+  assignee_name: string | null;
+  due_date: string | null;
+  is_paid: boolean;
+  position: string;
+  version: number;
+  subtasks_total: number;
+  subtasks_done: number;
+  subtasks_late: number;
+};
+
+export type Task = TaskCard & {
+  paid_at: string | null;
+  created_at: string;
+  updated_at: string;
+};
+
+export type NewTask = {
+  title: string;
+  client_id: string;
+  column_id: string;
+  assignee_id?: string | null;
+  due_date?: string | null;
+  is_paid?: boolean | null;
+};
+
+export type UpdateTask = NewTask & { version: number };
+
+export type MoveTask = { column_id: string; prev_id?: number | null; next_id?: number | null };
+
+export type TaskMutationResponse = { task: Task; warnings: StockWarning[] };
+export type TaskDeleteResponse = { warnings: StockWarning[] };
+
+export type ApiErrorSubtask = { id: string; service_name: string; status: 'new' | 'in_progress' | 'done' };
+export type ApiErrorSubtasks = { code: 'SUBTASKS_NOT_DONE'; message: string; details: { subtasks: ApiErrorSubtask[] } };
+
+// Wire-типы экрана «Остатки» (internal/features/board/stock_dto.go, §TD-6.2). Amount-поля
+// (stock/min_stock/pending/forecast) — numeric.Amount, на wire JSON-число без кавычек.
+export type StockScope = 'risky' | 'all';
+export type StockState = 'out' | 'low' | 'will_low' | 'ok';
+
+export type StockRow = {
+  product_id: string;
+  name: string;
+  unit: string;
+  box: string;
+  place: string;
+  stock: number;
+  min_stock: number;
+  pending: number;
+  forecast: number;
+  state: StockState;
+};
+
+export type StockListResponse = { items: StockRow[]; total: number; limit: number; offset: number };
+
+export type StockSummaryResponse = {
+  products_total: number;
+  low_count: number;
+  out_count: number;
+  will_low_count: number;
+  risk_count: number;
+};
diff --git a/e2e/fixtures/board.ts b/e2e/fixtures/board.ts
new file mode 100644
index 0000000..b7a1d50
--- /dev/null
+++ b/e2e/fixtures/board.ts
@@ -0,0 +1,82 @@
+import { Pool } from 'pg';
+import { test as base } from './test';
+import type { Column } from './board-types';
+
+// pg-хелпер доски (ADR-103): подзадачи (услуги в заказе) и принятое оборудование заказа
+// у доски фазы 6 нет собственного API создания/правки (это фаза 7+) — единственный способ
+// завести их для E2E-фикстур (BD-003/BD-018) без тестового HTTP-эндпоинта в сервере —
+// прямая вставка в БД для заказа, созданного через настоящий API (AdminApi.createTask).
+// Подключение — E2E_DATABASE_URL, иначе тот же дефолт стенда, что и scripts/dev/env.sh.
+const DATABASE_URL = process.env.E2E_DATABASE_URL ?? process.env.DATABASE_URL ?? 'postgres://admin:dev@127.0.0.1:5432/app?sslmode=disable';
+
+export type SubtaskStatus = 'new' | 'in_progress' | 'done';
+
+export type NewSubtask = {
+  taskId: number;
+  serviceId: string;
+  status?: SubtaskStatus;
+  dueDate?: string | null;
+  products?: Array<{ productId: string; qty: number }>;
+};
+
+type BoardFixtures = {
+  /** Вставляет подзадачу (услугу заказа) напрямую в БД — возвращает id подзадачи. */
+  insertSubtask: (s: NewSubtask) => Promise<string>;
+  /** Меняет статус подзадачи (у доски фазы 6 нет API редактирования подзадач). */
+  setSubtaskStatus: (subtaskId: string, status: SubtaskStatus) => Promise<void>;
+  /** Отмечает оборудование клиента как принятое в заказе (task_equipment). */
+  insertTaskEquipment: (taskId: number, equipmentId: string) => Promise<void>;
+};
+
+type BoardWorkerFixtures = {
+  boardPool: Pool;
+};
+
+export const test = base.extend<BoardFixtures, BoardWorkerFixtures>({
+  boardPool: [
+    async ({}, use) => {
+      const pool = new Pool({ connectionString: DATABASE_URL });
+      await use(pool);
+      await pool.end();
+    },
+    { scope: 'worker' },
+  ],
+
+  insertSubtask: async ({ boardPool }, use) => {
+    await use(async (s) => {
+      const res = await boardPool.query<{ id: string }>(
+        `INSERT INTO subtasks (task_id, service_id, status, due_date) VALUES ($1, $2, $3, $4) RETURNING id`,
+        [s.taskId, s.serviceId, s.status ?? 'new', s.dueDate ?? null],
+      );
+      const subtaskId = res.rows[0].id;
+      for (const p of s.products ?? []) {
+        await boardPool.query(`INSERT INTO subtask_products (subtask_id, product_id, qty) VALUES ($1, $2, $3)`, [subtaskId, p.productId, p.qty]);
+      }
+      return subtaskId;
+    });
+  },
+
+  setSubtaskStatus: async ({ boardPool }, use) => {
+    await use(async (subtaskId, status) => {
+      await boardPool.query(`UPDATE subtasks SET status = $2, updated_at = now() WHERE id = $1`, [subtaskId, status]);
+    });
+  },
+
+  insertTaskEquipment: async ({ boardPool }, use) => {
+    await use(async (taskId, equipmentId) => {
+      await boardPool.query(
+        `INSERT INTO task_equipment (task_id, equipment_id) VALUES ($1, $2) ON CONFLICT (task_id, equipment_id) DO NOTHING`,
+        [taskId, equipmentId],
+      );
+    });
+  },
+});
+
+/** Колонка сида D32 по названию (AC-008) — колонки создаются миграцией, id непредсказуем. */
+export function columnByName(columns: Column[], name: string): Column {
+  const c = columns.find((x) => x.name === name);
+  if (!c) throw new Error(`колонка «${name}» не найдена среди: ${columns.map((x) => x.name).join(', ')}`);
+  return c;
+}
+
+export { expect } from './test';
