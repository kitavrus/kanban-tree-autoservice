+++ b/e2e/pages/StockPage.ts
@@ -0,0 +1,71 @@
+import { expect, type Locator, type Page } from '@playwright/test';
+
+// POM экрана «Остатки» «/stock» (design-go-layers.md §Frontend Modules testid-контракт,
+// эталон структуры — e2e/pages/BoardPage.ts). Переключатель scope — обычный <select>,
+// превращённый js/combobox.js в комбобокс: testid уходит на видимую кнопку, выбор — клик
+// по кнопке и затем по `.cb-opt` в `combobox-dropdown` (как у фильтров доски).
+export class StockPage {
+  readonly root: Locator;
+  readonly kpiTotal: Locator;
+  readonly kpiLow: Locator;
+  readonly kpiOut: Locator;
+  readonly kpiWillLow: Locator;
+  readonly scope: Locator;
+  readonly q: Locator;
+  readonly table: Locator;
+  readonly empty: Locator;
+  readonly dropdown: Locator;
+
+  readonly form: Locator;
+  readonly value: Locator;
+  readonly save: Locator;
+  readonly error: Locator;
+
+  constructor(readonly page: Page) {
+    this.root = page.getByTestId('stock-root');
+    this.kpiTotal = page.getByTestId('stock-kpi-total');
+    this.kpiLow = page.getByTestId('stock-kpi-low');
+    this.kpiOut = page.getByTestId('stock-kpi-out');
+    this.kpiWillLow = page.getByTestId('stock-kpi-will-low');
+    this.scope = page.getByTestId('stock-scope');
+    this.q = page.getByTestId('stock-q');
+    this.table = page.getByTestId('stock-table');
+    this.empty = page.getByTestId('stock-empty');
+    this.dropdown = page.getByTestId('combobox-dropdown');
+
+    this.form = page.getByTestId('stock-form');
+    this.value = page.getByTestId('stock-value');
+    this.save = page.getByTestId('stock-save');
+    this.error = page.getByTestId('stock-error');
+  }
+
+  async goto() {
+    await this.page.goto('/stock');
+    await expect(this.root).toBeVisible();
+  }
+
+  row(productId: string): Locator {
+    return this.page.getByTestId(`stock-row-${productId}`);
+  }
+
+  editBtn(productId: string): Locator {
+    return this.page.getByTestId(`stock-edit-${productId}`);
+  }
+
+  /** Выбор опции в комбобоксе переключателя scope по видимому тексту. */
+  async chooseScope(optionText: string) {
+    await this.scope.click();
+    await expect(this.dropdown).toBeVisible();
+    await this.dropdown.locator('.cb-opt', { hasText: optionText }).first().click();
+  }
+
+  async openEdit(productId: string) {
+    await this.editBtn(productId).click();
+    await expect(this.form).toBeVisible();
+  }
+
+  async submitValue(value: string | number) {
+    await this.value.fill(String(value));
+    await this.save.click();
+  }
+}
diff --git a/e2e/tests/board-guards.spec.ts b/e2e/tests/board-guards.spec.ts
new file mode 100644
index 0000000..ad1da13
--- /dev/null
+++ b/e2e/tests/board-guards.spec.ts
@@ -0,0 +1,129 @@
+import { test, expect } from '../fixtures/board';
+import { ClientsPage } from '../pages/ClientsPage';
+import { EquipmentPage } from '../pages/EquipmentPage';
+import { CatalogPage } from '../pages/CatalogPage';
+
+// Фаза 8 (D26): E2E-гарды поверх backend-гардов фазы 01 — удаление клиента/оборудования/
+// товара/услуги, на которые ссылается заказ, отклоняется (409), сущность остаётся на месте,
+// форма показывает понятное сообщение вместо голого JSON (эталон CT-005 catalog.spec.ts —
+// там уже проверен PRODUCT_IN_USE через комплект услуги; здесь — через реальный заказ,
+// design-errors.md §Codes 01-15 #07/#08/#09/#15).
+test.use({ colorScheme: 'light' });
+
+test.describe('BD: нельзя удалить клиента с заказами (AC-017)', () => {
+  test('BD-017: удаление клиента с заказом — сообщение, клиент остаётся', async ({ adminPage: page, adminApi, uniq, allowHttpErrors }) => {
+    const company = uniq('BD-017 клиент с заказом');
+    const client = await adminApi.createClient({ company_name: company, phones: [{ phone: '9990001111', note: '' }] });
+    const columns = (await adminApi.listColumns()).items;
+    await adminApi.createTask({ title: uniq('BD-017 заказ'), client_id: client.id, column_id: columns[0].id });
+
+    allowHttpErrors((url, status) => url.endsWith(`/clients/${client.id}/delete`) && status === 409);
+
+    const clients = new ClientsPage(page);
+    await clients.goto(`?q=${company}`);
+    await clients.open(company);
+    await clients.confirmDelete();
+
+    // карточка перерисована с сообщением (POST не редиректит на список — форма остаётся
+    // с данными клиента, не голый JSON из FiberErrorHandler).
+    await expect(clients.formError).toContainText('заказы');
+    await expect(clients.companyName).toHaveValue(company);
+
+    // клиент по-прежнему присутствует в списке.
+    await clients.goto(`?q=${company}`);
+    await expect(clients.row(company)).toBeVisible();
+  });
+});
+
+test.describe('BD: нельзя удалить оборудование, бывшее в заказе (AC-018)', () => {
+  test('BD-018: удаление оборудования из заказа — сообщение, оборудование остаётся', async ({
+    adminPage: page,
+    adminApi,
+    uniq,
+    allowHttpErrors,
+    insertTaskEquipment,
+  }) => {
+    const company = uniq('BD-018 клиент оборудования');
+    const client = await adminApi.createClient({ company_name: company, phones: [{ phone: '9990002222', note: '' }] });
+    const type = await adminApi.createEquipmentType({ name: uniq('BD-018 тип') });
+    const equipment = await adminApi.createEquipment(client.id, { type_id: type.id, model: uniq('BD-018 модель') });
+    const columns = (await adminApi.listColumns()).items;
+    const task = await adminApi.createTask({ title: uniq('BD-018 заказ'), client_id: client.id, column_id: columns[0].id });
+    await insertTaskEquipment(task.id, equipment.id);
+
+    allowHttpErrors((url, status) => url.endsWith(`/equipment/${equipment.id}/delete`) && status === 409);
+
+    const eq = new EquipmentPage(page);
+    await eq.gotoEdit(equipment.id);
+    await eq.confirmDelete();
+
+    // оборудование остаётся на карточке — форма показывает сообщение.
+    await expect(eq.formError).toContainText('заказе');
+
+    // оборудование по-прежнему присутствует у клиента.
+    const clients = new ClientsPage(page);
+    await clients.goto(`?q=${company}`);
+    await clients.open(company);
+    await expect(page.getByTestId('equipment-table')).toContainText(equipment.model);
+  });
+});
+
+test.describe('BD: нельзя удалить товар, использованный в заказе (PRODUCT_IN_USE)', () => {
+  test('BD-019a: товар в subtask_products действующего заказа — сообщение, не 500', async ({
+    adminPage: page,
+    adminApi,
+    uniq,
+    allowHttpErrors,
+    insertSubtask,
+  }) => {
+    const prodCat = await adminApi.createCategory({ kind: 'product', name: uniq('BD-019a категория товаров') });
+    const product = await adminApi.createProduct({ category_id: prodCat.id, name: uniq('BD-019a товар') });
+    const svcCat = await adminApi.createCategory({ kind: 'service', name: uniq('BD-019a категория услуг') });
+    const svc = await adminApi.createService({ category_id: svcCat.id, name: uniq('BD-019a услуга') });
+    const client = await adminApi.createClient({ company_name: uniq('BD-019a клиент'), phones: [{ phone: '9990003333', note: '' }] });
+    const columns = (await adminApi.listColumns()).items;
+    const task = await adminApi.createTask({ title: uniq('BD-019a заказ'), client_id: client.id, column_id: columns[0].id });
+    await insertSubtask({ taskId: task.id, serviceId: svc.id, products: [{ productId: product.id, qty: 1 }] });
+
+    allowHttpErrors((url, status) => url.includes(`/catalog/products/${product.id}/delete`) && status === 409);
+
+    const catalog = new CatalogPage(page);
+    await catalog.gotoProducts();
+    await catalog.open(product.name);
+    await catalog.confirmDelete();
+
+    // не 500 — форма показывает понятное сообщение (design-errors.md #15), товар остаётся.
+    await expect(catalog.formError).toContainText('используется в услугах, заказах или журнале склада');
+    await catalog.gotoProducts();
+    await expect(catalog.row(product.name)).toBeVisible();
+  });
+});
+
+test.describe('BD: нельзя удалить услугу, использованную в заказе (SERVICE_IN_USE)', () => {
+  test('BD-019b: услуга в subtasks действующего заказа — сообщение, не 500', async ({
+    adminPage: page,
+    adminApi,
+    uniq,
+    allowHttpErrors,
+    insertSubtask,
+  }) => {
+    const svcCat = await adminApi.createCategory({ kind: 'service', name: uniq('BD-019b категория услуг') });
+    const svc = await adminApi.createService({ category_id: svcCat.id, name: uniq('BD-019b услуга') });
+    const client = await adminApi.createClient({ company_name: uniq('BD-019b клиент'), phones: [{ phone: '9990004444', note: '' }] });
+    const columns = (await adminApi.listColumns()).items;
+    const task = await adminApi.createTask({ title: uniq('BD-019b заказ'), client_id: client.id, column_id: columns[0].id });
+    await insertSubtask({ taskId: task.id, serviceId: svc.id });
+
+    allowHttpErrors((url, status) => url.includes(`/catalog/services/${svc.id}/delete`) && status === 409);
+
+    const catalog = new CatalogPage(page);
+    await catalog.gotoServices();
+    await catalog.openService(svc.name);
+    await catalog.confirmServiceDelete();
+
+    // не 500 — форма показывает сообщение (design-errors.md §Codes 01-15 #09), услуга остаётся.
+    await expect(catalog.formError).toContainText('используется в заказах');
+    await catalog.gotoServices();
+    await expect(catalog.serviceRow(svc.name)).toBeVisible();
+  });
+});
diff --git a/e2e/tests/board.spec.ts b/e2e/tests/board.spec.ts
