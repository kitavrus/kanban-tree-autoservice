@@ -0,0 +1,167 @@
+package board
+
+import (
+	"context"
+	"errors"
+	"math"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// FuzzColumnInputValidate — TD-7/design-tests.md §Fuzz Targets: normalize()+validate() не
+// должны паниковать на произвольном вводе (мусорный цвет, экстремальная позиция).
+func FuzzColumnInputValidate(f *testing.F) {
+	f.Add("Новые", "#94A3B8", false, false, 1)
+	f.Add("", "#GGGGGG", false, false, 0)
+	f.Add("x", "#fff", true, true, math.MinInt)
+	f.Add("y", "", false, true, math.MaxInt)
+
+	f.Fuzz(func(t *testing.T, name, color string, isFinal, consumesStock bool, position int) {
+		in := ColumnInput{Name: name, Color: color, IsFinal: isFinal, ConsumesStock: consumesStock, Position: &position}
+		_ = in.normalize().validate()
+	})
+}
+
+// FuzzParseTaskFilter — design-tests.md §Fuzz Targets: одна и та же произвольная строка
+// подставляется во ВСЕ query-параметры ParseTaskFilter (url.Values-вход, безопасное
+// percent-кодирование через Values.Encode — сырые байты в URL не ломают http.Request).
+// Инвариант: без паники; единственная допустимая ошибка — *errorspkg.AppError 400.
+func FuzzParseTaskFilter(f *testing.F) {
+	for _, s := range []string{"#", "#0", "#999999999999999999999", "%", "_\\", "me", "all", validUUID, "\x00abc", "日本語ラベル"} {
+		f.Add(s)
+	}
+
+	app := fiber.New()
+	var gotErr error
+	app.Get("/x", func(c fiber.Ctx) error {
+		_, gotErr = ParseTaskFilter(c, admin)
+		return c.SendStatus(fiber.StatusOK)
+	})
+
+	f.Fuzz(func(t *testing.T, s string) {
+		// Кап по БАЙТАМ (не рунам) — невалидный UTF-8 после []rune()/percent-encoding может
+		// раздуться до x9 (replacement-рута U+FFFD → 3 байта → "%EF%BF%BD"); тестовый
+		// транспорт (fasthttp app.Test) читает запрос через буфер 4096 байт. ParseTaskFilter
+		// сама кэпит длину q до 100 рун (taskFilterQMax) — инвариант не теряется.
+		if len(s) > 120 {
+			s = s[:120]
+		}
+		v := url.Values{}
+		for _, key := range []string{"q", "client_id", "category_id", "paid", "assignee", "due", "limit", "offset"} {
+			v.Set(key, s)
+		}
+		req := httptest.NewRequest(fiber.MethodGet, "/x?"+v.Encode(), nil)
+		resp, err := app.Test(req)
+		if err != nil {
+			t.Fatalf("app.Test: %v", err)
+		}
+		_ = resp.Body.Close()
+		if gotErr == nil {
+			return
+		}
+		var appErr *errorspkg.AppError
+		if !errors.As(gotErr, &appErr) || appErr.HTTP != fiber.StatusBadRequest {
+			t.Fatalf("ParseTaskFilter(%q): ошибка не 400 *errorspkg.AppError: %v", s, gotErr)
+		}
+	})
+}
+
+// FuzzTaskInputValidate — design-tests.md §Fuzz Targets: normalize()+validate() не должны
+// паниковать; поля ошибок — подмножество {title, client_id, column_id, assignee_id,
+// due_date} (version — только у TaskUpdateRequest, здесь не участвует).
+func FuzzTaskInputValidate(f *testing.F) {
+	f.Add("Заказ", validUUID, validUUID, "", "", false)
+	f.Add("", "", "", "\x00", "2026-02-30", true)
+	f.Add(strings.Repeat("я", 250), "not-a-uuid", "not-a-uuid", "bad", "bad-date", false)
+	f.Add(strings.Repeat("a", 201), validUUID, validUUID, validUUID, "2026-01-15", true)
+
+	allowed := map[string]bool{"title": true, "client_id": true, "column_id": true, "assignee_id": true, "due_date": true}
+
+	f.Fuzz(func(t *testing.T, title, clientID, columnID, assigneeID, dueDate string, isPaid bool) {
+		in := TaskCreateRequest{
+			Title: title, ClientID: clientID, ColumnID: columnID,
+			AssigneeID: &assigneeID, DueDate: &dueDate, IsPaid: &isPaid,
+		}
+		for _, fld := range in.normalize().validate() {
+			if !allowed[fld.Name] {
+				t.Fatalf("неожиданное поле в ошибках валидации: %s", fld.Name)
+			}
+		}
+	})
+}
+
+// fakeMoveTaskService — реализация taskService для FuzzMoveBody (§9.1: app.Test —
+// единственное допустимое исключение из запрета для новых тестов, т.к. фаззинг без БД
+// требует чистой in-process сборки; фейк реализует полный интерфейс структурно).
+type fakeMoveTaskService struct{}
+
+func (fakeMoveTaskService) List(context.Context, TaskFilter) (*TaskListResponse, error) {
+	return nil, nil
+}
+func (fakeMoveTaskService) Get(context.Context, string) (*TaskResponse, error) { return nil, nil }
+func (fakeMoveTaskService) Create(context.Context, Actor, TaskCreateRequest) (*TaskMutationResponse, error) {
+	return nil, nil
+}
+func (fakeMoveTaskService) Update(context.Context, Actor, string, TaskUpdateRequest) (*TaskMutationResponse, error) {
+	return nil, nil
+}
+func (fakeMoveTaskService) Delete(context.Context, Actor, string) (*TaskDeleteResponse, error) {
+	return nil, nil
+}
+
+// Move — покрывает диапазон {200,400,404,409} по форме входа, без обращения к БД.
+func (fakeMoveTaskService) Move(_ context.Context, _ Actor, _ string, in TaskMoveRequest) (*TaskMutationResponse, error) {
+	switch {
+	case in.ColumnID == "":
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "column_id", Message: msgRequired})
+	case uuid.Validate(in.ColumnID) != nil:
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "column_id", Message: msgInvalid})
+	case in.ColumnID == "00000000-0000-0000-0000-000000000000":
+		return nil, ErrTaskNotFound
+	case in.PrevID != nil && in.NextID != nil && *in.PrevID == *in.NextID:
+		return nil, ErrSubtasksNotDone
+	default:
+		return &TaskMutationResponse{Warnings: []StockWarning{}}, nil
+	}
+}
+
+// FuzzMoveBody — design-tests.md §Fuzz Targets: POST move через app.Test (исключение
+// §9.1) — статус ∈ {200,400,404,409}, никогда 5xx, вне зависимости от формы тела.
+func FuzzMoveBody(f *testing.F) {
+	f.Add(`{}`)
+	f.Add(`{"prev_id":1e99}`)
+	f.Add(`[]`)
+	f.Add(`null`)
+	f.Add(`{"column_id":"` + validUUID + `"}`)
+	f.Add(`{"column_id":"` + validUUID + `","prev_id":1,"next_id":1}`)
+	f.Add(`{"column_id":"not-a-uuid"}`)
+
+	app := fiber.New(fiber.Config{ErrorHandler: errorspkg.FiberErrorHandler})
+	app.Use(func(c fiber.Ctx) error {
+		c.Locals(middleware.PrincipalKey, &middleware.Principal{ID: validUUID, Role: middleware.RoleAdmin, IsActive: true})
+		return c.Next()
+	})
+	h := NewTasksHandler(fakeMoveTaskService{})
+	app.Post("/tasks/:id/move", h.Move)
+
+	f.Fuzz(func(t *testing.T, body string) {
+		req := httptest.NewRequest(fiber.MethodPost, "/tasks/1/move", strings.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := app.Test(req)
+		if err != nil {
+			t.Fatalf("app.Test: %v", err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode >= 500 {
+			t.Fatalf("5xx для тела %q: %d", body, resp.StatusCode)
+		}
+	})
+}
diff --git a/internal/features/board/board_http_live_test.go b/internal/features/board/board_http_live_test.go
new file mode 100644
index 0000000..5cd1a32
--- /dev/null
+++ b/internal/features/board/board_http_live_test.go
@@ -0,0 +1,1375 @@
+//go:build integration
+
+package board_test
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// BoardLiveSuite (§TD-8): доска — колонки, заказы, move, склад, фильтры, права,
+// конкурентность. Реальный бинарь + TCP + реальный логин; auth-стабы и app.Test (кроме
+// *_fuzz_test.go) запрещены.
+type BoardLiveSuite struct {
+	testutil.LiveSuite
+	admin *testutil.Browser
+}
+
+func TestBoardLiveSuite(t *testing.T) {
+	suite.Run(t, &BoardLiveSuite{LiveSuite: testutil.LiveSuite{BinaryPkg: "./cmd/server"}})
+}
+
+func (s *BoardLiveSuite) SetupSuite() {
+	s.LiveSuite.SetupSuite()
+	s.SeedUser("board-admin", "password1", "Доска Админ", "admin", true)
+	s.admin = s.NewBrowser()
+	s.admin.Login("board-admin", "password1")
+}
+
+// ---- DTO wire-типы (1:1 с internal/features/board/*_dto.go, §TD-6.2) ----
+
+type columnDTO struct {
+	ID            string `json:"id"`
+	Name          string `json:"name"`
+	Color         string `json:"color"`
+	IsFinal       bool   `json:"is_final"`
+	ConsumesStock bool   `json:"consumes_stock"`
+	Position      int    `json:"position"`
+	TasksCount    int    `json:"tasks_count"`
+}
+
+type columnListDTO struct {
+	Items  []columnDTO `json:"items"`
+	Total  int         `json:"total"`
+	Limit  int         `json:"limit"`
+	Offset int         `json:"offset"`
+}
+
+type stockWarningDTO struct {
+	ProductID string      `json:"product_id"`
+	Name      string      `json:"name"`
+	Stock     json.Number `json:"stock"`    // numeric.Amount на wire — JSON-число без кавычек
+	MinStock  json.Number `json:"min_stock"`
+	Kind      string      `json:"kind"`
+}
+
+type taskCardDTO struct {
+	ID            int64   `json:"id"`
+	ColumnID      string  `json:"column_id"`
+	ClientID      string  `json:"client_id"`
+	ClientName    string  `json:"client_name"`
+	Title         string  `json:"title"`
+	AssigneeID    *string `json:"assignee_id"`
+	AssigneeName  *string `json:"assignee_name"`
+	DueDate       *string `json:"due_date"`
+	IsPaid        bool    `json:"is_paid"`
+	Position      string  `json:"position"`
+	Version       int64   `json:"version"`
+	SubtasksTotal int     `json:"subtasks_total"`
+	SubtasksDone  int     `json:"subtasks_done"`
+	SubtasksLate  int     `json:"subtasks_late"`
+}
+
+type taskDTO struct {
+	taskCardDTO
+	PaidAt    *string `json:"paid_at"`
+	CreatedAt string  `json:"created_at"`
+	UpdatedAt string  `json:"updated_at"`
+}
+
+type taskListDTO struct {
+	Items  []taskCardDTO `json:"items"`
+	Total  int           `json:"total"`
+	Limit  int           `json:"limit"`
+	Offset int           `json:"offset"`
+}
+
+type taskMutationDTO struct {
+	Task     taskDTO           `json:"task"`
+	Warnings []stockWarningDTO `json:"warnings"`
+}
+
+type apiErrSubtaskDTO struct {
+	ID          string `json:"id"`
+	ServiceName string `json:"service_name"`
+	Status      string `json:"status"`
+}
+
+type apiErrDTO struct {
+	Code    string `json:"code"`
+	Details *struct {
+		Fields   []struct{ Name, Message string } `json:"fields"`
+		Subtasks []apiErrSubtaskDTO               `json:"subtasks"`
+	} `json:"details"`
+}
+
+func (s *BoardLiveSuite) errOf(body []byte) apiErrDTO {
+	var e apiErrDTO
+	s.Require().NoError(json.Unmarshal(body, &e), string(body))
+	return e
+}
+
+func (s *BoardLiveSuite) fields(body []byte) map[string]string {
+	e := s.errOf(body)
+	s.Require().NotNil(e.Details, string(body))
+	m := map[string]string{}
+	for _, f := range e.Details.Fields {
+		m[f.Name] = f.Message
+	}
+	return m
+}
+
+// ---- фикстуры (клиент/товар/услуга — напрямую SQL: не входят в API этой фазы) ----
+
+func (s *BoardLiveSuite) newClient(company string) string {
+	var id string
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`INSERT INTO clients (company_name) VALUES ($1) RETURNING id`, company).Scan(&id))
+	return id
+}
+
+// columnID — id одной из 5 сидовых колонок D32 по имени.
+func (s *BoardLiveSuite) columnID(name string) string {
+	var id string
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT id FROM columns WHERE name = $1`, name).Scan(&id))
+	return id
+}
+
+func (s *BoardLiveSuite) createProduct(stock, minStock string) string {
+	ctx := context.Background()
+	var categoryID string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO catalog_categories (kind, name) VALUES ('product', 'BoardLive ' || gen_random_uuid()) RETURNING id`).Scan(&categoryID))
+	var productID string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO products (category_id, name, stock, min_stock) VALUES ($1, 'Товар', $2::numeric, $3::numeric) RETURNING id`,
+		categoryID, stock, minStock).Scan(&productID))
+	return productID
+}
+
+func (s *BoardLiveSuite) productStock(id string) string {
+	var stock string
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT stock::text FROM products WHERE id = $1`, id).Scan(&stock))
+	return stock
+}
+
+func (s *BoardLiveSuite) newServiceWithCategory() (categoryID, serviceID string) {
+	ctx := context.Background()
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO catalog_categories (kind, name) VALUES ('service', 'BoardLive Svc ' || gen_random_uuid()) RETURNING id`).Scan(&categoryID))
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO services (category_id, name) VALUES ($1, 'Услуга') RETURNING id`, categoryID).Scan(&serviceID))
+	return categoryID, serviceID
+}
+
+// addSubtask — подзадача-услуга заказа (subtasks вне API фазы 5, появится в фазе 6).
+func (s *BoardLiveSuite) addSubtask(taskID int64, serviceID, status string) string {
+	var id string
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`INSERT INTO subtasks (task_id, service_id, status) VALUES ($1, $2, $3) RETURNING id`,
+		taskID, serviceID, status).Scan(&id))
+	return id
+}
+
+func (s *BoardLiveSuite) addSubtaskProduct(subtaskID, productID, qty string) {
+	_, err := s.Pool.Exec(context.Background(),
+		`INSERT INTO subtask_products (subtask_id, product_id, qty) VALUES ($1, $2, $3::numeric)`, subtaskID, productID, qty)
+	s.Require().NoError(err)
+}
+
+// ---- HTTP-хелперы ----
+
+// createTask — POST /tasks; для негативных сценариев (400) тело ответа — errorBody, не
+// taskMutationDTO, поэтому Task не парсится (raw остаётся источником для s.fields/s.errOf).
+func (s *BoardLiveSuite) createTask(b *testutil.Browser, body map[string]any) (int, taskDTO, []byte) {
+	st, m, raw := s.mutate(b, http.MethodPost, "/api/v1/tasks", body)
+	return st, m.Task, raw
+}
+
+func (s *BoardLiveSuite) mutate(b *testutil.Browser, method, path string, body map[string]any) (int, taskMutationDTO, []byte) {
+	st, raw := b.Do(method, path, body)
+	var m taskMutationDTO
+	if st == http.StatusOK || st == http.StatusCreated {
+		s.Require().NoError(json.Unmarshal(raw, &m), string(raw))
+	}
+	return st, m, raw
+}
+
+func (s *BoardLiveSuite) getTask(b *testutil.Browser, id int64) (int, taskDTO, []byte) {
+	st, raw := b.Do(http.MethodGet, fmt.Sprintf("/api/v1/tasks/%d", id), nil)
+	var t taskDTO
+	if st == http.StatusOK {
+		s.Require().NoError(json.Unmarshal(raw, &t), string(raw))
+	}
+	return st, t, raw
+}
+
+func (s *BoardLiveSuite) newTask(clientID, columnID string) taskDTO {
+	st, m, raw := s.mutate(s.admin, http.MethodPost, "/api/v1/tasks", map[string]any{
+		"title": "Заказ", "client_id": clientID, "column_id": columnID,
+	})
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+	return m.Task
+}
+
+func taskCard(t taskDTO, patch map[string]any) map[string]any {
+	m := map[string]any{
+		"title": t.Title, "client_id": t.ClientID, "column_id": t.ColumnID,
+		"assignee_id": t.AssigneeID, "due_date": t.DueDate, "is_paid": t.IsPaid, "version": t.Version,
+	}
+	for k, v := range patch {
+		m[k] = v
+	}
+	return m
+}
+
+func (s *BoardLiveSuite) createColumn(b *testutil.Browser, body map[string]any) (int, columnDTO, []byte) {
+	st, raw := b.Do(http.MethodPost, "/api/v1/columns", body)
+	var m struct {
+		Column columnDTO `json:"column"`
+	}
+	if st == http.StatusCreated {
+		s.Require().NoError(json.Unmarshal(raw, &m), string(raw))
+	}
+	return st, m.Column, raw
+}
