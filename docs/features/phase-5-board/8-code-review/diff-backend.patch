+		s.Equal(http.StatusUnauthorized, st, "%s %s → %s", cs.method, cs.path, raw)
+	}
+}
diff --git a/internal/features/board/stock_repo.go b/internal/features/board/stock_repo.go
new file mode 100644
index 0000000..a05e3e5
--- /dev/null
+++ b/internal/features/board/stock_repo.go
@@ -0,0 +1,170 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// stockPendingCTE — design-sql.md §Stock Pending CTE (Q-002): общий подзапрос для List/
+// Summary/бейджа меню — потребность ещё не взятых в работу заказов (колонка не consumes_
+// stock и не финальная) и вычисленное state товара.
+const stockPendingCTE = `
+WITH pending AS (
+    SELECT sp.product_id, sum(sp.qty) AS qty
+    FROM subtask_products sp
+    JOIN subtasks s ON s.id = sp.subtask_id
+    JOIN tasks t    ON t.id = s.task_id
+    JOIN columns c  ON c.id = t.column_id
+    WHERE NOT c.consumes_stock AND NOT c.is_final
+    GROUP BY sp.product_id),
+rows AS (
+    SELECT p.id, p.name, p.unit, p.box, p.place, p.stock, p.min_stock,
+           coalesce(pd.qty, 0) AS pending, p.stock - coalesce(pd.qty, 0) AS forecast,
+           CASE WHEN p.stock <= 0 THEN 'out'
+                WHEN p.stock <= p.min_stock THEN 'low'
+                WHEN p.stock - coalesce(pd.qty, 0) <= p.min_stock THEN 'will_low'
+                ELSE 'ok' END AS state
+    FROM products p LEFT JOIN pending pd ON pd.product_id = p.id
+    WHERE p.is_active)
+`
+
+type StockRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewStockRepo(pool *pgxpool.Pool) *StockRepo { return &StockRepo{pool: pool} }
+
+// List — design-sql.md §Stock List Query. scope=StockScopeAll — все товары, иначе
+// (StockScopeRisky) только state <> 'ok'. q — сырой ввод пользователя (handler передаёт
+// c.Query("q") как есть); экранирует сам repo (sqlutil.EscapeLike ниже) — пустая строка
+// после экранирования означает «без фильтра по имени».
+func (r *StockRepo) List(ctx context.Context, scope, q string, limit, offset int) ([]StockRow, int, error) {
+	var like *string
+	if q != "" {
+		s := "%" + sqlutil.EscapeLike(q) + "%"
+		like = &s
+	}
+	rows, err := r.pool.Query(ctx, stockPendingCTE+`
+SELECT id, name, unit, box, place, stock::text, min_stock::text, pending::text, forecast::text, state,
+       count(*) OVER () AS total
+FROM rows
+WHERE ($1 = 'all' OR state <> 'ok')
+  AND ($2::text IS NULL OR name ILIKE $2 ESCAPE '\')
+ORDER BY stock - min_stock, name, id
+LIMIT $3 OFFSET $4`, scope, like, limit, offset)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+
+	var total int
+	out := []StockRow{}
+	for rows.Next() {
+		row, stock, minStock, pending, forecast, err := scanStockRowText(rows, &total)
+		if err != nil {
+			return nil, 0, err
+		}
+		row.Stock, row.MinStock, row.Pending, row.Forecast =
+			numeric.Amount(stock), numeric.Amount(minStock), numeric.Amount(pending), numeric.Amount(forecast)
+		out = append(out, row)
+	}
+	return out, total, rows.Err()
+}
+
+// scanStockRowText — общий porядок колонок List (с total) — вынесен, чтобы не дублировать
+// Scan-вызов; total сканируется, только если totalDst != nil.
+func scanStockRowText(rows pgx.Rows, totalDst *int) (row StockRow, stock, minStock, pending, forecast string, err error) {
+	dest := []any{&row.ProductID, &row.Name, &row.Unit, &row.Box, &row.Place,
+		&stock, &minStock, &pending, &forecast, &row.State}
+	if totalDst != nil {
+		dest = append(dest, totalDst)
+	}
+	err = rows.Scan(dest...)
+	return
+}
+
+// Summary — design-sql.md §Stock Summary Query (Q-002/AC-016) — RiskCount = бейдж меню.
+func (r *StockRepo) Summary(ctx context.Context) (*StockSummaryResponse, error) {
+	var resp StockSummaryResponse
+	err := r.pool.QueryRow(ctx, stockPendingCTE+`
+SELECT count(*)                                  AS products_total,
+       count(*) FILTER (WHERE state = 'low')      AS low_count,
+       count(*) FILTER (WHERE state = 'out')      AS out_count,
+       count(*) FILTER (WHERE state = 'will_low') AS will_low_count,
+       count(*) FILTER (WHERE state <> 'ok')      AS risk_count
+FROM rows`).Scan(&resp.ProductsTotal, &resp.LowCount, &resp.OutCount, &resp.WillLowCount, &resp.RiskCount)
+	if err != nil {
+		return nil, err
+	}
+	return &resp, nil
+}
+
+// Adjust — design-sql.md §Stock Adjust Query (D44, эталон catalog.ProductRepo.Update):
+// правка остатка вручную одной транзакцией; запись в stock_movements — только при
+// ненулевой дельте. Ответ — свежая строка через stockPendingCTE (re-fetch-after-write:
+// pending/forecast/state — вычисляемые поля, write-строка их не несёт).
+func (r *StockRepo) Adjust(ctx context.Context, productID, userID string, newStock numeric.Amount) (*StockRow, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+
+	// oldStock — значение ДО записи, под блокировкой строки: дельта считается относительно
+	// него, а не относительно уже применённого нового значения (эталон products_repo.Update).
+	var oldStock string
+	if err := tx.QueryRow(ctx, `SELECT stock::text FROM products WHERE id = $1::uuid FOR UPDATE`, productID).Scan(&oldStock); err != nil {
+		if errors.Is(err, pgx.ErrNoRows) {
+			return nil, errNotFound
+		}
+		return nil, err
+	}
+
+	if _, err := tx.Exec(ctx, `UPDATE products SET stock = $2::numeric, updated_at = now() WHERE id = $1::uuid`,
+		productID, newStock.String()); err != nil {
+		return nil, err
+	}
+
+	if _, err := tx.Exec(ctx, `
+		INSERT INTO stock_movements (product_id, qty_delta, reason, user_id)
+		SELECT $1::uuid, $2::numeric - $3::numeric, 'manual', $4::uuid
+		WHERE ($2::numeric - $3::numeric) <> 0`,
+		productID, newStock.String(), oldStock, userID); err != nil {
+		return nil, err
+	}
+
+	row, err := r.getForUpdateResponse(ctx, tx, productID)
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// getForUpdateResponse — товар ПОСЛЕ Adjust через тот же CTE, что List/Summary (общий
+// источник вычисления state/pending/forecast).
+func (r *StockRepo) getForUpdateResponse(ctx context.Context, tx pgx.Tx, id string) (*StockRow, error) {
+	var row StockRow
+	var stock, minStock, pending, forecast string
+	err := tx.QueryRow(ctx, stockPendingCTE+`
+SELECT id, name, unit, box, place, stock::text, min_stock::text, pending::text, forecast::text, state
+FROM rows WHERE id = $1::uuid`, id).Scan(
+		&row.ProductID, &row.Name, &row.Unit, &row.Box, &row.Place, &stock, &minStock, &pending, &forecast, &row.State)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	row.Stock, row.MinStock, row.Pending, row.Forecast =
+		numeric.Amount(stock), numeric.Amount(minStock), numeric.Amount(pending), numeric.Amount(forecast)
+	return &row, nil
+}
diff --git a/internal/features/board/stock_service.go b/internal/features/board/stock_service.go
new file mode 100644
index 0000000..e115a93
--- /dev/null
+++ b/internal/features/board/stock_service.go
@@ -0,0 +1,75 @@
+package board
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+// stockScale — NUMERIC(12,3): products.stock (эталон catalog.qtyScale) — отдельная
+// декларация в board, не импорт из catalog (фичи не завязаны друг на друга, ADR-101 вынес
+// саму логику диапазона в pkg/numeric, здесь только числа колонки).
+var stockScale = numeric.Scale{IntDigits: 9, FracDigits: 3}
+
+// StockService — экран «Остатки»: список/summary без транзакции, Adjust — целиком внутри
+// StockRepo.Adjust (design-go-layers.md §Service Interface; своей транзакции сервису не
+// нужно — в отличие от ColumnService/TaskService, у Stock нет multi-step Lock Order).
+type StockService struct {
+	repo *StockRepo
+}
+
+func NewStockService(repo *StockRepo) *StockService {
+	return &StockService{repo: repo}
+}
+
+// List — GET /api/v1/stock?scope=&q=&limit=&offset= (лимиты/дефолты — stock_handler.go).
+func (s *StockService) List(ctx context.Context, scope, q string, limit, offset int) (*StockListResponse, error) {
+	items, total, err := s.repo.List(ctx, scope, q, limit, offset)
+	if err != nil {
+		return nil, err
+	}
+	return &StockListResponse{Items: items, Total: total, Limit: limit, Offset: offset}, nil
+}
+
+// Summary — GET /api/v1/stock/summary.
+func (s *StockService) Summary(ctx context.Context) (*StockSummaryResponse, error) {
+	return s.repo.Summary(ctx)
+}
+
+// Adjust — PUT /api/v1/stock/:product_id (admin, D44).
+func (s *StockService) Adjust(ctx context.Context, productID, userID string, in StockAdjustRequest) (*StockRow, error) {
+	if uuid.Validate(productID) != nil {
+		return nil, ErrStockProductNotFound
+	}
+	if in.Stock == nil {
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "stock", Message: msgRequired})
+	}
+	if code := in.Stock.Validate(stockScale, true); code != "" { // D44: остаток может быть < 0
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "stock", Message: code})
+	}
+
+	row, err := s.repo.Adjust(ctx, productID, userID, *in.Stock)
+	if err != nil {
+		if errors.Is(err, errNotFound) {
+			return nil, ErrStockProductNotFound
+		}
+		return nil, err
+	}
+	return row, nil
+}
+
+// NavBadges — ssr.BadgeSource (ADR-004): бейдж «Остатки» в сайдбаре = risk_count. Ошибка
+// БД не должна ломать рендер страницы — предупреждение в лог, бейдж просто не показывается.
+func (s *StockService) NavBadges(ctx context.Context) map[string]int {
+	summary, err := s.repo.Summary(ctx)
+	if err != nil {
+		slog.WarnContext(ctx, "board: NavBadges: не удалось получить stock summary", "err", err)
+		return nil
+	}
+	return map[string]int{"/stock": summary.RiskCount}
+}
diff --git a/internal/features/board/tasks_dto.go b/internal/features/board/tasks_dto.go
new file mode 100644
index 0000000..6ff81bb
--- /dev/null
+++ b/internal/features/board/tasks_dto.go
@@ -0,0 +1,90 @@
+package board
+
+import "time"
+
+// Wire-типы заказов — JSON только snake_case (§API-1); конверт списка {items,total,limit,
+// offset} (design-go-layers.md §DTO Task).
+
+// TaskCard — элемент списка доски. Position — NUMERIC строкой, клиенту только для
+// отладки/сортировки (не Amount — это не денежная величина).
+type TaskCard struct {
+	ID            int64   `json:"id"`
+	ColumnID      string  `json:"column_id"`
+	ClientID      string  `json:"client_id"`
+	ClientName    string  `json:"client_name"`
+	Title         string  `json:"title"`
+	AssigneeID    *string `json:"assignee_id"`
+	AssigneeName  *string `json:"assignee_name"`
+	DueDate       *string `json:"due_date"` // YYYY-MM-DD
+	IsPaid        bool    `json:"is_paid"`
+	Position      string  `json:"position"`
+	Version       int64   `json:"version"`
+	SubtasksTotal int     `json:"subtasks_total"`
+	SubtasksDone  int     `json:"subtasks_done"`
+	SubtasksLate  int     `json:"subtasks_late"`
+}
+
+// TaskListResponse — гарантия порядка items (контракт): columns.position, columns.id,
+// tasks.position, tasks.id — по колонкам слева направо, внутри колонки сверху вниз;
+// стабилен между запросами. Дефолты: limit=500 (1..1000), offset=0.
+type TaskListResponse struct {
+	Items  []TaskCard `json:"items"`
+	Total  int        `json:"total"`
+	Limit  int        `json:"limit"`
+	Offset int        `json:"offset"`
+}
+
+// TaskResponse — GET /tasks/:id и в mutation-ответах.
+type TaskResponse struct {
+	TaskCard
+	PaidAt    *time.Time `json:"paid_at"`
+	CreatedAt time.Time  `json:"created_at"`
+	UpdatedAt time.Time  `json:"updated_at"`
+}
+
+// TaskCreateRequest — POST /api/v1/tasks. IsPaid: executor — nil|false, иначе 403
+// PAID_ADMIN_ONLY (AC-011).
+type TaskCreateRequest struct {
+	Title      string  `json:"title"`
+	ClientID   string  `json:"client_id"`
+	ColumnID   string  `json:"column_id"`
+	AssigneeID *string `json:"assignee_id"`
+	DueDate    *string `json:"due_date"`
+	IsPaid     *bool   `json:"is_paid"`
+}
+
+// TaskUpdateRequest — PUT /api/v1/tasks/:id, полная замена карточки. Version обязателен
+// (§FE-1.1, оптимистичная блокировка).
+type TaskUpdateRequest struct {
+	TaskCreateRequest
+	Version *int64 `json:"version"`
+}
+
+// TaskMoveRequest — POST /api/v1/tasks/:id/move. PrevID/NextID — карточки сверху/снизу
+// после вставки (ADR-001); «чужой»/несуществующий сосед игнорируется (position.go).
+type TaskMoveRequest struct {
+	ColumnID string `json:"column_id"`
+	PrevID   *int64 `json:"prev_id"`
+	NextID   *int64 `json:"next_id"`
+}
+
+// TaskMutationResponse — ответ Create/Update/Move.
+type TaskMutationResponse struct {
+	Task     TaskResponse   `json:"task"`
+	Warnings []StockWarning `json:"warnings"`
+}
+
+// TaskDeleteResponse — ответ Delete: удаление возвращает товары на склад, клиенту нужны
+// предупреждения (напр. below_min после возврата демонстративно маловероятно, но контракт
+// единообразен с Create/Update/Move).
+type TaskDeleteResponse struct {
+	Warnings []StockWarning `json:"warnings"`
+}
+
+// OpenSubtask — незавершённая услуга заказа (design-sql.md §Open Subtasks Query),
+// сериализуется в details.subtasks[] ошибки SUBTASKS_NOT_DONE (ADR-102).
+type OpenSubtask struct {
+	ID          string `json:"id"`
+	ServiceName string `json:"service_name"`
+	Status      string `json:"status"`
+}
diff --git a/internal/features/board/tasks_filter.go b/internal/features/board/tasks_filter.go
new file mode 100644
index 0000000..6a32177
--- /dev/null
+++ b/internal/features/board/tasks_filter.go
@@ -0,0 +1,143 @@
+package board
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+const (
+	tasksDefaultLimit = 500
+	tasksMaxLimit     = 1000
+	taskFilterQMax    = 100
+)
+
+// taskNoRe — design-sql.md §Board List Query: `q` трактуется как номер заказа `#N`/`N`.
+var taskNoRe = regexp.MustCompile(`^#?\d{1,18}$`)
+
+// TaskFilter — параметры GET /api/v1/tasks после разбора и валидации query (design-go-
+// layers.md §DTO TaskFilter).
+type TaskFilter struct {
+	ClientID   *string
+	Q          string
+	TaskNo     *int64
+	CategoryID *string
+	Paid       *bool
+	AssigneeID *string
+	Due        string
+	Limit      int
+	Offset     int
+}
+
+// ParseTaskFilter — разбор и валидация query GET /tasks (design-sql.md §Board List Query,
+// design-go-layers.md §DTO TaskFilter). Actor нужен для дефолта assignee по роли (AC-014).
+func ParseTaskFilter(c fiber.Ctx, a Actor) (TaskFilter, error) {
+	var f TaskFilter
+	var fields []errorspkg.Field
+	add := func(name string) { fields = append(fields, errorspkg.Field{Name: name, Message: msgInvalid}) }
+
+	if raw := strings.TrimSpace(c.Query("client_id")); raw != "" {
+		if uuid.Validate(raw) != nil {
+			add("client_id")
+		} else {
+			f.ClientID = &raw
+		}
+	}
+
+	q := strings.TrimSpace(c.Query("q"))
+	if sqlutil.HasInvalidText(q) {
+		q = "" // NUL-байт/невалидный UTF-8 — фильтр молча игнорируется (TD-4), не 400/500.
+	}
+	if utf8.RuneCountInString(q) > taskFilterQMax {
+		r := []rune(q)
+		q = string(r[:taskFilterQMax])
+	}
+	if taskNoRe.MatchString(q) {
+		digits := strings.TrimPrefix(q, "#")
+		if n, err := strconv.ParseInt(digits, 10, 64); err == nil {
+			f.TaskNo = &n
+		}
+	}
+	if q != "" {
+		esc := sqlutil.EscapeLike(q)
+		f.Q = esc
+	}
+
+	if raw := strings.TrimSpace(c.Query("category_id")); raw != "" {
+		if uuid.Validate(raw) != nil {
+			add("category_id")
+		} else {
+			f.CategoryID = &raw
+		}
+	}
+
+	switch p := c.Query("paid", PaidFilterAll); p {
+	case PaidFilterAll:
+		f.Paid = nil
+	case PaidFilterPaid:
+		v := true
+		f.Paid = &v
+	case PaidFilterUnpaid:
+		v := false
+		f.Paid = &v
+	default:
+		add("paid")
+	}
+
+	assignee := strings.TrimSpace(c.Query("assignee"))
+	switch {
+	case assignee == "":
+		if !a.IsAdmin {
+			id := a.ID
+			f.AssigneeID = &id
+		}
+	case assignee == AssigneeMe:
+		id := a.ID
+		f.AssigneeID = &id
+	case assignee == AssigneeAll:
+		f.AssigneeID = nil
+	case uuid.Validate(assignee) == nil:
+		f.AssigneeID = &assignee
+	default:
+		add("assignee")
+	}
+
+	switch d := c.Query("due", DueFilterAll); d {
+	case DueFilterAll:
+		f.Due = ""
+	case DueFilterSoon, DueFilterOverdue:
+		f.Due = d
+	default:
+		add("due")
+	}
+
+	f.Limit = tasksDefaultLimit
+	if raw := c.Query("limit"); raw != "" {
+		n, err := strconv.Atoi(raw)
+		if err != nil || n < 1 || n > tasksMaxLimit {
+			add("limit")
+		} else {
+			f.Limit = n
+		}
+	}
+	if raw := c.Query("offset"); raw != "" {
+		n, err := strconv.Atoi(raw)
+		if err != nil || n < 0 {
+			add("offset")
+		} else {
+			f.Offset = n
+		}
+	}
+
+	if len(fields) > 0 {
+		return TaskFilter{}, errorspkg.Validation(fields...)
+	}
+	return f, nil
+}
diff --git a/internal/features/board/tasks_filter_test.go b/internal/features/board/tasks_filter_test.go
new file mode 100644
index 0000000..d6433a2
--- /dev/null
+++ b/internal/features/board/tasks_filter_test.go
@@ -0,0 +1,100 @@
+package board
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/stretchr/testify/require"
+)
+
+// parseFilter — ParseTaskFilter(c fiber.Ctx, a Actor) требует реальный fiber.Ctx; здесь он
+// нужен только как носитель query-параметров (не тест HTTP-роутинга/middleware — §TD-8
+// про app.Test относится к HTTP-уровневым integration-тестам handler/router, не к юнит-
+// тесту чистой функции разбора query).
+func parseFilter(t *testing.T, rawQuery string, actor Actor) (TaskFilter, error) {
+	t.Helper()
+	app := fiber.New()
+	var got TaskFilter
+	var gotErr error
+	app.Get("/x", func(c fiber.Ctx) error {
+		got, gotErr = ParseTaskFilter(c, actor)
+		return c.SendStatus(fiber.StatusOK)
+	})
+	req := httptest.NewRequest(fiber.MethodGet, "/x?"+rawQuery, nil)
+	resp, err := app.Test(req)
+	require.NoError(t, err)
+	_ = resp.Body.Close()
+	return got, gotErr
+}
+
+var admin = Actor{ID: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", IsAdmin: true}
+var executor = Actor{ID: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", IsAdmin: false}
+
+// TestParseTaskFilter_HashNumber — UT-001.
+func TestParseTaskFilter_HashNumber(t *testing.T) {
+	f, err := parseFilter(t, "q=%2342", admin)
+	require.NoError(t, err)
+	require.NotNil(t, f.TaskNo)
+	require.Equal(t, int64(42), *f.TaskNo)
+}
+
+// TestParseTaskFilter_PlainNumber — UT-001.
+func TestParseTaskFilter_PlainNumber(t *testing.T) {
+	f, err := parseFilter(t, "q=42", admin)
+	require.NoError(t, err)
+	require.NotNil(t, f.TaskNo)
+	require.Equal(t, int64(42), *f.TaskNo)
+}
+
+// TestParseTaskFilter_InvalidNumber — UT-001: "42a" не число заказа, но валидный текстовый
+// поиск (не ошибка).
+func TestParseTaskFilter_InvalidNumber(t *testing.T) {
+	f, err := parseFilter(t, "q=42a", admin)
+	require.NoError(t, err)
+	require.Nil(t, f.TaskNo)
+	require.Equal(t, "42a", f.Q)
+}
+
+// TestParseTaskFilter_DefaultsByRole — UT-001/AC-014: executor без `assignee` → «свои»;
+// admin — все.
+func TestParseTaskFilter_DefaultsByRole(t *testing.T) {
+	f, err := parseFilter(t, "", executor)
+	require.NoError(t, err)
+	require.NotNil(t, f.AssigneeID)
+	require.Equal(t, executor.ID, *f.AssigneeID)
+	require.Equal(t, tasksDefaultLimit, f.Limit)
+	require.Equal(t, 0, f.Offset)
+
+	f, err = parseFilter(t, "", admin)
+	require.NoError(t, err)
+	require.Nil(t, f.AssigneeID)
+}
+
+// TestParseTaskFilter_EnumValidation — UT-001/LV-037: enum'ы, uuid, лимиты.
+func TestParseTaskFilter_EnumValidation(t *testing.T) {
+	cases := []string{"paid=maybe", "due=x", "assignee=bad", "limit=-1", "limit=1001", "limit=abc", "offset=-1", "client_id=not-a-uuid"}
+	for _, q := range cases {
+		_, err := parseFilter(t, q, admin)
+		require.Error(t, err, "q=%s", q)
+	}
+
+	f, err := parseFilter(t, "paid=paid&due=soon&assignee=all&limit=10&offset=5", admin)
+	require.NoError(t, err)
+	require.NotNil(t, f.Paid)
+	require.True(t, *f.Paid)
+	require.Equal(t, DueFilterSoon, f.Due)
+	require.Nil(t, f.AssigneeID)
+	require.Equal(t, 10, f.Limit)
+	require.Equal(t, 5, f.Offset)
+
+	f, err = parseFilter(t, "assignee=me", executor)
+	require.NoError(t, err)
+	require.NotNil(t, f.AssigneeID)
+	require.Equal(t, executor.ID, *f.AssigneeID)
+
+	f, err = parseFilter(t, "assignee="+validUUID, admin)
+	require.NoError(t, err)
+	require.NotNil(t, f.AssigneeID)
+	require.Equal(t, validUUID, *f.AssigneeID)
+}
diff --git a/internal/features/board/tasks_handler.go b/internal/features/board/tasks_handler.go
new file mode 100644
index 0000000..654b986
--- /dev/null
+++ b/internal/features/board/tasks_handler.go
@@ -0,0 +1,108 @@
+package board
+
+import (
+	"context"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// taskService — узкий интерфейс зависимости TasksHandler (не `*TaskService` напрямую):
+// FuzzMoveBody (board_fuzz_test.go, §9.1) собирает app.Test-хендлер с фейковой
+// реализацией без БД — TaskService (tasks_service.go) реализует его структурно, без явной
+// декларации.
+type taskService interface {
+	List(ctx context.Context, f TaskFilter) (*TaskListResponse, error)
+	Get(ctx context.Context, idStr string) (*TaskResponse, error)
+	Create(ctx context.Context, a Actor, in TaskCreateRequest) (*TaskMutationResponse, error)
+	Update(ctx context.Context, a Actor, idStr string, in TaskUpdateRequest) (*TaskMutationResponse, error)
+	Move(ctx context.Context, a Actor, idStr string, in TaskMoveRequest) (*TaskMutationResponse, error)
+	Delete(ctx context.Context, a Actor, idStr string) (*TaskDeleteResponse, error)
+}
+
+// TasksHandler — JSON API /api/v1/tasks (чтение/мутации — RequireAPI, Delete — +admin;
+// PAID_ADMIN_ONLY — сервисная проверка, не роут-гард).
+type TasksHandler struct {
+	svc taskService
+}
+
+func NewTasksHandler(svc taskService) *TasksHandler { return &TasksHandler{svc: svc} }
+
+// currentActor — Actor из middleware.CurrentPrincipal (роут закрыт RequireAPI — principal
+// всегда не nil).
+func currentActor(c fiber.Ctx) Actor {
+	p := middleware.CurrentPrincipal(c)
+	return Actor{ID: p.ID, IsAdmin: p.IsAdmin()}
+}
+
+// List — GET /api/v1/tasks?<TaskFilter>.
+func (h *TasksHandler) List(c fiber.Ctx) error {
+	f, err := ParseTaskFilter(c, currentActor(c))
+	if err != nil {
+		return err
+	}
+	resp, err := h.svc.List(c.Context(), f)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Get — GET /api/v1/tasks/:id.
+func (h *TasksHandler) Get(c fiber.Ctx) error {
+	resp, err := h.svc.Get(c.Context(), c.Params("id"))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Create — POST /api/v1/tasks (D19 — доступно и executor).
+func (h *TasksHandler) Create(c fiber.Ctx) error {
+	var req TaskCreateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Create(c.Context(), currentActor(c), req)
+	if err != nil {
+		return err
+	}
+	return c.Status(fiber.StatusCreated).JSON(resp)
+}
+
+// Update — PUT /api/v1/tasks/:id (D19 — доступно и executor; version обязателен).
+func (h *TasksHandler) Update(c fiber.Ctx) error {
+	var req TaskUpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Update(c.Context(), currentActor(c), c.Params("id"), req)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Move — POST /api/v1/tasks/:id/move (D19 — доступно и executor).
+func (h *TasksHandler) Move(c fiber.Ctx) error {
+	var req TaskMoveRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("Некорректное тело запроса")
+	}
+	resp, err := h.svc.Move(c.Context(), currentActor(c), c.Params("id"), req)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Delete — DELETE /api/v1/tasks/:id (admin) — 200 + warnings (товары вернулись на склад).
+func (h *TasksHandler) Delete(c fiber.Ctx) error {
+	resp, err := h.svc.Delete(c.Context(), currentActor(c), c.Params("id"))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
diff --git a/internal/features/board/tasks_repo.go b/internal/features/board/tasks_repo.go
new file mode 100644
index 0000000..d4bda60
--- /dev/null
+++ b/internal/features/board/tasks_repo.go
@@ -0,0 +1,285 @@
+package board
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Task — repo-модель заказа. LockTask/Move/Update/Insert заполняют базовые поля;
+// ClientName/AssigneeName/Subtasks* заполняет только Get/List (JOIN'ы, design-sql.md
+// §Board List Query) — «Re-fetch-after-write»: ответ клиенту всегда собирается из Get()
+// ПОСЛЕ коммита транзакции, не из RETURNING строки записи.
+type Task struct {
+	ID            int64
+	ColumnID      string
+	ClientID      string
+	ClientName    string
+	Title         string
+	AssigneeID    *string
+	AssigneeName  *string
+	DueDate       *string // YYYY-MM-DD
+	IsPaid        bool
+	PaidAt        *time.Time
+	Position      string
+	Version       int64
+	CreatedAt     time.Time
+	UpdatedAt     time.Time
+	SubtasksTotal int
+	SubtasksDone  int
+	SubtasksLate  int
+}
+
+// columnFlags — колонка под FOR SHARE (design-sql.md §Lock Target Column Query).
+type columnFlags struct {
+	ID            string
+	IsFinal       bool
+	ConsumesStock bool
+}
+
+// taskRow — параметры записи Insert/Update (design-go-layers.md §Repository Interface:
+// `in taskRow`).
+type taskRow struct {
+	Title      string
+	ClientID   string
+	ColumnID   string
+	AssigneeID *string
+	DueDate    *string
+	IsPaid     bool
+	Position   string
+}
+
+type TaskRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewTaskRepo(pool *pgxpool.Pool) *TaskRepo { return &TaskRepo{pool: pool} }
+
+// taskWriteReturning — общий список колонок RETURNING для Insert/Update/Move (без JOIN —
+// денормализованные поля добавляет только Get/List).
+const taskWriteReturning = `id, column_id, client_id, title, assignee_id, due_date::text, is_paid, paid_at, position::text, version, created_at, updated_at`
+
+func scanTaskRow(row pgx.Row, t *Task) error {
+	return row.Scan(&t.ID, &t.ColumnID, &t.ClientID, &t.Title, &t.AssigneeID, &t.DueDate,
+		&t.IsPaid, &t.PaidAt, &t.Position, &t.Version, &t.CreatedAt, &t.UpdatedAt)
+}
+
+// LockTargetColumn — design-sql.md §Lock Target Column Query. 0 строк → errNotFound
+// (сервис мапит в 400 field column_id, «404 — только id в пути»).
+func (r *TaskRepo) LockTargetColumn(ctx context.Context, tx pgx.Tx, columnID string) (*columnFlags, error) {
+	var f columnFlags
+	err := tx.QueryRow(ctx, `SELECT id, is_final, consumes_stock FROM columns WHERE id = $1 FOR SHARE`, columnID).
+		Scan(&f.ID, &f.IsFinal, &f.ConsumesStock)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &f, nil
+}
+
+// LockTask — design-sql.md §Lock Task Query. 0 строк → errNotFound (ErrTaskNotFound).
+func (r *TaskRepo) LockTask(ctx context.Context, tx pgx.Tx, id int64) (*Task, error) {
+	var t Task
+	err := tx.QueryRow(ctx, `
+		SELECT id, column_id, client_id, title, assignee_id, due_date::text, is_paid, paid_at, position::text, version
+		FROM tasks WHERE id = $1 FOR UPDATE`, id).
+		Scan(&t.ID, &t.ColumnID, &t.ClientID, &t.Title, &t.AssigneeID, &t.DueDate, &t.IsPaid, &t.PaidAt, &t.Position, &t.Version)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &t, nil
+}
+
+// OpenSubtasks — design-sql.md §Open Subtasks Query (D11/D22): незавершённые услуги
+// заказа, проверка перед переносом в is_final.
+func (r *TaskRepo) OpenSubtasks(ctx context.Context, tx pgx.Tx, taskID int64) ([]OpenSubtask, error) {
+	rows, err := tx.Query(ctx, `
+		SELECT s.id, sv.name, s.status
+		FROM subtasks s JOIN services sv ON sv.id = s.service_id
+		WHERE s.task_id = $1 AND s.status <> 'done'
+		ORDER BY s.position, s.id`, taskID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []OpenSubtask{}
+	for rows.Next() {
+		var o OpenSubtask
+		if err := rows.Scan(&o.ID, &o.ServiceName, &o.Status); err != nil {
+			return nil, err
+		}
+		out = append(out, o)
+	}
+	return out, rows.Err()
+}
+
+// NextPosition — делегирует position.go (design-sql.md §Position Query). taskID=0 —
+// сентинел нового (ещё не вставленного) заказа, используется Create.
+func (r *TaskRepo) NextPosition(ctx context.Context, tx pgx.Tx, columnID string, taskID int64, prevID, nextID *int64) (string, error) {
+	return nextPosition(ctx, tx, columnID, taskID, prevID, nextID)
+}
+
+// Move — design-sql.md §Move Task Query.
+func (r *TaskRepo) Move(ctx context.Context, tx pgx.Tx, id int64, columnID, pos string) (*Task, error) {
+	var t Task
+	err := scanTaskRow(tx.QueryRow(ctx, `
+		UPDATE tasks SET column_id = $2::uuid, position = $3::numeric, version = version + 1, updated_at = now()
+		WHERE id = $1
+		RETURNING `+taskWriteReturning, id, columnID, pos), &t)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	return &t, err
+}
+
+// Update — design-sql.md §Update Task Query. 0 строк при уже подтверждённом (LockTask)
+// существовании заказа → errVersionConflict.
+func (r *TaskRepo) Update(ctx context.Context, tx pgx.Tx, id, version int64, in taskRow) (*Task, error) {
+	var t Task
+	err := scanTaskRow(tx.QueryRow(ctx, `
+		UPDATE tasks SET title = $3, client_id = $4::uuid, column_id = $5::uuid, assignee_id = $6::uuid,
+		       due_date = $7::date, is_paid = $8,
+		       paid_at = CASE WHEN $8 AND NOT is_paid THEN now() WHEN NOT $8 THEN NULL ELSE paid_at END,
+		       position = $9::numeric, version = version + 1, updated_at = now()
+		WHERE id = $1 AND version = $2
+		RETURNING `+taskWriteReturning,
+		id, version, in.Title, in.ClientID, in.ColumnID, in.AssigneeID, in.DueDate, in.IsPaid, in.Position), &t)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errVersionConflict
+	}
+	return &t, err
+}
+
+// Insert — design-sql.md §Insert Task Query.
+func (r *TaskRepo) Insert(ctx context.Context, tx pgx.Tx, in taskRow, createdBy string) (*Task, error) {
+	var t Task
+	err := scanTaskRow(tx.QueryRow(ctx, `
+		INSERT INTO tasks (column_id, client_id, title, assignee_id, due_date, is_paid, paid_at, position, created_by)
+		VALUES ($1::uuid, $2::uuid, $3, $4::uuid, $5::date, $6, CASE WHEN $6 THEN now() END, $7::numeric, $8::uuid)
+		RETURNING `+taskWriteReturning,
+		in.ColumnID, in.ClientID, in.Title, in.AssigneeID, in.DueDate, in.IsPaid, in.Position, createdBy), &t)
+	return &t, err
+}
+
+// Delete — design-sql.md §Delete Task Query. Вызывающая сторона уже отработала
+// StockEngine.Reconcile(target=false) под тем же FOR UPDATE заказа.
+func (r *TaskRepo) Delete(ctx context.Context, tx pgx.Tx, id int64) error {
+	tag, err := tx.Exec(ctx, `DELETE FROM tasks WHERE id = $1`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return nil
+}
+
+// ClientExists — проверка client_id (design-go-layers.md §Service Interface: «проверка
+// client/assignee» перед Insert/Update). Запрос — в переданной tx (тот же снапшот
+// READ COMMITTED, что и остальные шаги Create/Update).
+func (r *TaskRepo) ClientExists(ctx context.Context, tx pgx.Tx, id string) (bool, error) {
+	var exists bool
+	err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM clients WHERE id = $1)`, id).Scan(&exists)
+	return exists, err
+}
+
+// ActiveAssigneeExists — design-errors.md §Validation Fields: assignee_id «NULL или uuid
+// активного пользователя».
+func (r *TaskRepo) ActiveAssigneeExists(ctx context.Context, tx pgx.Tx, id string) (bool, error) {
+	var exists bool
+	err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM users WHERE id = $1 AND is_active)`, id).Scan(&exists)
+	return exists, err
+}
+
+// Get — design-sql.md §Board List Query (без пагинации/фильтров, одна строка): полная
+// карточка заказа с денормализованными именами и счётчиками подзадач — источник ответа
+// GET /tasks/:id и всех mutation-ответов (Re-fetch-after-write).
+func (r *TaskRepo) Get(ctx context.Context, id int64) (*Task, error) {
+	var t Task
+	err := r.pool.QueryRow(ctx, `
+		SELECT t.id, t.column_id, t.client_id, cl.company_name, t.title, t.assignee_id, u.name,
+		       t.due_date::text, t.is_paid, t.paid_at, t.position::text, t.version, t.created_at, t.updated_at,
+		       (SELECT count(*) FROM subtasks s WHERE s.task_id = t.id),
+		       (SELECT count(*) FROM subtasks s WHERE s.task_id = t.id AND s.status = 'done'),
+		       (SELECT count(*) FROM subtasks s WHERE s.task_id = t.id AND s.status <> 'done' AND s.due_date < current_date)
+		FROM tasks t
+		JOIN clients cl ON cl.id = t.client_id
+		LEFT JOIN users u ON u.id = t.assignee_id
+		WHERE t.id = $1`, id).
+		Scan(&t.ID, &t.ColumnID, &t.ClientID, &t.ClientName, &t.Title, &t.AssigneeID, &t.AssigneeName,
+			&t.DueDate, &t.IsPaid, &t.PaidAt, &t.Position, &t.Version, &t.CreatedAt, &t.UpdatedAt,
+			&t.SubtasksTotal, &t.SubtasksDone, &t.SubtasksLate)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	return &t, err
+}
+
+// boardListSQL — design-sql.md §Board List Query, `due_date`/`position` приведены к text
+// (TaskCard.DueDate/Position — *string/string, не time.Time/Amount).
+const boardListSQL = `
+SELECT t.id, t.column_id, t.client_id, cl.company_name, t.title, t.assignee_id, u.name,
+       t.due_date::text, t.is_paid, t.position::text, t.version,
+       (SELECT count(*) FROM subtasks s WHERE s.task_id = t.id)                       AS subtasks_total,
+       (SELECT count(*) FROM subtasks s WHERE s.task_id = t.id AND s.status = 'done') AS subtasks_done,
+       (SELECT count(*) FROM subtasks s WHERE s.task_id = t.id AND s.status <> 'done'
+                                           AND s.due_date < current_date)             AS subtasks_late,
+       count(*) OVER () AS total
+FROM tasks t
+JOIN columns c  ON c.id = t.column_id
+JOIN clients cl ON cl.id = t.client_id
+LEFT JOIN users u ON u.id = t.assignee_id
+WHERE ($1::uuid IS NULL OR t.client_id = $1)
+  AND ($2::text IS NULL OR t.title ILIKE '%' || $2 || '%' ESCAPE '\' OR cl.company_name ILIKE '%' || $2 || '%' ESCAPE '\'
+       OR t.id = $3::bigint)
+  AND ($4::uuid IS NULL OR EXISTS (SELECT 1 FROM subtasks s JOIN services sv ON sv.id = s.service_id
+                                   WHERE s.task_id = t.id AND sv.category_id = $4))
+  AND ($5::boolean IS NULL OR t.is_paid = $5)
+  AND ($6::uuid IS NULL OR t.assignee_id = $6
+       OR EXISTS (SELECT 1 FROM subtasks s WHERE s.task_id = t.id AND s.assignee_id = $6))
+  AND ($7::text IS NULL OR (NOT c.is_final AND (
+         ($7 = 'overdue' AND t.due_date < current_date)
+      OR ($7 = 'soon'    AND t.due_date <= current_date + 1)
+      OR EXISTS (SELECT 1 FROM subtasks s WHERE s.task_id = t.id AND s.status <> 'done'
+                 AND s.due_date < current_date))))
+ORDER BY c.position, c.id, t.position, t.id
+LIMIT $8 OFFSET $9`
+
+// List — design-sql.md §Board List Query. Q-3 передаётся вызывающей стороной уже
+// экранированным (pkg/sqlutil.EscapeLike, tasks_filter.go).
+func (r *TaskRepo) List(ctx context.Context, f TaskFilter) ([]TaskCard, int, error) {
+	var q, due any
+	if f.Q != "" {
+		q = f.Q
+	}
+	if f.Due != "" {
+		due = f.Due
+	}
+
+	rows, err := r.pool.Query(ctx, boardListSQL,
+		f.ClientID, q, f.TaskNo, f.CategoryID, f.Paid, f.AssigneeID, due, f.Limit, f.Offset)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+
+	var total int
+	out := []TaskCard{}
+	for rows.Next() {
+		var c TaskCard
+		if err := rows.Scan(&c.ID, &c.ColumnID, &c.ClientID, &c.ClientName, &c.Title, &c.AssigneeID, &c.AssigneeName,
+			&c.DueDate, &c.IsPaid, &c.Position, &c.Version, &c.SubtasksTotal, &c.SubtasksDone, &c.SubtasksLate, &total); err != nil {
+			return nil, 0, err
+		}
+		out = append(out, c)
+	}
+	return out, total, rows.Err()
+}
diff --git a/internal/features/board/tasks_service.go b/internal/features/board/tasks_service.go
new file mode 100644
index 0000000..9994cd5
--- /dev/null
+++ b/internal/features/board/tasks_service.go
@@ -0,0 +1,407 @@
+package board
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Actor — вызывающий пользователь (design-go-layers.md §Service Interface). Из
+// middleware.CurrentPrincipal(c) — эталон catalog/products_handler.go:77-80.
+type Actor struct {
+	ID      string
+	IsAdmin bool
+}
+
+// TaskService — концентрирует Lock Order (columns→tasks→products, ADR-104) операций
+// над заказами: список/чтение без транзакции, мутации — withTx + StockEngine.Reconcile.
+type TaskService struct {
+	pool   *pgxpool.Pool
+	repo   *TaskRepo
+	engine *StockEngine
+}
+
+func NewTaskService(pool *pgxpool.Pool, repo *TaskRepo, engine *StockEngine) *TaskService {
+	return &TaskService{pool: pool, repo: repo, engine: engine}
+}
+
+func (s *TaskService) List(ctx context.Context, f TaskFilter) (*TaskListResponse, error) {
+	items, total, err := s.repo.List(ctx, f)
+	if err != nil {
+		return nil, err
+	}
+	return &TaskListResponse{Items: items, Total: total, Limit: f.Limit, Offset: f.Offset}, nil
+}
+
+func (s *TaskService) Get(ctx context.Context, idStr string) (*TaskResponse, error) {
+	id, ok := parseTaskID(idStr)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	t, err := s.repo.Get(ctx, id)
+	if errors.Is(err, errNotFound) {
+		return nil, ErrTaskNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toTaskResponse(*t)
+	return &resp, nil
+}
+
+// Create — design-go-layers.md §Service Interface: Lock Target Column → проверка
+// client/assignee → Insert (позиция в конец) → Reconcile (no-op без услуг; единообразие).
+func (s *TaskService) Create(ctx context.Context, a Actor, in TaskCreateRequest) (*TaskMutationResponse, error) {
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	if !a.IsAdmin && in.IsPaid != nil && *in.IsPaid {
+		return nil, ErrPaidAdminOnly
+	}
+
+	var taskID int64
+	var reconcile ReconcileResult
+	err := withTx(ctx, s.pool, func(tx pgx.Tx) error {
+		target, err := s.repo.LockTargetColumn(ctx, tx, in.ColumnID)
+		if err != nil {
+			return columnRefError(err)
+		}
+
+		exists, err := s.repo.ClientExists(ctx, tx, in.ClientID)
+		if err != nil {
+			return err
+		}
+		if !exists {
+			return errorspkg.Validation(errorspkg.Field{Name: "client_id", Message: msgNotFound})
+		}
+
+		assigneeID := nilIfEmpty(in.AssigneeID)
+		if assigneeID != nil {
+			ok, err := s.repo.ActiveAssigneeExists(ctx, tx, *assigneeID)
+			if err != nil {
+				return err
+			}
+			if !ok {
+				return errorspkg.Validation(errorspkg.Field{Name: "assignee_id", Message: msgNotFound})
+			}
+		}
+
+		pos, err := s.repo.NextPosition(ctx, tx, in.ColumnID, 0, nil, nil)
+		if err != nil {
+			return err
+		}
+
+		created, err := s.repo.Insert(ctx, tx, taskRow{
+			Title: in.Title, ClientID: in.ClientID, ColumnID: in.ColumnID,
+			AssigneeID: assigneeID, DueDate: nilIfEmpty(in.DueDate),
+			IsPaid: in.IsPaid != nil && *in.IsPaid, Position: pos,
+		}, a.ID)
+		if err != nil {
+			return mapTaskFKError(err)
+		}
+		taskID = created.ID
+
+		res, err := s.engine.Reconcile(ctx, tx, taskID, target.ConsumesStock, a.ID)
+		if err != nil {
+			return err
+		}
+		reconcile = res
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.mutationResponse(ctx, taskID, reconcile)
+}
+
+// Update — полная замена карточки (LWW по version). column_id сменился → шаги
+// Lock/OpenSubtasks/Position/Reconcile выполняются как при Move; иначе позиция и склад
+// не трогаются (design-go-layers.md §Service Interface).
+func (s *TaskService) Update(ctx context.Context, a Actor, idStr string, in TaskUpdateRequest) (*TaskMutationResponse, error) {
+	id, ok := parseTaskID(idStr)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	var reconcile ReconcileResult
+	err := withTx(ctx, s.pool, func(tx pgx.Tx) error {
+		target, err := s.repo.LockTargetColumn(ctx, tx, in.ColumnID)
+		if err != nil {
+			return columnRefError(err)
+		}
+		current, err := s.repo.LockTask(ctx, tx, id)
+		if err != nil {
+			return taskLockError(err)
+		}
+
+		// version-конфликт — ДО paid-гарда (AC-010/AC-011, code review MEDIUM-2): executor
+		// со устаревшей формой должен получить 409 TASK_VERSION_CONFLICT (клиент по коду
+		// перезагружает карточку), а не ложный 403 PAID_ADMIN_ONLY из-за того, что is_paid
+		// успели сменить с момента открытия формы. current — из LockTask (FOR UPDATE),
+		// проверка авторитетна: значение не может смениться до конца этой транзакции.
+		if *in.Version != current.Version {
+			return ErrTaskVersionConflict
+		}
+
+		if !a.IsAdmin {
+			wantPaid := in.IsPaid != nil && *in.IsPaid
+			if wantPaid != current.IsPaid {
+				return ErrPaidAdminOnly
+			}
+		}
+
+		exists, err := s.repo.ClientExists(ctx, tx, in.ClientID)
+		if err != nil {
+			return err
+		}
+		if !exists {
+			return errorspkg.Validation(errorspkg.Field{Name: "client_id", Message: msgNotFound})
+		}
+
+		assigneeID := nilIfEmpty(in.AssigneeID)
+		if !samePtr(current.AssigneeID, assigneeID) && assigneeID != nil {
+			ok, err := s.repo.ActiveAssigneeExists(ctx, tx, *assigneeID)
+			if err != nil {
+				return err
+			}
+			if !ok {
+				return errorspkg.Validation(errorspkg.Field{Name: "assignee_id", Message: msgNotFound})
+			}
+		}
+
+		columnChanged := current.ColumnID != in.ColumnID
+		pos := current.Position
+		if columnChanged {
+			if target.IsFinal {
+				open, err := s.repo.OpenSubtasks(ctx, tx, id)
+				if err != nil {
+					return err
+				}
+				if len(open) > 0 {
+					return ErrSubtasksNotDone.WithDetail("subtasks", open)
+				}
+			}
+			pos, err = s.repo.NextPosition(ctx, tx, in.ColumnID, id, nil, nil)
+			if err != nil {
+				return err
+			}
+		}
+
+		if _, err := s.repo.Update(ctx, tx, id, *in.Version, taskRow{
+			Title: in.Title, ClientID: in.ClientID, ColumnID: in.ColumnID,
+			AssigneeID: assigneeID, DueDate: nilIfEmpty(in.DueDate),
+			IsPaid: in.IsPaid != nil && *in.IsPaid, Position: pos,
+		}); err != nil {
+			if errors.Is(err, errVersionConflict) {
+				return ErrTaskVersionConflict
+			}
+			return mapTaskFKError(err)
+		}
+
+		if columnChanged {
+			res, err := s.engine.Reconcile(ctx, tx, id, target.ConsumesStock, a.ID)
+			if err != nil {
+				return err
+			}
+			reconcile = res
+		} else {
+			reconcile = ReconcileResult{Warnings: []StockWarning{}}
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.mutationResponse(ctx, id, reconcile)
+}
+
+// Move — design-go-layers.md §Service Interface, шаги 1-7.
+func (s *TaskService) Move(ctx context.Context, a Actor, idStr string, in TaskMoveRequest) (*TaskMutationResponse, error) {
+	id, ok := parseTaskID(idStr)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "tasks.move")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id))
+
+	var fromColumn string
+	var reconcile ReconcileResult
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
+		target, err := s.repo.LockTargetColumn(spanCtx, tx, in.ColumnID)
+		if err != nil {
+			return columnRefError(err)
+		}
+		current, err := s.repo.LockTask(spanCtx, tx, id)
+		if err != nil {
+			return taskLockError(err)
+		}
+		fromColumn = current.ColumnID
+		columnChanged := current.ColumnID != in.ColumnID
+
+		if target.IsFinal && columnChanged {
+			open, err := s.repo.OpenSubtasks(spanCtx, tx, id)
+			if err != nil {
+				return err
+			}
+			if len(open) > 0 {
+				return ErrSubtasksNotDone.WithDetail("subtasks", open)
+			}
+		}
+
+		pos, err := s.repo.NextPosition(spanCtx, tx, in.ColumnID, id, in.PrevID, in.NextID)
+		if err != nil {
+			return err
+		}
+		if _, err := s.repo.Move(spanCtx, tx, id, in.ColumnID, pos); err != nil {
+			return err
+		}
+
+		res, err := s.engine.Reconcile(spanCtx, tx, id, target.ConsumesStock, a.ID)
+		if err != nil {
+			return err
+		}
+		reconcile = res
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	span.SetAttributes(
+		attribute.String("from_column", fromColumn),
+		attribute.String("to_column", in.ColumnID),
+		attribute.Int("movements_count", reconcile.Movements),
+	)
+	return s.mutationResponse(ctx, id, reconcile)
+}
+
+// Delete — только admin (роут + повторная проверка роли в сервисе); StockEngine.
+// Reconcile(false) возвращает весь склад заказа перед удалением строки.
+func (s *TaskService) Delete(ctx context.Context, a Actor, idStr string) (*TaskDeleteResponse, error) {
+	id, ok := parseTaskID(idStr)
+	if !ok {
+		return nil, ErrTaskNotFound
+	}
+	if !a.IsAdmin {
+		return nil, errorspkg.Forbidden("admin only")
+	}
+
+	var reconcile ReconcileResult
+	err := withTx(ctx, s.pool, func(tx pgx.Tx) error {
+		if _, err := s.repo.LockTask(ctx, tx, id); err != nil {
+			return taskLockError(err)
+		}
+		res, err := s.engine.Reconcile(ctx, tx, id, false, a.ID)
+		if err != nil {
+			return err
+		}
+		reconcile = res
+		if err := s.repo.Delete(ctx, tx, id); err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrTaskNotFound
+			}
+			return err
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &TaskDeleteResponse{Warnings: reconcile.Warnings}, nil
+}
+
+// mutationResponse — Re-fetch-after-write: ответ Create/Update/Move собирается ИЗ Get()
+// после коммита транзакции, не из RETURNING-строки мутации (денормализованные поля
+// TaskCard — JOIN'ы, посчитанные заново).
+func (s *TaskService) mutationResponse(ctx context.Context, id int64, reconcile ReconcileResult) (*TaskMutationResponse, error) {
+	full, err := s.repo.Get(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	warnings := reconcile.Warnings
+	if warnings == nil {
+		warnings = []StockWarning{}
+	}
+	return &TaskMutationResponse{Task: toTaskResponse(*full), Warnings: warnings}, nil
+}
+
+func toTaskResponse(t Task) TaskResponse {
+	return TaskResponse{
+		TaskCard: TaskCard{
+			ID: t.ID, ColumnID: t.ColumnID, ClientID: t.ClientID, ClientName: t.ClientName,
+			Title: t.Title, AssigneeID: t.AssigneeID, AssigneeName: t.AssigneeName,
+			DueDate: t.DueDate, IsPaid: t.IsPaid, Position: t.Position, Version: t.Version,
+			SubtasksTotal: t.SubtasksTotal, SubtasksDone: t.SubtasksDone, SubtasksLate: t.SubtasksLate,
+		},
+		PaidAt: t.PaidAt, CreatedAt: t.CreatedAt, UpdatedAt: t.UpdatedAt,
+	}
+}
+
+// parseTaskID — design-errors.md: «tasks.id в пути — strconv.ParseInt>0 до SQL».
+func parseTaskID(s string) (int64, bool) {
+	id, err := strconv.ParseInt(s, 10, 64)
+	return id, err == nil && id > 0
+}
+
+// nilIfEmpty — пустая строка внутри указателя (после normalize) трактуется как «нет
+// значения» на уровне записи в БД/проверки существования.
+func nilIfEmpty(s *string) *string {
+	if s == nil || *s == "" {
+		return nil
+	}
+	return s
+}
+
+// samePtr — nil-безопасное сравнение двух *string (assignee_id «сменился» ли, design-
+// errors.md §Validation Fields).
+func samePtr(a, b *string) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return *a == *b
+}
+
+// columnRefError — LockTargetColumn(errNotFound) → 400 field column_id «не найден»
+// (design-errors.md: «404 — только id в пути», ссылки из тела — VALIDATION).
+func columnRefError(err error) error {
+	if errors.Is(err, errNotFound) {
+		return errorspkg.Validation(errorspkg.Field{Name: "column_id", Message: msgNotFound})
+	}
+	return err
+}
+
+func taskLockError(err error) error {
+	if errors.Is(err, errNotFound) {
+		return ErrTaskNotFound
+	}
+	return err
+}
+
+// mapTaskFKError — гонка с параллельным удалением client_id/assignee_id между проверкой
+// существования и INSERT/UPDATE (design-errors.md §Error Mapping).
+func mapTaskFKError(err error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "23503" {
+		switch pgErr.ConstraintName {
+		case "tasks_client_id_fkey":
+			return errorspkg.Validation(errorspkg.Field{Name: "client_id", Message: msgNotFound})
+		case "tasks_assignee_id_fkey":
+			return errorspkg.Validation(errorspkg.Field{Name: "assignee_id", Message: msgNotFound})
+		}
+	}
+	return err
+}
diff --git a/internal/features/board/tasks_validate.go b/internal/features/board/tasks_validate.go
new file mode 100644
index 0000000..51dc7c7
--- /dev/null
+++ b/internal/features/board/tasks_validate.go
@@ -0,0 +1,100 @@
+package board
+
+import (
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// msgNotFound/msgInvalidDate — коды полей заказов; msgRequired/msgTooLong/msgInvalid/
+// msgInvalidText — общие (columns_validate.go).
+const (
+	msgNotFound    = "not_found"
+	msgInvalidDate = "invalid_date"
+)
+
+// taskTitleMax — design-errors.md §Validation Fields (`title`, trim 1..200).
+const taskTitleMax = 200
+
+// dateLayout — YYYY-MM-DD (design-errors.md §Validation Fields `due_date`).
+const dateLayout = "2006-01-02"
+
+// normalize — trim текстовых полей; nil-указатели (assignee_id/due_date) остаются nil,
+// пустая строка внутри указателя не трактуется как отсутствие значения здесь — это делает
+// nilIfEmpty() в сервисном слое перед записью в БД.
+func (in TaskCreateRequest) normalize() TaskCreateRequest {
+	in.Title = strings.TrimSpace(in.Title)
+	in.ClientID = strings.TrimSpace(in.ClientID)
+	in.ColumnID = strings.TrimSpace(in.ColumnID)
+	if in.AssigneeID != nil {
+		v := strings.TrimSpace(*in.AssigneeID)
+		in.AssigneeID = &v
+	}
+	if in.DueDate != nil {
+		v := strings.TrimSpace(*in.DueDate)
+		in.DueDate = &v
+	}
+	return in
+}
+
+// validate — формат полей после normalize(); существование client_id/column_id/
+// assignee_id проверяет сервис (design-errors.md: «404 клиент/ответственный — в форме
+// ошибка поля»).
+func (in TaskCreateRequest) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	switch n := utf8.RuneCountInString(in.Title); {
+	case n == 0:
+		add("title", msgRequired)
+	case n > taskTitleMax:
+		add("title", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Title) {
+		add("title", msgInvalidText)
+	}
+
+	switch {
+	case in.ClientID == "":
+		add("client_id", msgRequired)
+	case uuid.Validate(in.ClientID) != nil:
+		add("client_id", msgInvalid)
+	}
+
+	switch {
+	case in.ColumnID == "":
+		add("column_id", msgRequired)
+	case uuid.Validate(in.ColumnID) != nil:
+		add("column_id", msgInvalid)
+	}
+
+	if in.AssigneeID != nil && *in.AssigneeID != "" && uuid.Validate(*in.AssigneeID) != nil {
+		add("assignee_id", msgInvalid)
+	}
+
+	if in.DueDate != nil && *in.DueDate != "" {
+		if _, err := time.Parse(dateLayout, *in.DueDate); err != nil {
+			add("due_date", msgInvalidDate)
+		}
+	}
+	return f
+}
+
+// normalize/validate TaskUpdateRequest — та же форма плюс обязательный version (≥1).
+func (in TaskUpdateRequest) normalize() TaskUpdateRequest {
+	in.TaskCreateRequest = in.TaskCreateRequest.normalize()
+	return in
+}
+
+func (in TaskUpdateRequest) validate() []errorspkg.Field {
+	f := in.TaskCreateRequest.validate()
+	if in.Version == nil || *in.Version < 1 {
+		f = append(f, errorspkg.Field{Name: "version", Message: msgRequired})
+	}
+	return f
+}
