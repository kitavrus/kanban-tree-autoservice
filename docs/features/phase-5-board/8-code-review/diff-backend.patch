+// ---------------------------------------------------------------------------------------
+// Заказы: prototype state.tasks (id 11-15, дословно) + demoTasks[5] «Согласование»
+// (синтетика — колонки не было в прототипе, см. комментарий пакета).
+// ---------------------------------------------------------------------------------------
+
+// demoSubtaskItem — prototype newSubtask(serviceId, extra): serviceIdx — индекс
+// demoServices (proto serviceId-201); assigneeIdx -1 — без исполнителя; dueOffset —
+// дни от текущей даты (nil — без срока, эталон dayOffset() прототипа); goodsOverride/
+// priceOverride — explicit-поля extra (nil/"" — берём из услуги, как newSubtask()).
+type demoSubtaskItem struct {
+	serviceIdx    int
+	status        string
+	assigneeIdx   int
+	dueOffset     *int
+	priceOverride string // "" — из услуги
+	goodsOverride []protoGood
+}
+
+// demoTaskItem — prototype state.tasks[i] (без attachments/log — см. комментарий пакета).
+type demoTaskItem struct {
+	column      string
+	clientIdx   int
+	title       string
+	assigneeIdx int // -1 — без исполнителя
+	dueOffset   *int
+	paid        bool
+	descHTML    string
+	subtasks    []demoSubtaskItem
+}
+
+func offset(n int) *int { return &n }
+
+var demoTasks = []demoTaskItem{
+	{ // proto id11
+		column: "Новые", clientIdx: 0, title: "Лазерный станок Bodor — не режет металл", assigneeIdx: 0, dueOffset: offset(1), paid: false,
