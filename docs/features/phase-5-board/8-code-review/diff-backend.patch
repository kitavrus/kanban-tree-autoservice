+// seedProducts — вставляет товар (price/sku/unit/box/place сразу, stock=0 по умолчанию),
+// затем правит остаток на целевой (Stock Adjust Query, D44): движение = target-0, reason
+// manual — стартовый остаток попадает в журнал так же, как ручная правка на «Остатках».
+func (s *seeder) seedProducts(categoryIDs []string) ([]productRow, error) {
+	out := make([]productRow, 0, len(demoProducts))
+	for _, p := range demoProducts {
+		var id string
+		if err := s.tx.QueryRow(s.ctx,
+			`INSERT INTO products (category_id, name, sku, unit, price, box, place, min_stock)
+			 VALUES ($1, $2, $3, $4, $5::numeric, $6, $7, $8::numeric) RETURNING id`,
+			categoryIDs[p.categoryIdx], p.name, p.sku, p.unit, p.price, p.box, p.place, p.minStock).Scan(&id); err != nil {
+			return nil, err
+		}
+		if p.stock == "0" {
+			// stock=0 по умолчанию у только что вставленного товара — движения нет
+			// (stock_movements.qty_delta CHECK <> 0, эталон Stock Adjust Query: «только
+			// если дельта ≠ 0»), UPDATE тоже не нужен.
+			out = append(out, productRow{ID: id})
+			continue
+		}
+		if _, err := s.tx.Exec(s.ctx,
+			`UPDATE products SET stock = $2::numeric, updated_at = now() WHERE id = $1`, id, p.stock); err != nil {
+			return nil, err
+		}
+		if _, err := s.tx.Exec(s.ctx,
+			`INSERT INTO stock_movements (product_id, qty_delta, reason, user_id) VALUES ($1::uuid, $2::numeric, 'manual', $3::uuid)`,
+			id, p.stock, s.adminID); err != nil {
+			return nil, err
+		}
+		out = append(out, productRow{ID: id})
+	}
+	return out, nil
+}
