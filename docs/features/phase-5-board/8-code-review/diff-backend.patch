+++ b/internal/features/board/columns_repo.go
@@ -0,0 +1,207 @@
+package board
+
+import (
+	"context"
+	"errors"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Column — repo-модель колонки (JOIN подсчёта заказов — по месту вызова).
+type Column struct {
+	ID            string
+	Name          string
+	Color         string
+	IsFinal       bool
+	ConsumesStock bool
+	Position      int
+	TasksCount    int
+}
+
+type ColumnRepo struct {
+	pool *pgxpool.Pool
+}
+
+func NewColumnRepo(pool *pgxpool.Pool) *ColumnRepo { return &ColumnRepo{pool: pool} }
+
+const columnColumns = `id, name, color, is_final, consumes_stock, position`
+
+// List — без пагинации по данным (колонок — единицы), но конверт списка §API-1 общий
+// для всех эндпоинтов; total — реальное число строк (не count(*) OVER(), пагинации нет
+// в design-sql.md — набор колонок мал).
+func (r *ColumnRepo) List(ctx context.Context, limit, offset int) ([]Column, int, error) {
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM columns`).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	rows, err := r.pool.Query(ctx, `
+		SELECT `+columnColumns+`, (SELECT count(*) FROM tasks t WHERE t.column_id = c.id) AS tasks_count
+		FROM columns c
+		ORDER BY position, id
+		LIMIT $1 OFFSET $2`, limit, offset)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []Column{}
+	for rows.Next() {
+		var c Column
+		if err := rows.Scan(&c.ID, &c.Name, &c.Color, &c.IsFinal, &c.ConsumesStock, &c.Position, &c.TasksCount); err != nil {
+			return nil, 0, err
+		}
+		out = append(out, c)
+	}
+	return out, total, rows.Err()
+}
+
+// LockAll — вся таблица под FOR UPDATE (ADR-104): держит блокировку колонок на время CRUD/
+// смены флагов, чтобы инвариант «≥1 нефинальная колонка» и перенумерация были устойчивы к
+// конкурентным запросам.
+func (r *ColumnRepo) LockAll(ctx context.Context, tx pgx.Tx) ([]Column, error) {
+	rows, err := tx.Query(ctx, `
+		SELECT `+columnColumns+`, (SELECT count(*) FROM tasks t WHERE t.column_id = c.id) AS tasks_count
+		FROM columns c
+		ORDER BY id
+		FOR UPDATE`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []Column{}
+	for rows.Next() {
+		var c Column
+		if err := rows.Scan(&c.ID, &c.Name, &c.Color, &c.IsFinal, &c.ConsumesStock, &c.Position, &c.TasksCount); err != nil {
+			return nil, err
+		}
+		out = append(out, c)
+	}
+	return out, rows.Err()
+}
+
+// Insert — INSERT с временной (provisional) позицией; итоговую расставляет Renumber
+// сразу следом в той же транзакции (design-sql.md §Column Renumber Query) — позиция
+// не UNIQUE, дублирование на миг между Insert и Renumber безопасно.
+func (r *ColumnRepo) Insert(ctx context.Context, tx pgx.Tx, in ColumnInput, provisionalPosition int) (*Column, error) {
+	var c Column
+	err := tx.QueryRow(ctx, `
+		INSERT INTO columns (name, color, is_final, consumes_stock, position)
+		VALUES ($1, $2, $3, $4, $5)
+		RETURNING `+columnColumns,
+		in.Name, in.Color, in.IsFinal, in.ConsumesStock, provisionalPosition,
+	).Scan(&c.ID, &c.Name, &c.Color, &c.IsFinal, &c.ConsumesStock, &c.Position)
+	return &c, err
+}
+
+// Update — карточка колонки без position (позицию двигает Renumber отдельно, вызывающая
+// сторона знает, менялась ли она). 0 строк → errNotFound.
+func (r *ColumnRepo) Update(ctx context.Context, tx pgx.Tx, id string, in ColumnInput) (*Column, error) {
+	var c Column
+	err := tx.QueryRow(ctx, `
+		UPDATE columns SET name = $2, color = $3, is_final = $4, consumes_stock = $5, updated_at = now()
+		WHERE id = $1
+		RETURNING `+columnColumns,
+		id, in.Name, in.Color, in.IsFinal, in.ConsumesStock,
+	).Scan(&c.ID, &c.Name, &c.Color, &c.IsFinal, &c.ConsumesStock, &c.Position)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	return &c, err
+}
+
+// Renumber — design-sql.md §Column Renumber Query: сдвигает остальные колонки и ставит
+// movingID на targetPosition (1..N, кэлмп — вызывающая сторона). Два отдельных Exec —
+// оператора с общими $1/$2 не объединяются в одну команду (pgx extended protocol).
+func (r *ColumnRepo) Renumber(ctx context.Context, tx pgx.Tx, movingID string, targetPosition int) error {
+	if _, err := tx.Exec(ctx, `
+		WITH ordered AS (
+		    SELECT id, row_number() OVER (ORDER BY position, (id = $1) DESC, id) AS rn FROM columns WHERE id <> $1)
+		UPDATE columns c SET position = CASE WHEN o.rn >= $2 THEN o.rn + 1 ELSE o.rn END
+		FROM ordered o WHERE c.id = o.id`, movingID, targetPosition); err != nil {
+		return err
+	}
+	_, err := tx.Exec(ctx, `UPDATE columns SET position = $2, updated_at = now() WHERE id = $1`, movingID, targetPosition)
+	return err
+}
+
+// closeGaps — после удаления колонки перенумеровывает оставшиеся 1..N (design-sql.md:
+// «position не UNIQUE: перенумерация 1..N в транзакции при create/update/delete»).
+func (r *ColumnRepo) closeGaps(ctx context.Context, tx pgx.Tx) error {
+	_, err := tx.Exec(ctx, `
+		UPDATE columns c SET position = o.rn, updated_at = now()
+		FROM (SELECT id, row_number() OVER (ORDER BY position, id) AS rn FROM columns) o
+		WHERE c.id = o.id AND c.position <> o.rn`)
+	return err
+}
+
+// HasTasks — design-sql.md §Delete Column Query, первая строка (EXISTS-проверка ДО DELETE).
+func (r *ColumnRepo) HasTasks(ctx context.Context, tx pgx.Tx, columnID string) (bool, error) {
+	var exists bool
+	err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM tasks WHERE column_id = $1)`, columnID).Scan(&exists)
+	return exists, err
+}
+
+// TaskIDsForUpdate — design-sql.md §Column Recalc Query: заказы колонки под FOR UPDATE
+// (порядок id) перед циклом StockEngine.Reconcile при смене consumes_stock (AC-007).
+func (r *ColumnRepo) TaskIDsForUpdate(ctx context.Context, tx pgx.Tx, columnID string) ([]int64, error) {
+	rows, err := tx.Query(ctx, `SELECT id FROM tasks WHERE column_id = $1 ORDER BY id FOR UPDATE`, columnID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []int64
+	for rows.Next() {
+		var id int64
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		out = append(out, id)
+	}
+	return out, rows.Err()
+}
+
+// OpenSubtasksForColumn — незавершённые услуги ВСЕХ заказов колонки (эталон
+// TaskRepo.OpenSubtasks, но по всей колонке разом) — используется ColumnService.Update
+// при смене is_final false→true (AC-003, code review MEDIUM-3): заказ с открытыми
+// услугами не должен молча попасть в финальную колонку.
+func (r *ColumnRepo) OpenSubtasksForColumn(ctx context.Context, tx pgx.Tx, columnID string) ([]OpenSubtask, error) {
+	rows, err := tx.Query(ctx, `
+		SELECT s.id, sv.name, s.status
+		FROM subtasks s
+		JOIN services sv ON sv.id = s.service_id
+		JOIN tasks t ON t.id = s.task_id
+		WHERE t.column_id = $1 AND s.status <> 'done'
+		ORDER BY s.position, s.id`, columnID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []OpenSubtask{}
+	for rows.Next() {
+		var o OpenSubtask
+		if err := rows.Scan(&o.ID, &o.ServiceName, &o.Status); err != nil {
+			return nil, err
+		}
+		out = append(out, o)
+	}
+	return out, rows.Err()
+}
+
+// Delete — design-sql.md §Delete Column Query, третья строка. HasTasks/LAST_NON_FINAL_COLUMN
+// проверяет сервис (данные уже под FOR UPDATE из LockAll); здесь — сам DELETE + закрытие
+// пробелов позиций, плюс страховка от гонки: 23503/23001 → errColumnHasTasks.
+func (r *ColumnRepo) Delete(ctx context.Context, tx pgx.Tx, id string) error {
+	tag, err := tx.Exec(ctx, `DELETE FROM columns WHERE id = $1`, id)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && (pgErr.Code == "23503" || pgErr.Code == "23001") {
+			return errColumnHasTasks
+		}
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return errNotFound
+	}
+	return r.closeGaps(ctx, tx)
+}
diff --git a/internal/features/board/columns_service.go b/internal/features/board/columns_service.go
new file mode 100644
index 0000000..969abcc
--- /dev/null
+++ b/internal/features/board/columns_service.go
@@ -0,0 +1,276 @@
+package board
+
+import (
+	"context"
+	"errors"
+	"sort"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"go.opentelemetry.io/otel"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+const (
+	columnsDefaultLimit = 100
+	columnsMaxLimit     = 1000
+)
+
+type ColumnService struct {
+	pool   *pgxpool.Pool
+	repo   *ColumnRepo
+	engine *StockEngine
+}
+
+func NewColumnService(pool *pgxpool.Pool, repo *ColumnRepo, engine *StockEngine) *ColumnService {
+	return &ColumnService{pool: pool, repo: repo, engine: engine}
+}
+
+func (s *ColumnService) List(ctx context.Context, limit, offset int) (*ColumnListResponse, error) {
+	if limit <= 0 {
+		limit = columnsDefaultLimit
+	}
+	limit = min(limit, columnsMaxLimit)
+	offset = max(offset, 0)
+
+	items, total, err := s.repo.List(ctx, limit, offset)
+	if err != nil {
+		return nil, err
+	}
+	resp := &ColumnListResponse{Items: make([]ColumnResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, c := range items {
+		resp.Items[i] = toColumnResponse(c)
+	}
+	return resp, nil
+}
+
+// Create — вся таблица под FOR UPDATE (LockAll), вставка с провизорной позицией в конец,
+// затем Renumber на целевую (POST Position nil → в конец, иначе клэмп к 1..N+1).
+// Create — userID пока не используется (Reconcile на создании — no-op без подзадач,
+// see Service Interface §Create: "единообразие"), сохранён в сигнатуре ради единого
+// профиля ColumnService.{Create,Update} и потенциального аудита создания колонки.
+func (s *ColumnService) Create(ctx context.Context, userID string, in ColumnInput) (*ColumnMutationResponse, error) {
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	var result ColumnMutationResponse
+	err := withTx(ctx, s.pool, func(tx pgx.Tx) error {
+		columns, err := s.repo.LockAll(ctx, tx)
+		if err != nil {
+			return err
+		}
+		n := len(columns)
+		target := n + 1
+		if in.Position != nil {
+			target = clamp(*in.Position, 1, n+1)
+		}
+
+		col, err := s.repo.Insert(ctx, tx, in, n+1)
+		if err != nil {
+			return err
+		}
+		if target != col.Position {
+			if err := s.repo.Renumber(ctx, tx, col.ID, target); err != nil {
+				return err
+			}
+			col.Position = target
+		}
+		col.TasksCount = 0
+		result = ColumnMutationResponse{Column: toColumnResponse(*col), Warnings: []StockWarning{}}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &result, nil
+}
+
+// Update — смена consumes_stock пересчитывает склад по всем заказам колонки
+// (StockEngine.Reconcile, AC-007, span columns.recalc); смена position — Renumber.
+// Оба шага выполняются под тем же LockAll (ADR-104).
+func (s *ColumnService) Update(ctx context.Context, id, userID string, in ColumnInput) (*ColumnMutationResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrColumnNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	var result ColumnMutationResponse
+	err := withTx(ctx, s.pool, func(tx pgx.Tx) error {
+		columns, err := s.repo.LockAll(ctx, tx)
+		if err != nil {
+			return err
+		}
+		var before *Column
+		for i := range columns {
+			if columns[i].ID == id {
+				before = &columns[i]
+				break
+			}
+		}
+		if before == nil {
+			return ErrColumnNotFound
+		}
+		consumesChanged := before.ConsumesStock != in.ConsumesStock
+		becomesFinal := !before.IsFinal && in.IsFinal
+
+		// becomesFinal — тот же инвариант «≥1 нефинальная колонка», что и Delete (ADR-104,
+		// LV-054): PUT is_final=true на последней нефинальной колонке запрещён так же, как
+		// её удаление — иначе на доске не остаётся места для незавершённых заказов.
+		if becomesFinal {
+			nonFinalOthers := 0
+			for i := range columns {
+				if columns[i].ID == id {
+					continue
+				}
+				if !columns[i].IsFinal {
+					nonFinalOthers++
+				}
+			}
+			if nonFinalOthers == 0 {
+				return ErrLastNonFinalColumn
+			}
+
+			// AC-003: заказы с незавершёнными услугами не должны оказаться в финальной
+			// колонке в обход правила, которое уже действует для Move/Update заказа
+			// (эскалация code review, design-errors.md/design-sql.md — MEDIUM-3).
+			open, err := s.repo.OpenSubtasksForColumn(ctx, tx, id)
+			if err != nil {
+				return err
+			}
+			if len(open) > 0 {
+				return ErrSubtasksNotDone.WithDetail("subtasks", open)
+			}
+		}
+
+		updated, err := s.repo.Update(ctx, tx, id, in)
+		if err != nil {
+			if errors.Is(err, errNotFound) {
+				return ErrColumnNotFound
+			}
+			return err
+		}
+		updated.Position = before.Position
+		updated.TasksCount = before.TasksCount
+
+		if in.Position != nil {
+			target := clamp(*in.Position, 1, len(columns))
+			if target != updated.Position {
+				if err := s.repo.Renumber(ctx, tx, id, target); err != nil {
+					return err
+				}
+				updated.Position = target
+			}
+		}
+
+		warnings := []StockWarning{}
+		if consumesChanged {
+			recalcCtx, span := otel.Tracer("board").Start(ctx, "columns.recalc")
+			taskIDs, err := s.repo.TaskIDsForUpdate(recalcCtx, tx, id)
+			if err != nil {
+				span.End()
+				return err
+			}
+			byProduct := map[string]StockWarning{}
+			for _, taskID := range taskIDs {
+				res, err := s.engine.Reconcile(recalcCtx, tx, taskID, in.ConsumesStock, userID)
+				if err != nil {
+					span.End()
+					return err
+				}
+				for _, w := range res.Warnings {
+					byProduct[w.ProductID] = w
+				}
+			}
+			span.End()
+			for _, w := range byProduct {
+				warnings = append(warnings, w)
+			}
+			sort.Slice(warnings, func(i, j int) bool { return warnings[i].ProductID < warnings[j].ProductID })
+		}
+
+		result = ColumnMutationResponse{Column: toColumnResponse(*updated), Warnings: warnings}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &result, nil
+}
+
+// Delete — guard'ы COLUMN_NOT_EMPTY/LAST_NON_FINAL_COLUMN под тем же LockAll, что и
+// сам DELETE (ADR-104: инвариант «≥1 нефинальная колонка» устойчив к гонке).
+func (s *ColumnService) Delete(ctx context.Context, id string) error {
+	if uuid.Validate(id) != nil {
+		return ErrColumnNotFound
+	}
+	return withTx(ctx, s.pool, func(tx pgx.Tx) error {
+		columns, err := s.repo.LockAll(ctx, tx)
+		if err != nil {
+			return err
+		}
+		var target *Column
+		nonFinalOthers := 0
+		for i := range columns {
+			if columns[i].ID == id {
+				target = &columns[i]
+				continue
+			}
+			if !columns[i].IsFinal {
+				nonFinalOthers++
+			}
+		}
+		if target == nil {
+			return ErrColumnNotFound
+		}
+
+		hasTasks, err := s.repo.HasTasks(ctx, tx, id)
+		if err != nil {
+			return err
+		}
+		if hasTasks {
+			return ErrColumnNotEmpty
+		}
+		if !target.IsFinal && nonFinalOthers == 0 {
+			return ErrLastNonFinalColumn
+		}
+
+		if err := s.repo.Delete(ctx, tx, id); err != nil {
+			switch {
+			case errors.Is(err, errColumnHasTasks):
+				return ErrColumnNotEmpty
+			case errors.Is(err, errNotFound):
+				return ErrColumnNotFound
+			default:
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+func toColumnResponse(c Column) ColumnResponse {
+	return ColumnResponse{
+		ID: c.ID, Name: c.Name, Color: c.Color, IsFinal: c.IsFinal,
+		ConsumesStock: c.ConsumesStock, Position: c.Position, TasksCount: c.TasksCount,
+	}
+}
+
+// clamp — ограничивает v диапазоном [lo, hi] (design-sql.md §Column Renumber Query: "$2 —
+// целевая позиция (1..N, clamp)").
+func clamp(v, lo, hi int) int {
+	switch {
+	case v < lo:
+		return lo
+	case v > hi:
+		return hi
+	default:
+		return v
+	}
+}
diff --git a/internal/features/board/columns_validate.go b/internal/features/board/columns_validate.go
new file mode 100644
index 0000000..9fe1c08
--- /dev/null
+++ b/internal/features/board/columns_validate.go
@@ -0,0 +1,59 @@
+package board
+
+import (
+	"regexp"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Коды ошибок полей (details.fields[].message) — эталон internal/features/clients/validate.go.
+const (
+	msgRequired      = "required"
+	msgTooLong       = "too_long"
+	msgInvalid       = "invalid"
+	msgInvalidFormat = "invalid_format"
+	msgInvalidText   = "invalid_text"
+)
+
+// columnNameMax — design-errors.md §Validation Fields (`name` колонки, trim 1..60).
+const columnNameMax = 60
+
+// columnColorRe — design-errors.md §Validation Fields / migrations/0005_board CHECK.
+var columnColorRe = regexp.MustCompile(`^#[0-9A-Fa-f]{6}$`)
+
+// normalize — trim name/color; is_final/consumes_stock/position — без нормализации.
+func (in ColumnInput) normalize() ColumnInput {
+	in.Name = strings.TrimSpace(in.Name)
+	in.Color = strings.TrimSpace(in.Color)
+	return in
+}
+
+// validate — ошибки полей после normalize(). Position == nil допустим (POST → в конец,
+// PUT → без перемещения); клэмп явного значения к 1..N — сервис (там известно текущее N
+// колонок под FOR UPDATE, design-sql.md §Column Renumber Query).
+func (in ColumnInput) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	switch n := utf8.RuneCountInString(in.Name); {
+	case n == 0:
+		add("name", msgRequired)
+	case n > columnNameMax:
+		add("name", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Name) {
+		add("name", msgInvalidText)
+	}
+
+	if !columnColorRe.MatchString(in.Color) {
+		add("color", msgInvalidFormat)
+	}
+
+	if in.Position != nil && *in.Position < 1 {
+		add("position", msgInvalid)
+	}
+	return f
+}
diff --git a/internal/features/board/columns_validate_test.go b/internal/features/board/columns_validate_test.go
new file mode 100644
index 0000000..1625f77
--- /dev/null
+++ b/internal/features/board/columns_validate_test.go
@@ -0,0 +1,55 @@
+package board
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func ptrInt(v int) *int { return &v }
+
+func TestColumnInputValidate_EmptyName(t *testing.T) {
+	in := ColumnInput{Name: "  ", Color: "#94A3B8"}.normalize()
+	fields := in.validate()
+	assert.Len(t, fields, 1)
+	assert.Equal(t, "name", fields[0].Name)
+	assert.Equal(t, msgRequired, fields[0].Message)
+}
+
+func TestColumnInputValidate_NameTooLong(t *testing.T) {
+	long := make([]byte, columnNameMax+1)
+	for i := range long {
+		long[i] = 'a'
+	}
+	in := ColumnInput{Name: string(long), Color: "#94A3B8"}.normalize()
+	fields := in.validate()
+	assert.Len(t, fields, 1)
+	assert.Equal(t, "name", fields[0].Name)
+	assert.Equal(t, msgTooLong, fields[0].Message)
+}
+
+func TestColumnInputValidate_InvalidColor(t *testing.T) {
+	cases := []string{"", "94A3B8", "#94A3B", "#GGGGGG", "#94a3b8g"}
+	for _, c := range cases {
+		in := ColumnInput{Name: "Новые", Color: c}.normalize()
+		fields := in.validate()
+		assert.Len(t, fields, 1, "color=%q", c)
+		assert.Equal(t, "color", fields[0].Name)
+		assert.Equal(t, msgInvalidFormat, fields[0].Message)
+	}
+}
+
+func TestColumnInputValidate_ValidInput(t *testing.T) {
+	in := ColumnInput{
+		Name: "Новые", Color: "#94A3B8", IsFinal: false, ConsumesStock: true, Position: ptrInt(1),
+	}.normalize()
+	assert.Empty(t, in.validate())
+}
+
+func TestColumnInputValidate_InvalidPosition(t *testing.T) {
+	in := ColumnInput{Name: "Новые", Color: "#94A3B8", Position: ptrInt(0)}.normalize()
+	fields := in.validate()
+	assert.Len(t, fields, 1)
+	assert.Equal(t, "position", fields[0].Name)
+	assert.Equal(t, msgInvalid, fields[0].Message)
+}
diff --git a/internal/features/board/enums.go b/internal/features/board/enums.go
new file mode 100644
index 0000000..109cbee
--- /dev/null
+++ b/internal/features/board/enums.go
@@ -0,0 +1,78 @@
+package board
+
+// Enum'ы доски (design-go-layers.md §Enum*). Источник правды для валидации query-параметров
+// и sync-тестов (enums_test.go — статическая сверка; сверка с pg_get_constraintdef CHECK'ов
+// БД — live-сьюта фазы 03, board_http_live_test.go).
+
+// SubtaskStatus — CHECK subtasks.status (migrations/0005_board.up.sql).
+const (
+	SubtaskStatusNew        = "new"
+	SubtaskStatusInProgress = "in_progress"
+	SubtaskStatusDone       = "done"
+)
+
+var SubtaskStatuses = []string{SubtaskStatusNew, SubtaskStatusInProgress, SubtaskStatusDone}
+
+// PaidFilter — query `paid` списка заказов (AC-013).
+const (
