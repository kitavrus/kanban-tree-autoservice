+		subtasks: []demoSubtaskItem{
+			{serviceIdx: 6, status: board.SubtaskStatusNew, assigneeIdx: 0},
+			{serviceIdx: 1, status: board.SubtaskStatusInProgress, assigneeIdx: 0, dueOffset: offset(3)},
+		},
+	},
+	{ // proto id12
+		column: "Новые", clientIdx: 2, title: "ТО грузовика ГАЗель NEXT", assigneeIdx: 1, dueOffset: offset(6), paid: true,
+		subtasks: []demoSubtaskItem{{serviceIdx: 7, status: board.SubtaskStatusNew, assigneeIdx: 1}},
+	},
+	{ // proto id13
+		column: "В работе", clientIdx: 1, title: "Замена двигателя погрузчика №2", assigneeIdx: 0, dueOffset: offset(-1), paid: false,
+		descHTML: "<p>Двигатель заклинило. Клиент согласовал контрактный.</p>",
+		subtasks: []demoSubtaskItem{
