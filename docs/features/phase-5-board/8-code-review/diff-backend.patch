+// Package board — доска заказов: колонки, заказы (BIGSERIAL, D37), подзадачи-услуги,
+// движение склада по заказу (StockEngine.Reconcile, ADR-104). Многосущностный пакет,
+// файлы разделены по сущности (эталон internal/features/catalog, D43).
+package board
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Sentinel'ы, отдаваемые наружу API (design-errors.md §Sentinel Errors, коды 01-11).
+var (
+	ErrTaskNotFound         = errorspkg.New("TASK_NOT_FOUND", http.StatusNotFound, "Заказ не найден")
+	ErrColumnNotFound       = errorspkg.New("COLUMN_NOT_FOUND", http.StatusNotFound, "Колонка не найдена")
+	ErrSubtasksNotDone      = errorspkg.New("SUBTASKS_NOT_DONE", http.StatusConflict, "Есть незавершённые услуги — в финальную колонку нельзя")
+	ErrColumnNotEmpty       = errorspkg.New("COLUMN_NOT_EMPTY", http.StatusConflict, "В колонке есть заказы")
+	ErrLastNonFinalColumn   = errorspkg.New("LAST_NON_FINAL_COLUMN", http.StatusConflict, "Нужна хотя бы одна нефинальная колонка")
+	ErrTaskVersionConflict  = errorspkg.New("TASK_VERSION_CONFLICT", http.StatusConflict, "Заказ уже изменён, обновите")
+	ErrStockProductNotFound = errorspkg.New("PRODUCT_NOT_FOUND", http.StatusNotFound, "Товар не найден")
+	ErrPaidAdminOnly        = errorspkg.New("PAID_ADMIN_ONLY", http.StatusForbidden, "Оплату меняет только администратор")
+)
+
+// Внутренние (репозиторные) ошибки — наружу не текут, сервисный слой мапит их через
+// errors.Is в sentinel'ы выше.
+var (
+	errNotFound = errors.New("board: not found")
+	// errColumnHasTasks — 23503/23001 на tasks_column_id_fkey при DELETE columns (в т.ч.
+	// гонка: заказ создан между EXISTS-проверкой сервиса и DELETE).
+	errColumnHasTasks = errors.New("board: column has tasks")
+	// errVersionConflict — UPDATE tasks ... WHERE version=$n вернул 0 строк при уже
+	// подтверждённом (LockTask) существовании заказа (ErrTaskVersionConflict, AC-010).
+	errVersionConflict = errors.New("board: task version conflict")
+)
diff --git a/internal/features/board/position.go b/internal/features/board/position.go
new file mode 100644
index 0000000..992fa3d
--- /dev/null
+++ b/internal/features/board/position.go
@@ -0,0 +1,67 @@
+package board
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// positionQuerySQL — ADR-001 (design-sql.md §Position Query). Соседи читаются только из
+// целевой колонки и не равные самому заказу; «чужой»/несуществующий сосед игнорируется.
+// needs_rebalance (code review MEDIUM-1): PG ограничивает scale результата деления
+// NUMERIC значением max(16, scale входов) — порог `scale(pos) > 20` недостижим, середина
+// округляется до scale=16 и после ~64 последовательных вставок в один зазор совпадает с
+// соседом. Триггерим ребалансировку раньше — как только середина перестаёт быть строго
+// МЕЖДУ соседями (pos <= prev_pos OR pos >= next_pos), либо когда scale(pos) уже достиг
+// потолка (>= 16) и следующее деление пополам гарантированно даст совпадение.
+const positionQuerySQL = `
+WITH prev AS (SELECT position FROM tasks WHERE id = $3 AND column_id = $1 AND id <> $2),
+     next AS (SELECT position FROM tasks WHERE id = $4 AND column_id = $1 AND id <> $2),
+     last AS (SELECT max(position) AS p FROM tasks WHERE column_id = $1 AND id <> $2),
+     calc AS (
+         SELECT CASE
+             WHEN (SELECT position FROM prev) IS NOT NULL AND (SELECT position FROM next) IS NOT NULL
+                  THEN trim_scale(((SELECT position FROM prev) + (SELECT position FROM next)) / 2)
+             WHEN (SELECT position FROM prev) IS NOT NULL THEN (SELECT position FROM prev) + 1024
+             WHEN (SELECT position FROM next) IS NOT NULL THEN (SELECT position FROM next) - 1024
+             ELSE COALESCE((SELECT p FROM last), 0) + 1024
+         END AS pos,
+         (SELECT position FROM prev) AS prev_pos,
+         (SELECT position FROM next) AS next_pos
+     )
+SELECT pos::text,
+       (prev_pos IS NOT NULL AND next_pos IS NOT NULL AND (prev_pos >= next_pos OR pos <= prev_pos OR pos >= next_pos))
+       OR scale(pos) >= 16 AS needs_rebalance
+FROM calc;`
+
+// renumberColumnSQL — ребалансировка колонки (одна итерация): перенумеровать 1024*rn всех
+// заказов колонки, КРОМЕ переносимого $2 (design-sql.md §Position Query, второй блок).
+// version НЕ инкрементится (порядок ≠ правка заказа).
+const renumberColumnSQL = `
+UPDATE tasks t SET position = r.rn * 1024
+FROM (SELECT id, row_number() OVER (ORDER BY position, id) AS rn
+      FROM tasks WHERE column_id = $1 AND id <> $2) r
+WHERE t.id = r.id;`
+
+// nextPosition — позиция карточки $2 между prev/next в колонке $1 (ADR-001); при
+// неустойчивом результате колонка перенумеровывается и позиция считается заново один раз.
+// Используется TaskRepo.NextPosition (design-go-layers.md §Repository Interface, фаза 03).
+func nextPosition(ctx context.Context, tx pgx.Tx, columnID string, taskID int64, prevID, nextID *int64) (string, error) {
+	pos, rebalance, err := queryPosition(ctx, tx, columnID, taskID, prevID, nextID)
+	if err != nil {
+		return "", err
+	}
+	if !rebalance {
+		return pos, nil
+	}
+	if _, err := tx.Exec(ctx, renumberColumnSQL, columnID, taskID); err != nil {
+		return "", err
+	}
+	pos, _, err = queryPosition(ctx, tx, columnID, taskID, prevID, nextID)
+	return pos, err
+}
+
+func queryPosition(ctx context.Context, tx pgx.Tx, columnID string, taskID int64, prevID, nextID *int64) (pos string, rebalance bool, err error) {
+	err = tx.QueryRow(ctx, positionQuerySQL, columnID, taskID, prevID, nextID).Scan(&pos, &rebalance)
+	return pos, rebalance, err
+}
diff --git a/internal/features/board/position_integration_test.go b/internal/features/board/position_integration_test.go
new file mode 100644
index 0000000..d0d617f
--- /dev/null
+++ b/internal/features/board/position_integration_test.go
@@ -0,0 +1,109 @@
+//go:build integration
+
+package board
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// PositionSuite — ADR-001 (design-sql.md §Position Query): позиция между соседями,
+// добавление в пустую/конец колонки, ребалансировка при переполнении масштаба дроби.
+// Пакет `board` (не board_test) — nextPosition/queryPosition неэкспортированы.
+type PositionSuite struct {
+	testutil.BaseSuite
+}
+
+func TestPositionSuite(t *testing.T) {
+	suite.Run(t, new(PositionSuite))
+}
+
+const (
+	posAdminID  = "77777777-7777-7777-7777-777777777777"
+	posClientID = "66666666-6666-6666-6666-666666666666"
+	posColumnID = "55555555-5555-5555-5555-555555555555"
+)
+
+func (s *PositionSuite) SetupSuite() {
+	s.BaseSuite.SetupSuite()
+	ctx := context.Background()
+	_, err := s.Pool.Exec(ctx, `INSERT INTO users (id, login, password_hash, name, role) VALUES
+		($1, 'position-admin', 'x', 'Admin', 'admin') ON CONFLICT (id) DO NOTHING`, posAdminID)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO clients (id, company_name) VALUES ($1, 'Position Co')
+		ON CONFLICT (id) DO NOTHING`, posClientID)
+	s.Require().NoError(err)
+}
+
+func (s *PositionSuite) SetupTest() {
+	ctx := context.Background()
+	_, err := s.Pool.Exec(ctx, `TRUNCATE TABLE columns RESTART IDENTITY CASCADE`)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO columns (id, name, color, is_final, consumes_stock, position)
+		VALUES ($1, 'Новые', '#94A3B8', false, false, 1)`, posColumnID)
+	s.Require().NoError(err)
+}
+
+func (s *PositionSuite) createTask(position string) int64 {
+	ctx := context.Background()
+	var id int64
+	err := s.Pool.QueryRow(ctx, `INSERT INTO tasks (column_id, client_id, title, position, created_by)
+		VALUES ($1, $2, 'T', $3::numeric, $4) RETURNING id`, posColumnID, posClientID, position, posAdminID).Scan(&id)
+	s.Require().NoError(err)
+	return id
+}
+
+func (s *PositionSuite) TestNextPosition_EmptyColumn_AppendsDefault() {
+	ctx := context.Background()
+	tx, err := s.Pool.Begin(ctx)
+	s.Require().NoError(err)
+	defer tx.Rollback(ctx) //nolint:errcheck
+
+	pos, err := nextPosition(ctx, tx, posColumnID, 0, nil, nil)
+	s.Require().NoError(err)
+	s.Equal("1024", pos)
+	s.Require().NoError(tx.Commit(ctx))
+}
+
+func (s *PositionSuite) TestNextPosition_Between_ReturnsMidpoint() {
+	t1 := s.createTask("1024")
+	t2 := s.createTask("2048")
+
+	ctx := context.Background()
+	tx, err := s.Pool.Begin(ctx)
+	s.Require().NoError(err)
+	defer tx.Rollback(ctx) //nolint:errcheck
+
+	pos, err := nextPosition(ctx, tx, posColumnID, 0, &t1, &t2)
+	s.Require().NoError(err)
+	s.Equal("1536", pos)
+	s.Require().NoError(tx.Commit(ctx))
+}
+
+// TestNextPosition_DeepScale_TriggersRebalance — прев/некст с 23-значной дробной частью
+// (итог многократных бисекций) → scale(pos) > 20 → колонка перенумеровывается (1024*rn)
+// один раз, позиция считается заново по уже чистым значениям.
+func (s *PositionSuite) TestNextPosition_DeepScale_TriggersRebalance() {
+	t1 := s.createTask("1")
+	t2 := s.createTask("1.00000000000000000000002")
+
+	ctx := context.Background()
+	tx, err := s.Pool.Begin(ctx)
+	s.Require().NoError(err)
+	defer tx.Rollback(ctx) //nolint:errcheck
+
+	pos, err := nextPosition(ctx, tx, posColumnID, 0, &t1, &t2)
+	s.Require().NoError(err)
+	s.Equal("1536", pos)
+	s.Require().NoError(tx.Commit(ctx))
+
+	var p1, p2 string
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT position::text FROM tasks WHERE id=$1`, t1).Scan(&p1))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT position::text FROM tasks WHERE id=$1`, t2).Scan(&p2))
+	s.Equal("1024", p1)
+	s.Equal("2048", p2)
+}
diff --git a/internal/features/board/routes.go b/internal/features/board/routes.go
new file mode 100644
index 0000000..ec3145c
--- /dev/null
+++ b/internal/features/board/routes.go
@@ -0,0 +1,50 @@
+package board
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+)
+
+// Handlers — группировка хендлеров фичи (design-go-layers.md §Package Layout).
+type Handlers struct {
+	Columns   *ColumnsHandler
+	Tasks     *TasksHandler
+	Assignees *AssigneesHandler
+	Stock     *StockHandler
+}
+
+// Register — JSON API + SSR-страницы `/` и `/stock` (доска занимает корень, ADR-100 —
+// home снят в этой фазе). s == nil — SSR-группа не регистрируется (эталон
+// clients/routes.go; используется, где рендерер не нужен, напр. FuzzMoveBody).
+func Register(app *fiber.App, api fiber.Router, a *middleware.Auth, h *Handlers, s *SSR) {
+	admin := middleware.RequireAdmin(nil)
+	col := api.Group("/columns", a.RequireAPI())
+	col.Get("", h.Columns.List)
+	col.Post("", admin, h.Columns.Create)
+	col.Put("/:id", admin, h.Columns.Update)
+	col.Delete("/:id", admin, h.Columns.Delete)
+
+	// D19 — заказы создаёт/правит/переносит и executor; Delete — только admin.
+	t := api.Group("/tasks", a.RequireAPI())
+	t.Get("", h.Tasks.List)
+	t.Post("", h.Tasks.Create)
+	t.Get("/:id", h.Tasks.Get)
+	t.Put("/:id", h.Tasks.Update)
+	t.Post("/:id/move", h.Tasks.Move)
+	t.Delete("/:id", admin, h.Tasks.Delete)
+
+	api.Get("/assignees", a.RequireAPI(), h.Assignees.List)
+
+	// Остатки — чтение всем авторизованным (в т.ч. executor), правка вручную — admin (D44).
+	st := api.Group("/stock", a.RequireAPI())
+	st.Get("", h.Stock.List)
+	st.Get("/summary", h.Stock.Summary)
+	st.Put("/:product_id", admin, h.Stock.Adjust)
+
+	if s == nil {
+		return
+	}
+	app.Get("/", a.RequireSSR(), s.board)
+	app.Get("/stock", a.RequireSSR(), s.stock)
+}
