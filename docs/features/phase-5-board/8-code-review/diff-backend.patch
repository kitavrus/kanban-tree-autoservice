+func TestAmount_UnmarshalJSON_RejectsNonNumber(t *testing.T) {
+	var a Amount
+	for _, raw := range []string{`"12.50"`, `{}`, `[]`, ``} {
+		err := a.UnmarshalJSON([]byte(raw))
+		assert.Error(t, err, "raw=%q", raw)
+	}
+}
+
+func TestAmount_UnmarshalJSON_Null(t *testing.T) {
+	var a Amount = "should be reset"
+	require.NoError(t, a.UnmarshalJSON([]byte("null")))
+	assert.Equal(t, Amount(""), a)
+
+	var b Amount
+	require.NoError(t, json.Unmarshal([]byte(`5.5`), &b))
+	assert.Equal(t, Amount("5.5"), b)
+}
+
+func TestAmount_Validate_TooLarge(t *testing.T) {
+	scale := Scale{IntDigits: 9, FracDigits: 3}
+	assert.Equal(t, MsgTooLarge, Amount("1000000000").Validate(scale, true))
+	assert.Empty(t, Amount("999999999").Validate(scale, true), "граница — валидно")
+}
+
+func TestAmount_Validate_TooPrecise(t *testing.T) {
+	scale := Scale{IntDigits: 10, FracDigits: 2}
+	assert.Equal(t, MsgTooPrecise, Amount("1.239").Validate(scale, false))
+	assert.Empty(t, Amount("1.23").Validate(scale, false), "граница — валидно")
+}
+
+func TestAmount_Validate_InvalidFormat(t *testing.T) {
+	scale := Scale{IntDigits: 9, FracDigits: 3}
+	for _, v := range []string{"abc", "1e5", "NaN", "1.2.3"} {
+		assert.Equal(t, MsgInvalidFormat, Amount(v).Validate(scale, true), "v=%q", v)
+	}
+}
+
+func TestAmount_Validate_NegativeNotAllowed(t *testing.T) {
+	scale := Scale{IntDigits: 9, FracDigits: 3}
+	assert.Equal(t, MsgInvalid, Amount("-1").Validate(scale, false))
+	assert.Empty(t, Amount("-1").Validate(scale, true), "allowNegative=true — валидно")
+}
diff --git a/pkg/numeric/amount_validate.go b/pkg/numeric/amount_validate.go
new file mode 100644
index 0000000..62740d9
--- /dev/null
+++ b/pkg/numeric/amount_validate.go
@@ -0,0 +1,53 @@
+package numeric
+
+import (
+	"regexp"
+	"strings"
+)
+
+// Коды ошибок диапазона/точности NUMERIC-полей (message-код в details.fields[]; текст
+// подбирает клиент/SSR) — общие для всех фич, использующих Amount (ADR-101).
+const (
+	MsgInvalidFormat = "invalid_format" // не число вовсе: мусор, экспонента, NaN/Inf
+	MsgInvalid       = "invalid"        // отрицательное значение там, где не допускается
+	MsgTooPrecise    = "too_precise"    // больше знаков после запятой, чем допускает scale колонки
+	MsgTooLarge      = "too_large"      // целая часть длиннее, чем допускает precision-scale колонки
+)
+
+// Scale — предел целой/дробной части для конкретной NUMERIC(precision,scale) колонки.
+// IntDigits = precision - scale — сколько цифр допустимо ДО точки, иначе PG вернёт 22003
+// numeric_value_out_of_range на INSERT/UPDATE.
+type Scale struct {
+	IntDigits  int
+	FracDigits int
+}
+
+// decimalRe — целое/десятичное число, опциональный минус, без ведущих нулей (кроме самого
+// "0"), без экспоненты — исключает мусор вида "1e400"/"NaN"/"Inf".
+var decimalRe = regexp.MustCompile(`^-?(0|[1-9]\d*)(\.\d+)?$`)
+
+// Validate — decimalRe уже отсекает всё, что не «-?(0|[1-9]\d*)(\.\d+)?» (экспонента,
+// NaN/Inf, произвольный мусор — MsgInvalidFormat). Дальше — величина целой части (иначе PG
+// молча не округляет, а падает 22003) и точность дробной части (PG НЕ отклоняет лишние
+// знаки — она их МОЛЧА обрезает при записи). Пустая строка — валидно.
+func (a Amount) Validate(scale Scale, allowNegative bool) string {
+	val := string(a)
+	if !decimalRe.MatchString(val) {
+		return MsgInvalidFormat
+	}
+	digits := val
+	if strings.HasPrefix(val, "-") {
+		if !allowNegative {
+			return MsgInvalid
+		}
+		digits = val[1:]
+	}
+	intPart, fracPart, _ := strings.Cut(digits, ".")
+	if len(fracPart) > scale.FracDigits {
+		return MsgTooPrecise
+	}
+	if len(intPart) > scale.IntDigits {
+		return MsgTooLarge
+	}
+	return ""
+}
