+		column: "Ждёт запчасти", clientIdx: 0, title: "Прицеп: усиление рессор и покраска рамы", assigneeIdx: 2, dueOffset: offset(7), paid: false,
+		descHTML: "<p>Ждём краску RAL 5005 — поставка в пятницу.</p>",
+		subtasks: []demoSubtaskItem{
+			{serviceIdx: 4, status: board.SubtaskStatusDone, assigneeIdx: 2},
+			{serviceIdx: 3, status: board.SubtaskStatusNew, assigneeIdx: 2, dueOffset: offset(8), priceOverride: "12000"},
+		},
+	},
+	{ // proto id15
+		column: "Готово", clientIdx: 1, title: "Диагностика электрики станка ЧПУ", assigneeIdx: 1, dueOffset: offset(-5), paid: true,
+		subtasks: []demoSubtaskItem{
+			{serviceIdx: 6, status: board.SubtaskStatusDone, assigneeIdx: 1},
+			{serviceIdx: 2, status: board.SubtaskStatusDone, assigneeIdx: 1, goodsOverride: []protoGood{{10, "10", "120"}}},
+		},
