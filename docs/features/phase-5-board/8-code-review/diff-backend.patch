+	{ // СИНТЕТИКА (не из прототипа — в prototype/index.html только 4 колонки без
+		// «Согласование»; добавлено ради AC-019 «заказы во всех 5 колонках D32»).
+		column: "Согласование", clientIdx: 3, title: "Согласование сметы на плановое ТО", assigneeIdx: -1, paid: false,
