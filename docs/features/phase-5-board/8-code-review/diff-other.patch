+++ b/web/ssr/board/templates/pages/board.html
@@ -0,0 +1,133 @@
+{{ define "actions" }}
+<button type="button" class="btn btn-primary btn-sm" id="task-add-btn" data-testid="task-add">+ Заказ</button>
+{{ if .IsAdmin }}
+<button type="button" class="btn btn-outline-secondary btn-sm" id="column-add-btn" data-testid="column-add">+ Колонка</button>
+{{ end }}
+{{ end }}
+
+{{ define "content" }}
+<div class="board-filters d-flex flex-wrap gap-2 align-items-center mb-3" data-testid="board-filters">
+  <select class="form-select form-select-sm" id="filter-client" data-testid="filter-client" style="max-width:220px">
+    <option value="">Все клиенты</option>
+  </select>
+  <input type="search" class="form-control form-control-sm" id="filter-q" data-testid="filter-q"
+         placeholder="Поиск: №, название, клиент" style="max-width:260px" autocomplete="off">
