+@media (max-width: 576px) {
+  .board-col { width: 85vw; }
+  .board-filters .form-select, .board-filters .form-control, .board-filters .cb { flex: 1 1 100%; max-width: none !important; }
+}
+
+/* ---- остатки (фаза 7, эталон prototype/index.html .kpis/.kpi) ---- */
+.stock-kpis { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4); min-width: 0; }
+.stock-kpi { flex: 1 1 160px; min-width: 0; background: var(--bs-tertiary-bg); border: 1px solid var(--bs-border-color);
+  border-radius: var(--kt-radius); padding: var(--space-3) var(--space-4); display: flex; flex-direction: column; gap: 4px; }
+.stock-kpi span { font-size: var(--text-xs); color: var(--bs-secondary-color); }
+.stock-kpi b { font-size: var(--text-xl); }
+
+@media (max-width: 576px) {
+  .stock-kpis { gap: var(--space-2); }
+  .stock-kpi { flex: 1 1 45%; padding: var(--space-2) var(--space-3); }
+  .stock-view .d-flex.flex-wrap .form-select, .stock-view .d-flex.flex-wrap .form-control, .stock-view .d-flex.flex-wrap .cb { flex: 1 1 100%; max-width: none !important; }
