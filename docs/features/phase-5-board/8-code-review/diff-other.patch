+.board-col-body { padding: 0 8px 8px; overflow-y: auto; min-height: 60px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
+.board-col-body.drag-over { background: rgba(var(--bs-primary-rgb), .08); border-radius: 6px; }
+.board-add-task { margin: 0 8px 8px; border-style: dashed; }
+.task-card { background: var(--bs-body-bg); border: 1px solid var(--bs-border-color); border-left: 4px solid var(--c, var(--bs-border-color));
+  border-radius: var(--kt-radius); padding: 8px 10px; cursor: grab; min-width: 0; }
+.task-card.dragging { opacity: .4; }
+.task-card.overdue { box-shadow: 0 0 0 1px var(--bs-danger); }
+.task-card-title { font-weight: 600; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.task-card-client { font-size: var(--text-xs); color: var(--bs-secondary-color); display: flex; align-items: center; gap: 6px; margin-bottom: 6px; min-width: 0; }
+.task-card-client .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
+.task-card-menu-btn { margin-left: auto; flex-shrink: 0; }
+.task-card-foot { display: flex; align-items: center; gap: 8px; font-size: var(--text-xs); margin-top: 6px; }
+.task-card .pay { font-size: 11px; font-weight: 600; padding: 0 7px; border-radius: 10px; white-space: nowrap; }
+.task-card .pay-yes { background: rgba(var(--bs-success-rgb), .15); color: var(--bs-success); }
+.task-card .pay-no { background: rgba(var(--bs-danger-rgb), .15); color: var(--bs-danger); }
+.task-card .due { padding: 1px 6px; border-radius: 4px; background: var(--bs-secondary-bg); color: var(--bs-secondary-color); }
+.task-card .due-soon { background: rgba(var(--bs-primary-rgb), .15); color: var(--bs-primary); font-weight: 600; }
+.task-card .due-overdue { background: rgba(var(--bs-danger-rgb), .15); color: var(--bs-danger); font-weight: 600; }
+.task-card .avatar { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font-size: 10px; font-weight: 700;
+  background: rgba(var(--bs-primary-rgb), .15); color: var(--bs-primary); flex-shrink: 0; margin-left: auto; }
+.board-drop-placeholder { height: 48px; border: 2px dashed var(--bs-primary); border-radius: var(--kt-radius); background: rgba(var(--bs-primary-rgb), .06); }
+.board-add-column { width: 240px; flex-shrink: 0; border: 2px dashed var(--bs-border-color); border-radius: var(--kt-radius); padding: 14px;
+  text-align: center; color: var(--bs-secondary-color); background: transparent; }
+.board-add-column:hover { border-color: var(--bs-primary); color: var(--bs-primary); }
+.swatches { flex-wrap: wrap; }
+.swatch { width: 26px; height: 26px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; padding: 0; outline: 2px solid transparent; outline-offset: 1px; }
+.swatch.on { outline-color: var(--bs-body-color); }
+.board-toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 1090; max-width: min(560px, 92vw); }
