+			st, raw := exec.Do(http.MethodPost, base+id+"/restore", nil)
+			s.Equal(http.StatusForbidden, st, "restore %s%s: %s", base, id, raw)
+			s.Equal("Нет доступа", s.sdErr(raw).Message)
