+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal("not_found", s.fields(raw)["category_id"])
+	st, _, raw = s.sdServiceReq(http.MethodPost, "/api/v1/services", goneSvc.ID, "SD-cat Новая услуга "+m, nil)
+	s.Equal(http.StatusBadRequest, st, string(raw))
