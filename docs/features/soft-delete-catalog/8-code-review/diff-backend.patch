diff --git a/internal/features/softdelete/catalog_source.go b/internal/features/softdelete/catalog_source.go
new file mode 100644
index 0000000..994eb82
--- /dev/null
+++ b/internal/features/softdelete/catalog_source.go
@@ -0,0 +1,106 @@
+package softdelete
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Источники вкладок «Товары», «Услуги», «Категории», «Типы оборудования» раздела «Удалённые»
+// (часть 5 soft-delete-catalog §6.9, §8.2). Таблицы читаются напрямую: softdelete — reader,
+// отметку удаления пишут пакеты catalog и equipmenttypes. Строка у всех четырёх видов одной
+// формы: title — название, subtitle — по виду, is_archived = true у записи, удалённой из архива
+// (DS-009: признак архива удалением не меняется).
+
+// CatalogSource — удалённые записи одной таблицы каталога.
+type CatalogSource struct {
+	pool *pgxpool.Pool
+	kind Kind
+	// table — таблица вида (алиас r); subtitleSQL — выражение подзаголовка; joinSQL — соединения
+	// для него (без условия «не удалён»: категория записи сама может быть в удалённых).
+	table, subtitleSQL, joinSQL string
+}
+
+// CategoryKindSubtitle — подзаголовок строки удалённой категории: «товары» либо «услуги».
+func CategoryKindSubtitle(kind string) string {
+	if kind == "product" {
+		return "товары"
+	}
+	return "услуги"
+}
+
+// NewProductsSource — вкладка «Товары»: subtitle — название категории товара.
+func NewProductsSource(pool *pgxpool.Pool) *CatalogSource {
+	return &CatalogSource{pool: pool, kind: KindProducts, table: "products",
+		subtitleSQL: "cc.name", joinSQL: "JOIN catalog_categories cc ON cc.id = r.category_id"}
+}
+
+// NewServicesSource — вкладка «Услуги»: subtitle — название категории услуги.
+func NewServicesSource(pool *pgxpool.Pool) *CatalogSource {
+	return &CatalogSource{pool: pool, kind: KindServices, table: "services",
+		subtitleSQL: "cc.name", joinSQL: "JOIN catalog_categories cc ON cc.id = r.category_id"}
+}
+
+// NewCatalogCategoriesSource — вкладка «Категории»: subtitle — «товары» либо «услуги».
+func NewCatalogCategoriesSource(pool *pgxpool.Pool) *CatalogSource {
+	return &CatalogSource{pool: pool, kind: KindCatalogCategories, table: "catalog_categories",
+		subtitleSQL: "CASE r.kind WHEN 'product' THEN '" + CategoryKindSubtitle("product") + "' ELSE '" + CategoryKindSubtitle("service") + "' END"}
+}
+
+// NewEquipmentTypesSource — вкладка «Типы оборудования»: subtitle — пустая строка.
+func NewEquipmentTypesSource(pool *pgxpool.Pool) *CatalogSource {
+	return &CatalogSource{pool: pool, kind: KindEquipmentTypes, table: "equipment_types", subtitleSQL: "''"}
+}
+
+// whereSQL — фильтр вкладки: $1 — строка поиска (название, причина; уже экранирована), $2/$3 —
+// период [с; по), $4 — кто удалил. Номера у записей каталога нет. Частичный индекс
+// {table}_deleted_at_idx покрывает условие и сортировку.
+func (s *CatalogSource) whereSQL() string {
+	return `
+FROM ` + s.table + ` r
+` + s.joinSQL + `
+JOIN users u ON u.id = r.deleted_by
+WHERE r.deleted_at IS NOT NULL
+  AND ($1::text IS NULL OR r.name ILIKE '%' || $1 || '%' ESCAPE '\'
+       OR r.delete_reason ILIKE '%' || $1 || '%' ESCAPE '\')
+  AND ($2::timestamptz IS NULL OR r.deleted_at >= $2)
+  AND ($3::timestamptz IS NULL OR r.deleted_at < $3)
+  AND ($4::uuid IS NULL OR r.deleted_by = $4)`
+}
+
+func (s *CatalogSource) List(ctx context.Context, f Filter) ([]Item, int, error) {
+	args := filterArgs(f)
+	where := s.whereSQL()
+
+	var total int
+	if err := s.pool.QueryRow(ctx, `SELECT count(*)`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+
+	rows, err := s.pool.Query(ctx, `
+SELECT r.id::text, r.name, `+s.subtitleSQL+`, NOT r.is_active, r.deleted_at, u.id::text,
+       coalesce(nullif(u.name, ''), u.login), r.delete_reason`+where+`
+ORDER BY r.deleted_at DESC, r.id
+LIMIT $5 OFFSET $6`, append(args, f.Limit, f.Offset)...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+
+	out := []Item{}
+	for rows.Next() {
+		it := Item{Kind: string(s.kind)}
+		if err := rows.Scan(&it.ID, &it.Title, &it.Subtitle, &it.IsArchived, &it.DeletedAt, &it.DeletedBy.ID, &it.DeletedBy.Name, &it.DeleteReason); err != nil {
+			return nil, 0, err
+		}
+		it.DeletedAt = it.DeletedAt.UTC()
+		out = append(out, it)
+	}
+	return out, total, rows.Err()
+}
+
+func (s *CatalogSource) Count(ctx context.Context) (int, error) {
+	var n int
+	err := s.pool.QueryRow(ctx, `SELECT count(*) FROM `+s.table+` WHERE deleted_at IS NOT NULL`).Scan(&n)
+	return n, err
+}
diff --git a/internal/features/softdelete/catalog_source_test.go b/internal/features/softdelete/catalog_source_test.go
new file mode 100644
index 0000000..4195a15
--- /dev/null
+++ b/internal/features/softdelete/catalog_source_test.go
@@ -0,0 +1,34 @@
+package softdelete
+
+import "testing"
+
+// Подзаголовок строки удалённой категории (soft-delete-catalog §6.9): вид product — «товары»,
+// service — «услуги».
+func TestCategoryKindSubtitle(t *testing.T) {
+	if got := CategoryKindSubtitle("product"); got != "товары" {
+		t.Fatalf("product: ожидалось «товары», получено %q", got)
+	}
+	if got := CategoryKindSubtitle("service"); got != "услуги" {
+		t.Fatalf("service: ожидалось «услуги», получено %q", got)
+	}
+}
+
+// Источники каталога привязаны к своему виду и таблице: перепутанная пара отдала бы строки
+// чужой вкладки (вид строки — из источника, не из запроса).
+func TestCatalogSourcesKindAndTable(t *testing.T) {
+	cases := []struct {
+		src   *CatalogSource
+		kind  Kind
+		table string
+	}{
+		{NewProductsSource(nil), KindProducts, "products"},
+		{NewServicesSource(nil), KindServices, "services"},
+		{NewCatalogCategoriesSource(nil), KindCatalogCategories, "catalog_categories"},
+		{NewEquipmentTypesSource(nil), KindEquipmentTypes, "equipment_types"},
+	}
+	for _, c := range cases {
+		if c.src.kind != c.kind || c.src.table != c.table {
+			t.Fatalf("источник %s: вид %q, таблица %q", c.kind, c.src.kind, c.src.table)
+		}
+	}
+}
diff --git a/internal/features/softdelete/delete_request_test.go b/internal/features/softdelete/delete_request_test.go
new file mode 100644
index 0000000..294b772
--- /dev/null
+++ b/internal/features/softdelete/delete_request_test.go
@@ -0,0 +1,70 @@
+package softdelete
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// DS-028: тело DELETE разбирается как JSON независимо от Content-Type; пустое, не-JSON и тело без
+// reason дают «причины нет» (nil) — валидатор ответит required, а не 400 «некорректное тело».
+func TestParseDeleteRequest(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       *string
+	}{
+		{"пустое тело", "", nil},
+		{"пробелы", " \n\t ", nil},
+		{"не JSON", "{", nil},
+		{"JSON не объект", `"строка"`, nil},
+		{"нет поля", `{"note":"x"}`, nil},
+		{"null", `{"reason":null}`, nil},
+		{"reason не строка", `{"reason":5}`, nil},
+		{"причина", `{"reason":"Создан по ошибке"}`, ptr("Создан по ошибке")},
+		{"пробелы сохраняются до валидатора", ` {"reason":"  x  "} `, ptr("  x  ")},
+		{"лишние поля игнорируются", `{"reason":"x","version":3}`, ptr("x")},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := ParseDeleteRequest([]byte(c.body)).Reason
+			if c.want == nil {
+				assert.Nil(t, got)
+				return
+			}
+			if assert.NotNil(t, got) {
+				assert.Equal(t, *c.want, *got)
+			}
+		})
+	}
+}
+
+// DS-032: текст под полем «Причина» серверной формы удаления — по коду ошибки поля reason;
+// отказ не по причине (другое поле, 409, не AppError) — пустая строка: форма покажет общий блок.
+func TestReasonError(t *testing.T) {
+	texts := map[string]string{
+		"пусто":      "Укажите причину удаления",
+		"длинная":    "Причина — не длиннее 500 символов",
+		"NUL-символ": "Недопустимые символы в причине",
+	}
+	inputs := map[string]string{"пусто": "  ", "длинная": strings.Repeat("я", ReasonMax+1), "NUL-символ": "x\x00"}
+	for name, in := range inputs {
+		_, fields := ValidateReason(&in)
+		assert.Equal(t, texts[name], ReasonError(errorspkg.Validation(fields...)), name)
+	}
+	assert.Equal(t, "Недопустимое значение", ReasonError(errorspkg.Validation(errorspkg.Field{Name: "reason", Message: "unknown_code"})))
+	assert.Empty(t, ReasonError(errorspkg.Validation(errorspkg.Field{Name: "name", Message: "required"})), "ошибка другого поля")
+	assert.Empty(t, ReasonError(ErrNameTaken), "отказ 409 — не по причине")
+	assert.Empty(t, ReasonError(errors.New("сбой")), "не AppError")
+	assert.Empty(t, ReasonError(nil))
