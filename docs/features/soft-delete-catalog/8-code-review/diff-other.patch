+test.describe('SDCT: мягкое удаление каталога и типов оборудования', () => {
+  test('SDCT-001 (TS-044): категория удаляется с причиной → её товар остаётся с бейджем «категория удалена»; новая категория с тем же названием создаётся; «Восстановить» старую → «Название занято — переименуйте действующую запись», строка остаётся; после переименования новой — «Восстановлено»; архивный товар после удаления и восстановления остаётся в архиве (бейдж «в архиве», «Запись вернётся в архив»); негатив: товар с остатком — «У товара есть остаток на складе — сначала переместите или спишите его», товар не удалён', async ({
+    adminPage: page,
