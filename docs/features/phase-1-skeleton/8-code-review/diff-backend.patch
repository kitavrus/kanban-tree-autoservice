diff --git a/cmd/migrate/main.go b/cmd/migrate/main.go
new file mode 100644
index 0000000..92de9d6
--- /dev/null
+++ b/cmd/migrate/main.go
@@ -0,0 +1,41 @@
+// Migrate — go run ./cmd/migrate up|down (без внешнего migrate-CLI).
+// DATABASE_URL читается напрямую (не internal/config): миграции не обязаны знать
+// auth-режимные переменные (JWT_SECRET и т.п.), которые config.Load() требует.
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+)
+
+func main() {
+	if len(os.Args) < 2 || (os.Args[1] != "up" && os.Args[1] != "down") {
+		fmt.Fprintln(os.Stderr, "usage: migrate up|down")
+		os.Exit(1)
+	}
+	dsn := os.Getenv("DATABASE_URL")
+	if dsn == "" {
+		fmt.Fprintln(os.Stderr, "DATABASE_URL обязателен")
+		os.Exit(1)
+	}
+	m, err := migrate.New("file://migrations", dsn)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "migrate init:", err)
+		os.Exit(1)
+	}
+	if os.Args[1] == "up" {
+		err = m.Up()
+	} else {
+		err = m.Steps(-1)
+	}
+	if err != nil && !errors.Is(err, migrate.ErrNoChange) {
+		fmt.Fprintln(os.Stderr, "migrate", os.Args[1]+":", err)
+		os.Exit(1)
+	}
+	fmt.Println("migrate", os.Args[1], "OK")
+}
diff --git a/cmd/seed/main.go b/cmd/seed/main.go
new file mode 100644
index 0000000..7c14054
--- /dev/null
+++ b/cmd/seed/main.go
@@ -0,0 +1,47 @@
+// Seed — идемпотентный локальный admin (make local-up-seed). ON CONFLICT DO NOTHING:
+// повторный прогон безопасен. Одна и та же users-таблица под session и jwt auth.mode.
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"golang.org/x/crypto/bcrypt"
+)
+
+const (
+	seedLogin    = "admin"
+	seedPassword = "admin1234"
+)
+
+func main() {
+	dsn := os.Getenv("DATABASE_URL")
+	if dsn == "" {
+		fmt.Fprintln(os.Stderr, "DATABASE_URL обязателен")
+		os.Exit(1)
+	}
+	ctx := context.Background()
+	pool, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "pgx:", err)
+		os.Exit(1)
+	}
+	defer pool.Close()
+
+	hash, err := bcrypt.GenerateFromPassword([]byte(seedPassword), bcrypt.DefaultCost)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "bcrypt:", err)
+		os.Exit(1)
+	}
+	_, err = pool.Exec(ctx,
+		`INSERT INTO users (login, password_hash, name) VALUES ($1, $2, $3)
+		 ON CONFLICT (login) DO NOTHING`,
+		seedLogin, string(hash), "Admin")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "seed:", err)
+		os.Exit(1)
+	}
+	fmt.Printf("seed: %s / %s (готов, если не существовал)\n", seedLogin, seedPassword)
+}
diff --git a/cmd/server/main.go b/cmd/server/main.go
new file mode 100644
index 0000000..fff8ab0
--- /dev/null
+++ b/cmd/server/main.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/redis/go-redis/v9"
+
+	"github.com/kitavrus/kanban-tree/internal/config"
+	"github.com/kitavrus/kanban-tree/internal/observability"
+	"github.com/kitavrus/kanban-tree/internal/server"
+)
+
+func main() {
+	// --check-config ОБЯЗАТЕЛЕН (контракт infra-bootstrap): образ проверяет env
+	// своим кодом и выходит 0/1, не поднимая БД/Redis/портов.
+	checkConfig := flag.Bool("check-config", false, "validate env and exit")
+	flag.Parse()
+
+	cfg, err := config.Load()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "config:", err)
+		os.Exit(1)
+	}
+	if *checkConfig {
+		os.Exit(0)
+	}
+
+	logger := observability.NewLogger(cfg.LogLevel)
+	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
+	defer stop()
+
+	shutdownTracer, err := observability.InitTracer(ctx, "kanban-tree", cfg.OTLPEndpoint)
+	if err != nil {
+		logger.Error("otel init", "err", err)
+		os.Exit(1)
+	}
+	defer func() { _ = shutdownTracer(context.Background()) }()
+
+	pool, err := pgxpool.New(ctx, cfg.DatabaseURL)
+	if err != nil {
+		logger.Error("pgx pool", "err", err)
+		os.Exit(1)
+	}
+	defer pool.Close()
+
+	rdb := redis.NewClient(&redis.Options{Addr: cfg.RedisAddr})
+	defer rdb.Close()
+
+	app, err := server.New(cfg, logger, pool, rdb)
+	if err != nil {
+		logger.Error("server init", "err", err)
+		os.Exit(1)
+	}
+
+	go func() {
+		<-ctx.Done()
+		logger.Info("shutdown")
+		_ = app.Shutdown()
+	}()
+
+	logger.Info("listening", "port", cfg.Port)
+	if err := app.Listen(":" + cfg.Port); err != nil {
+		logger.Error("listen", "err", err)
+		os.Exit(1)
+	}
+}
