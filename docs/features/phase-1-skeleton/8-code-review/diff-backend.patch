@@ -0,0 +1,50 @@
+package ssr
+
+// NavItem — пункт сайдбара.
+type NavItem struct {
+	Title     string
+	Icon      string
+	URL       string
+	AdminOnly bool
+}
+
+// NavGroup — группа пунктов с подписью.
+type NavGroup struct {
+	Label string
+	Items []NavItem
+}
+
+// menu — полный сайдбар приложения (эталон — prototype/index.html, plan.md §5).
+// Пункты справочников и администрирования видит только admin (plan.md §2, D19).
+var menu = []NavGroup{
+	{Label: "Работа", Items: []NavItem{
+		{Title: "Доска", Icon: "▦", URL: "/"},
+		{Title: "Остатки", Icon: "📊", URL: "/stock"},
+	}},
+	{Label: "Справочники", Items: []NavItem{
+		{Title: "Клиенты", Icon: "🏢", URL: "/clients", AdminOnly: true},
+		{Title: "Услуги и товары", Icon: "🧰", URL: "/catalog", AdminOnly: true},
+	}},
+	{Label: "Администрирование", Items: []NavItem{
+		{Title: "Сотрудники", Icon: "👥", URL: "/users", AdminOnly: true},
+	}},
+}
+
+// BuildMenu — сайдбар для пользователя: только реализованные разделы (enabled) и
+// только доступные по роли; пустые группы выкидываются.
+func BuildMenu(enabled map[string]bool, isAdmin bool) []NavGroup {
+	var out []NavGroup
+	for _, g := range menu {
+		var items []NavItem
+		for _, it := range g.Items {
+			if !enabled[it.URL] || (it.AdminOnly && !isAdmin) {
+				continue
+			}
+			items = append(items, it)
+		}
+		if len(items) > 0 {
+			out = append(out, NavGroup{Label: g.Label, Items: items})
+		}
+	}
+	return out
+}
diff --git a/internal/ssr/render.go b/internal/ssr/render.go
new file mode 100644
index 0000000..0f360b8
--- /dev/null
+++ b/internal/ssr/render.go
@@ -0,0 +1,122 @@
+// Package ssr — общий SSR-рендерер проекта (Go html/template + vanilla JS, D30).
+//
+// Совместим с /z-scaffold: тот генерирует internal/ssr/render.go ОДИН раз на проект
+// (SKIP, если файл уже есть) и в хендлерах фич зовёт ssr.NewRenderer(root) /
+// r.Page / r.Fragment — сигнатуры сохранены, sharedRoots — вариадик-надстройка.
+//
+// Каждая фича держит свои pages/partials в web/ssr/{feature}/templates (у каждой свой
+// Renderer: html/template требует уникальных {{ define }} внутри набора). Общий layout
+// приложения (сайдбар, топбар, тема — "base") живёт в web/ssr/_layout/templates — ВНЕ
+// корня раздаваемой статики web/ssr/_shared — и подмешивается в каждую страницу через
+// sharedRoots (паттерн zerem_wms).
+//
+// Подключение фичи от /z-scaffold (он штампует свой layouts/base.html и BaseVM без Shell):
+//  1. удалить web/ssr/{feature}/templates/layouts/base.html — иначе два {{ define "base" }};
+//  2. добавить в dto.BaseVM поле `Shell ssr.Shell` и заполнять его в хендлерах
+//     (h.Shell.Build(c, title)) — общий layout читает .Shell.*;
+//  3. в router.go: ssr.NewRenderer("web/ssr/{feature}/templates", ssr.SharedRoot),
+//     путь раздела — в ssr.NewShellBuilder(...), чтобы он появился в сайдбаре.
+//
+// Пути — относительно корня модуля (make run / LiveSuite запускают бинарь оттуда).
+package ssr
+
+import (
+	"bytes"
+	"fmt"
+	"html/template"
+	"io"
+	"path/filepath"
+	"strings"
+
+	"github.com/gofiber/fiber/v3"
+)
+
+// SharedRoot — общий набор шаблонов (layout "base") относительно корня модуля.
+const SharedRoot = "web/ssr/_layout/templates"
+
+type Renderer struct {
+	pages     map[string]*template.Template // имя страницы → set (layouts+partials+page)
+	fragments *template.Template            // только partials — для AJAX-фрагментов
+}
+
+// NewRenderer собирает Renderer из root (layouts/partials/pages фичи) плюс layouts/
+// partials каждого из sharedRoots. Страницы берутся только из root.
+func NewRenderer(root string, sharedRoots ...string) (*Renderer, error) {
+	var layouts, partials []string
+	for _, dir := range append([]string{root}, sharedRoots...) {
+		l, err := filepath.Glob(filepath.Join(dir, "layouts", "*.html"))
+		if err != nil {
+			return nil, err
+		}
+		p, err := filepath.Glob(filepath.Join(dir, "partials", "*.html"))
+		if err != nil {
+			return nil, err
+		}
+		layouts = append(layouts, l...)
+		partials = append(partials, p...)
+	}
+	pages, err := filepath.Glob(filepath.Join(root, "pages", "*.html"))
+	if err != nil {
+		return nil, err
+	}
+	if len(layouts) == 0 || len(pages) == 0 {
+		return nil, fmt.Errorf("ssr: не найдены шаблоны в %s", root)
+	}
+
+	r := &Renderer{pages: map[string]*template.Template{}}
+	for _, p := range pages {
+		files := append(append(append([]string{}, layouts...), partials...), p)
+		name := strings.TrimSuffix(filepath.Base(p), ".html")
+		t, err := template.New(name).Funcs(Funcs).ParseFiles(files...)
+		if err != nil {
+			return nil, fmt.Errorf("ssr: страница %s: %w", name, err)
+		}
+		r.pages[name] = t
+	}
+	// Набор без partials: ParseFiles с пустым списком паникует — fragments опциональны.
+	if len(partials) > 0 {
+		frag, err := template.New("fragments").Funcs(Funcs).ParseFiles(partials...)
+		if err != nil {
+			return nil, fmt.Errorf("ssr: partials: %w", err)
+		}
+		r.fragments = frag
+	}
+	return r, nil
+}
+
+// Funcs — функции шаблонов, общие для всех наборов.
+var Funcs = template.FuncMap{
+	"initials": Initials,
+}
+
+// Render пишет страницу page в layout в w — без HTTP (unit-тесты, печатные формы).
+func (r *Renderer) Render(w io.Writer, page, layout string, vm any) error {
+	t, ok := r.pages[page]
+	if !ok {
+		return fmt.Errorf("ssr: нет страницы %q", page)
+	}
+	return t.ExecuteTemplate(w, layout, vm)
+}
+
+// Page — полная страница: layout "base" + блоки страницы.
+func (r *Renderer) Page(c fiber.Ctx, page string, vm any) error {
+	var buf bytes.Buffer
+	if err := r.Render(&buf, page, "base", vm); err != nil {
+		return err
+	}
+	c.Type("html", "utf-8")
+	return c.Send(buf.Bytes())
+}
+
+// Fragment — именованный partial для AJAX-ответа.
+func (r *Renderer) Fragment(c fiber.Ctx, name string, vm any) error {
+	if r.fragments == nil {
+		return fmt.Errorf("ssr: у набора без partials нет фрагментов (%q)", name)
+	}
+	var buf bytes.Buffer
+	if err := r.fragments.ExecuteTemplate(&buf, name, vm); err != nil {
+		return err
+	}
+	c.Type("html", "utf-8")
+	return c.Send(buf.Bytes())
+}
diff --git a/internal/ssr/render_test.go b/internal/ssr/render_test.go
new file mode 100644
index 0000000..c54c9b6
--- /dev/null
+++ b/internal/ssr/render_test.go
@@ -0,0 +1,138 @@
+package ssr
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/valyala/fasthttp"
+)
+
+// Пути — от каталога пакета (go test запускается в internal/ssr).
+const (
+	testSharedRoot = "../../" + SharedRoot
+	testHomeRoot   = "../../web/ssr/home/templates"
+)
+
+type pageVM struct{ Shell Shell }
+
+func render(t *testing.T, sh Shell) string {
+	t.Helper()
+	r, err := NewRenderer(testHomeRoot, testSharedRoot)
+	require.NoError(t, err)
+	var buf bytes.Buffer
+	require.NoError(t, r.Render(&buf, "index", "base", pageVM{Shell: sh}))
+	return buf.String()
+}
+
+func TestRenderer_PageInSharedLayout(t *testing.T) {
+	html := render(t, Shell{
+		Title:      "Доска заказов",
+		Menu:       BuildMenu(map[string]bool{"/": true}, false),
+		ActivePath: "/",
+		CSRFToken:  "tok-123",
+	})
+
+	assert.Contains(t, html, "<title>Доска заказов — Kanban-tree</title>")
+	assert.Contains(t, html, `<meta name="csrf-token" content="tok-123">`)
+	assert.Contains(t, html, `data-testid="sidebar"`)
+	assert.Contains(t, html, `data-testid="home-placeholder"`, "страница вставлена в блок content")
+	assert.Contains(t, html, `class="app-nav-link active" aria-current="page">▦ Доска</a>`)
+	for _, js := range []string{"theme.js", "api.js", "ui-dialog.js", "combobox.js", "bootstrap.bundle.min.js"} {
+		assert.Contains(t, html, js)
+	}
+	// гость: блока пользователя и формы выхода нет
+	assert.NotContains(t, html, `action="/logout"`)
+}
+
+func TestRenderer_UserBlock(t *testing.T) {
+	html := render(t, Shell{Title: "x", User: Viewer{Name: "Сидоров Пётр", Role: "executor"}})
+	assert.Contains(t, html, `<span class="app-avatar">СП</span>`)
+	assert.Contains(t, html, "Исполнитель")
+	assert.Contains(t, html, `action="/logout"`)
+
+	html = render(t, Shell{Title: "x", User: Viewer{Name: "Админ", Role: RoleAdmin}, IsAdmin: true})
+	assert.Contains(t, html, "Администратор")
+}
+
+func TestRenderer_EscapesData(t *testing.T) {
+	html := render(t, Shell{Title: `<script>alert(1)</script>`, User: Viewer{Name: `<b>x</b>`}})
+	assert.NotContains(t, html, "<script>alert(1)</script>")
+	assert.Contains(t, html, "&lt;script&gt;alert(1)&lt;/script&gt;")
+	assert.NotContains(t, html, "<b>x</b>")
+}
+
+func TestRenderer_Errors(t *testing.T) {
+	r, err := NewRenderer(testHomeRoot, testSharedRoot)
+	require.NoError(t, err)
+	var buf bytes.Buffer
+	assert.ErrorContains(t, r.Render(&buf, "nope", "base", nil), `нет страницы "nope"`)
+
+	_, err = NewRenderer("../../web/ssr/does-not-exist")
+	assert.ErrorContains(t, err, "не найдены шаблоны")
+
+	// без shared-набора у страницы нет layout "base"
+	_, err = NewRenderer(testHomeRoot)
+	assert.ErrorContains(t, err, "не найдены шаблоны")
+}
+
+func TestBuildMenu(t *testing.T) {
+	all := map[string]bool{"/": true, "/stock": true, "/clients": true, "/catalog": true, "/users": true}
+
+	titles := func(groups []NavGroup) []string {
+		var out []string
+		for _, g := range groups {
+			for _, it := range g.Items {
+				out = append(out, g.Label+"/"+it.Title)
+			}
+		}
+		return out
+	}
+
+	assert.Equal(t, []string{"Работа/Доска", "Работа/Остатки", "Справочники/Клиенты", "Справочники/Услуги и товары", "Администрирование/Сотрудники"},
+		titles(BuildMenu(all, true)))
+	assert.Equal(t, []string{"Работа/Доска", "Работа/Остатки"}, titles(BuildMenu(all, false)),
+		"исполнитель не видит справочники и сотрудников (D19); пустые группы выкинуты")
+	assert.Equal(t, []string{"Работа/Доска"}, titles(BuildMenu(map[string]bool{"/": true}, true)),
+		"нереализованные разделы скрыты")
+	assert.Empty(t, BuildMenu(nil, true))
+}
+
+func TestShellBuilder_Build(t *testing.T) {
+	app := fiber.New()
+	fctx := &fasthttp.RequestCtx{}
+	fctx.Request.SetRequestURI("/stock")
+	c := app.AcquireCtx(fctx)
+	defer app.ReleaseCtx(c)
+
+	b := NewShellBuilder("/", "/stock", "/users")
+
+	sh := b.Build(c, "Остатки")
+	assert.Equal(t, "Остатки", sh.Title)
+	assert.Equal(t, "/stock", sh.ActivePath)
+	assert.False(t, sh.IsAdmin, "без viewer — гость")
+	assert.Len(t, sh.Menu, 1, "гостю — только «Работа»")
+
+	c.Locals(LocalViewer, Viewer{Name: "Админ", Role: RoleAdmin})
+	c.Locals(LocalCSRFToken, "csrf-x")
+	sh = b.Build(c, "Остатки")
+	assert.True(t, sh.IsAdmin)
+	assert.Equal(t, "csrf-x", sh.CSRFToken)
+	assert.Len(t, sh.Menu, 2, "admin видит «Администрирование»")
+}
+
+func TestInitials(t *testing.T) {
+	cases := map[string]string{
+		"Сидоров Пётр Иванович": "СП",
+		"admin":            "A",
+		"  волков   олег ": "ВО",
+		"":                 "",
+	}
+	for in, want := range cases {
+		assert.Equal(t, want, Initials(in), in)
+	}
+	assert.True(t, strings.HasPrefix(Initials("ёжик"), "Ё"))
+}
diff --git a/internal/ssr/shell.go b/internal/ssr/shell.go
new file mode 100644
index 0000000..22b206d
--- /dev/null
+++ b/internal/ssr/shell.go
@@ -0,0 +1,81 @@
+package ssr
+
+import (
+	"strings"
+	"unicode"
+
+	"github.com/gofiber/fiber/v3"
+)
+
+// RoleAdmin — роль администратора (plan.md §2); остальные роли видят меню «Работа».
+const RoleAdmin = "admin"
+
+// LocalViewer — Locals-ключ текущего пользователя для layout. Кладёт auth-middleware
+// (фаза 2); нет значения — гость: меню строится без admin-пунктов, блок пользователя скрыт.
+const LocalViewer = "ssr_viewer"
+
+// LocalCSRFToken — Locals-ключ CSRF-токена запроса (CSRF-middleware, фаза 2).
+const LocalCSRFToken = "ssr_csrf_token"
+
+// Viewer — кто смотрит страницу (для сайдбара и прав в шаблонах).
+type Viewer struct {
+	Name string
+	Role string
+}
+
+// Shell — данные общего layout "base", одинаковые для любой страницы любой фичи.
+// Встраивается во view-model страницы полем Shell; хендлер заполняет его через
+// ShellBuilder.Build перед Renderer.Page (сам Renderer сессию не читает).
+type Shell struct {
+	Title      string // заголовок топбара и <title>
+	Menu       []NavGroup
+	ActivePath string
+	User       Viewer
+	IsAdmin    bool
+	// CSRFToken — формы отдают полем _csrf, fetch — заголовком X-Csrf-Token
+	// (скрипты берут из <meta name="csrf-token">).
+	CSRFToken string
+}
+
+// ShellBuilder собирает Shell из запроса. Один экземпляр на процесс.
+type ShellBuilder struct {
+	enabled map[string]bool
+}
+
+// NewShellBuilder — enabled: пути разделов, уже реализованных в приложении. Пункты
+// меню остальных разделов скрыты, чтобы сайдбар не вёл на 404 между фазами плана.
+func NewShellBuilder(enabled ...string) ShellBuilder {
+	b := ShellBuilder{enabled: map[string]bool{}}
+	for _, p := range enabled {
+		b.enabled[p] = true
+	}
+	return b
+}
+
+// Build — Shell для текущего запроса с заголовком title.
+func (b ShellBuilder) Build(c fiber.Ctx, title string) Shell {
+	v, _ := c.Locals(LocalViewer).(Viewer)
+	token, _ := c.Locals(LocalCSRFToken).(string)
+	isAdmin := v.Role == RoleAdmin
+	return Shell{
+		Title:      title,
+		Menu:       BuildMenu(b.enabled, isAdmin),
+		ActivePath: c.Path(),
+		User:       v,
+		IsAdmin:    isAdmin,
+		CSRFToken:  token,
+	}
+}
+
+// Initials — «Сидоров Пётр» → «СП» (аватар в сайдбаре, как в прототипе).
+func Initials(name string) string {
+	var out []rune
+	for _, w := range strings.Fields(name) {
+		r := []rune(w)
+		out = append(out, unicode.ToUpper(r[0]))
+		if len(out) == 2 {
+			break
+		}
+	}
+	return string(out)
+}
diff --git a/pkg/errorspkg/errors.go b/pkg/errorspkg/errors.go
new file mode 100644
index 0000000..0741636
--- /dev/null
+++ b/pkg/errorspkg/errors.go
@@ -0,0 +1,76 @@
+// Package errorspkg — единый формат ошибок API (wire — CLAUDE.md §API-1/§FE-1.1):
+// JSON snake_case, валидация 400 несёт details.fields[] — клиент раскладывает по полям.
+package errorspkg
+
+import (
+	"errors"
+	"log/slog"
+	"net/http"
+
+	"github.com/gofiber/fiber/v3"
+)
+
+// Field — ошибка конкретного поля (валидация server-only, §FE-1.1).
+type Field struct {
+	Name    string `json:"name"`
+	Message string `json:"message"`
+}
+
+type AppError struct {
+	Code    string  `json:"code"`
+	HTTP    int     `json:"-"`
+	Message string  `json:"message"`
+	Fields  []Field `json:"-"`
+}
+
+func (e *AppError) Error() string { return e.Code + ": " + e.Message }
+
+func New(code string, httpStatus int, message string) *AppError {
+	return &AppError{Code: code, HTTP: httpStatus, Message: message}
+}
+
+func BadRequest(msg string) *AppError   { return New("BAD_REQUEST", http.StatusBadRequest, msg) }
+func Unauthorized(msg string) *AppError { return New("UNAUTHORIZED", http.StatusUnauthorized, msg) }
+func Forbidden(msg string) *AppError    { return New("FORBIDDEN", http.StatusForbidden, msg) }
+func NotFound(msg string) *AppError     { return New("NOT_FOUND", http.StatusNotFound, msg) }
+func Conflict(msg string) *AppError     { return New("CONFLICT", http.StatusConflict, msg) }
+func Internal(msg string) *AppError     { return New("INTERNAL", http.StatusInternalServerError, msg) }
+
+// Validation — 400 с пополевыми ошибками.
+func Validation(fields ...Field) *AppError {
+	e := New("VALIDATION", http.StatusBadRequest, "validation failed")
+	e.Fields = fields
+	return e
+}
+
+type errorBody struct {
+	Code    string      `json:"code"`
+	Message string      `json:"message"`
+	Details *errDetails `json:"details,omitempty"`
+}
+
+type errDetails struct {
+	Fields []Field `json:"fields"`
+}
+
+// FiberErrorHandler — маппинг ошибок в wire-формат. Мусор/паника наружу не течёт:
+// неизвестная ошибка = 500 INTERNAL без текста первопричины.
+func FiberErrorHandler(c fiber.Ctx, err error) error {
+	var app *AppError
+	if errors.As(err, &app) {
+		body := errorBody{Code: app.Code, Message: app.Message}
+		if len(app.Fields) > 0 {
+			body.Details = &errDetails{Fields: app.Fields}
+		}
+		return c.Status(app.HTTP).JSON(body)
+	}
+	var fe *fiber.Error
+	if errors.As(err, &fe) {
+		return c.Status(fe.Code).JSON(errorBody{Code: "HTTP_ERROR", Message: fe.Message})
+	}
+	// Неизвестная ошибка (SQL/паника/т.п.) — клиенту наружу текст НЕ течёт, но в
+	// логи пишем полностью: иначе 500 немой и первопричину не найти без дебаггера.
+	slog.Error("unhandled error", "err", err, "path", c.Path(), "method", c.Method())
+	return c.Status(http.StatusInternalServerError).
+		JSON(errorBody{Code: "INTERNAL", Message: "internal error"})
+}
diff --git a/pkg/testutil/base_suite.go b/pkg/testutil/base_suite.go
new file mode 100644
index 0000000..40b5d44
--- /dev/null
+++ b/pkg/testutil/base_suite.go
@@ -0,0 +1,91 @@
+//go:build integration
+
+// Package testutil — интеграционная база (§TD-8): dockertest PG+Redis + миграции.
+package testutil
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/ory/dockertest/v3"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/suite"
+)
+
+// BaseSuite — тест-контейнеры PG18 + Redis, миграции применены. Экспортирует
+// Pool/DSN/RedisAddr() — их использует LiveSuite и repository-интеграция.
+type BaseSuite struct {
+	suite.Suite
+
+	Pool *pgxpool.Pool
+	DSN  string
+
+	redisAddr string
+	pool      *dockertest.Pool
+	pgRes     *dockertest.Resource
+	redisRes  *dockertest.Resource
+}
+
+func (s *BaseSuite) RedisAddr() string { return s.redisAddr }
+
+func (s *BaseSuite) SetupSuite() {
+	var err error
+	s.pool, err = dockertest.NewPool("")
+	s.Require().NoError(err, "docker недоступен")
+	s.pool.MaxWait = 90 * time.Second
+
+	s.pgRes, err = s.pool.RunWithOptions(&dockertest.RunOptions{
+		Repository: "postgres", Tag: "18",
+		Env: []string{"POSTGRES_USER=test", "POSTGRES_PASSWORD=test", "POSTGRES_DB=test"},
+	})
+	s.Require().NoError(err)
+	_ = s.pgRes.Expire(600)
+	s.DSN = fmt.Sprintf("postgres://test:test@127.0.0.1:%s/test?sslmode=disable",
+		s.pgRes.GetPort("5432/tcp"))
+
+	s.redisRes, err = s.pool.RunWithOptions(&dockertest.RunOptions{
+		Repository: "redis", Tag: "8",
+	})
+	s.Require().NoError(err)
+	_ = s.redisRes.Expire(600)
+	s.redisAddr = "127.0.0.1:" + s.redisRes.GetPort("6379/tcp")
+
+	s.Require().NoError(s.pool.Retry(func() error {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		p, err := pgxpool.New(ctx, s.DSN)
+		if err != nil {
+			return err
+		}
+		defer p.Close()
+		return p.Ping(ctx)
+	}))
+	s.Require().NoError(s.pool.Retry(func() error {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		return redis.NewClient(&redis.Options{Addr: s.redisAddr}).Ping(ctx).Err()
+	}))
+
+	mig, err := migrate.New("file://"+moduleRoot()+"/migrations", s.DSN)
+	s.Require().NoError(err)
+	s.Require().NoError(mig.Up())
+
+	s.Pool, err = pgxpool.New(context.Background(), s.DSN)
+	s.Require().NoError(err)
+}
+
+func (s *BaseSuite) TearDownSuite() {
+	if s.Pool != nil {
+		s.Pool.Close()
+	}
+	for _, r := range []*dockertest.Resource{s.pgRes, s.redisRes} {
+		if r != nil {
+			_ = s.pool.Purge(r)
+		}
+	}
+}
diff --git a/pkg/testutil/live_suite.go b/pkg/testutil/live_suite.go
new file mode 100644
index 0000000..6f507d3
--- /dev/null
+++ b/pkg/testutil/live_suite.go
@@ -0,0 +1,112 @@
+//go:build integration
+
+package testutil
+
+import (
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/cookiejar"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"time"
+)
+
+// LiveSuite (CLAUDE.md §TD-8): боевой бинарь + реальная сеть поверх BaseSuite.
+// Сьюта обязана задать BinaryPkg до SetupSuite. Auth-стабы запрещены — LoginAs
+// (login_*.go, штампуется под auth.mode) ходит в реальный endpoint.
+type LiveSuite struct {
+	BaseSuite
+
+	BinaryPkg   string   // пакет бинаря: "./cmd/server"
+	ExtraEnv    []string // доп. env поверх обязательных
+	HealthzPath string   // дефолт "/health"
+
+	BaseURL string
+	Client  *http.Client
+
+	cmd *exec.Cmd
+}
+
+// moduleRoot — корень Go-модуля (каталог с go.mod) от текущего файла.
+func moduleRoot() string {
+	_, f, _, _ := runtime.Caller(0)
+	d := filepath.Dir(f)
+	for d != "/" {
+		if _, err := os.Stat(filepath.Join(d, "go.mod")); err == nil {
+			return d
+		}
+		d = filepath.Dir(d)
+	}
+	return "."
+}
+
+func freePort() (int, error) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return 0, err
+	}
+	defer ln.Close()
+	return ln.Addr().(*net.TCPAddr).Port, nil
+}
+
+func (s *LiveSuite) SetupSuite() {
+	s.Require().NotEmpty(s.BinaryPkg, "LiveSuite.BinaryPkg обязателен (§TD-8)")
+	s.BaseSuite.SetupSuite() // dockertest PG+Redis + миграции
+
+	// 1. Боевой бинарь — go build (одна сборка на сьюту).
+	binPath := filepath.Join(s.T().TempDir(), "server")
+	build := exec.Command("go", "build", "-o", binPath, s.BinaryPkg)
+	build.Dir = moduleRoot()
+	if out, err := build.CombinedOutput(); err != nil {
+		s.Require().NoError(err, "go build %s:\n%s", s.BinaryPkg, out)
+	}
+
+	// 2. Запуск subprocess'ом на тест-контейнеры, случайный порт.
+	port, err := freePort()
+	s.Require().NoError(err)
+	s.BaseURL = fmt.Sprintf("http://127.0.0.1:%d", port)
+
+	s.cmd = exec.Command(binPath)
+	s.cmd.Dir = moduleRoot()
+	s.cmd.Env = append(os.Environ(),
+		"DATABASE_URL="+s.DSN,
+		"REDIS_ADDR="+s.RedisAddr(),
+		fmt.Sprintf("PORT=%d", port),
+	)
+	s.cmd.Env = append(s.cmd.Env, defaultExtraEnv()...) // auth-режимный env (login.go)
+	s.cmd.Env = append(s.cmd.Env, s.ExtraEnv...)
+	s.cmd.Stdout, s.cmd.Stderr = os.Stdout, os.Stderr
+	s.Require().NoError(s.cmd.Start())
+
+	jar, _ := cookiejar.New(nil)
+	s.Client = &http.Client{Jar: jar, Timeout: 10 * time.Second}
+
+	// 3. Ожидание готовности — /health до 200 (детерминированный retry, не sleep-вслепую).
+	hp := s.HealthzPath
+	if hp == "" {
+		hp = "/health"
+	}
+	deadline := time.Now().Add(30 * time.Second)
+	for {
+		resp, err := s.Client.Get(s.BaseURL + hp)
+		if err == nil {
+			resp.Body.Close()
+			if resp.StatusCode == http.StatusOK {
+				break
+			}
+		}
+		s.Require().True(time.Now().Before(deadline), "бинарь не поднялся за 30s: %v", err)
+		time.Sleep(100 * time.Millisecond)
+	}
+}
+
+func (s *LiveSuite) TearDownSuite() {
+	if s.cmd != nil && s.cmd.Process != nil {
+		_ = s.cmd.Process.Kill()
+		_, _ = s.cmd.Process.Wait()
+	}
+	s.BaseSuite.TearDownSuite()
+}
