new file mode 100644
index 0000000..a2228d1
--- /dev/null
+++ b/pkg/testutil/login.go
@@ -0,0 +1,23 @@
+//go:build integration
+
+package testutil
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+)
+
+// defaultExtraEnv — session-режим: обязательного auth-env нет.
+func defaultExtraEnv() []string { return nil }
+
+// LoginAs — реальный логин через реальный endpoint (session-режим, логин/пароль —
+// не email); cookie sid остаётся в jar. Auth-стабы запрещены §TD-8. Пользователя
+// сидируй через s.Pool.
+func (s *LiveSuite) LoginAs(login, password string) {
+	body := strings.NewReader(fmt.Sprintf(`{"login":%q,"password":%q}`, login, password))
+	resp, err := s.Client.Post(s.BaseURL+"/api/v1/auth/login", "application/json", body)
+	s.Require().NoError(err)
+	defer resp.Body.Close()
+	s.Require().Equal(http.StatusOK, resp.StatusCode, "реальный логин обязан пройти (§TD-8)")
+}
