new file mode 100644
index 0000000..dadd96f
--- /dev/null
+++ b/internal/server/middleware/auth.go
@@ -0,0 +1,31 @@
+package middleware
+
+import (
+	"github.com/gofiber/fiber/v3"
+	"github.com/redis/go-redis/v9"
+
+	"github.com/kitavrus/kanban-tree/internal/config"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// SessionKeyPrefix — ключи сессий в Redis: session:<sid> → user_id.
+const SessionKeyPrefix = "session:"
+
+// UserIDKey — Locals-ключ авторизованного пользователя.
+const UserIDKey = "user_id"
+
+// RequireAuth (session-режим): cookie sid → Redis lookup. Нет/протухла → 401.
+func RequireAuth(cfg *config.Config, rdb *redis.Client) fiber.Handler {
+	return func(c fiber.Ctx) error {
+		sid := c.Cookies("sid")
+		if sid == "" {
+			return errorspkg.Unauthorized("no session")
+		}
+		userID, err := rdb.Get(c.Context(), SessionKeyPrefix+sid).Result()
+		if err != nil {
+			return errorspkg.Unauthorized("invalid session")
+		}
+		c.Locals(UserIDKey, userID)
+		return c.Next()
+	}
+}
