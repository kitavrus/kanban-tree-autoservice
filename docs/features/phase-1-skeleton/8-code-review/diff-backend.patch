index 0000000..1ad861b
--- /dev/null
+++ b/internal/features/auth/routes.go
@@ -0,0 +1,21 @@
+package auth
+
+import (
+	"github.com/gofiber/fiber/v3"
+	"github.com/redis/go-redis/v9"
+
+	"github.com/kitavrus/kanban-tree/internal/config"
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+)
+
+// Register монтирует /auth/* под /api/v1 (§API-1).
+func Register(api fiber.Router, svc *Service, cfg *config.Config, rdb *redis.Client) {
+	h := NewHandler(svc)
+	g := api.Group("/auth")
+	// Fiber выполняет хэндлеры В ПОРЯДКЕ АРГУМЕНТОВ: middleware ОБЯЗАН идти
+	// первым — иначе Me/Logout читают Locals(UserIDKey) до того, как RequireAuth
+	// его заполнит (проявляется как пустой userID → битый запрос ниже по стеку).
+	g.Post("/login", h.Login)
+	g.Post("/logout", middleware.RequireAuth(cfg, rdb), h.Logout)
+	g.Get("/me", middleware.RequireAuth(cfg, rdb), h.Me)
+}
diff --git a/internal/features/auth/service.go b/internal/features/auth/service.go
new file mode 100644
index 0000000..5b617ff
--- /dev/null
+++ b/internal/features/auth/service.go
@@ -0,0 +1,66 @@
+package auth
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/redis/go-redis/v9"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/kitavrus/kanban-tree/internal/config"
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Service — session-auth: логин выдаёт sid, сессия живёт в Redis (SESSION_TTL).
+type Service struct {
+	repo *Repo
+	rdb  *redis.Client
+	cfg  *config.Config
+}
+
+func NewService(pool *pgxpool.Pool, rdb *redis.Client, cfg *config.Config) *Service {
+	return &Service{repo: NewRepo(pool), rdb: rdb, cfg: cfg}
+}
+
+// Login проверяет пароль и создаёт сессию. Неверные креды → единый 401
+// (без утечки "user not found" vs "wrong password").
+func (s *Service) Login(ctx context.Context, login, password string) (sid string, u *User, err error) {
+	u, err = s.repo.GetByLogin(ctx, login)
+	if err != nil {
+		if errors.Is(err, ErrNotFound) {
+			return "", nil, errorspkg.Unauthorized("invalid credentials")
+		}
+		return "", nil, err
+	}
+	if bcrypt.CompareHashAndPassword([]byte(u.PasswordHash), []byte(password)) != nil {
+		return "", nil, errorspkg.Unauthorized("invalid credentials")
+	}
+	raw := make([]byte, 32)
+	if _, err := rand.Read(raw); err != nil {
+		return "", nil, err
+	}
+	sid = hex.EncodeToString(raw)
+	if err := s.rdb.Set(ctx, middleware.SessionKeyPrefix+sid, u.ID, s.cfg.Auth.SessionTTL).Err(); err != nil {
+		return "", nil, err
+	}
+	return sid, u, nil
+}
+
+func (s *Service) Logout(ctx context.Context, sid string) error {
+	return s.rdb.Del(ctx, middleware.SessionKeyPrefix+sid).Err()
+}
+
+func (s *Service) UserByID(ctx context.Context, id string) (*User, error) {
+	u, err := s.repo.GetByID(ctx, id)
+	if err != nil {
+		if errors.Is(err, ErrNotFound) {
+			return nil, errorspkg.Unauthorized("user gone")
+		}
+		return nil, err
+	}
+	return u, nil
+}
