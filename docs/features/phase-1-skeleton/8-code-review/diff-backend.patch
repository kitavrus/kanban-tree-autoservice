+func NewRepo(pool *pgxpool.Pool) *Repo { return &Repo{pool: pool} }
+
+var ErrNotFound = pgx.ErrNoRows
+
+// ListParams — фильтры + сортировка + пагинация списка (стандарт списочных экранов).
+// Sort/Order приходят из сервиса УЖЕ прошедшими whitelist: их нельзя передать
+// параметром запроса, они склеиваются в SQL как идентификаторы.
+type ListParams struct {
+	Login    string // подстрока, регистронезависимо
+	Name     string // подстрока, регистронезависимо
+	IsActive *bool  // nil = любой статус
+	Sort     string // login | name | is_active | created_at
+	Order    string // ASC | DESC
+	Limit    int
+	Offset   int
+}
+
+func (r *Repo) List(ctx context.Context, p ListParams) ([]User, int, error) {
+	where := ""
+	var args []any
+	add := func(cond string, val any) {
+		args = append(args, val)
+		if where == "" {
+			where = " WHERE "
+		} else {
+			where += " AND "
+		}
+		where += fmt.Sprintf(cond, len(args))
+	}
+	if p.Login != "" {
+		add("login ILIKE $%d", "%"+escapeLike(p.Login)+"%")
+	}
+	if p.Name != "" {
+		add("name ILIKE $%d", "%"+escapeLike(p.Name)+"%")
+	}
+	if p.IsActive != nil {
+		add("is_active = $%d", *p.IsActive)
+	}
+
+	// id вторым ключом — стабильный тай-брейк: без него строки с равным значением
+	// сортировки прыгают между запросами и ломают пагинацию.
+	order := fmt.Sprintf(" ORDER BY %s %s, id", p.Sort, p.Order)
+
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM users`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+
+	args = append(args, p.Limit, p.Offset)
+	q := `SELECT id, login, name, is_active, created_at FROM users` + where + order +
+		fmt.Sprintf(" LIMIT $%d OFFSET $%d", len(args)-1, len(args))
+	rows, err := r.pool.Query(ctx, q, args...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	var out []User
+	for rows.Next() {
+		var u User
+		if err := rows.Scan(&u.ID, &u.Login, &u.Name, &u.IsActive, &u.CreatedAt); err != nil {
+			return nil, 0, err
+		}
+		out = append(out, u)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, 0, err
+	}
+	return out, total, nil
+}
+
+// escapeLike — символы шаблона LIKE в пользовательском вводе ищутся буквально.
+func escapeLike(s string) string {
+	r := strings.NewReplacer(`\`, `\\`, `%`, `\%`, `_`, `\_`)
+	return r.Replace(s)
+}
+
+func (r *Repo) Create(ctx context.Context, login, passwordHash, name string) (*User, error) {
+	var u User
+	err := r.pool.QueryRow(ctx,
+		`INSERT INTO users (login, password_hash, name) VALUES ($1, $2, $3)
+		 RETURNING id, login, name, is_active, created_at`,
+		login, passwordHash, name,
+	).Scan(&u.ID, &u.Login, &u.Name, &u.IsActive, &u.CreatedAt)
+	if err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
+
+func (r *Repo) GetByID(ctx context.Context, id string) (*User, error) {
+	var u User
+	// ::uuid — id хранится как uuid, а pgx шлёт Go-string параметром как text;
+	// Postgres не кастует text→uuid неявно в сравнении (operator does not exist).
+	err := r.pool.QueryRow(ctx,
+		`SELECT id, login, name, is_active, created_at FROM users WHERE id = $1::uuid`, id,
+	).Scan(&u.ID, &u.Login, &u.Name, &u.IsActive, &u.CreatedAt)
+	if err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
+
+// Update — частичное обновление (nil-поля не трогаем); version бампается (§FE-1.1).
+// passwordHash приходит уже посчитанным (bcrypt в сервисе — repo не знает про хеши).
+func (r *Repo) Update(ctx context.Context, id string, name *string, isActive *bool, passwordHash *string) (*User, error) {
+	var u User
+	err := r.pool.QueryRow(ctx,
+		`UPDATE users SET
+		   name = COALESCE($2, name),
+		   is_active = COALESCE($3, is_active),
+		   password_hash = COALESCE($4, password_hash),
+		   version = version + 1,
+		   updated_at = now()
+		 WHERE id = $1::uuid
+		 RETURNING id, login, name, is_active, created_at`,
+		id, name, isActive, passwordHash,
+	).Scan(&u.ID, &u.Login, &u.Name, &u.IsActive, &u.CreatedAt)
+	if err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
+
+func (r *Repo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM users WHERE id = $1::uuid`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrNotFound
+	}
+	return nil
+}
+
+func (r *Repo) LoginExists(ctx context.Context, login string) (bool, error) {
+	var exists bool
+	err := r.pool.QueryRow(ctx,
+		`SELECT EXISTS(SELECT 1 FROM users WHERE login = $1)`, login,
+	).Scan(&exists)
+	return exists, err
+}
