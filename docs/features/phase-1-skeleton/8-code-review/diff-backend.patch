diff --git a/internal/features/users/handler.go b/internal/features/users/handler.go
new file mode 100644
index 0000000..81f41d1
--- /dev/null
+++ b/internal/features/users/handler.go
@@ -0,0 +1,79 @@
+package users
+
+import (
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+type Handler struct {
+	svc *Service
+}
+
+func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }
+
+// List — GET /api/v1/users?limit=&offset=&login=&name=&is_active=&sort=&order=
+// (конверт §FE-1.1). Фильтры и сортировка — стандарт списочных экранов.
+func (h *Handler) List(c fiber.Ctx) error {
+	limit, _ := strconv.Atoi(c.Query("limit"))
+	offset, _ := strconv.Atoi(c.Query("offset"))
+	// Пустой is_active = «любой статус»; невалидное значение трактуем так же.
+	var isActive *bool
+	if raw := c.Query("is_active"); raw != "" {
+		if v, err := strconv.ParseBool(raw); err == nil {
+			isActive = &v
+		}
+	}
+	resp, err := h.svc.List(c.Context(), ListQuery{
+		Login:    c.Query("login"),
+		Name:     c.Query("name"),
+		IsActive: isActive,
+		Sort:     c.Query("sort"),
+		Order:    c.Query("order"),
+		Limit:    limit,
+		Offset:   offset,
+	})
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Create — POST /api/v1/users.
+func (h *Handler) Create(c fiber.Ctx) error {
+	var req CreateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("invalid body")
+	}
+	resp, err := h.svc.Create(c.Context(), req)
+	if err != nil {
+		return err
+	}
+	return c.Status(fiber.StatusCreated).JSON(resp)
+}
+
+// Update — PATCH /api/v1/users/:id (частичное; используется и для toggle статуса).
+func (h *Handler) Update(c fiber.Ctx) error {
+	var req UpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("invalid body")
+	}
+	currentUserID, _ := c.Locals(middleware.UserIDKey).(string)
+	resp, err := h.svc.Update(c.Context(), currentUserID, c.Params("id"), req)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Delete — DELETE /api/v1/users/:id.
+func (h *Handler) Delete(c fiber.Ctx) error {
+	currentUserID, _ := c.Locals(middleware.UserIDKey).(string)
+	if err := h.svc.Delete(c.Context(), currentUserID, c.Params("id")); err != nil {
+		return err
+	}
+	return c.JSON(fiber.Map{"status": "ok"})
+}
