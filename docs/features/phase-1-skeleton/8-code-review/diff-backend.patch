+package users
+
+import (
+	"github.com/gofiber/fiber/v3"
+)
+
+// Register монтирует /users под уже защищённую группу (§API-1) — RequireAuth
+// вешает вызывающий код (router.go), здесь предполагается protected-роутер.
+func Register(protected fiber.Router, svc *Service) {
+	h := NewHandler(svc)
+	g := protected.Group("/users")
+	g.Get("", h.List)
+	g.Post("", h.Create)
+	g.Patch("/:id", h.Update)
+	g.Delete("/:id", h.Delete)
+}
diff --git a/internal/features/users/service.go b/internal/features/users/service.go
new file mode 100644
index 0000000..5f46514
--- /dev/null
+++ b/internal/features/users/service.go
@@ -0,0 +1,174 @@
+package users
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+const (
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+type Service struct {
+	repo *Repo
+}
+
+func NewService(pool *pgxpool.Pool) *Service {
+	return &Service{repo: NewRepo(pool)}
+}
+
+// sortColumns — whitelist сортировки: значение query-параметра НЕ попадает в SQL,
+// в SQL идёт только имя колонки из этой карты (иначе — SQL-инъекция через ORDER BY).
+var sortColumns = map[string]string{
+	"login":      "login",
+	"name":       "name",
+	"is_active":  "is_active",
+	"created_at": "created_at",
+}
+
+const defaultSort = "created_at"
+
+// ListQuery — сырые параметры из HTTP-слоя (уже разобранные, но не валидированные).
+type ListQuery struct {
+	Login    string
+	Name     string
+	IsActive *bool
+	Sort     string
+	Order    string
+	Limit    int
+	Offset   int
+}
+
+func (s *Service) List(ctx context.Context, q ListQuery) (*ListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = defaultLimit
+	}
+	if limit > maxLimit {
+		limit = maxLimit
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	// Неизвестное поле/направление — тихий откат к дефолту, а не 400: сортировка
+	// приходит из URL, кривая ссылка не должна ломать экран.
+	col, ok := sortColumns[q.Sort]
+	if !ok {
+		col = sortColumns[defaultSort]
+	}
+	order := "DESC"
+	if strings.EqualFold(q.Order, "asc") {
+		order = "ASC"
+	}
+	items, total, err := s.repo.List(ctx, ListParams{
+		Login:    strings.TrimSpace(q.Login),
+		Name:     strings.TrimSpace(q.Name),
+		IsActive: q.IsActive,
+		Sort:     col,
+		Order:    order,
+		Limit:    limit,
+		Offset:   offset,
+	})
+	if err != nil {
+		return nil, err
+	}
+	resp := &ListResponse{Items: make([]UserResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, u := range items {
+		resp.Items[i] = toResponse(u)
+	}
+	return resp, nil
+}
+
+func (s *Service) Create(ctx context.Context, req CreateRequest) (*UserResponse, error) {
+	var fields []errorspkg.Field
+	if utf8.RuneCountInString(req.Login) < 3 {
+		fields = append(fields, errorspkg.Field{Name: "login", Message: "min 3 chars"})
+	}
+	if utf8.RuneCountInString(req.Password) < 8 {
+		fields = append(fields, errorspkg.Field{Name: "password", Message: "min 8 chars"})
+	}
+	if len(fields) > 0 {
+		return nil, errorspkg.Validation(fields...)
+	}
+	exists, err := s.repo.LoginExists(ctx, req.Login)
+	if err != nil {
+		return nil, err
+	}
+	if exists {
+		return nil, errorspkg.Conflict("login already taken")
+	}
+	hash, err := bcrypt.GenerateFromPassword([]byte(req.Password), bcrypt.DefaultCost)
+	if err != nil {
+		return nil, err
+	}
+	u, err := s.repo.Create(ctx, req.Login, string(hash), req.Name)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && pgErr.Code == "23505" { // unique_violation — гонка мимо pre-check
+			return nil, errorspkg.Conflict("login already taken")
+		}
+		return nil, err
+	}
+	resp := toResponse(*u)
+	return &resp, nil
+}
+
+// Update — currentUserID из сессии: самому себе статус менять нельзя (не остаться
+// без доступа), удобство важнее полноты — гарда «последний активный» намеренно не
+// добавлена (минимальный набор каркаса, расширяется через /scaffold при надобности).
+// Имя и пароль себе менять МОЖНО — это не самоблокировка.
+func (s *Service) Update(ctx context.Context, currentUserID, id string, req UpdateRequest) (*UserResponse, error) {
+	if req.IsActive != nil && id == currentUserID {
+		return nil, errorspkg.Forbidden("cannot change your own status")
+	}
+	var passwordHash *string
+	if req.Password != nil {
+		if utf8.RuneCountInString(*req.Password) < 8 {
+			return nil, errorspkg.Validation(errorspkg.Field{Name: "password", Message: "min 8 chars"})
+		}
+		hash, err := bcrypt.GenerateFromPassword([]byte(*req.Password), bcrypt.DefaultCost)
+		if err != nil {
+			return nil, err
+		}
+		hashStr := string(hash)
+		passwordHash = &hashStr
+	}
+	if req.Name != nil && *req.Name == "" {
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "name", Message: "required"})
+	}
+	u, err := s.repo.Update(ctx, id, req.Name, req.IsActive, passwordHash)
+	if err != nil {
+		if errors.Is(err, ErrNotFound) {
+			return nil, errorspkg.NotFound("user not found")
+		}
+		return nil, err
+	}
+	resp := toResponse(*u)
+	return &resp, nil
+}
+
+func (s *Service) Delete(ctx context.Context, currentUserID, id string) error {
+	if id == currentUserID {
+		return errorspkg.Forbidden("cannot delete your own account")
+	}
+	if err := s.repo.Delete(ctx, id); err != nil {
+		if errors.Is(err, ErrNotFound) {
+			return errorspkg.NotFound("user not found")
+		}
+		return err
+	}
+	return nil
+}
+
+func toResponse(u User) UserResponse {
+	return UserResponse{ID: u.ID, Login: u.Login, Name: u.Name, IsActive: u.IsActive, CreatedAt: u.CreatedAt}
+}
