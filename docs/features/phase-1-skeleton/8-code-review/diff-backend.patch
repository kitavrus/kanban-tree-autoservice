@@ -0,0 +1,21 @@
+package config
+
+import (
+	"fmt"
+	"time"
+)
+
+// AuthConfig — session-режим (auth.mode=session, /project-bootstrap):
+// HttpOnly cookie `sid`, store — Redis.
+type AuthConfig struct {
+	SessionTTL time.Duration
+}
+
+func loadAuth() (AuthConfig, error) {
+	ttl := getenv("SESSION_TTL", "720h")
+	d, err := time.ParseDuration(ttl)
+	if err != nil {
+		return AuthConfig{}, fmt.Errorf("SESSION_TTL '%s': %w", ttl, err)
+	}
+	return AuthConfig{SessionTTL: d}, nil
+}
