diff --git a/internal/features/auth/handler.go b/internal/features/auth/handler.go
new file mode 100644
index 0000000..a86d200
--- /dev/null
+++ b/internal/features/auth/handler.go
@@ -0,0 +1,64 @@
+package auth
+
+import (
+	"time"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+type Handler struct {
+	svc *Service
+}
+
+func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }
+
+// Login — POST /api/v1/auth/login. Успех: HttpOnly cookie sid + профиль.
+func (h *Handler) Login(c fiber.Ctx) error {
+	var req LoginRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return errorspkg.BadRequest("invalid body")
+	}
+	if req.Login == "" || req.Password == "" {
+		return errorspkg.Validation(
+			errorspkg.Field{Name: "login", Message: "required"},
+			errorspkg.Field{Name: "password", Message: "required"},
+		)
+	}
+	sid, u, err := h.svc.Login(c.Context(), req.Login, req.Password)
+	if err != nil {
+		return err
+	}
+	c.Cookie(&fiber.Cookie{
+		Name:     "sid",
+		Value:    sid,
+		HTTPOnly: true,
+		SameSite: fiber.CookieSameSiteLaxMode,
+		Path:     "/",
+		Expires:  time.Now().Add(h.svc.cfg.Auth.SessionTTL),
+	})
+	return c.JSON(UserResponse{ID: u.ID, Login: u.Login, Name: u.Name})
+}
+
+// Logout — POST /api/v1/auth/logout (protected).
+func (h *Handler) Logout(c fiber.Ctx) error {
+	if sid := c.Cookies("sid"); sid != "" {
+		if err := h.svc.Logout(c.Context(), sid); err != nil {
+			return err
+		}
+	}
+	c.ClearCookie("sid")
+	return c.JSON(fiber.Map{"status": "ok"})
+}
+
+// Me — GET /api/v1/auth/me (protected).
+func (h *Handler) Me(c fiber.Ctx) error {
+	userID, _ := c.Locals(middleware.UserIDKey).(string)
+	u, err := h.svc.UserByID(c.Context(), userID)
+	if err != nil {
+		return err
+	}
+	return c.JSON(UserResponse{ID: u.ID, Login: u.Login, Name: u.Name})
+}
diff --git a/internal/features/auth/repo.go b/internal/features/auth/repo.go
new file mode 100644
index 0000000..d991607
--- /dev/null
+++ b/internal/features/auth/repo.go
@@ -0,0 +1,47 @@
+package auth
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+type User struct {
+	ID           string
+	Login        string
+	PasswordHash string
+	Name         string
+}
+
+type Repo struct {
+	pool *pgxpool.Pool
+}
+
+func NewRepo(pool *pgxpool.Pool) *Repo { return &Repo{pool: pool} }
+
+var ErrNotFound = pgx.ErrNoRows
+
+func (r *Repo) GetByLogin(ctx context.Context, login string) (*User, error) {
+	var u User
+	err := r.pool.QueryRow(ctx,
+		`SELECT id, login, password_hash, name FROM users WHERE login = $1`, login,
+	).Scan(&u.ID, &u.Login, &u.PasswordHash, &u.Name)
+	if err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
+
+func (r *Repo) GetByID(ctx context.Context, id string) (*User, error) {
+	var u User
+	// ::uuid — id хранится как uuid, а pgx шлёт Go-string параметром как text;
+	// Postgres не кастует text→uuid неявно в сравнении (operator does not exist).
+	err := r.pool.QueryRow(ctx,
+		`SELECT id, login, password_hash, name FROM users WHERE id = $1::uuid`, id,
+	).Scan(&u.ID, &u.Login, &u.PasswordHash, &u.Name)
+	if err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
