diff --git a/internal/features/stocktransfers/dto.go b/internal/features/stocktransfers/dto.go
new file mode 100644
index 0000000..adb9042
--- /dev/null
+++ b/internal/features/stocktransfers/dto.go
@@ -0,0 +1,142 @@
+package stocktransfers
+
+import (
+	"time"
+
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+// Wire-типы — JSON только snake_case (§API-1); конверт списка {items,total,limit,offset}.
+
+// Статусы перемещения (DS-006).
+const (
+	StatusRequested = "requested"
+	StatusInTransit = "in_transit"
+	StatusReceived  = "received"
+	StatusCancelled = "cancelled"
+)
+
+// Statuses — допустимые значения фильтра списка.
+var Statuses = []string{StatusRequested, StatusInTransit, StatusReceived, StatusCancelled}
+
+// Причины движений перемещения (DS-007, CHECK stock_movements_reason_check миграции 0008).
+const (
+	reasonOut    = "transfer_out"
+	reasonIn     = "transfer_in"
+	reasonLoss   = "transfer_loss"
+	reasonReturn = "transfer_return"
+)
+
+// ItemInput — строка товара в запросе создания/правки.
+type ItemInput struct {
+	ProductID string         `json:"product_id"`
+	QtySent   numeric.Amount `json:"qty_sent"`
+}
+
+// TransferCreateRequest — POST /api/v1/stock-transfers. send=true — сразу «Отправить»
+// (in_transit, DS-006), иначе «Заявка» (requested).
+type TransferCreateRequest struct {
+	FromWarehouseID string      `json:"from_warehouse_id"`
+	ToWarehouseID   string      `json:"to_warehouse_id"`
+	Note            string      `json:"note"`
+	Items           []ItemInput `json:"items"`
+	Send            bool        `json:"send"`
+}
+
+// TransferUpdateRequest — PUT /api/v1/stock-transfers/:id (только requested).
+type TransferUpdateRequest struct {
+	FromWarehouseID string      `json:"from_warehouse_id"`
+	ToWarehouseID   string      `json:"to_warehouse_id"`
+	Note            string      `json:"note"`
+	Items           []ItemInput `json:"items"`
+	Version         *int        `json:"version"`
+}
+
+// TransferActionRequest — POST /:id/send и /:id/cancel.
+type TransferActionRequest struct {
+	Version *int `json:"version"`
+}
+
+// ReceiveItemInput — факт по строке при приёмке; строка без записи — факт = qty_sent.
+type ReceiveItemInput struct {
+	ID          string         `json:"id"`
+	QtyReceived numeric.Amount `json:"qty_received"`
+}
+
+// TransferReceiveRequest — POST /:id/receive.
+type TransferReceiveRequest struct {
+	Version *int               `json:"version"`
+	Items   []ReceiveItemInput `json:"items"`
+}
+
+// StockWarning — остаток пары товар×склад после списания с источника (отрицательный или
+// на/ниже минимума; разрешено, как D17/D18 — только предупреждение).
+type StockWarning struct {
+	ProductID     string         `json:"product_id"`
+	WarehouseID   string         `json:"warehouse_id"`
+	WarehouseName string         `json:"warehouse_name"`
+	Name          string         `json:"name"`
+	Stock         numeric.Amount `json:"stock"`
+	MinStock      numeric.Amount `json:"min_stock"`
+	Kind          string         `json:"kind"` // negative | below_min
+}
+
+type TransferItemResponse struct {
+	ID          string          `json:"id"`
+	ProductID   string          `json:"product_id"`
+	ProductName string          `json:"product_name"`
+	Unit        string          `json:"unit"`
+	QtySent     numeric.Amount  `json:"qty_sent"`
+	QtyReceived *numeric.Amount `json:"qty_received"`
+}
+
+// TransferResponse — карточка перемещения (re-fetch-after-write). Warnings — только в
+// ответе отправки (иначе пустой массив).
+type TransferResponse struct {
+	ID                int64                  `json:"id"`
+	FromWarehouseID   string                 `json:"from_warehouse_id"`
+	FromWarehouseName string                 `json:"from_warehouse_name"`
+	ToWarehouseID     string                 `json:"to_warehouse_id"`
+	ToWarehouseName   string                 `json:"to_warehouse_name"`
+	Status            string                 `json:"status"`
+	Note              string                 `json:"note"`
+	CreatedBy         string                 `json:"created_by"`
+	CreatedByName     string                 `json:"created_by_name"`
+	SentBy            *string                `json:"sent_by"`
+	SentByName        *string                `json:"sent_by_name"`
+	SentAt            *time.Time             `json:"sent_at"`
+	ReceivedBy        *string                `json:"received_by"`
+	ReceivedByName    *string                `json:"received_by_name"`
+	ReceivedAt        *time.Time             `json:"received_at"`
+	CancelledBy       *string                `json:"cancelled_by"`
+	CancelledByName   *string                `json:"cancelled_by_name"`
+	CancelledAt       *time.Time             `json:"cancelled_at"`
+	CreatedAt         time.Time              `json:"created_at"`
+	UpdatedAt         time.Time              `json:"updated_at"`
+	Version           int                    `json:"version"`
+	Items             []TransferItemResponse `json:"items"`
+	Warnings          []StockWarning         `json:"warnings"`
+}
+
+// TransferSummary — строка списка (без строк товаров).
+type TransferSummary struct {
+	ID                int64     `json:"id"`
+	FromWarehouseID   string    `json:"from_warehouse_id"`
+	FromWarehouseName string    `json:"from_warehouse_name"`
+	ToWarehouseID     string    `json:"to_warehouse_id"`
+	ToWarehouseName   string    `json:"to_warehouse_name"`
+	Status            string    `json:"status"`
+	Note              string    `json:"note"`
+	ItemsCount        int       `json:"items_count"`
+	CreatedByName     string    `json:"created_by_name"`
+	CreatedAt         time.Time `json:"created_at"`
+	UpdatedAt         time.Time `json:"updated_at"`
+	Version           int       `json:"version"`
+}
+
+type TransferListResponse struct {
+	Items  []TransferSummary `json:"items"`
+	Total  int               `json:"total"`
+	Limit  int               `json:"limit"`
+	Offset int               `json:"offset"`
+}
diff --git a/internal/features/stocktransfers/handler.go b/internal/features/stocktransfers/handler.go
new file mode 100644
index 0000000..4c9cae9
--- /dev/null
+++ b/internal/features/stocktransfers/handler.go
@@ -0,0 +1,112 @@
+package stocktransfers
+
+import (
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Handler — JSON API /api/v1/stock-transfers (только admin, DS-010/TS-014; гарды — routes.go).
+type Handler struct {
+	svc *Service
+}
+
+func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }
+
+func currentUserID(c fiber.Ctx) string { return middleware.CurrentPrincipal(c).ID }
+
+func badBody() error { return errorspkg.BadRequest("Некорректное тело запроса") }
+
+// List — GET /api/v1/stock-transfers?status=&warehouse_id=&limit=&offset=.
+func (h *Handler) List(c fiber.Ctx) error {
+	limit, _ := strconv.Atoi(c.Query("limit"))
+	offset, _ := strconv.Atoi(c.Query("offset"))
+	resp, err := h.svc.List(c.Context(), ListQuery{
+		Status: c.Query("status"), WarehouseID: c.Query("warehouse_id"), Limit: limit, Offset: offset,
+	})
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Get — GET /api/v1/stock-transfers/:id.
+func (h *Handler) Get(c fiber.Ctx) error {
+	resp, err := h.svc.Get(c.Context(), c.Params("id"))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Create — POST /api/v1/stock-transfers.
+func (h *Handler) Create(c fiber.Ctx) error {
+	var req TransferCreateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return badBody()
+	}
+	resp, err := h.svc.Create(c.Context(), Input{
+		FromWarehouseID: req.FromWarehouseID, ToWarehouseID: req.ToWarehouseID, Note: req.Note, Items: req.Items,
+	}, currentUserID(c), req.Send)
+	if err != nil {
+		return err
+	}
+	return c.Status(fiber.StatusCreated).JSON(resp)
+}
+
+// Update — PUT /api/v1/stock-transfers/:id (только заявка).
+func (h *Handler) Update(c fiber.Ctx) error {
+	var req TransferUpdateRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return badBody()
+	}
+	resp, err := h.svc.Update(c.Context(), c.Params("id"), Input{
+		FromWarehouseID: req.FromWarehouseID, ToWarehouseID: req.ToWarehouseID, Note: req.Note, Items: req.Items,
+	}, req.Version)
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Send — POST /api/v1/stock-transfers/:id/send.
+func (h *Handler) Send(c fiber.Ctx) error {
+	var req TransferActionRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return badBody()
+	}
+	resp, err := h.svc.Send(c.Context(), c.Params("id"), req.Version, currentUserID(c))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Receive — POST /api/v1/stock-transfers/:id/receive.
+func (h *Handler) Receive(c fiber.Ctx) error {
+	var req TransferReceiveRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return badBody()
+	}
+	resp, err := h.svc.Receive(c.Context(), c.Params("id"), req.Version, req.Items, currentUserID(c))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Cancel — POST /api/v1/stock-transfers/:id/cancel.
+func (h *Handler) Cancel(c fiber.Ctx) error {
+	var req TransferActionRequest
+	if err := c.Bind().Body(&req); err != nil {
+		return badBody()
+	}
+	resp, err := h.svc.Cancel(c.Context(), c.Params("id"), req.Version, currentUserID(c))
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
diff --git a/internal/features/stocktransfers/migration_integration_test.go b/internal/features/stocktransfers/migration_integration_test.go
new file mode 100644
index 0000000..3b0c7b2
--- /dev/null
+++ b/internal/features/stocktransfers/migration_integration_test.go
@@ -0,0 +1,98 @@
+//go:build integration
+
+package stocktransfers_test
+
+import (
+	"context"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/golang-migrate/migrate/v4"
+	_ "github.com/golang-migrate/migrate/v4/database/postgres"
+	_ "github.com/golang-migrate/migrate/v4/source/file"
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// StockTransfersMigrationSuite — миграция 0009 (DS-006/DS-007): таблицы перемещений,
+// CHECK from ≠ to, FK stock_movements.transfer_id ON DELETE SET NULL; down удаляет таблицы,
+// движения transfer_* сохраняются без ссылки.
+type StockTransfersMigrationSuite struct {
+	testutil.BaseSuite
+}
+
+func TestStockTransfersMigrationSuite(t *testing.T) {
+	suite.Run(t, new(StockTransfersMigrationSuite))
+}
+
+const stmAdminID = "aaaaaaaa-0009-0009-0009-000000000001"
+
+func migrationsURL() string {
+	_, f, _, _ := runtime.Caller(0)
+	return "file://" + filepath.Join(filepath.Dir(f), "..", "..", "..", "migrations")
+}
+
+func (s *StockTransfersMigrationSuite) tableExists(name string) bool {
+	var ok bool
+	s.Require().NoError(s.Pool.QueryRow(context.Background(), `SELECT to_regclass($1) IS NOT NULL`, name).Scan(&ok))
+	return ok
+}
+
+func (s *StockTransfersMigrationSuite) TestUpDown() {
+	ctx := context.Background()
+	mig, err := migrate.New(migrationsURL(), s.DSN)
+	s.Require().NoError(err)
+	defer func() { _, _ = mig.Close() }()
+
+	s.Require().NoError(mig.Migrate(8))
+	defer func() { s.Require().NoError(mig.Up()) }()
+	s.False(s.tableExists("stock_transfers"))
+
+	s.Require().NoError(mig.Migrate(9))
+	s.True(s.tableExists("stock_transfers"))
+	s.True(s.tableExists("stock_transfer_items"))
+
+	_, err = s.Pool.Exec(ctx, `INSERT INTO users (id, login, password_hash, name, role) VALUES ($1, 'stm-admin', 'x', 'Admin', 'admin')`, stmAdminID)
+	s.Require().NoError(err)
+	var almaty, moscow, catID, productID string
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT id FROM warehouses WHERE name = 'Алматы'`).Scan(&almaty))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT id FROM warehouses WHERE name = 'Москва'`).Scan(&moscow))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO catalog_categories (kind, name) VALUES ('product', 'STM') RETURNING id`).Scan(&catID))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `INSERT INTO products (category_id, name) VALUES ($1, 'STM товар') RETURNING id`, catID).Scan(&productID))
+
+	// from = to запрещено CHECK'ом.
+	_, err = s.Pool.Exec(ctx, `INSERT INTO stock_transfers (from_warehouse_id, to_warehouse_id, created_by) VALUES ($1, $1, $2)`, almaty, stmAdminID)
+	s.Error(err)
+
+	var transferID int64
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO stock_transfers (from_warehouse_id, to_warehouse_id, created_by) VALUES ($1, $2, $3) RETURNING id`,
+		almaty, moscow, stmAdminID).Scan(&transferID))
+	_, err = s.Pool.Exec(ctx, `INSERT INTO stock_transfer_items (transfer_id, product_id, position, qty_sent) VALUES ($1, $2, 1, 0)`, transferID, productID)
+	s.Error(err, "qty_sent > 0")
+	_, err = s.Pool.Exec(ctx, `INSERT INTO stock_transfer_items (transfer_id, product_id, position, qty_sent, qty_received) VALUES ($1, $2, 1, 2, 3)`, transferID, productID)
+	s.Error(err, "qty_received ≤ qty_sent")
+	_, err = s.Pool.Exec(ctx, `INSERT INTO stock_movements (product_id, warehouse_id, qty_delta, reason, user_id, transfer_id) VALUES ($1, $2, -1, 'transfer_out', $3, $4)`,
+		productID, almaty, stmAdminID, transferID)
+	s.Require().NoError(err)
+	_, err = s.Pool.Exec(ctx, `INSERT INTO stock_movements (product_id, warehouse_id, qty_delta, reason, user_id, transfer_id) VALUES ($1, $2, -1, 'transfer_out', $3, 999999)`,
+		productID, almaty, stmAdminID)
+	s.Error(err, "FK transfer_id")
+
+	// ON DELETE SET NULL.
+	_, err = s.Pool.Exec(ctx, `DELETE FROM stock_transfers WHERE id = $1`, transferID)
+	s.Require().NoError(err)
+	var nullRef int
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT count(*) FROM stock_movements WHERE product_id = $1 AND transfer_id IS NULL`, productID).Scan(&nullRef))
+	s.Equal(1, nullRef)
+
+	// down → 0008: таблиц нет, движение осталось.
+	s.Require().NoError(mig.Migrate(8))
+	s.False(s.tableExists("stock_transfers"))
+	s.False(s.tableExists("stock_transfer_items"))
+	var cnt int
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT count(*) FROM stock_movements WHERE product_id = $1`, productID).Scan(&cnt))
+	s.Equal(1, cnt)
+}
diff --git a/internal/features/stocktransfers/repo.go b/internal/features/stocktransfers/repo.go
new file mode 100644
index 0000000..72dac7e
--- /dev/null
+++ b/internal/features/stocktransfers/repo.go
@@ -0,0 +1,540 @@
+package stocktransfers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+)
+
+var (
+	errNotFound = errors.New("stocktransfers: not found")
+	// errVersion — присланный version не совпал с текущим (409, DS-006/TS-010).
+	errVersion = errors.New("stocktransfers: version mismatch")
+	// errStatus — действие недоступно в текущем статусе (финальные/не тот переход, 409).
+	errStatus = errors.New("stocktransfers: status conflict")
+	// errOverflow — 22003 numeric_value_out_of_range при изменении остатка.
+	errOverflow = errors.New("stocktransfers: stock overflow")
+)
+
+// fieldsError — ошибки полей, найденные под транзакцией (склад/товар не существует или в
+// архиве, факт приёмки вне границ).
+type fieldsError struct{ Fields []errorspkg.Field }
+
+func (e *fieldsError) Error() string { return "stocktransfers: invalid fields" }
+
+type querier interface {
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
+}
+
+type Repo struct {
+	pool *pgxpool.Pool
+}
+
+func NewRepo(pool *pgxpool.Pool) *Repo { return &Repo{pool: pool} }
+
+type ListParams struct {
+	Status, WarehouseID string
+	Limit, Offset       int
+}
+
+func nullable(s string) *string {
+	if s == "" {
+		return nil
+	}
+	return &s
+}
+
+// List — перемещения, новые сверху; warehouse_id — откуда ИЛИ куда.
+func (r *Repo) List(ctx context.Context, p ListParams) ([]TransferSummary, int, error) {
+	rows, err := r.pool.Query(ctx, `
+SELECT t.id, t.from_warehouse_id::text, fw.name, t.to_warehouse_id::text, tw.name, t.status, t.note,
+       (SELECT count(*) FROM stock_transfer_items i WHERE i.transfer_id = t.id)::int,
+       cu.name, t.created_at, t.updated_at, t.version, count(*) OVER () AS total
+FROM stock_transfers t
+JOIN warehouses fw ON fw.id = t.from_warehouse_id
+JOIN warehouses tw ON tw.id = t.to_warehouse_id
+JOIN users cu      ON cu.id = t.created_by
+WHERE ($1::text IS NULL OR t.status = $1)
+  AND ($2::uuid IS NULL OR t.from_warehouse_id = $2::uuid OR t.to_warehouse_id = $2::uuid)
+ORDER BY t.id DESC
+LIMIT $3 OFFSET $4`, nullable(p.Status), nullable(p.WarehouseID), p.Limit, p.Offset)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []TransferSummary{}
+	total := 0
+	for rows.Next() {
+		var t TransferSummary
+		if err := rows.Scan(&t.ID, &t.FromWarehouseID, &t.FromWarehouseName, &t.ToWarehouseID, &t.ToWarehouseName,
+			&t.Status, &t.Note, &t.ItemsCount, &t.CreatedByName, &t.CreatedAt, &t.UpdatedAt, &t.Version, &total); err != nil {
+			return nil, 0, err
+		}
+		out = append(out, t)
+	}
+	return out, total, rows.Err()
+}
+
+// Get — карточка перемещения со строками (q — пул или транзакция).
+func (r *Repo) Get(ctx context.Context, id int64) (*TransferResponse, error) {
+	return getTransfer(ctx, r.pool, id)
+}
+
+func getTransfer(ctx context.Context, q querier, id int64) (*TransferResponse, error) {
+	var t TransferResponse
+	err := q.QueryRow(ctx, `
+SELECT t.id, t.from_warehouse_id::text, fw.name, t.to_warehouse_id::text, tw.name, t.status, t.note,
+       t.created_by::text, cu.name,
+       t.sent_by::text, su.name, t.sent_at,
+       t.received_by::text, ru.name, t.received_at,
+       t.cancelled_by::text, xu.name, t.cancelled_at,
+       t.created_at, t.updated_at, t.version
+FROM stock_transfers t
+JOIN warehouses fw ON fw.id = t.from_warehouse_id
+JOIN warehouses tw ON tw.id = t.to_warehouse_id
+JOIN users cu      ON cu.id = t.created_by
+LEFT JOIN users su ON su.id = t.sent_by
+LEFT JOIN users ru ON ru.id = t.received_by
+LEFT JOIN users xu ON xu.id = t.cancelled_by
+WHERE t.id = $1`, id).Scan(&t.ID, &t.FromWarehouseID, &t.FromWarehouseName, &t.ToWarehouseID, &t.ToWarehouseName,
+		&t.Status, &t.Note, &t.CreatedBy, &t.CreatedByName,
+		&t.SentBy, &t.SentByName, &t.SentAt,
+		&t.ReceivedBy, &t.ReceivedByName, &t.ReceivedAt,
+		&t.CancelledBy, &t.CancelledByName, &t.CancelledAt,
+		&t.CreatedAt, &t.UpdatedAt, &t.Version)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	rows, err := q.Query(ctx, `
+SELECT i.id::text, i.product_id::text, p.name, p.unit, i.qty_sent::text, i.qty_received::text
+FROM stock_transfer_items i JOIN products p ON p.id = i.product_id
+WHERE i.transfer_id = $1 ORDER BY i.position, i.id`, id)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	t.Items = []TransferItemResponse{}
+	for rows.Next() {
+		var it TransferItemResponse
+		var sent string
+		var received *string
+		if err := rows.Scan(&it.ID, &it.ProductID, &it.ProductName, &it.Unit, &sent, &received); err != nil {
+			return nil, err
+		}
+		it.QtySent = numeric.Amount(sent)
+		if received != nil {
+			a := numeric.Amount(*received)
+			it.QtyReceived = &a
+		}
+		t.Items = append(t.Items, it)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	t.Warnings = []StockWarning{}
+	return &t, nil
+}
+
+// inTx — транзакция с откатом при ошибке; fn возвращает id перемещения для re-fetch.
+func (r *Repo) inTx(ctx context.Context, fn func(tx pgx.Tx) ([]StockWarning, int64, error)) (*TransferResponse, error) {
+	tx, err := r.pool.BeginTx(ctx, pgx.TxOptions{})
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+	warnings, id, err := fn(tx)
+	if err != nil {
+		return nil, mapPgErr(err)
+	}
+	t, err := getTransfer(ctx, tx, id)
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, mapPgErr(err)
+	}
+	if warnings != nil {
+		t.Warnings = warnings
+	}
+	return t, nil
+}
+
+func mapPgErr(err error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "22003" {
+		return errOverflow
+	}
+	return err
+}
+
+// Create — новое перемещение (requested) и, при send, сразу отправка (in_transit).
+func (r *Repo) Create(ctx context.Context, in Input, userID string, send bool) (*TransferResponse, error) {
+	return r.inTx(ctx, func(tx pgx.Tx) ([]StockWarning, int64, error) {
+		if err := checkRefs(ctx, tx, in, nil); err != nil {
+			return nil, 0, err
+		}
+		var id int64
+		if err := tx.QueryRow(ctx, `
+INSERT INTO stock_transfers (from_warehouse_id, to_warehouse_id, note, created_by)
+VALUES ($1::uuid, $2::uuid, $3, $4::uuid) RETURNING id`,
+			in.FromWarehouseID, in.ToWarehouseID, in.Note, userID).Scan(&id); err != nil {
+			return nil, 0, err
+		}
+		if err := insertItems(ctx, tx, id, in.Items); err != nil {
+			return nil, 0, err
+		}
+		if !send {
+			return nil, id, nil
+		}
+		w, err := doSend(ctx, tx, id, userID)
+		return w, id, err
+	})
+}
+
+// Update — правка заявки (только requested): склады, примечание, строки целиком.
+func (r *Repo) Update(ctx context.Context, id int64, in Input, version int) (*TransferResponse, error) {
+	return r.inTx(ctx, func(tx pgx.Tx) ([]StockWarning, int64, error) {
+		if _, err := lockTransfer(ctx, tx, id, version, StatusRequested); err != nil {
+			return nil, 0, err
+		}
+		existing, err := existingProductIDs(ctx, tx, id)
+		if err != nil {
+			return nil, 0, err
+		}
+		if err := checkRefs(ctx, tx, in, existing); err != nil {
+			return nil, 0, err
+		}
+		if _, err := tx.Exec(ctx, `
+UPDATE stock_transfers SET from_warehouse_id = $2::uuid, to_warehouse_id = $3::uuid, note = $4,
+       updated_at = now(), version = version + 1
+WHERE id = $1`, id, in.FromWarehouseID, in.ToWarehouseID, in.Note); err != nil {
+			return nil, 0, err
+		}
+		if _, err := tx.Exec(ctx, `DELETE FROM stock_transfer_items WHERE transfer_id = $1`, id); err != nil {
+			return nil, 0, err
+		}
+		return nil, id, insertItems(ctx, tx, id, in.Items)
+	})
+}
+
+// Send — requested → in_transit: −qty_sent с источника (transfer_out).
+func (r *Repo) Send(ctx context.Context, id int64, version int, userID string) (*TransferResponse, error) {
+	return r.inTx(ctx, func(tx pgx.Tx) ([]StockWarning, int64, error) {
+		if _, err := lockTransfer(ctx, tx, id, version, StatusRequested); err != nil {
+			return nil, 0, err
+		}
+		w, err := doSend(ctx, tx, id, userID)
+		return w, id, err
+	})
+}
+
+// Receive — in_transit → received: факт по строкам, на получателе +qty_sent (transfer_in)
+// и −недостача (transfer_loss); остаток получателя растёт на факт.
+func (r *Repo) Receive(ctx context.Context, id int64, version int, in []ReceiveItemInput, userID string) (*TransferResponse, error) {
+	return r.inTx(ctx, func(tx pgx.Tx) ([]StockWarning, int64, error) {
+		st, err := lockTransfer(ctx, tx, id, version, StatusInTransit)
+		if err != nil {
+			return nil, 0, err
+		}
+		items, err := sentItems(ctx, tx, id)
+		if err != nil {
+			return nil, 0, err
+		}
+		facts, fields := resolveReceive(items, in)
+		if len(fields) > 0 {
+			return nil, 0, &fieldsError{Fields: fields}
+		}
+		ids := make([]string, 0, len(facts))
+		qtys := make([]string, 0, len(facts))
+		for k, v := range facts {
+			ids = append(ids, k)
+			qtys = append(qtys, v)
+		}
+		if _, err := tx.Exec(ctx, `
+UPDATE stock_transfer_items i SET qty_received = u.q::numeric
+FROM unnest($2::uuid[], $3::text[]) AS u(id, q)
+WHERE i.transfer_id = $1 AND i.id = u.id`, id, ids, qtys); err != nil {
+			return nil, 0, err
+		}
+		if err := lockPairs(ctx, tx, id, st.to); err != nil {
+			return nil, 0, err
+		}
+		if _, err := tx.Exec(ctx, `
+UPDATE product_stock ps SET stock = ps.stock + i.qty_received
+FROM stock_transfer_items i
+WHERE i.transfer_id = $1 AND ps.product_id = i.product_id AND ps.warehouse_id = $2::uuid`, id, st.to); err != nil {
+			return nil, 0, err
+		}
+		if _, err := tx.Exec(ctx, `
+INSERT INTO stock_movements (product_id, warehouse_id, qty_delta, reason, user_id, transfer_id)
+SELECT i.product_id, $2::uuid, i.qty_sent, $3, $4::uuid, $1 FROM stock_transfer_items i WHERE i.transfer_id = $1
+UNION ALL
+SELECT i.product_id, $2::uuid, -(i.qty_sent - i.qty_received), $5, $4::uuid, $1
+FROM stock_transfer_items i WHERE i.transfer_id = $1 AND i.qty_received < i.qty_sent`,
+			id, st.to, reasonIn, userID, reasonLoss); err != nil {
+			return nil, 0, err
+		}
+		_, err = tx.Exec(ctx, `
+UPDATE stock_transfers SET status = $2, received_by = $3::uuid, received_at = now(), updated_at = now(), version = version + 1
+WHERE id = $1`, id, StatusReceived, userID)
+		return nil, id, err
+	})
+}
+
+// Cancel — requested → cancelled (без движений); in_transit → cancelled (+qty_sent на
+// источник, transfer_return).
+func (r *Repo) Cancel(ctx context.Context, id int64, version int, userID string) (*TransferResponse, error) {
+	return r.inTx(ctx, func(tx pgx.Tx) ([]StockWarning, int64, error) {
+		st, err := lockTransfer(ctx, tx, id, version, StatusRequested, StatusInTransit)
+		if err != nil {
+			return nil, 0, err
+		}
+		if st.status == StatusInTransit {
+			if err := lockPairs(ctx, tx, id, st.from); err != nil {
+				return nil, 0, err
+			}
+			if _, err := tx.Exec(ctx, `
+UPDATE product_stock ps SET stock = ps.stock + i.qty_sent
+FROM stock_transfer_items i
+WHERE i.transfer_id = $1 AND ps.product_id = i.product_id AND ps.warehouse_id = $2::uuid`, id, st.from); err != nil {
+				return nil, 0, err
+			}
+			if _, err := tx.Exec(ctx, `
+INSERT INTO stock_movements (product_id, warehouse_id, qty_delta, reason, user_id, transfer_id)
+SELECT i.product_id, $2::uuid, i.qty_sent, $3, $4::uuid, $1 FROM stock_transfer_items i WHERE i.transfer_id = $1`,
+				id, st.from, reasonReturn, userID); err != nil {
+				return nil, 0, err
+			}
+		}
+		_, err = tx.Exec(ctx, `
+UPDATE stock_transfers SET status = $2, cancelled_by = $3::uuid, cancelled_at = now(), updated_at = now(), version = version + 1
+WHERE id = $1`, id, StatusCancelled, userID)
+		return nil, id, err
+	})
+}
+
+type lockedTransfer struct {
+	status   string
+	from, to string
+}
+
+// lockTransfer — FOR UPDATE строки перемещения (первая блокировка транзакции, D50: затем
+// product_stock); version сверяется ДО статуса — устаревшая форма получает 409 version.
+func lockTransfer(ctx context.Context, tx pgx.Tx, id int64, version int, allowed ...string) (lockedTransfer, error) {
+	var st lockedTransfer
+	var cur int
+	err := tx.QueryRow(ctx, `
+SELECT status, from_warehouse_id::text, to_warehouse_id::text, version FROM stock_transfers WHERE id = $1 FOR UPDATE`, id).
+		Scan(&st.status, &st.from, &st.to, &cur)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return st, errNotFound
+	}
+	if err != nil {
+		return st, err
+	}
+	if cur != version {
+		return st, errVersion
+	}
+	for _, a := range allowed {
+		if st.status == a {
+			return st, nil
+		}
+	}
+	return st, errStatus
+}
+
+// lockPairs — D34 для перемещений: отсутствующие строки product_stock (товар×склад)
+// создаются ON CONFLICT DO NOTHING, затем блокируются FOR UPDATE в порядке
+// (product_id, warehouse_id).
+func lockPairs(ctx context.Context, tx pgx.Tx, transferID int64, warehouseID string) error {
+	if _, err := tx.Exec(ctx, `
+INSERT INTO product_stock (product_id, warehouse_id)
+SELECT i.product_id, $2::uuid FROM stock_transfer_items i WHERE i.transfer_id = $1
+ON CONFLICT DO NOTHING`, transferID, warehouseID); err != nil {
+		return err
+	}
+	rows, err := tx.Query(ctx, `
+SELECT ps.product_id FROM product_stock ps
+JOIN stock_transfer_items i ON i.product_id = ps.product_id AND i.transfer_id = $1
+WHERE ps.warehouse_id = $2::uuid
+ORDER BY ps.product_id, ps.warehouse_id FOR UPDATE OF ps`, transferID, warehouseID)
+	if err != nil {
+		return err
+	}
+	rows.Close()
+	return rows.Err()
+}
+
+// doSend — списание с источника + статус in_transit; возвращает предупреждения по
+// остаткам источника (отрицательный/на минимуме — разрешено, D17/D18).
+func doSend(ctx context.Context, tx pgx.Tx, id int64, userID string) ([]StockWarning, error) {
+	var from string
+	if err := tx.QueryRow(ctx, `SELECT from_warehouse_id::text FROM stock_transfers WHERE id = $1`, id).Scan(&from); err != nil {
+		return nil, err
+	}
+	if err := lockPairs(ctx, tx, id, from); err != nil {
+		return nil, err
+	}
+	if _, err := tx.Exec(ctx, `
+UPDATE product_stock ps SET stock = ps.stock - i.qty_sent
+FROM stock_transfer_items i
+WHERE i.transfer_id = $1 AND ps.product_id = i.product_id AND ps.warehouse_id = $2::uuid`, id, from); err != nil {
+		return nil, err
+	}
+	if _, err := tx.Exec(ctx, `
+INSERT INTO stock_movements (product_id, warehouse_id, qty_delta, reason, user_id, transfer_id)
+SELECT i.product_id, $2::uuid, -i.qty_sent, $3, $4::uuid, $1 FROM stock_transfer_items i WHERE i.transfer_id = $1`,
+		id, from, reasonOut, userID); err != nil {
+		return nil, err
+	}
+	if _, err := tx.Exec(ctx, `
+UPDATE stock_transfers SET status = $2, sent_by = $3::uuid, sent_at = now(), updated_at = now(), version = version + 1
+WHERE id = $1`, id, StatusInTransit, userID); err != nil {
+		return nil, err
+	}
+
+	rows, err := tx.Query(ctx, `
+SELECT p.id::text, w.id::text, w.name, p.name, ps.stock::text, ps.min_stock::text,
+       CASE WHEN ps.stock < 0 THEN 'negative' ELSE 'below_min' END
+FROM stock_transfer_items i
+JOIN product_stock ps ON ps.product_id = i.product_id AND ps.warehouse_id = $2::uuid
+JOIN products p ON p.id = i.product_id
+JOIN warehouses w ON w.id = ps.warehouse_id
+WHERE i.transfer_id = $1 AND ps.stock <= ps.min_stock
+ORDER BY p.name, p.id`, id, from)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []StockWarning{}
+	for rows.Next() {
+		var w StockWarning
+		var stock, minStock string
+		if err := rows.Scan(&w.ProductID, &w.WarehouseID, &w.WarehouseName, &w.Name, &stock, &minStock, &w.Kind); err != nil {
+			return nil, err
+		}
+		w.Stock, w.MinStock = numeric.Amount(stock), numeric.Amount(minStock)
+		out = append(out, w)
+	}
+	return out, rows.Err()
+}
+
+func insertItems(ctx context.Context, tx pgx.Tx, id int64, items []ItemInput) error {
+	for i, it := range items {
+		if _, err := tx.Exec(ctx, `
+INSERT INTO stock_transfer_items (transfer_id, product_id, position, qty_sent) VALUES ($1, $2::uuid, $3, $4::numeric)`,
+			id, it.ProductID, i+1, it.QtySent.String()); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func sentItems(ctx context.Context, tx pgx.Tx, id int64) ([]sentItem, error) {
+	rows, err := tx.Query(ctx, `SELECT id::text, qty_sent::text FROM stock_transfer_items WHERE transfer_id = $1 ORDER BY position, id`, id)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []sentItem
+	for rows.Next() {
+		var it sentItem
+		if err := rows.Scan(&it.ID, &it.QtySent); err != nil {
+			return nil, err
+		}
+		out = append(out, it)
+	}
+	return out, rows.Err()
+}
+
+func existingProductIDs(ctx context.Context, tx pgx.Tx, id int64) (map[string]bool, error) {
+	rows, err := tx.Query(ctx, `SELECT product_id::text FROM stock_transfer_items WHERE transfer_id = $1`, id)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := map[string]bool{}
+	for rows.Next() {
+		var pid string
+		if err := rows.Scan(&pid); err != nil {
+			return nil, err
+		}
+		out[pid] = true
+	}
+	return out, rows.Err()
+}
+
+// checkRefs — склады существуют и активны; товары существуют и активны (архивный товар,
+// уже бывший в этой заявке, — допустим при пересохранении, как комплект услуги).
+func checkRefs(ctx context.Context, tx pgx.Tx, in Input, grandfathered map[string]bool) error {
+	var f []errorspkg.Field
+	activeWh := map[string]bool{}
+	rows, err := tx.Query(ctx, `SELECT id::text FROM warehouses WHERE id = ANY($1::uuid[]) AND is_active`,
+		[]string{in.FromWarehouseID, in.ToWarehouseID})
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return err
+		}
+		activeWh[id] = true
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	if !activeWh[in.FromWarehouseID] {
+		f = append(f, errorspkg.Field{Name: "from_warehouse_id", Message: msgInvalid})
+	}
+	if !activeWh[in.ToWarehouseID] {
+		f = append(f, errorspkg.Field{Name: "to_warehouse_id", Message: msgInvalid})
+	}
+
+	ids := make([]string, len(in.Items))
+	for i, it := range in.Items {
+		ids[i] = it.ProductID
+	}
+	products := map[string]bool{} // id → is_active
+	rows, err = tx.Query(ctx, `SELECT id::text, is_active FROM products WHERE id = ANY($1::uuid[])`, ids)
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var id string
+		var active bool
+		if err := rows.Scan(&id, &active); err != nil {
+			rows.Close()
+			return err
+		}
+		products[id] = active
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	for i, it := range in.Items {
+		active, ok := products[it.ProductID]
+		if !ok || (!active && !grandfathered[it.ProductID]) {
+			f = append(f, errorspkg.Field{Name: fmt.Sprintf("items[%d].product_id", i), Message: msgInvalid})
+		}
+	}
+	if len(f) > 0 {
+		return &fieldsError{Fields: f}
+	}
+	return nil
+}
