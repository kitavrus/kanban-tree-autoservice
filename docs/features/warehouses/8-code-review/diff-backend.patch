--- /dev/null
+++ b/internal/features/stocktransfers/stocktransfers_http_live_test.go
@@ -0,0 +1,536 @@
+//go:build integration
+
+package stocktransfers_test
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/suite"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// StockTransfersLiveSuite (§TD-8): перемещения товаров между складами
+// (docs/features/warehouses/draft-spec.md DS-006/DS-007/DS-010/DS-011) — TS-008 (заявка →
+// правка → отправка → приёмка с недостачей), TS-009 (отмены, финальные статусы, from = to),
+// TS-010 (version, двойной receive), TS-007 «В пути», TS-014 (executor → 403), SSR.
+type StockTransfersLiveSuite struct {
+	testutil.LiveSuite
+	admin   *testutil.Browser
+	adminID string
+	almaty  string
+	moscow  string
+	catID   string
+	seq     int
+}
+
+func TestStockTransfersLiveSuite(t *testing.T) {
+	suite.Run(t, &StockTransfersLiveSuite{LiveSuite: testutil.LiveSuite{BinaryPkg: "./cmd/server"}})
+}
+
+func (s *StockTransfersLiveSuite) SetupSuite() {
+	s.LiveSuite.SetupSuite()
+	s.SeedUser("st-admin", "password1", "Перемещения Админ", "admin", true)
+	s.admin = s.NewBrowser()
+	s.admin.Login("st-admin", "password1")
+	ctx := context.Background()
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT id::text FROM users WHERE login = 'st-admin'`).Scan(&s.adminID))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT id::text FROM warehouses WHERE name = 'Алматы'`).Scan(&s.almaty))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT id::text FROM warehouses WHERE name = 'Москва'`).Scan(&s.moscow))
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO catalog_categories (kind, name) VALUES ('product', 'ST товары') RETURNING id::text`).Scan(&s.catID))
+}
+
+// ---- wire-типы ----
+
+type itemDTO struct {
+	ID          string       `json:"id"`
+	ProductID   string       `json:"product_id"`
+	ProductName string       `json:"product_name"`
+	QtySent     json.Number  `json:"qty_sent"`
+	QtyReceived *json.Number `json:"qty_received"`
+}
+
+type warningDTO struct {
+	ProductID   string      `json:"product_id"`
+	WarehouseID string      `json:"warehouse_id"`
+	Stock       json.Number `json:"stock"`
+	Kind        string      `json:"kind"`
+}
+
+type transferDTO struct {
+	ID                int64        `json:"id"`
+	FromWarehouseID   string       `json:"from_warehouse_id"`
+	FromWarehouseName string       `json:"from_warehouse_name"`
+	ToWarehouseID     string       `json:"to_warehouse_id"`
+	Status            string       `json:"status"`
+	Note              string       `json:"note"`
+	CreatedByName     string       `json:"created_by_name"`
+	SentAt            *string      `json:"sent_at"`
+	ReceivedAt        *string      `json:"received_at"`
+	CancelledAt       *string      `json:"cancelled_at"`
+	Version           int          `json:"version"`
+	Items             []itemDTO    `json:"items"`
+	Warnings          []warningDTO `json:"warnings"`
+}
+
+type listDTO struct {
+	Items []struct {
+		ID         int64  `json:"id"`
+		Status     string `json:"status"`
+		ItemsCount int    `json:"items_count"`
+	} `json:"items"`
+	Total  int `json:"total"`
+	Limit  int `json:"limit"`
+	Offset int `json:"offset"`
+}
+
+type apiErr struct {
+	Code    string `json:"code"`
+	Details *struct {
+		Fields []struct{ Name, Message string } `json:"fields"`
+	} `json:"details"`
+}
+
+// ---- хелперы ----
+
+func (s *StockTransfersLiveSuite) errOf(raw []byte) apiErr {
+	var e apiErr
+	s.Require().NoError(json.Unmarshal(raw, &e), string(raw))
+	return e
+}
+
+func (s *StockTransfersLiveSuite) fields(raw []byte) map[string]string {
+	e := s.errOf(raw)
+	s.Require().NotNil(e.Details, string(raw))
+	m := map[string]string{}
+	for _, f := range e.Details.Fields {
+		m[f.Name] = f.Message
+	}
+	return m
+}
+
+// newProduct — товар с остатком stock на «Алматы» (SQL: фикстура, не предмет теста).
+func (s *StockTransfersLiveSuite) newProduct(stock string) string {
+	s.seq++
+	ctx := context.Background()
+	var id string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`INSERT INTO products (category_id, name) VALUES ($1, $2) RETURNING id::text`,
+		s.catID, fmt.Sprintf("ST товар %d", s.seq)).Scan(&id))
+	_, err := s.Pool.Exec(ctx, `INSERT INTO product_stock (product_id, warehouse_id, stock) VALUES ($1, $2, $3::numeric)`,
+		id, s.almaty, stock)
+	s.Require().NoError(err)
+	return id
+}
+
+func (s *StockTransfersLiveSuite) pairStock(productID, warehouseID string) string {
+	var v string
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT coalesce((SELECT stock FROM product_stock WHERE product_id = $1 AND warehouse_id = $2), 0)::text`,
+		productID, warehouseID).Scan(&v))
+	return v
+}
+
+// movements — reason:склад:delta по перемещению (id движений — uuid, порядок не задан).
+func (s *StockTransfersLiveSuite) movements(transferID int64) []string {
+	rows, err := s.Pool.Query(context.Background(), `
+		SELECT m.reason || ':' || w.name || ':' || m.qty_delta::text FROM stock_movements m
+		JOIN warehouses w ON w.id = m.warehouse_id WHERE m.transfer_id = $1`, transferID)
+	s.Require().NoError(err)
+	defer rows.Close()
+	out := []string{}
+	for rows.Next() {
+		var v string
+		s.Require().NoError(rows.Scan(&v))
+		out = append(out, v)
+	}
+	s.Require().NoError(rows.Err())
+	return out
+}
+
+func (s *StockTransfersLiveSuite) do(method, path string, body any) (int, transferDTO, []byte) {
+	st, raw := s.admin.Do(method, path, body)
+	var t transferDTO
+	if st < 300 {
+		s.Require().NoError(json.Unmarshal(raw, &t), string(raw))
+	}
+	return st, t, raw
+}
+
+func (s *StockTransfersLiveSuite) create(body map[string]any) transferDTO {
+	st, t, raw := s.do(http.MethodPost, "/api/v1/stock-transfers", body)
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+	return t
+}
+
+func (s *StockTransfersLiveSuite) action(t transferDTO, act string, body map[string]any) (int, transferDTO, []byte) {
+	if body == nil {
+		body = map[string]any{}
+	}
+	if _, ok := body["version"]; !ok {
+		body["version"] = t.Version
+	}
+	return s.do(http.MethodPost, fmt.Sprintf("/api/v1/stock-transfers/%d/%s", t.ID, act), body)
+}
+
+func (s *StockTransfersLiveSuite) inTransit(productID, warehouseID string) string {
+	q := "?scope=all&limit=1000"
+	if warehouseID != "" {
+		q += "&warehouse_id=" + warehouseID
+	}
+	st, raw := s.admin.Do(http.MethodGet, "/api/v1/stock"+q, nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	var l struct {
+		Items []struct {
+			ProductID string      `json:"product_id"`
+			InTransit json.Number `json:"in_transit"`
+		} `json:"items"`
+	}
+	s.Require().NoError(json.Unmarshal(raw, &l), string(raw))
+	for _, it := range l.Items {
+		if it.ProductID == productID {
+			return it.InTransit.String()
+		}
+	}
+	s.FailNow("товар не найден на экране остатков", productID)
+	return ""
+}
+
+// ---- TS-008 ----
+
+// TS-008: заявка → правка строк → отправка (минус на источнике, «в пути») → приёмка по
+// факту с недостачей (приход + transfer_loss) — итоговые остатки верны.
+func (s *StockTransfersLiveSuite) TestTS008_RequestEditSendReceiveWithLoss() {
+	p1, p2, p3 := s.newProduct("10"), s.newProduct("3"), s.newProduct("7")
+
+	t := s.create(map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "note": " под заказ ",
+		"items": []map[string]any{{"product_id": p1, "qty_sent": 4}, {"product_id": p3, "qty_sent": 1}},
+	})
+	s.Equal("requested", t.Status)
+	s.Equal("под заказ", t.Note)
+	s.Equal(1, t.Version)
+	s.Equal("Перемещения Админ", t.CreatedByName)
+	s.Len(t.Items, 2)
+	s.Nil(t.SentAt)
+	s.Equal("10.000", s.pairStock(p1, s.almaty), "заявка не двигает остатки")
+	s.Empty(s.movements(t.ID))
+
+	// правка строк заявки: p3 убрана, p2 добавлена, количество p1 изменено.
+	st, upd, raw := s.do(http.MethodPut, fmt.Sprintf("/api/v1/stock-transfers/%d", t.ID), map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "note": "",
+		"items":   []map[string]any{{"product_id": p1, "qty_sent": 6}, {"product_id": p2, "qty_sent": 5}},
+		"version": t.Version,
+	})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal(2, upd.Version)
+	s.Require().Len(upd.Items, 2)
+	s.Equal(p1, upd.Items[0].ProductID)
+	s.Equal("6.000", upd.Items[0].QtySent.String())
+	s.Equal(p2, upd.Items[1].ProductID)
+
+	// список: конверт §API-1, фильтр статуса.
+	st, raw = s.admin.Do(http.MethodGet, "/api/v1/stock-transfers?status=requested", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	var l listDTO
+	s.Require().NoError(json.Unmarshal(raw, &l))
+	s.Equal(50, l.Limit)
+	s.Equal(0, l.Offset)
+	found := false
+	for _, it := range l.Items {
+		s.Equal("requested", it.Status)
+		if it.ID == t.ID {
+			found = true
+			s.Equal(2, it.ItemsCount)
+		}
+	}
+	s.True(found)
+
+	// отправка: −qty_sent с источника; p2 уходит в минус (3−5) — разрешено с предупреждением.
+	st, sent, raw := s.action(upd, "send", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("in_transit", sent.Status)
+	s.NotNil(sent.SentAt)
+	s.Equal("4.000", s.pairStock(p1, s.almaty))
+	s.Equal("-2.000", s.pairStock(p2, s.almaty))
+	s.Require().Len(sent.Warnings, 1)
+	s.Equal(p2, sent.Warnings[0].ProductID)
+	s.Equal("negative", sent.Warnings[0].Kind)
+	s.Equal(s.almaty, sent.Warnings[0].WarehouseID)
+
+	// «В пути» (TS-007): по всем складам и при фильтре склада-получателя; у источника — 0.
+	s.Equal("6.000", s.inTransit(p1, ""))
+	s.Equal("6.000", s.inTransit(p1, s.moscow))
+	s.Equal("0", s.inTransit(p1, s.almaty))
+
+	// приёмка по факту: p1 — 5 из 6 (недостача 1), p2 — без записи → факт = отправлено.
+	st, rec, raw := s.action(sent, "receive", map[string]any{
+		"items": []map[string]any{{"id": sent.Items[0].ID, "qty_received": 5}},
+	})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("received", rec.Status)
+	s.NotNil(rec.ReceivedAt)
+	s.Require().NotNil(rec.Items[0].QtyReceived)
+	s.Equal("5.000", rec.Items[0].QtyReceived.String())
+	s.Equal("5.000", rec.Items[1].QtyReceived.String())
+	s.Equal("5.000", s.pairStock(p1, s.moscow))
+	s.Equal("5.000", s.pairStock(p2, s.moscow))
+	s.Equal("4.000", s.pairStock(p1, s.almaty), "приёмка не трогает источник")
+	s.Equal("0", s.inTransit(p1, ""), "после приёмки — не в пути")
+
+	s.ElementsMatch([]string{
+		"transfer_out:Алматы:-6.000", "transfer_out:Алматы:-5.000",
+		"transfer_in:Москва:6.000", "transfer_in:Москва:5.000",
+		"transfer_loss:Москва:-1.000",
+	}, s.movements(t.ID))
+}
+
+// Создание сразу «Отправить» (send=true) — in_transit одной операцией.
+func (s *StockTransfersLiveSuite) TestCreateAndSend() {
+	p := s.newProduct("2")
+	t := s.create(map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "send": true,
+		"items": []map[string]any{{"product_id": p, "qty_sent": 2}},
+	})
+	s.Equal("in_transit", t.Status)
+	s.Equal("0.000", s.pairStock(p, s.almaty))
+	s.Require().Len(t.Warnings, 1, "остаток 0 при минимуме 0 — на минимуме")
+	s.Equal("below_min", t.Warnings[0].Kind)
+	s.ElementsMatch([]string{"transfer_out:Алматы:-2.000"}, s.movements(t.ID))
+}
+
+// ---- TS-009 ----
+
+// TS-009: отмена in_transit → возврат на источник; отмена requested → без движений;
+// правка received → 409; from = to → 400.
+func (s *StockTransfersLiveSuite) TestTS009_CancelFinalSameWarehouse() {
+	p := s.newProduct("10")
+	items := []map[string]any{{"product_id": p, "qty_sent": 3}}
+
+	// отмена requested — без движений.
+	req := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items})
+	st, c1, raw := s.action(req, "cancel", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("cancelled", c1.Status)
+	s.NotNil(c1.CancelledAt)
+	s.Empty(s.movements(req.ID))
+	s.Equal("10.000", s.pairStock(p, s.almaty))
+
+	// отмена in_transit — возврат на источник.
+	tr := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "send": true})
+	s.Equal("7.000", s.pairStock(p, s.almaty))
+	st, c2, raw := s.action(tr, "cancel", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("cancelled", c2.Status)
+	s.Equal("10.000", s.pairStock(p, s.almaty))
+	s.Equal("0", s.pairStock(p, s.moscow), "получатель не затронут")
+	s.ElementsMatch([]string{"transfer_out:Алматы:-3.000", "transfer_return:Алматы:3.000"}, s.movements(tr.ID))
+
+	// финальные: правка/отправка/приёмка/отмена cancelled → 409.
+	for _, act := range []string{"send", "receive", "cancel"} {
+		st, _, raw := s.action(c2, act, nil)
+		s.Equal(http.StatusConflict, st, "%s → %s", act, raw)
+		s.Equal("STOCK_TRANSFER_STATUS_CONFLICT", s.errOf(raw).Code)
+	}
+
+	// правка received → 409.
+	rc := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "send": true})
+	st, rcv, raw := s.action(rc, "receive", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, _, raw = s.do(http.MethodPut, fmt.Sprintf("/api/v1/stock-transfers/%d", rc.ID), map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "version": rcv.Version,
+	})
+	s.Equal(http.StatusConflict, st, string(raw))
+	s.Equal("STOCK_TRANSFER_STATUS_CONFLICT", s.errOf(raw).Code)
+	st, _, raw = s.action(rcv, "cancel", nil)
+	s.Equal(http.StatusConflict, st, "received нельзя отменить: %s", raw)
+
+	// правка строк in_transit тоже запрещена (строки редактируемы только в заявке).
+	it := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "send": true})
+	st, _, raw = s.do(http.MethodPut, fmt.Sprintf("/api/v1/stock-transfers/%d", it.ID), map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "version": it.Version,
+	})
+	s.Equal(http.StatusConflict, st, string(raw))
+
+	// from = to → 400.
+	st, _, raw = s.do(http.MethodPost, "/api/v1/stock-transfers", map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.almaty, "items": items,
+	})
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal(map[string]string{"to_warehouse_id": "same_warehouse"}, s.fields(raw))
+}
+
+// Валидация тела: строки, склады/товары (не существует, архив), приёмка вне границ, мусор.
+func (s *StockTransfersLiveSuite) TestValidation() {
+	p := s.newProduct("1")
+	ok := []map[string]any{{"product_id": p, "qty_sent": 1}}
+	cases := []struct {
+		body any
+		want map[string]string
+	}{
+		{map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": []any{}}, map[string]string{"items": "required"}},
+		{map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": []map[string]any{{"product_id": p, "qty_sent": 0}}},
+			map[string]string{"items[0].qty_sent": "invalid"}},
+		{map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": []map[string]any{{"product_id": p, "qty_sent": 1}, {"product_id": p, "qty_sent": 2}}},
+			map[string]string{"items[1].product_id": "duplicate"}},
+		{map[string]any{"from_warehouse_id": "00000000-0000-0000-0000-000000000000", "to_warehouse_id": s.moscow, "items": ok},
+			map[string]string{"from_warehouse_id": "invalid"}},
+		{map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": []map[string]any{{"product_id": "00000000-0000-0000-0000-000000000000", "qty_sent": 1}}},
+			map[string]string{"items[0].product_id": "invalid"}},
+	}
+	for _, c := range cases {
+		st, _, raw := s.do(http.MethodPost, "/api/v1/stock-transfers", c.body)
+		s.Equal(http.StatusBadRequest, st, "%v → %s", c.body, raw)
+		s.Equal(c.want, s.fields(raw), "%v", c.body)
+	}
+	for _, body := range []any{`{`, `null`, `{"items":"x"}`, map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": []map[string]any{{"product_id": p, "qty_sent": "1"}}}} {
+		st, _, raw := s.do(http.MethodPost, "/api/v1/stock-transfers", body)
+		s.Equal(http.StatusBadRequest, st, "%v → %s", body, raw)
+	}
+
+	// архивный товар — 400; в существующей заявке — допустим при пересохранении.
+	t := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": ok})
+	_, err := s.Pool.Exec(context.Background(), `UPDATE products SET is_active = false WHERE id = $1`, p)
+	s.Require().NoError(err)
+	st, _, raw := s.do(http.MethodPost, "/api/v1/stock-transfers", map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": ok})
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal(map[string]string{"items[0].product_id": "invalid"}, s.fields(raw))
+	st, _, raw = s.do(http.MethodPut, fmt.Sprintf("/api/v1/stock-transfers/%d", t.ID), map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": ok, "version": t.Version,
+	})
+	s.Equal(http.StatusOK, st, "архивный товар уже в заявке: %s", raw)
+
+	// version обязателен; приёмка: факт > отправленного, чужая строка.
+	st, _, raw = s.do(http.MethodPost, fmt.Sprintf("/api/v1/stock-transfers/%d/send", t.ID), map[string]any{})
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal(map[string]string{"version": "required"}, s.fields(raw))
+
+	p2 := s.newProduct("5")
+	tr := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "send": true,
+		"items": []map[string]any{{"product_id": p2, "qty_sent": 2}}})
+	st, _, raw = s.action(tr, "receive", map[string]any{"items": []map[string]any{{"id": tr.Items[0].ID, "qty_received": 2.5}}})
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal(map[string]string{"items[0].qty_received": "exceeds_sent"}, s.fields(raw))
+	st, _, raw = s.action(tr, "receive", map[string]any{"items": []map[string]any{{"id": "00000000-0000-0000-0000-000000000000", "qty_received": 1}}})
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal(map[string]string{"items[0].id": "invalid"}, s.fields(raw))
+	s.Equal("3.000", s.pairStock(p2, s.almaty), "неудачная приёмка ничего не меняет")
+	s.Equal("0", s.pairStock(p2, s.moscow))
+
+	// фильтры списка: мусор → 400; 404 на чужой/битый id.
+	for _, q := range []string{"?status=done", "?warehouse_id=x"} {
+		st, raw := s.admin.Do(http.MethodGet, "/api/v1/stock-transfers"+q, nil)
+		s.Equal(http.StatusBadRequest, st, "%s → %s", q, raw)
+	}
+	for _, id := range []string{"abc", "0", "999999999"} {
+		st, raw := s.admin.Do(http.MethodGet, "/api/v1/stock-transfers/"+id, nil)
+		s.Equal(http.StatusNotFound, st, "%s → %s", id, raw)
+	}
+}
+
+// ---- TS-010 ----
+
+// TS-010: устаревший version → 409; двойной receive → 409; параллельные receive — один
+// успех, остаток получателя изменён ровно один раз.
+func (s *StockTransfersLiveSuite) TestTS010_VersionAndDoubleReceive() {
+	p := s.newProduct("10")
+	items := []map[string]any{{"product_id": p, "qty_sent": 2}}
+	t := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items})
+
+	// устаревший version на правке и на отправке.
+	st, upd, raw := s.do(http.MethodPut, fmt.Sprintf("/api/v1/stock-transfers/%d", t.ID), map[string]any{
+		"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "version": t.Version,
+	})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, _, raw = s.action(t, "send", nil) // t.Version = 1, актуальная — 2
+	s.Equal(http.StatusConflict, st, string(raw))
+	s.Equal("STOCK_TRANSFER_VERSION_CONFLICT", s.errOf(raw).Code)
+	s.Equal("10.000", s.pairStock(p, s.almaty))
+
+	st, sent, raw := s.action(upd, "send", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, _, raw = s.action(sent, "receive", nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, _, raw = s.action(sent, "receive", nil) // тот же version — повтор
+	s.Equal(http.StatusConflict, st, string(raw))
+	s.Equal("2.000", s.pairStock(p, s.moscow), "двойной receive не приходует дважды")
+
+	// параллельные receive одного перемещения.
+	t2 := s.create(map[string]any{"from_warehouse_id": s.almaty, "to_warehouse_id": s.moscow, "items": items, "send": true})
+	var wg sync.WaitGroup
+	codes := make([]int, 4)
+	for i := range codes {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			codes[i], _ = s.admin.Do(http.MethodPost, fmt.Sprintf("/api/v1/stock-transfers/%d/receive", t2.ID), map[string]any{"version": t2.Version})
+		}(i)
+	}
+	wg.Wait()
+	okCount := 0
+	for _, c := range codes {
+		if c == http.StatusOK {
+			okCount++
+		} else {
+			s.Equal(http.StatusConflict, c)
+		}
+	}
+	s.Equal(1, okCount, "ровно одна приёмка")
+	s.Equal("4.000", s.pairStock(p, s.moscow))
+}
+
+// ---- TS-014 ----
+
+// TS-014: executor не видит «Перемещения» — 403 на API и SSR, нет пункта меню.
+func (s *StockTransfersLiveSuite) TestTS014_ExecutorForbidden() {
+	s.SeedUser("st-exec", "password1", "Перемещения Исп", "executor", true)
+	exec := s.NewBrowser()
+	exec.Login("st-exec", "password1")
+	for _, cs := range []struct {
+		method, path string
+		body         any
+	}{
+		{http.MethodGet, "/api/v1/stock-transfers", nil},
+		{http.MethodPost, "/api/v1/stock-transfers", map[string]any{}},
+		{http.MethodGet, "/api/v1/stock-transfers/1", nil},
+		{http.MethodPut, "/api/v1/stock-transfers/1", map[string]any{}},
+		{http.MethodPost, "/api/v1/stock-transfers/1/send", map[string]any{"version": 1}},
+		{http.MethodPost, "/api/v1/stock-transfers/1/receive", map[string]any{"version": 1}},
+		{http.MethodPost, "/api/v1/stock-transfers/1/cancel", map[string]any{"version": 1}},
+	} {
+		st, raw := exec.Do(cs.method, cs.path, cs.body)
+		s.Equal(http.StatusForbidden, st, "%s %s → %s", cs.method, cs.path, raw)
+	}
+	resp := exec.Request(http.MethodGet, "/stock-transfers", nil, nil)
+	resp.Body.Close()
+	s.Equal(http.StatusForbidden, resp.StatusCode)
+
+	resp = exec.Request(http.MethodGet, "/", nil, nil)
+	body, err := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	s.Require().NoError(err)
+	s.NotContains(string(body), `href="/stock-transfers"`, "executor не видит пункт «Перемещения»")
+
+	anon := s.NewBrowser()
+	st, raw := anon.Do(http.MethodGet, "/api/v1/stock-transfers", nil)
+	s.Equal(http.StatusUnauthorized, st, string(raw))
+}
+
+// SSR: страница admin, пункт сайдбара, скрипт экрана.
+func (s *StockTransfersLiveSuite) TestSSR_Page() {
+	resp := s.admin.Request(http.MethodGet, "/stock-transfers", nil, nil)
+	body, err := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	s.Require().NoError(err)
+	s.Equal(http.StatusOK, resp.StatusCode)
+	s.Contains(string(body), `data-testid="st-root"`)
+	s.Contains(string(body), `href="/stock-transfers"`, "пункт «Перемещения» в сайдбаре admin")
+	s.Contains(string(body), `/assets/ssr-shared/js/stock-transfers.js`)
+}
diff --git a/internal/features/stocktransfers/validate.go b/internal/features/stocktransfers/validate.go
new file mode 100644
index 0000000..d729ff1
--- /dev/null
+++ b/internal/features/stocktransfers/validate.go
@@ -0,0 +1,184 @@
+package stocktransfers
+
+import (
+	"fmt"
+	"math/big"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/numeric"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Коды ошибок полей (details.fields[].message) — клиент переводит их в текст.
+const (
+	msgRequired    = "required"
+	msgInvalid     = "invalid"
+	msgTooLong     = "too_long"
+	msgInvalidText = "invalid_text"
+	msgTooMany     = "too_many"
+	// msgSameWarehouse — склад-получатель совпадает с источником (TS-009: from = to → 400).
+	msgSameWarehouse = "same_warehouse"
+	// msgDuplicate — товар уже есть в другой строке перемещения (D52: дубли не сливаются).
+	msgDuplicate = "duplicate"
+	// msgExceedsSent — факт приёмки больше отправленного (DS-006: 0 ≤ qty_received ≤ qty_sent).
+	msgExceedsSent = "exceeds_sent"
+)
+
+const (
+	noteMax  = 1000
+	itemsMax = 200
+)
+
+// qtyScale — NUMERIC(12,3): 9 цифр целой части, 3 дробной.
+var qtyScale = numeric.Scale{IntDigits: 9, FracDigits: 3}
+
+// Input — нормализованные поля перемещения (создание/правка заявки).
+type Input struct {
+	FromWarehouseID string
+	ToWarehouseID   string
+	Note            string
+	Items           []ItemInput
+}
+
+func (in Input) normalize() Input {
+	in.FromWarehouseID = strings.ToLower(strings.TrimSpace(in.FromWarehouseID))
+	in.ToWarehouseID = strings.ToLower(strings.TrimSpace(in.ToWarehouseID))
+	in.Note = strings.TrimSpace(in.Note)
+	items := make([]ItemInput, len(in.Items))
+	for i, it := range in.Items {
+		items[i] = ItemInput{ProductID: strings.ToLower(strings.TrimSpace(it.ProductID)), QtySent: it.QtySent}
+	}
+	in.Items = items
+	return in
+}
+
+// validate — ошибки полей после normalize() (существование/активность складов и товаров
+// проверяет repo).
+func (in Input) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	add := func(name, msg string) { f = append(f, errorspkg.Field{Name: name, Message: msg}) }
+
+	fromOK := checkUUID("from_warehouse_id", in.FromWarehouseID, add)
+	toOK := checkUUID("to_warehouse_id", in.ToWarehouseID, add)
+	if fromOK && toOK && in.FromWarehouseID == in.ToWarehouseID {
+		add("to_warehouse_id", msgSameWarehouse)
+	}
+
+	if utf8.RuneCountInString(in.Note) > noteMax {
+		add("note", msgTooLong)
+	}
+	if sqlutil.HasInvalidText(in.Note) {
+		add("note", msgInvalidText)
+	}
+
+	switch {
+	case len(in.Items) == 0:
+		add("items", msgRequired)
+	case len(in.Items) > itemsMax:
+		add("items", msgTooMany)
+	}
+	seen := map[string]bool{}
+	for i, it := range in.Items {
+		pf := fmt.Sprintf("items[%d].product_id", i)
+		if checkUUID(pf, it.ProductID, add) {
+			if seen[it.ProductID] {
+				add(pf, msgDuplicate)
+			}
+			seen[it.ProductID] = true
+		}
+		qf := fmt.Sprintf("items[%d].qty_sent", i)
+		if msg := positiveQty(it.QtySent); msg != "" {
+			add(qf, msg)
+		}
+	}
+	return f
+}
+
+func checkUUID(name, v string, add func(name, msg string)) bool {
+	if v == "" {
+		add(name, msgRequired)
+		return false
+	}
+	if uuid.Validate(v) != nil {
+		add(name, msgInvalid)
+		return false
+	}
+	return true
+}
+
+// positiveQty — qty_sent: число NUMERIC(12,3), строго > 0.
+func positiveQty(a numeric.Amount) string {
+	if a == "" {
+		return msgRequired
+	}
+	if msg := a.Validate(qtyScale, false); msg != "" {
+		return msg
+	}
+	if ratOf(string(a)).Sign() <= 0 {
+		return msgInvalid
+	}
+	return ""
+}
+
+func ratOf(s string) *big.Rat {
+	r, ok := new(big.Rat).SetString(s)
+	if !ok {
+		return new(big.Rat)
+	}
+	return r
+}
+
+// sentItem — строка перемещения для проверки приёмки.
+type sentItem struct {
+	ID      string
+	QtySent string
+}
+
+// resolveReceive — факт по каждой строке перемещения (DS-006): не указанная строка —
+// факт = qty_sent; указанная — 0 ≤ qty_received ≤ qty_sent. Возвращает id → факт.
+func resolveReceive(items []sentItem, in []ReceiveItemInput) (map[string]string, []errorspkg.Field) {
+	var f []errorspkg.Field
+	byID := make(map[string]sentItem, len(items))
+	out := make(map[string]string, len(items))
+	for _, it := range items {
+		byID[it.ID] = it
+		out[it.ID] = it.QtySent
+	}
+	seen := map[string]bool{}
+	for i, r := range in {
+		idf := fmt.Sprintf("items[%d].id", i)
+		qf := fmt.Sprintf("items[%d].qty_received", i)
+		id := strings.ToLower(strings.TrimSpace(r.ID))
+		it, ok := byID[id]
+		switch {
+		case id == "":
+			f = append(f, errorspkg.Field{Name: idf, Message: msgRequired})
+			continue
+		case !ok:
+			f = append(f, errorspkg.Field{Name: idf, Message: msgInvalid})
+			continue
+		case seen[id]:
+			f = append(f, errorspkg.Field{Name: idf, Message: msgDuplicate})
+			continue
+		}
+		seen[id] = true
+		if r.QtyReceived == "" {
+			f = append(f, errorspkg.Field{Name: qf, Message: msgRequired})
+			continue
+		}
+		if msg := r.QtyReceived.Validate(qtyScale, false); msg != "" {
+			f = append(f, errorspkg.Field{Name: qf, Message: msg})
+			continue
+		}
+		if ratOf(string(r.QtyReceived)).Cmp(ratOf(it.QtySent)) > 0 {
+			f = append(f, errorspkg.Field{Name: qf, Message: msgExceedsSent})
+			continue
+		}
+		out[id] = string(r.QtyReceived)
+	}
+	return out, f
+}
diff --git a/internal/features/stocktransfers/validate_test.go b/internal/features/stocktransfers/validate_test.go
new file mode 100644
index 0000000..c9a0c99
--- /dev/null
+++ b/internal/features/stocktransfers/validate_test.go
@@ -0,0 +1,136 @@
+package stocktransfers
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+const (
+	whA   = "11111111-1111-1111-1111-111111111111"
+	whB   = "22222222-2222-2222-2222-222222222222"
+	prodX = "33333333-3333-3333-3333-333333333333"
+	prodY = "44444444-4444-4444-4444-444444444444"
+)
+
+func fieldMap(f []errorspkg.Field) map[string]string {
+	m := map[string]string{}
+	for _, x := range f {
+		if _, ok := m[x.Name]; !ok {
+			m[x.Name] = x.Message
+		}
+	}
+	return m
+}
+
+func TestInputValidate_OK(t *testing.T) {
+	in := Input{
+		FromWarehouseID: " " + strings.ToUpper(whA) + " ", ToWarehouseID: whB, Note: "  срочно ",
+		Items: []ItemInput{{ProductID: prodX, QtySent: "1.5"}, {ProductID: prodY, QtySent: "2"}},
+	}.normalize()
+	assert.Empty(t, in.validate())
+	assert.Equal(t, whA, in.FromWarehouseID, "trim + lower")
+	assert.Equal(t, "срочно", in.Note)
+}
+
+// TS-009: from = to → 400 to_warehouse_id: same_warehouse (регистр uuid не важен).
+func TestInputValidate_SameWarehouse(t *testing.T) {
+	in := Input{FromWarehouseID: whA, ToWarehouseID: strings.ToUpper(whA), Items: []ItemInput{{ProductID: prodX, QtySent: "1"}}}.normalize()
+	assert.Equal(t, map[string]string{"to_warehouse_id": msgSameWarehouse}, fieldMap(in.validate()))
+}
+
+func TestInputValidate_Fields(t *testing.T) {
+	cases := []struct {
+		name string
+		in   Input
+		want map[string]string
+	}{
+		{"пусто", Input{}, map[string]string{"from_warehouse_id": msgRequired, "to_warehouse_id": msgRequired, "items": msgRequired}},
+		{"битые uuid", Input{FromWarehouseID: "x", ToWarehouseID: "y", Items: []ItemInput{{ProductID: "z", QtySent: "1"}}},
+			map[string]string{"from_warehouse_id": msgInvalid, "to_warehouse_id": msgInvalid, "items[0].product_id": msgInvalid}},
+		{"qty 0", Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: []ItemInput{{ProductID: prodX, QtySent: "0"}}},
+			map[string]string{"items[0].qty_sent": msgInvalid}},
+		{"qty отрицательное", Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: []ItemInput{{ProductID: prodX, QtySent: "-1"}}},
+			map[string]string{"items[0].qty_sent": msgInvalid}},
+		{"qty нет", Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: []ItemInput{{ProductID: prodX}}},
+			map[string]string{"items[0].qty_sent": msgRequired}},
+		{"qty точность", Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: []ItemInput{{ProductID: prodX, QtySent: "1.0001"}}},
+			map[string]string{"items[0].qty_sent": "too_precise"}},
+		{"qty велико", Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: []ItemInput{{ProductID: prodX, QtySent: "1000000000"}}},
+			map[string]string{"items[0].qty_sent": "too_large"}},
+		{"дубль товара", Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: []ItemInput{{ProductID: prodX, QtySent: "1"}, {ProductID: strings.ToUpper(prodX), QtySent: "2"}}},
+			map[string]string{"items[1].product_id": msgDuplicate}},
+		{"длинное примечание", Input{FromWarehouseID: whA, ToWarehouseID: whB, Note: strings.Repeat("я", noteMax+1), Items: []ItemInput{{ProductID: prodX, QtySent: "1"}}},
+			map[string]string{"note": msgTooLong}},
+		{"NUL в примечании", Input{FromWarehouseID: whA, ToWarehouseID: whB, Note: "a\x00b", Items: []ItemInput{{ProductID: prodX, QtySent: "1"}}},
+			map[string]string{"note": msgInvalidText}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, fieldMap(tc.in.normalize().validate()))
+		})
+	}
+}
+
+func TestInputValidate_TooManyItems(t *testing.T) {
+	items := make([]ItemInput, itemsMax+1)
+	for i := range items {
+		items[i] = ItemInput{ProductID: prodX, QtySent: "1"}
+	}
+	got := fieldMap(Input{FromWarehouseID: whA, ToWarehouseID: whB, Items: items}.normalize().validate())
+	assert.Equal(t, msgTooMany, got["items"])
+}
+
+// DS-006: факт по умолчанию = qty_sent; 0 ≤ qty_received ≤ qty_sent.
+func TestResolveReceive(t *testing.T) {
+	items := []sentItem{{ID: "aaaaaaaa-0000-0000-0000-000000000001", QtySent: "5.000"}, {ID: "aaaaaaaa-0000-0000-0000-000000000002", QtySent: "2.500"}}
+
+	facts, f := resolveReceive(items, nil)
+	require.Empty(t, f)
+	assert.Equal(t, map[string]string{items[0].ID: "5.000", items[1].ID: "2.500"}, facts)
+
+	facts, f = resolveReceive(items, []ReceiveItemInput{{ID: strings.ToUpper(items[0].ID), QtyReceived: "3.5"}, {ID: items[1].ID, QtyReceived: "0"}})
+	require.Empty(t, f)
+	assert.Equal(t, "3.5", facts[items[0].ID])
+	assert.Equal(t, "0", facts[items[1].ID])
+
+	_, f = resolveReceive(items, []ReceiveItemInput{
+		{ID: items[0].ID, QtyReceived: "5.001"},
+		{ID: "bbbbbbbb-0000-0000-0000-000000000009", QtyReceived: "1"},
+		{ID: items[1].ID, QtyReceived: "-1"},
+		{ID: items[1].ID, QtyReceived: "1"},
+		{ID: "", QtyReceived: "1"},
+	})
+	assert.Equal(t, map[string]string{
+		"items[0].qty_received": msgExceedsSent,
+		"items[1].id":           msgInvalid,
+		"items[2].qty_received": msgInvalid,
+		"items[3].id":           msgDuplicate,
+		"items[4].id":           msgRequired,
+	}, fieldMap(f))
+
+	_, f = resolveReceive(items, []ReceiveItemInput{{ID: items[0].ID}})
+	assert.Equal(t, map[string]string{"items[0].qty_received": msgRequired}, fieldMap(f))
+}
+
+func TestIsStatusAndParseID(t *testing.T) {
+	for _, s := range Statuses {
+		assert.True(t, isStatus(s))
+	}
+	assert.False(t, isStatus("done"))
+	_, err := parseID("abc")
+	assert.ErrorIs(t, err, ErrTransferNotFound)
+	_, err = parseID("0")
+	assert.ErrorIs(t, err, ErrTransferNotFound)
+	id, err := parseID("42")
+	require.NoError(t, err)
+	assert.Equal(t, int64(42), id)
+	_, err = parseIDVersion("42", nil)
+	var app *errorspkg.AppError
+	require.ErrorAs(t, err, &app)
+	assert.Equal(t, 400, app.HTTP)
+}
