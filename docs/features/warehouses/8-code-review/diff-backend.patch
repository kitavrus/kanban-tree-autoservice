@@ -0,0 +1,377 @@
+//go:build integration
+
+package board_test
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"sync"
+)
+
+// Склад и перемещения оборудования заказа (docs/features/warehouses/draft-spec.md DS-008,
+// DS-009, DS-005-хвост; TS-006, TS-011…TS-014; D55–D59). Методы OrderCardLiveSuite —
+// общие фикстуры карточки (order_card_http_live_test.go, warehouses_card_http_live_test.go).
+
+func (s *OrderCardLiveSuite) eqPath(taskID int64, equipmentID, action string) string {
+	return fmt.Sprintf("/api/v1/tasks/%d/equipment/%s/%s", taskID, equipmentID, action)
+}
+
+func (s *OrderCardLiveSuite) cardEquipment(c orderCardDTO, equipmentID string) cardEquipmentDTO {
+	for _, e := range c.Equipment {
+		if e.EquipmentID == equipmentID {
+			return e
+		}
+	}
+	s.FailNow("единица не найдена в карточке", equipmentID)
+	return cardEquipmentDTO{}
+}
+
+func strOr(p *string) string {
+	if p == nil {
+		return "<nil>"
+	}
+	return *p
+}
+
+func movementActions(e cardEquipmentDTO) []string {
+	out := make([]string, len(e.Movements))
+	for i, m := range e.Movements {
+		out[i] = m.Action
+	}
+	return out
+}
+
+// addEq — POST оборудования заказа с (опциональным) складом приёма.
+func (s *OrderCardLiveSuite) addEq(taskID int64, equipmentID, warehouseID string) orderCardMutationDTO {
+	body := map[string]any{"equipment_id": equipmentID}
+	if warehouseID != "" {
+		body["warehouse_id"] = warehouseID
+	}
+	st, m, raw := s.doEquipment(s.admin, http.MethodPost, fmt.Sprintf("/api/v1/tasks/%d/equipment", taskID), body)
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+	return m
+}
+
+// TS-011: добавить со складом приёма → «На складе: Москва» + received; без склада — первый
+// активный; отправить на Алматы (в пути, from→to, warehouse_id=null) → принять → история из
+// 3 записей; has_in_transit у заказа только пока единица в пути.
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_TS011_AddSendReceive() {
+	almaty, moscow := s.warehouseID("Алматы"), s.warehouseID("Москва")
+	c := s.newClient("Клиент-Оборудование-Склад")
+	taskID, _ := s.newTask(c, s.columnID("Новые"))
+	eqMoscow, eqDefault := s.newEquipment(c), s.newEquipment(c)
+
+	m := s.addEq(taskID, eqMoscow, moscow)
+	e := s.cardEquipment(m.Card, eqMoscow)
+	s.Equal("at_warehouse", e.Status)
+	s.Equal(moscow, strOr(e.WarehouseID))
+	s.Equal("Москва", strOr(e.WarehouseName))
+	s.Nil(e.TransitFromWarehouseID)
+	s.Nil(e.TransitToWarehouseID)
+	s.Require().Len(e.Movements, 1)
+	s.Equal("received", e.Movements[0].Action)
+	s.Nil(e.Movements[0].FromWarehouseID)
+	s.Equal(moscow, strOr(e.Movements[0].ToWarehouseID))
+	s.Equal("Карточка Админ", e.Movements[0].UserName)
+
+	m = s.addEq(taskID, eqDefault, "")
+	s.Equal(almaty, strOr(s.cardEquipment(m.Card, eqDefault).WarehouseID), "без склада — первый активный (D56)")
+
+	// повторный идемпотентный POST не пишет второй received.
+	m = s.addEq(taskID, eqMoscow, almaty)
+	e = s.cardEquipment(m.Card, eqMoscow)
+	s.Equal(moscow, strOr(e.WarehouseID), "повторный POST склад не меняет")
+	s.Len(e.Movements, 1)
+
+	st, m, raw := s.doEquipment(s.admin, http.MethodPost, s.eqPath(taskID, eqMoscow, "send"), map[string]any{"to_warehouse_id": almaty})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	e = s.cardEquipment(m.Card, eqMoscow)
+	s.Equal("in_transit", e.Status)
+	s.Nil(e.WarehouseID, "в пути склада нет")
+	s.Equal(moscow, strOr(e.TransitFromWarehouseID))
+	s.Equal("Москва", strOr(e.TransitFromWarehouseName))
+	s.Equal(almaty, strOr(e.TransitToWarehouseID))
+	s.Equal("Алматы", strOr(e.TransitToWarehouseName))
+	s.True(m.Card.Task.HasInTransit, "бейдж «в пути» (DS-009)")
+
+	st, m, raw = s.doEquipment(s.admin, http.MethodPost, s.eqPath(taskID, eqMoscow, "receive"), nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	e = s.cardEquipment(m.Card, eqMoscow)
+	s.Equal("at_warehouse", e.Status)
+	s.Equal(almaty, strOr(e.WarehouseID), "принято на складе назначения")
+	s.Nil(e.TransitToWarehouseID)
+	s.False(m.Card.Task.HasInTransit)
+	s.Equal([]string{"received", "sent", "arrived"}, movementActions(e))
+	s.Equal(moscow, strOr(e.Movements[2].FromWarehouseID))
+	s.Equal(almaty, strOr(e.Movements[2].ToWarehouseID))
+
+	// re-fetch: GET карточки отдаёт ту же историю.
+	_, card, _ := s.getCard(s.admin, taskID)
+	s.Equal([]string{"received", "sent", "arrived"}, movementActions(s.cardEquipment(card, eqMoscow)))
+}
+
+// TS-012: отмена отправки → обратно на исходный склад (cancelled хранит маршрут); принять/
+// отменить не в пути → 409; отправить в пути → 409; на тот же склад → 400; неверный склад/
+// тело → 400; чужая/битая единица → 404.
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_TS012_CancelAndErrors() {
+	almaty, moscow := s.warehouseID("Алматы"), s.warehouseID("Москва")
+	c := s.newClient("Клиент-Оборудование-Отмена")
+	taskID, _ := s.newTask(c, s.columnID("Новые"))
+	eq := s.newEquipment(c)
+	s.addEq(taskID, eq, almaty)
+
+	for _, action := range []string{"receive", "cancel-transit"} {
+		st, raw := s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, action), nil)
+		s.Equal(http.StatusConflict, st, "%s на складе → %s", action, raw)
+		s.Equal("TASK_EQUIPMENT_NOT_IN_TRANSIT", s.errOf(raw).Code)
+	}
+
+	st, raw := s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": almaty})
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Equal("same_warehouse", s.fields(raw)["to_warehouse_id"], string(raw))
+
+	_, err := s.Pool.Exec(context.Background(), `INSERT INTO warehouses (name, position, is_active) VALUES ('Архив-TS012', 98, false)`)
+	s.Require().NoError(err)
+	archived := s.warehouseID("Архив-TS012")
+	for _, body := range []map[string]any{
+		{"to_warehouse_id": archived},
+		{"to_warehouse_id": "00000000-0000-0000-0000-000000000000"},
+		{"to_warehouse_id": "msk"},
+		{},
+	} {
+		st, raw := s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), body)
+		s.Equal(http.StatusBadRequest, st, "%v → %s", body, raw)
+		s.Contains(s.fields(raw), "to_warehouse_id", string(raw))
+	}
+	st, raw = s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": moscow, "extra": 1})
+	s.Equal(http.StatusBadRequest, st, "strictJSON: лишнее поле → 400: %s", raw)
+
+	st, m, raw := s.doEquipment(s.admin, http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": moscow})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("in_transit", s.cardEquipment(m.Card, eq).Status)
+
+	st, raw = s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": almaty})
+	s.Equal(http.StatusConflict, st, string(raw))
+	s.Equal("TASK_EQUIPMENT_IN_TRANSIT", s.errOf(raw).Code)
+
+	st, m, raw = s.doEquipment(s.admin, http.MethodPost, s.eqPath(taskID, eq, "cancel-transit"), nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	e := s.cardEquipment(m.Card, eq)
+	s.Equal("at_warehouse", e.Status)
+	s.Equal(almaty, strOr(e.WarehouseID), "возврат на исходный склад")
+	s.Equal([]string{"received", "sent", "cancelled"}, movementActions(e))
+	s.Equal(almaty, strOr(e.Movements[2].FromWarehouseID), "cancelled хранит отменённый маршрут (D57)")
+	s.Equal(moscow, strOr(e.Movements[2].ToWarehouseID))
+
+	// единица не в заказе / битый uuid / чужой заказ → 404.
+	other := s.newEquipment(c)
+	st, raw = s.admin.Do(http.MethodPost, s.eqPath(taskID, other, "receive"), nil)
+	s.Equal(http.StatusNotFound, st, string(raw))
+	s.Equal("TASK_EQUIPMENT_NOT_FOUND", s.errOf(raw).Code)
+	st, raw = s.admin.Do(http.MethodPost, s.eqPath(taskID, "not-a-uuid", "receive"), nil)
+	s.Equal(http.StatusNotFound, st, string(raw))
+	st, raw = s.admin.Do(http.MethodPost, s.eqPath(999999999, eq, "receive"), nil)
+	s.Equal(http.StatusNotFound, st, string(raw))
+	s.Equal("TASK_NOT_FOUND", s.errOf(raw).Code)
+
+	// add: склад приёма архивный/несуществующий/не uuid → 400 warehouse_id.
+	eq2 := s.newEquipment(c)
+	for _, wh := range []string{archived, "00000000-0000-0000-0000-000000000000", "msk"} {
+		st, raw := s.admin.Do(http.MethodPost, fmt.Sprintf("/api/v1/tasks/%d/equipment", taskID), map[string]any{"equipment_id": eq2, "warehouse_id": wh})
+		s.Equal(http.StatusBadRequest, st, "%s → %s", wh, raw)
+		s.Contains(s.fields(raw), "warehouse_id", string(raw))
+	}
+}
+
+// Конкурентность (DS-008): параллельные receive одной единицы — ровно один 200, остальные
+// 409; в журнале один arrived.
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_ConcurrentReceive() {
+	almaty, moscow := s.warehouseID("Алматы"), s.warehouseID("Москва")
+	c := s.newClient("Клиент-Оборудование-Гонка")
+	taskID, _ := s.newTask(c, s.columnID("Новые"))
+	eq := s.newEquipment(c)
+	s.addEq(taskID, eq, almaty)
+	st, raw := s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": moscow})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+
+	var wg sync.WaitGroup
+	codes := make([]int, 5)
+	for i := range codes {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			codes[i], _ = s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "receive"), nil)
+		}(i)
+	}
+	wg.Wait()
+	ok := 0
+	for _, code := range codes {
+		if code == http.StatusOK {
+			ok++
+		} else {
+			s.Equal(http.StatusConflict, code)
+		}
+	}
+	s.Equal(1, ok, "ровно один приём")
+	var arrived int
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT count(*) FROM task_equipment_movements WHERE task_id = $1 AND equipment_id = $2 AND action = 'arrived'`, taskID, eq).Scan(&arrived))
+	s.Equal(1, arrived)
+}
+
+// TS-006 (полностью, D58): склад по умолчанию строки товара = склад оборудования услуги,
+// если единица на складе; в пути — первый активный.
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_TS006_DefaultFromEquipment() {
+	almaty, moscow := s.warehouseID("Алматы"), s.warehouseID("Москва")
+	c := s.newClient("Клиент-Оборудование-Товар")
+	taskID, _ := s.newTask(c, s.columnID("Новые"))
+	eq := s.newEquipment(c)
+	s.addEq(taskID, eq, moscow)
+	subID := s.addSubtask(taskID, s.newService("100"), "100")
+	s.attachSubtaskEquipment(subID, eq)
+	productID := s.newProduct("10", "10", "0")
+
+	st, m, raw := s.doCard(s.admin, http.MethodPost, "/api/v1/subtasks/"+subID+"/products", map[string]any{"product_id": productID, "qty": 1})
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+	s.Require().Len(m.Card.Subtasks[0].Products, 1)
+	s.Equal(moscow, m.Card.Subtasks[0].Products[0].WarehouseID, "склад оборудования услуги")
+
+	st, raw = s.admin.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": almaty})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, m, raw = s.doCard(s.admin, http.MethodPost, "/api/v1/subtasks/"+subID+"/products", map[string]any{"product_id": productID, "qty": 1})
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+	s.Require().Len(m.Card.Subtasks[0].Products, 2)
+	s.Equal(almaty, m.Card.Subtasks[0].Products[1].WarehouseID, "оборудование в пути → первый активный")
+	s.Equal(moscow, m.Card.Subtasks[0].Products[0].WarehouseID, "существующая строка не пересчитывается")
+}
