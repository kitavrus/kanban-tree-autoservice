+			return taskLockError(err)
+		}
+		loc, err := s.equipment.LockLocation(spanCtx, tx, id, equipmentID)
+		if errors.Is(err, errNotFound) {
+			return ErrTaskEquipmentNotFound
+		}
+		if err != nil {
+			return err
+		}
+		return apply(spanCtx, tx, id, loc)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return s.cardMutation(ctx, a, id, ReconcileResult{Warnings: []StockWarning{}})
+}
