+package board
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Склад оборудования заказа (warehouses подфаза C, DS-008/DS-009) — unit-уровень:
+// формат тел запросов, enum'ы статусов/действий, разбор фильтра «Склад» доски.
+
+// TestTaskEquipmentCreateRequestValidate_WarehouseID — TS-011: warehouse_id опционален
+// (D56: пусто → первый активный), но если передан — только uuid.
+func TestTaskEquipmentCreateRequestValidate_WarehouseID(t *testing.T) {
+	in := TaskEquipmentCreateRequest{EquipmentID: validUUID, WarehouseID: "  "}.normalize()
+	assert.Empty(t, in.validate())
+	assert.Empty(t, in.WarehouseID, "пробелы обрезаются")
+
+	in = TaskEquipmentCreateRequest{EquipmentID: validUUID, WarehouseID: validUUID}.normalize()
+	assert.Empty(t, in.validate())
+
+	in = TaskEquipmentCreateRequest{EquipmentID: validUUID, WarehouseID: "almaty"}.normalize()
+	fields := in.validate()
+	require.Len(t, fields, 1)
+	assert.Equal(t, "warehouse_id", fields[0].Name)
+	assert.Equal(t, msgInvalid, fields[0].Message)
+}
+
+// TestTaskEquipmentSendRequestValidate — TS-012: to_warehouse_id обязателен и uuid;
+// «тот же склад» проверяет сервис (нужен текущий склад под FOR UPDATE).
+func TestTaskEquipmentSendRequestValidate(t *testing.T) {
+	cases := map[string]string{"": msgRequired, "   ": msgRequired, "moscow": msgInvalid}
+	for raw, msg := range cases {
+		fields := TaskEquipmentSendRequest{ToWarehouseID: raw}.normalize().validate()
+		require.Len(t, fields, 1, "raw=%q", raw)
+		assert.Equal(t, "to_warehouse_id", fields[0].Name)
+		assert.Equal(t, msg, fields[0].Message, "raw=%q", raw)
+	}
+	assert.Empty(t, TaskEquipmentSendRequest{ToWarehouseID: " " + validUUID + " "}.normalize().validate())
+}
+
+// TestEquipmentEnums_MatchMigration — значения совпадают с CHECK миграции 0010 (сверка с
+// pg_get_constraintdef — live-сьюта equipment_warehouses_http_live_test.go).
+func TestEquipmentEnums_MatchMigration(t *testing.T) {
+	assert.ElementsMatch(t, []string{"at_warehouse", "in_transit"}, EquipmentStatuses)
+	assert.ElementsMatch(t, []string{"received", "sent", "arrived", "cancelled"}, EquipmentMovementActions)
+}
+
+// TestParseTaskFilter_WarehouseID — TS-013: warehouse_id невалидный → VALIDATION по полю;
+// валидный — в фильтре; отсутствует — nil.
+func TestParseTaskFilter_WarehouseID(t *testing.T) {
+	_, err := parseFilter(t, "warehouse_id=almaty", admin)
+	var ae *errorspkg.AppError
+	require.True(t, errors.As(err, &ae))
+	require.Equal(t, "VALIDATION", ae.Code)
+	require.Len(t, ae.Fields, 1)
+	assert.Equal(t, "warehouse_id", ae.Fields[0].Name)
+
+	f, err := parseFilter(t, "", admin)
+	require.NoError(t, err)
+	assert.Nil(t, f.WarehouseID)
+
+	f, err = parseFilter(t, "warehouse_id="+validUUID, admin)
+	require.NoError(t, err)
+	require.NotNil(t, f.WarehouseID)
+	assert.Equal(t, validUUID, *f.WarehouseID)
+}
