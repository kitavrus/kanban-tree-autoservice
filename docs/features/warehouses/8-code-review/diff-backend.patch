+++ b/internal/features/warehouses/service.go
@@ -0,0 +1,163 @@
+package warehouses
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+var (
+	ErrWarehouseNotFound = errorspkg.New("WAREHOUSE_NOT_FOUND", http.StatusNotFound, "Склад не найден")
+	// ErrLastActive — D47: последний активный склад архивировать нельзя (склад по умолчанию
+	// строки товара — «первый активный», DS-005; без активных складов добавить товар в заказ
+	// было бы некуда).
+	ErrLastActive = errorspkg.New("WAREHOUSE_LAST_ACTIVE", http.StatusConflict,
+		"Нельзя отправить в архив последний активный склад")
+)
+
+const (
+	defaultLimit = 500
+	maxLimit     = 500
+)
+
+type Service struct {
+	repo *Repo
+	pool *pgxpool.Pool
+}
+
+func NewService(pool *pgxpool.Pool) *Service {
+	return &Service{repo: NewRepo(pool), pool: pool}
+}
+
+type ListQuery struct {
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+func (s *Service) List(ctx context.Context, q ListQuery) (*WarehouseListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = defaultLimit
+	}
+	limit = min(limit, maxLimit)
+	offset = max(offset, 0)
+	items, total, err := s.repo.List(ctx, ListParams{IncludeArchived: q.IncludeArchived, Limit: limit, Offset: offset})
+	if err != nil {
+		return nil, err
+	}
+	resp := &WarehouseListResponse{Items: make([]WarehouseResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, w := range items {
+		resp.Items[i] = toResponse(w)
+	}
+	return resp, nil
+}
+
+func (s *Service) Get(ctx context.Context, id string) (*WarehouseResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrWarehouseNotFound
+	}
+	w, err := s.repo.Get(ctx, id)
+	if errors.Is(err, ErrNotFound) {
+		return nil, ErrWarehouseNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toResponse(*w)
+	return &resp, nil
+}
+
+func (s *Service) Create(ctx context.Context, in Input) (*WarehouseResponse, error) {
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	w, err := s.repo.Create(ctx, in)
+	if err != nil {
+		return nil, mapErr(err)
+	}
+	resp := toResponse(*w)
+	return &resp, nil
+}
+
+func (s *Service) Update(ctx context.Context, id string, in Input) (*WarehouseResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrWarehouseNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	if !in.IsActive {
+		if err := s.guardLastActive(ctx, id); err != nil {
+			return nil, err
+		}
+	}
+	w, err := s.repo.Update(ctx, id, in)
+	if err != nil {
+		return nil, mapErr(err)
+	}
+	resp := toResponse(*w)
+	return &resp, nil
+}
+
+// SetActive — SSR archive/restore.
+func (s *Service) SetActive(ctx context.Context, id string, active bool) error {
+	if uuid.Validate(id) != nil {
+		return ErrWarehouseNotFound
+	}
+	if !active {
+		if err := s.guardLastActive(ctx, id); err != nil {
+			return err
+		}
+	}
+	if err := s.repo.SetActive(ctx, id, active); errors.Is(err, ErrNotFound) {
+		return ErrWarehouseNotFound
+	} else if err != nil {
+		return err
+	}
+	return nil
+}
+
+// guardLastActive — архив склада id запрещён, если он — единственный активный (D47).
+func (s *Service) guardLastActive(ctx context.Context, id string) error {
+	var others int
+	if err := s.pool.QueryRow(ctx,
+		`SELECT count(*) FROM warehouses WHERE is_active AND id <> $1::uuid`, id).Scan(&others); err != nil {
+		return err
+	}
+	if others == 0 {
+		var exists bool
+		if err := s.pool.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM warehouses WHERE id = $1::uuid AND is_active)`, id).Scan(&exists); err != nil {
+			return err
+		}
+		if exists {
+			return ErrLastActive
+		}
+	}
+	return nil
+}
+
+func mapErr(err error) error {
+	switch {
+	case errors.Is(err, ErrNotFound):
+		return ErrWarehouseNotFound
+	case errors.Is(err, errNameTaken):
+		return errorspkg.Validation(errorspkg.Field{Name: "name", Message: msgTaken})
+	case errors.Is(err, errNameArchived):
+		return errorspkg.Validation(errorspkg.Field{Name: "name", Message: msgArchived})
+	}
+	return err
+}
+
+func toResponse(w Warehouse) WarehouseResponse {
+	return WarehouseResponse{
+		ID: w.ID, Name: w.Name, Position: w.Position, IsActive: w.IsActive,
+		CreatedAt: w.CreatedAt, UpdatedAt: w.UpdatedAt,
+	}
+}
diff --git a/internal/features/warehouses/ssr.go b/internal/features/warehouses/ssr.go
new file mode 100644
index 0000000..d7b67f8
--- /dev/null
+++ b/internal/features/warehouses/ssr.go
@@ -0,0 +1,183 @@
+package warehouses
+
+import (
+	"errors"
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Root — шаблоны экрана «Склады» относительно корня модуля.
+const Root = "web/ssr/warehouses/templates"
+
+// SSR — экран «Склады» (admin, DS-001): список + форма добавления на той же странице,
+// правка названия, архив/возврат (удаления нет). PRG, как equipmenttypes.
+type SSR struct {
+	svc    *Service
+	r      *ssr.Renderer
+	shell  ssr.ShellBuilder
+	status *ssr.StatusPages
+}
+
+func NewSSR(svc *Service, r *ssr.Renderer, shell ssr.ShellBuilder, status *ssr.StatusPages) *SSR {
+	return &SSR{svc: svc, r: r, shell: shell, status: status}
+}
+
+// ListVM — список складов + форма добавления (NewName/NewError — после неудачного POST).
+type ListVM struct {
+	Shell    ssr.Shell
+	Archived bool
+	Flash    string
+	Error    string
+	Items    []WarehouseResponse
+	NewName  string
+	NewError string
+}
+
+// FormVM — правка склада.
+type FormVM struct {
+	Shell    ssr.Shell
+	ID       string
+	Name     string
+	IsActive bool
+	Errors   map[string]string
+	Error    string
+}
+
+var flashes = map[string]string{
+	"created":  "Склад добавлен",
+	"saved":    "Изменения сохранены",
+	"archived": "Склад отправлен в архив",
+	"restored": "Склад возвращён из архива",
+}
+
+func (h *SSR) loadList(c fiber.Ctx, vm *ListVM) error {
+	resp, err := h.svc.List(c.Context(), ListQuery{IncludeArchived: vm.Archived, Limit: defaultLimit})
+	if err != nil {
+		return err
+	}
+	vm.Items = resp.Items
+	vm.Shell = h.shell.Build(c, "Склады")
+	return nil
+}
+
+// list — GET /warehouses.
+func (h *SSR) list(c fiber.Ctx) error {
+	vm := ListVM{Flash: flashes[c.Query("flash")]}
+	vm.Archived, _ = strconv.ParseBool(c.Query("archived"))
+	if c.Query("error") == "last_active" {
+		vm.Error = ErrLastActive.Message
+	}
+	if err := h.loadList(c, &vm); err != nil {
+		return err
+	}
+	return h.r.Page(c, "list", vm)
+}
+
+// create — POST /warehouses.
+func (h *SSR) create(c fiber.Ctx) error {
+	name := c.FormValue("name")
+	_, err := h.svc.Create(c.Context(), Input{Name: name, IsActive: true})
+	if err == nil {
+		return c.Redirect().Status(fiber.StatusSeeOther).To("/warehouses?flash=created")
+	}
+	var app *errorspkg.AppError
+	if !errors.As(err, &app) || app.HTTP >= fiber.StatusInternalServerError {
+		return err
+	}
+	vm := ListVM{NewName: name, NewError: app.Message}
+	for _, f := range app.Fields {
+		if f.Name == "name" {
+			vm.NewError = fieldText(f.Message)
+		}
+	}
+	if err := h.loadList(c, &vm); err != nil {
+		return err
+	}
+	c.Status(fiber.StatusUnprocessableEntity)
+	return h.r.Page(c, "list", vm)
+}
+
+// formEdit — GET /warehouses/:id.
+func (h *SSR) formEdit(c fiber.Ctx) error {
+	w, err := h.svc.Get(c.Context(), c.Params("id"))
+	if errors.Is(err, ErrWarehouseNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	return h.renderForm(c, fiber.StatusOK, FormVM{ID: w.ID, Name: w.Name, IsActive: w.IsActive})
+}
+
+// update — POST /warehouses/:id (переименование; is_active не меняется).
+func (h *SSR) update(c fiber.Ctx) error {
+	id := c.Params("id")
+	cur, err := h.svc.Get(c.Context(), id)
+	if errors.Is(err, ErrWarehouseNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	vm := FormVM{ID: id, Name: c.FormValue("name"), IsActive: cur.IsActive}
+	if _, err := h.svc.Update(c.Context(), id, Input{Name: vm.Name, IsActive: cur.IsActive}); err != nil {
+		var app *errorspkg.AppError
+		if !errors.As(err, &app) || app.HTTP >= fiber.StatusInternalServerError {
+			return err
+		}
+		vm.Errors = map[string]string{}
+		for _, f := range app.Fields {
+			vm.Errors[f.Name] = fieldText(f.Message)
+		}
+		if len(app.Fields) == 0 {
+			vm.Error = app.Message
+		}
+		return h.renderForm(c, fiber.StatusUnprocessableEntity, vm)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/warehouses?flash=saved")
+}
+
+func (h *SSR) archive(c fiber.Ctx) error { return h.setActive(c, false, "archived") }
+func (h *SSR) restore(c fiber.Ctx) error { return h.setActive(c, true, "restored") }
+
+func (h *SSR) setActive(c fiber.Ctx, active bool, flash string) error {
+	q := ""
+	if c.FormValue("archived") != "" {
+		q = "archived=1&"
+	}
+	err := h.svc.SetActive(c.Context(), c.Params("id"), active)
+	switch {
+	case errors.Is(err, ErrWarehouseNotFound):
+		return h.status.NotFound(c)
+	case errors.Is(err, ErrLastActive):
+		return c.Redirect().Status(fiber.StatusSeeOther).To("/warehouses?" + q + "error=last_active")
+	case err != nil:
+		return err
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/warehouses?" + q + "flash=" + flash)
+}
+
+func (h *SSR) renderForm(c fiber.Ctx, status int, vm FormVM) error {
+	vm.Shell = h.shell.Build(c, "Склад")
+	c.Status(status)
+	return h.r.Page(c, "form", vm)
+}
+
+// fieldText — код ошибки поля → текст под полем.
+func fieldText(code string) string {
+	switch code {
+	case msgRequired:
+		return "Обязательное поле"
+	case msgTooLong:
+		return "Слишком длинное значение"
+	case msgTaken:
+		return "Такой склад уже есть"
+	case msgArchived:
+		return "Такой склад уже есть в архиве — верните его из архива"
+	}
+	return "Недопустимое значение"
+}
diff --git a/internal/features/warehouses/validate.go b/internal/features/warehouses/validate.go
new file mode 100644
index 0000000..f0c3eff
--- /dev/null
+++ b/internal/features/warehouses/validate.go
@@ -0,0 +1,48 @@
+package warehouses
+
+import (
+	"strings"
+	"unicode/utf8"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Коды ошибок полей (details.fields[].message) — SSR переводит их в текст.
+const (
+	msgRequired    = "required"
+	msgTooLong     = "too_long"
+	msgInvalidText = "invalid_text"
+	// msgTaken — имя занято активным складом; msgArchived — архивным (DS-001: уникальность
+	// включает архивные, ошибка — 400 по полю name, TS-002).
+	msgTaken    = "taken"
+	msgArchived = "archived"
+)
+
+const nameMax = 100
+
+// Input — нормализованные поля склада (общие для API и SSR-формы).
+type Input struct {
+	Name     string
+	IsActive bool
+}
+
+func (in Input) normalize() Input {
+	in.Name = strings.TrimSpace(in.Name)
+	return in
+}
+
+// validate — ошибки полей после normalize().
+func (in Input) validate() []errorspkg.Field {
+	var f []errorspkg.Field
+	switch n := utf8.RuneCountInString(in.Name); {
+	case n == 0:
+		f = append(f, errorspkg.Field{Name: "name", Message: msgRequired})
+	case n > nameMax:
+		f = append(f, errorspkg.Field{Name: "name", Message: msgTooLong})
+	}
+	if sqlutil.HasInvalidText(in.Name) {
+		f = append(f, errorspkg.Field{Name: "name", Message: msgInvalidText})
+	}
+	return f
+}
