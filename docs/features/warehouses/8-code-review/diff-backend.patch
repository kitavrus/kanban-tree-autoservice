+			return nil, err
+		}
+		out = append(out, w)
+	}
+	return out, rows.Err()
+}
+
+// AllWarehouses — все склады по position (вкл. архивные), для фильтра
+// «Склад» доски (DS-009): архивный склад может ещё держать оборудование.
+func (r *CardRepo) AllWarehouses(ctx context.Context) ([]CardWarehouse, error) {
+	rows, err := r.pool.Query(ctx, `SELECT id, name, is_active FROM warehouses ORDER BY position, id`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []CardWarehouse{}
+	for rows.Next() {
+		var w CardWarehouse
+		if err := rows.Scan(&w.ID, &w.Name, &w.IsActive); err != nil {
+			return nil, err
+		}
+		out = append(out, w)
+	}
+	return out, rows.Err()
+}
