+type boardListItemDTO struct {
+	ID           int64 `json:"id"`
+	HasInTransit bool  `json:"has_in_transit"`
+}
+
+func (s *OrderCardLiveSuite) boardIDs(query string) map[int64]bool {
+	st, raw := s.admin.Do(http.MethodGet, "/api/v1/tasks?assignee=all&"+query, nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	var l struct {
+		Items []boardListItemDTO `json:"items"`
+	}
+	s.Require().NoError(json.Unmarshal(raw, &l), string(raw))
+	out := map[int64]bool{}
+	for _, it := range l.Items {
+		out[it.ID] = it.HasInTransit
+	}
+	return out
+}
+
+func keys(m map[int64]bool) []int64 {
+	out := make([]int64, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+// TS-013: фильтр доски «Склад» — заказы с оборудованием на складе X или едущим на X;
+// has_in_transit — только у заказа с единицей в пути; работает с per_column/column_id;
+// невалидный warehouse_id → 400.
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_TS013_BoardFilterAndBadge() {
+	almaty, moscow := s.warehouseID("Алматы"), s.warehouseID("Москва")
+	c := s.newClient("Клиент-Доска-Склад")
+	col := s.columnID("Новые")
+	atMoscow, _ := s.newTask(c, col)
+	toMoscow, _ := s.newTask(c, col)
+	atAlmaty, _ := s.newTask(c, col)
+	noEquipment, _ := s.newTask(c, col)
+
+	s.addEq(atMoscow, s.newEquipment(c), moscow)
+	eqTransit := s.newEquipment(c)
+	s.addEq(toMoscow, eqTransit, almaty)
+	st, raw := s.admin.Do(http.MethodPost, s.eqPath(toMoscow, eqTransit, "send"), map[string]any{"to_warehouse_id": moscow})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.addEq(atAlmaty, s.newEquipment(c), almaty)
+
+	got := s.boardIDs("client_id=" + c + "&warehouse_id=" + moscow)
+	s.Equal([]int64{atMoscow, toMoscow}, keys(got), "Москва: на складе + едет в Москву")
+	s.False(got[atMoscow])
+	s.True(got[toMoscow], "бейдж «в пути»")
+
+	got = s.boardIDs("client_id=" + c + "&warehouse_id=" + almaty)
+	s.Equal([]int64{atAlmaty}, keys(got), "Алматы: единица в пути из Алматы не считается")
+
+	all := s.boardIDs("client_id=" + c)
+	s.Len(all, 4, "без фильтра — все заказы")
+	s.True(all[toMoscow])
+	s.False(all[noEquipment])
+
+	got = s.boardIDs("client_id=" + c + "&warehouse_id=" + moscow + "&per_column=1&column_id=" + col)
+	s.Len(got, 1, "фильтр склада совместим с окном per_column/column_id")
+
+	st, raw = s.admin.Do(http.MethodGet, "/api/v1/tasks?warehouse_id=msk", nil)
+	s.Equal(http.StatusBadRequest, st, string(raw))
+	s.Contains(s.fields(raw), "warehouse_id")
+
+	// GET /tasks/:id тоже несёт has_in_transit (мутации доски перерисовывают карточку из него).
+	st, raw = s.admin.Do(http.MethodGet, fmt.Sprintf("/api/v1/tasks/%d", toMoscow), nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	var one boardListItemDTO
+	s.Require().NoError(json.Unmarshal(raw, &one))
+	s.True(one.HasInTransit)
+
+	// SSR доски рендерит опции фильтра «Склад».
+	st, raw = s.admin.Do(http.MethodGet, "/", nil)
+	s.Require().Equal(http.StatusOK, st)
+	s.Contains(string(raw), `data-testid="filter-warehouse"`)
+	s.Contains(string(raw), `value="`+moscow+`"`)
+}
+
+// TS-014 (часть): executor может отправить/принять/отменить оборудование заказа (права
+// как у правки оборудования, D19).
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_TS014_ExecutorCanMove() {
+	almaty, moscow := s.warehouseID("Алматы"), s.warehouseID("Москва")
+	s.SeedUser("eqwh-exec", "password1", "Склад Исполнитель", "executor", true)
+	exec := s.NewBrowser()
+	exec.Login("eqwh-exec", "password1")
+
+	c := s.newClient("Клиент-Оборудование-Исполнитель")
+	taskID, _ := s.newTask(c, s.columnID("Новые"))
+	eq := s.newEquipment(c)
+	st, _, raw := s.doEquipment(exec, http.MethodPost, fmt.Sprintf("/api/v1/tasks/%d/equipment", taskID), map[string]any{"equipment_id": eq, "warehouse_id": almaty})
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+
+	st, _, raw = s.doEquipment(exec, http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": moscow})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, _, raw = s.doEquipment(exec, http.MethodPost, s.eqPath(taskID, eq, "cancel-transit"), nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, _, raw = s.doEquipment(exec, http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": moscow})
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, m, raw := s.doEquipment(exec, http.MethodPost, s.eqPath(taskID, eq, "receive"), nil)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	e := s.cardEquipment(m.Card, eq)
+	s.Equal(moscow, strOr(e.WarehouseID))
+	s.Equal("Склад Исполнитель", e.Movements[len(e.Movements)-1].UserName)
+
+	// без сессии → 401.
+	anon := s.NewBrowser()
+	st, _ = anon.Do(http.MethodPost, s.eqPath(taskID, eq, "send"), map[string]any{"to_warehouse_id": almaty})
+	s.Equal(http.StatusUnauthorized, st)
+}
+
+// Enum'ы склада оборудования совпадают с CHECK'ами миграции 0010 (pg_get_constraintdef).
+func (s *OrderCardLiveSuite) TestEquipmentWarehouses_EnumsMatchDBChecks() {
+	ctx := context.Background()
+	for constraint, values := range map[string][]string{
+		"task_equipment_status_check":           {"at_warehouse", "in_transit"},
+		"task_equipment_movements_action_check": {"received", "sent", "arrived", "cancelled"},
+	} {
+		var def string
+		s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = $1`, constraint).Scan(&def))
+		for _, v := range values {
+			s.Contains(def, "'"+v+"'", constraint)
+		}
+	}
+}
diff --git a/internal/features/board/equipment_warehouses_migration_integration_test.go b/internal/features/board/equipment_warehouses_migration_integration_test.go
