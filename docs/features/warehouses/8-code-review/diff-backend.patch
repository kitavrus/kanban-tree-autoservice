+package stocktransfers
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+)
+
+// Root — шаблоны экрана «Перемещения» относительно корня модуля.
+const Root = "web/ssr/stocktransfers/templates"
+
+// SSR — экран «Перемещения» (admin, DS-006): master-detail; список, карточка и действия
+// рисует js/stock-transfers.js поверх JSON API (как экран «Остатки»), выбранное
+// перемещение — ?id=N.
+type SSR struct {
+	r      *ssr.Renderer
+	shell  ssr.ShellBuilder
+	status *ssr.StatusPages
+}
+
+func NewSSR(r *ssr.Renderer, shell ssr.ShellBuilder, status *ssr.StatusPages) *SSR {
+	return &SSR{r: r, shell: shell, status: status}
+}
+
+// PageVM — только оболочка: данные грузит JS.
+type PageVM struct {
+	Shell ssr.Shell
+}
+
+// page — GET /stock-transfers.
+func (h *SSR) page(c fiber.Ctx) error {
+	return h.r.Page(c, "list", PageVM{Shell: h.shell.Build(c, "Перемещения")})
+}
diff --git a/internal/features/stocktransfers/stocktransfers_http_live_test.go b/internal/features/stocktransfers/stocktransfers_http_live_test.go
