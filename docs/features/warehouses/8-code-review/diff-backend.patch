+	// остаток пары = Σ журнала пары (сид пишет каждое изменение движением).
+	var drift int
+	s.Require().NoError(s.Pool.QueryRow(ctx, `
+		SELECT count(*) FROM product_stock ps
+		WHERE ps.stock <> coalesce((SELECT sum(m.qty_delta) FROM stock_movements m
+		                            WHERE m.product_id = ps.product_id AND m.warehouse_id = ps.warehouse_id), 0)`).Scan(&drift))
+	s.Zero(drift, "product_stock = Σ stock_movements по паре")
+
+	var atMoscow, inTransit, equipmentRows, received int
+	s.Require().NoError(s.Pool.QueryRow(ctx, `
+		SELECT count(*) FILTER (WHERE te.status = 'at_warehouse' AND w.name = 'Москва'),
+		       count(*) FILTER (WHERE te.status = 'in_transit'),
+		       count(*)
+		FROM task_equipment te LEFT JOIN warehouses w ON w.id = te.warehouse_id`).Scan(&atMoscow, &inTransit, &equipmentRows))
+	s.Positive(atMoscow, "часть оборудования демо-заказов — в Москве")
+	s.Equal(1, inTransit, "одна единица в пути")
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT count(*) FROM task_equipment_movements WHERE action = 'received'`).Scan(&received))
+	s.Equal(equipmentRows, received, "у каждой единицы журнал received")
 }
 
