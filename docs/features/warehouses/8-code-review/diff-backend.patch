+	}
+	if validate != nil {
+		if f := validate(); len(f) > 0 {
+			return nil, errorspkg.Validation(f...)
+		}
+	}
+
+	spanCtx, span := otel.Tracer("board").Start(ctx, "task_equipment.transition")
+	defer span.End()
+	span.SetAttributes(attribute.Int64("task_id", id), attribute.String("op", op))
+
+	err := withTx(spanCtx, s.pool, func(tx pgx.Tx) error {
