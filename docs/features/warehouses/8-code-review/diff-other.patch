+    receiveModal.show();
+  }
+
+  function bindReceive() {
+    var receiving = false;
+    $('#st-receive-form').addEventListener('submit', function (e) {
+      e.preventDefault();
+      if (receiving) return;
+      var t = state.current;
+      var errEl = $('#st-receive-error');
+      var bad = false;
+      var items = $$('#st-receive-tbody input').map(function (inp) {
+        var raw = inp.value.trim();
+        var n = Number(raw);
+        if (raw === '' || Number.isNaN(n)) bad = true;
+        return { id: inp.dataset.itemId, qty_received: n };
+      });
+      if (bad) {
+        errEl.textContent = 'Введите число в каждой строке';
+        errEl.classList.remove('d-none');
+        return;
+      }
+      receiving = true;
+      $('#st-receive-confirm').disabled = true;
+      KT.api.post('/api/v1/stock-transfers/' + t.id + '/receive', { version: t.version, items: items })
+        .then(function (r) {
+          receiveModal.hide();
