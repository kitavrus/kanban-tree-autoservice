+              return fieldMessage(f);
+            }).join('; ')
+            : (err && err.message) || 'Не удалось принять перемещение';
+          errEl.textContent = msg;
+          errEl.classList.remove('d-none');
+          if (err && err.status === 409) {
+            receiveModal.hide();
+            handleError(err);
+          }
+        })
+        .then(function () {
