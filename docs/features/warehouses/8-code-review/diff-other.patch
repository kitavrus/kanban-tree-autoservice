+        case 'send': doSend(); break;
+        case 'cancel': doCancel(); break;
+        case 'receive': openReceive(); break;
+      }
+    });
+    bindReceive();
+  }
+
+  // ---------- инициализация ----------
+  function init() {
+    var root = $('#st');
+    if (!root) return;
+    bind();
+    var id = new URLSearchParams(window.location.search).get('id');
+    loadRefs()
+      .then(function () { return loadList(); })
+      .then(function () { if (id) return loadTransfer(id); })
+      .catch(function (err) {
+        $('#st-list').innerHTML = '<div class="empty-state">Не удалось загрузить перемещения' + (err && err.message ? ': ' + esc(err.message) : '') + '</div>';
+      });
+  }
+
+  KT.stockTransfers = { init: init };
+  document.addEventListener('DOMContentLoaded', init);
+})();
