+import { test, expect } from '../fixtures/board';
+import { StockTransfersPage } from '../pages/StockTransfersPage';
+import { StockPage } from '../pages/StockPage';
+import { ShellPage } from '../pages/ShellPage';
+import type { AdminApi } from '../fixtures/auth';
+
+// Перемещения товаров между складами — подфаза B (docs/features/warehouses/draft-spec.md
+// DS-006/DS-007/DS-010, TS-007 «В пути», TS-008, TS-009, TS-010, TS-014). Общая dev-БД
+// (§TD-6.2): свои товары через uniq()+adminApi, склады — сид «Алматы»/«Москва».
