+    await adminApi.taskEquipmentAction(task.id, eq.id, 'send', moscow.id);
+
+    await page.goto(`/equipment/${eq.id}/history`);
+    const order = page.locator(`[data-testid="history-order"][data-task-id="${task.id}"]`);
+    await expect(order.getByTestId('history-order-location')).toHaveText('В пути: Алматы → Москва');
+  });
+});
