diff --git a/web/ssr/stocktransfers/templates/pages/list.html b/web/ssr/stocktransfers/templates/pages/list.html
new file mode 100644
index 0000000..eacddb3
--- /dev/null
+++ b/web/ssr/stocktransfers/templates/pages/list.html
@@ -0,0 +1,64 @@
+{{ define "content" }}
+<div id="st" class="row g-3" data-testid="st-root">
+  <!-- Список перемещений (master) -->
+  <div class="col-lg-5">
+    <div class="d-flex flex-wrap align-items-center gap-2 mb-3" data-testid="st-filters">
+      <select class="form-select form-select-sm" id="st-filter-status" data-testid="st-filter-status" style="max-width:170px" aria-label="Статус">
+        <option value="">Все статусы</option>
+        <option value="requested">Заявка</option>
+        <option value="in_transit">В пути</option>
+        <option value="received">Принято</option>
+        <option value="cancelled">Отменено</option>
+      </select>
+      <select class="form-select form-select-sm" id="st-filter-warehouse" data-testid="st-filter-warehouse" style="max-width:190px" aria-label="Склад">
+        <option value="">Все склады</option>
+      </select>
+      <button type="button" class="btn btn-primary btn-sm ms-auto" id="st-new" data-testid="st-new">+ Перемещение</button>
+    </div>
+    <div class="list-group" id="st-list" data-testid="st-list"></div>
+    <div class="empty-state d-none" id="st-empty" data-testid="st-empty">Перемещений нет.</div>
+    <p class="text-body-secondary small d-none mt-2" id="st-shown" data-testid="st-shown"></p>
+  </div>
+
+  <!-- Карточка перемещения (detail) -->
+  <div class="col-lg-7">
+    <div class="card" id="st-detail" data-testid="st-detail">
+      <div class="card-body">
+        <div class="text-body-secondary" id="st-placeholder" data-testid="st-placeholder">Выберите перемещение в списке или создайте новое.</div>
+        <div class="d-none" id="st-card"></div>
+      </div>
+    </div>
+    <p class="text-body-secondary small mt-2">При отправке товары списываются со склада-источника и числятся «в пути»; при приёмке — приходуют на склад-получатель по факту, недостача фиксируется в журнале движений как потеря. Отмена отправленного перемещения возвращает товары на источник.</p>
+  </div>
+</div>
+
+<!-- Модалка приёмки по факту (DS-006) -->
+<div class="modal fade" id="st-receive-modal" tabindex="-1" aria-hidden="true" data-testid="st-receive-modal">
+  <div class="modal-dialog modal-lg">
+    <form class="modal-content" id="st-receive-form" novalidate>
+      <div class="modal-header">
+        <h2 class="modal-title fs-5">Приёмка перемещения</h2>
+        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
+      </div>
+      <div class="modal-body">
+        <div class="alert alert-danger d-none" id="st-receive-error" data-testid="st-receive-error"></div>
+        <p class="text-body-secondary small">Укажите фактически полученное количество. Недостача будет списана как потеря при перемещении.</p>
+        <div class="table-responsive">
+          <table class="table align-middle mb-0">
+            <thead><tr><th>Товар</th><th>Отправлено</th><th style="width:160px">Получено *</th></tr></thead>
+            <tbody id="st-receive-tbody"></tbody>
+          </table>
+        </div>
+      </div>
+      <div class="modal-footer">
+        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
+        <button type="submit" class="btn btn-primary" id="st-receive-confirm" data-testid="st-receive-confirm">Принять</button>
+      </div>
+    </form>
+  </div>
+</div>
+{{ end }}
+
+{{ define "scripts" }}
+<script src="/assets/ssr-shared/js/stock-transfers.js"></script>
+{{ end }}
diff --git a/web/ssr/warehouses/templates/pages/form.html b/web/ssr/warehouses/templates/pages/form.html
new file mode 100644
index 0000000..a2eaedc
--- /dev/null
+++ b/web/ssr/warehouses/templates/pages/form.html
@@ -0,0 +1,22 @@
+{{ define "content" }}
+<form class="card mw-760" method="post" action="/warehouses/{{ .ID }}" data-testid="warehouse-form" novalidate>
+  <div class="card-body">
+    <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+    {{ if .Error }}<div class="alert alert-danger py-2" role="alert" data-testid="form-error">{{ .Error }}</div>{{ end }}
+    <div class="mb-3">
+      <label for="name" class="form-label">Название *</label>
+      <input id="name" name="name" class="form-control{{ if index .Errors "name" }} is-invalid{{ end }}" value="{{ .Name }}" maxlength="100" autocomplete="off" data-testid="warehouse-name">
+      {{ with index .Errors "name" }}<div class="invalid-feedback" data-testid="error-name">{{ . }}</div>{{ end }}
+    </div>
+    {{ if not .IsActive }}<p class="text-body-secondary small" data-testid="warehouse-archived-note">Склад в архиве.</p>{{ end }}
+    <div class="d-flex gap-2">
+      <button type="submit" class="btn btn-primary" data-testid="warehouse-save">Сохранить</button>
+      <a href="/warehouses" class="btn btn-outline-secondary">Отмена</a>
+      <button type="submit" form="warehouse-archive-form" class="btn btn-outline-secondary ms-auto" data-testid="warehouse-archive">{{ if .IsActive }}В архив{{ else }}Вернуть{{ end }}</button>
+    </div>
+  </div>
+</form>
+<form id="warehouse-archive-form" method="post" action="/warehouses/{{ .ID }}/{{ if .IsActive }}archive{{ else }}restore{{ end }}" class="d-none" aria-hidden="true">
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+</form>
+{{ end }}
diff --git a/web/ssr/warehouses/templates/pages/list.html b/web/ssr/warehouses/templates/pages/list.html
new file mode 100644
index 0000000..5d5eb7b
--- /dev/null
+++ b/web/ssr/warehouses/templates/pages/list.html
@@ -0,0 +1,46 @@
+{{ define "content" }}
+{{ if .Flash }}<div class="alert alert-success py-2" role="status" data-testid="flash">{{ .Flash }}</div>{{ end }}
+{{ if .Error }}<div class="alert alert-danger py-2" role="alert" data-testid="list-error">{{ .Error }}</div>{{ end }}
+<form class="d-flex flex-wrap align-items-start gap-2 mb-3" method="post" action="/warehouses" data-testid="warehouse-create-form" novalidate>
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+  <div style="min-width:260px">
+    <input class="form-control{{ if .NewError }} is-invalid{{ end }}" name="name" value="{{ .NewName }}" maxlength="100" placeholder="Название нового склада" aria-label="Название склада" autocomplete="off" data-testid="warehouse-new-name">
+    {{ if .NewError }}<div class="invalid-feedback" data-testid="error-name">{{ .NewError }}</div>{{ end }}
+  </div>
+  <button type="submit" class="btn btn-primary" data-testid="warehouse-add">+ Склад</button>
+</form>
+<form class="mb-3" method="get" action="/warehouses">
+  <div class="form-check">
+    <input class="form-check-input" type="checkbox" id="archived" name="archived" value="1"{{ if .Archived }} checked{{ end }} onchange="this.form.submit()" data-testid="filter-archived">
+    <label class="form-check-label" for="archived">Показать архивные</label>
+  </div>
+</form>
+{{ if .Items }}
+<div class="table-responsive">
+<table class="table table-hover align-middle" data-testid="warehouses-table">
+  <thead><tr><th>#</th><th>Название</th><th></th></tr></thead>
+  <tbody>
+  {{ range .Items }}
+    <tr data-testid="warehouse-row" data-name="{{ .Name }}">
+      <td class="text-body-secondary">{{ .Position }}</td>
+      <td>
+        <a href="/warehouses/{{ .ID }}" class="fw-semibold" data-testid="warehouse-edit-link">{{ .Name }}</a>
+        {{ if not .IsActive }}<span class="badge-off" data-testid="warehouse-archived-badge">в архиве</span>{{ end }}
+      </td>
+      <td class="text-end">
+        <form method="post" action="/warehouses/{{ .ID }}/{{ if .IsActive }}archive{{ else }}restore{{ end }}" class="d-inline">
+          <input type="hidden" name="_csrf" value="{{ $.Shell.CSRFToken }}">
+          {{ if $.Archived }}<input type="hidden" name="archived" value="1">{{ end }}
+          <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="warehouse-toggle-active">{{ if .IsActive }}В архив{{ else }}Вернуть{{ end }}</button>
+        </form>
+      </td>
+    </tr>
+  {{ end }}
+  </tbody>
+</table>
+</div>
+{{ else }}
+<div class="empty-state" data-testid="warehouses-empty">Складов нет.</div>
+{{ end }}
+<p class="text-body-secondary small mt-3">Остатки товаров ведутся по каждому складу. Архивный склад не предлагается в новых строках, его остатки сохраняются.</p>
+{{ end }}
