diff --git a/web/ssr/_shared/js/stock-transfers.js b/web/ssr/_shared/js/stock-transfers.js
new file mode 100644
index 0000000..1a11855
--- /dev/null
+++ b/web/ssr/_shared/js/stock-transfers.js
@@ -0,0 +1,508 @@
+/* KT.stockTransfers — экран «Перемещения» «/stock-transfers» (admin, warehouses DS-006/
+   DS-011): master-detail поверх JSON API /api/v1/stock-transfers.
+
+   Слева — список с фильтром по статусу/складу ({items,total,limit,offset}); справа —
+   карточка выбранного перемещения (?id=N в адресе). Заявка (requested) и новое
+   перемещение — редактор: склады, примечание, строки товаров; кнопки «Сохранить заявку» /
+   «Отправить» / «Отменить». В пути (in_transit) — «Принять» (модалка с фактом по строкам,
+   по умолчанию = отправлено) и «Отменить». Принято/отменено — только просмотр.
+   Подтверждение отмены — KT.uiDialog (нативные confirm/prompt не используются).
+   Числа выводятся как пришли в JSON (String()), весь текст — через esc(). */
+(function () {
+  'use strict';
+  var KT = window.KT = window.KT || {};
+
+  function esc(s) {
+    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
+      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+    });
+  }
+  function $(sel, root) { return (root || document).querySelector(sel); }
+  function $$(sel, root) { return [].slice.call((root || document).querySelectorAll(sel)); }
+  function num(v) { return String(v == null ? 0 : v); }
+
+  var STATUS = {
+    requested: { label: 'Заявка', cls: 'text-bg-secondary' },
+    in_transit: { label: 'В пути', cls: 'text-bg-warning' },
+    received: { label: 'Принято', cls: 'text-bg-success' },
+    cancelled: { label: 'Отменено', cls: 'text-bg-light border' }
+  };
+
+  var FIELD_TEXT = {
+    required: 'обязательное поле',
+    invalid: 'недопустимое значение',
+    invalid_format: 'введите число',
+    too_precise: 'не больше 3 знаков после запятой',
+    too_large: 'слишком большое число',
+    too_long: 'слишком длинное значение',
+    invalid_text: 'недопустимые символы',
+    too_many: 'слишком много строк',
+    same_warehouse: 'склад-получатель совпадает с источником',
+    duplicate: 'товар уже есть в другой строке',
+    exceeds_sent: 'больше отправленного'
+  };
+  var FIELD_LABEL = {
+    from_warehouse_id: 'Откуда',
+    to_warehouse_id: 'Куда',
+    note: 'Примечание',
+    items: 'Товары',
+    version: 'Версия'
+  };
+
+  var state = {
+    list: [],
+    total: 0,
+    status: '',
+    warehouseId: '',
+    warehouses: [],
+    products: [],
+    current: null, // TransferResponse | {new: true}
+    warnings: [],
+    busy: false
+  };
+  var receiveModal = null;
+
+  // ---------- загрузка ----------
+  // Активные товары для строк — постранично (API отдаёт не больше 500 за запрос).
+  function loadProducts(offset, acc) {
+    return KT.api.get('/api/v1/products?limit=500&offset=' + offset).then(function (r) {
+      var items = acc.concat(r.items || []);
+      if ((r.items || []).length > 0 && items.length < r.total && items.length < 10000) return loadProducts(items.length, items);
+      return items;
+    });
+  }
+
+  function loadRefs() {
+    return Promise.all([
+      KT.api.get('/api/v1/warehouses'),
+      loadProducts(0, [])
+    ]).then(function (r) {
+      state.warehouses = r[0].items || [];
+      state.products = r[1];
+      var sel = $('#st-filter-warehouse');
+      sel.innerHTML = '<option value="">Все склады</option>' + state.warehouses.map(function (w) {
+        return '<option value="' + esc(w.id) + '">' + esc(w.name) + '</option>';
+      }).join('');
+      if (sel._cbSync) sel._cbSync();
+    });
+  }
+
+  function loadList() {
+    var p = new URLSearchParams();
+    if (state.status) p.set('status', state.status);
+    if (state.warehouseId) p.set('warehouse_id', state.warehouseId);
+    p.set('limit', '500');
+    return KT.api.get('/api/v1/stock-transfers?' + p.toString()).then(function (r) {
+      state.list = r.items || [];
+      state.total = r.total || 0;
+      renderList();
+    });
+  }
+
+  function loadTransfer(id) {
+    return KT.api.get('/api/v1/stock-transfers/' + id).then(function (t) {
+      state.current = t;
+      setUrl(t.id);
+      renderCard();
+      renderList();
+    });
+  }
+
+  function setUrl(id) {
+    var u = new URL(window.location.href);
+    if (id) u.searchParams.set('id', id); else u.searchParams.delete('id');
+    window.history.replaceState(null, '', u.pathname + u.search);
+  }
+
+  // ---------- список ----------
+  function fmtDate(s) {
+    if (!s) return '';
+    var d = new Date(s);
+    return isNaN(d) ? '' : d.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
+  }
+
+  function badge(status) {
+    var s = STATUS[status] || { label: status, cls: 'text-bg-secondary' };
+    return '<span class="badge ' + s.cls + '" data-testid="st-status-badge" data-status="' + esc(status) + '">' + esc(s.label) + '</span>';
+  }
+
+  function renderList() {
+    var box = $('#st-list');
+    var curId = state.current && state.current.id;
+    box.innerHTML = state.list.map(function (t) {
+      return '<button type="button" class="list-group-item list-group-item-action' + (t.id === curId ? ' active' : '') + '"' +
+        ' data-testid="st-row" data-id="' + esc(t.id) + '">' +
+        '<div class="d-flex justify-content-between align-items-center gap-2">' +
+        '<span class="fw-semibold">#' + esc(t.id) + ' · ' + esc(t.from_warehouse_name) + ' → ' + esc(t.to_warehouse_name) + '</span>' +
+        badge(t.status) + '</div>' +
+        '<div class="small' + (t.id === curId ? '' : ' text-body-secondary') + '">' +
+        esc(fmtDate(t.created_at)) + ' · позиций: ' + esc(t.items_count) + (t.note ? ' · ' + esc(t.note) : '') + '</div>' +
+        '</button>';
+    }).join('');
+    $('#st-empty').classList.toggle('d-none', state.list.length > 0);
+    var shown = $('#st-shown');
+    if (state.total > state.list.length) {
+      shown.textContent = 'Показано ' + state.list.length + ' из ' + state.total;
+      shown.classList.remove('d-none');
+    } else {
+      shown.classList.add('d-none');
+    }
+  }
+
+  // ---------- карточка ----------
+  function warehouseOptions(selected, withEmpty) {
+    var list = state.warehouses.slice();
+    if (selected && !list.some(function (w) { return w.id === selected; })) {
+      // склад заявки ушёл в архив — показать его, чтобы не потерять значение
+      var cur = state.current || {};
+      var name = cur.from_warehouse_id === selected ? cur.from_warehouse_name : cur.to_warehouse_name;
+      list.push({ id: selected, name: (name || selected) + ' (архив)' });
+    }
+    return (withEmpty ? '<option value="">— выберите склад —</option>' : '') + list.map(function (w) {
+      return '<option value="' + esc(w.id) + '"' + (w.id === selected ? ' selected' : '') + '>' + esc(w.name) + '</option>';
+    }).join('');
+  }
+
+  function productOptions(selected, fallbackName) {
+    var list = state.products.slice();
+    if (selected && !list.some(function (p) { return p.id === selected; })) {
+      list.push({ id: selected, name: (fallbackName || selected) + ' (архив)', unit: '' });
+    }
+    return '<option value="">— выберите товар —</option>' + list.map(function (p) {
+      return '<option value="' + esc(p.id) + '"' + (p.id === selected ? ' selected' : '') + '>' + esc(p.name) + (p.unit ? ', ' + esc(p.unit) : '') + '</option>';
+    }).join('');
+  }
+
+  function itemRowHTML(it) {
+    it = it || {};
+    return '<tr data-testid="st-item-row">' +
+      '<td><select class="form-select form-select-sm" data-testid="st-item-product" aria-label="Товар">' + productOptions(it.product_id, it.product_name) + '</select></td>' +
+      '<td style="width:140px"><input type="number" step="any" min="0" class="form-control form-control-sm" data-testid="st-item-qty" aria-label="Количество" value="' + esc(it.qty_sent == null ? '' : num(it.qty_sent)) + '"></td>' +
+      '<td style="width:44px" class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-testid="st-item-remove" title="Убрать строку" aria-label="Убрать строку">×</button></td>' +
+      '</tr>';
+  }
+
+  function warningsHTML() {
+    if (!state.warnings.length) return '';
+    return '<div class="alert alert-warning" data-testid="st-warnings"><div class="fw-semibold mb-1">Остатки на складе-источнике:</div><ul class="mb-0">' +
+      state.warnings.map(function (w) {
+        return '<li>' + esc(w.name) + ' (' + esc(w.warehouse_name) + '): ' + esc(num(w.stock)) +
+          (w.kind === 'negative' ? ' — отрицательный остаток' : ' — на минимуме или ниже (' + esc(num(w.min_stock)) + ')') + '</li>';
+      }).join('') + '</ul></div>';
+  }
+
+  function headerHTML(t) {
+    if (t.new) return '<h2 class="fs-5 mb-3" data-testid="st-card-title">Новое перемещение</h2>';
+    var meta = ['Создал: ' + esc(t.created_by_name) + ', ' + esc(fmtDate(t.created_at))];
+    if (t.sent_at) meta.push('Отправил: ' + esc(t.sent_by_name || '') + ', ' + esc(fmtDate(t.sent_at)));
+    if (t.received_at) meta.push('Принял: ' + esc(t.received_by_name || '') + ', ' + esc(fmtDate(t.received_at)));
+    if (t.cancelled_at) meta.push('Отменил: ' + esc(t.cancelled_by_name || '') + ', ' + esc(fmtDate(t.cancelled_at)));
+    return '<div class="d-flex justify-content-between align-items-center mb-2">' +
+      '<h2 class="fs-5 mb-0" data-testid="st-card-title">Перемещение #' + esc(t.id) + '</h2>' +
+      '<span data-testid="st-card-status">' + badge(t.status) + '</span></div>' +
+      '<div class="small text-body-secondary mb-3">' + meta.join('<br>') + '</div>';
+  }
+
+  function renderCard() {
+    var t = state.current;
+    $('#st-placeholder').classList.toggle('d-none', !!t);
+    var card = $('#st-card');
+    card.classList.toggle('d-none', !t);
+    if (!t) { card.innerHTML = ''; return; }
+    var editable = t.new || t.status === 'requested';
+    var html = headerHTML(t) + warningsHTML() +
+      '<div class="alert alert-danger d-none" data-testid="st-error" id="st-error"></div>';
+    if (editable) {
+      html += '<div class="row g-2 mb-2">' +
+        '<div class="col-sm-6"><label class="form-label" for="st-from">Откуда *</label>' +
+        '<select class="form-select" id="st-from" data-testid="st-from">' + warehouseOptions(t.from_warehouse_id, true) + '</select></div>' +
+        '<div class="col-sm-6"><label class="form-label" for="st-to">Куда *</label>' +
+        '<select class="form-select" id="st-to" data-testid="st-to">' + warehouseOptions(t.to_warehouse_id, true) + '</select></div>' +
+        '</div>' +
+        '<div class="mb-3"><label class="form-label" for="st-note">Примечание</label>' +
+        '<textarea class="form-control" id="st-note" data-testid="st-note" rows="2" maxlength="1000">' + esc(t.note || '') + '</textarea></div>' +
+        '<div class="table-responsive"><table class="table table-sm align-middle mb-2" data-testid="st-items">' +
+        '<thead><tr><th>Товар *</th><th>Количество *</th><th></th></tr></thead><tbody id="st-items-tbody">' +
+        ((t.items && t.items.length) ? t.items.map(itemRowHTML).join('') : itemRowHTML()) +
+        '</tbody></table></div>' +
+        '<button type="button" class="btn btn-sm btn-outline-secondary mb-3" data-testid="st-item-add" id="st-item-add">+ Товар</button>' +
+        '<div class="d-flex flex-wrap gap-2">' +
+        '<button type="button" class="btn btn-outline-primary" data-testid="st-save" data-act="save">' + (t.new ? 'Сохранить заявку' : 'Сохранить') + '</button>' +
+        '<button type="button" class="btn btn-primary" data-testid="st-send" data-act="send">Отправить</button>' +
+        (t.new ? '' : '<button type="button" class="btn btn-outline-danger ms-auto" data-testid="st-cancel" data-act="cancel">Отменить перемещение</button>') +
+        '</div>';
+    } else {
+      var showReceived = t.status === 'received';
+      html += '<dl class="row mb-2">' +
+        '<dt class="col-sm-3">Откуда</dt><dd class="col-sm-9" data-testid="st-view-from">' + esc(t.from_warehouse_name) + '</dd>' +
+        '<dt class="col-sm-3">Куда</dt><dd class="col-sm-9" data-testid="st-view-to">' + esc(t.to_warehouse_name) + '</dd>' +
+        (t.note ? '<dt class="col-sm-3">Примечание</dt><dd class="col-sm-9" data-testid="st-view-note">' + esc(t.note) + '</dd>' : '') +
+        '</dl>' +
+        '<div class="table-responsive"><table class="table table-sm align-middle" data-testid="st-items">' +
+        '<thead><tr><th>Товар</th><th>Отправлено</th>' + (showReceived ? '<th>Получено</th>' : '') + '</tr></thead><tbody>' +
+        t.items.map(function (it) {
+          var loss = showReceived && it.qty_received != null && Number(it.qty_received) < Number(it.qty_sent);
+          return '<tr data-testid="st-view-item" data-product-id="' + esc(it.product_id) + '">' +
+            '<td>' + esc(it.product_name) + (it.unit ? ', ' + esc(it.unit) : '') + '</td>' +
