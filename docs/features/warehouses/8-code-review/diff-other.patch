+      state.busy = false;
+      $$('#st-card button').forEach(function (b) { b.disabled = false; });
+    });
+  }
+
+  function save() {
+    var t = state.current;
+    var body = collectForm();
+    if (t.new) return KT.api.post('/api/v1/stock-transfers', body);
+    body.version = t.version;
+    return KT.api.put('/api/v1/stock-transfers/' + t.id, body);
+  }
+
+  function doSave() {
+    return withBusy(save().then(function (t) { return after(t, false); }));
+  }
+
+  function doSend() {
+    var t = state.current;
+    var p;
+    if (t.new) {
+      var body = collectForm();
+      body.send = true;
+      p = KT.api.post('/api/v1/stock-transfers', body);
+    } else {
+      // несохранённые правки заявки уходят вместе с отправкой
+      p = save().then(function (saved) {
+        state.current = saved;
+        return KT.api.post('/api/v1/stock-transfers/' + saved.id + '/send', { version: saved.version });
+      });
+    }
+    return withBusy(p.then(function (r) { return after(r, true); }));
+  }
+
+  function doCancel() {
+    var t = state.current;
+    var text = t.status === 'in_transit'
