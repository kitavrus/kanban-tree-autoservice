diff --git a/e2e/pages/StockTransfersPage.ts b/e2e/pages/StockTransfersPage.ts
new file mode 100644
index 0000000..f36a88b
--- /dev/null
+++ b/e2e/pages/StockTransfersPage.ts
@@ -0,0 +1,102 @@
+import { expect, type Locator, type Page } from '@playwright/test';
+
+// POM экрана «Перемещения» «/stock-transfers» (warehouses DS-006, js/stock-transfers.js).
+// Селекты складов/товаров превращаются js/combobox.js в комбобоксы: testid уходит на
+// видимую кнопку, выбор — клик по кнопке, поиск в `.cb-search` и клик по `.cb-opt` в
+// `combobox-dropdown` (эталон — StockPage/CatalogPage).
+export class StockTransfersPage {
+  readonly root: Locator;
+  readonly list: Locator;
+  readonly filterStatus: Locator;
+  readonly filterWarehouse: Locator;
+  readonly newBtn: Locator;
+  readonly cardTitle: Locator;
+  readonly cardStatus: Locator;
+  readonly from: Locator;
+  readonly to: Locator;
+  readonly note: Locator;
+  readonly itemProducts: Locator;
+  readonly itemQtys: Locator;
+  readonly itemAdd: Locator;
+  readonly save: Locator;
+  readonly send: Locator;
+  readonly cancel: Locator;
+  readonly receive: Locator;
+  readonly error: Locator;
+  readonly warnings: Locator;
+  readonly receiveModal: Locator;
+  readonly receiveQtys: Locator;
+  readonly receiveConfirm: Locator;
+  readonly dropdown: Locator;
+
+  constructor(readonly page: Page) {
+    this.root = page.getByTestId('st-root');
+    this.list = page.getByTestId('st-list');
+    this.filterStatus = page.getByTestId('st-filter-status');
+    this.filterWarehouse = page.getByTestId('st-filter-warehouse');
+    this.newBtn = page.getByTestId('st-new');
+    this.cardTitle = page.getByTestId('st-card-title');
+    this.cardStatus = page.getByTestId('st-card-status').getByTestId('st-status-badge');
+    this.from = page.getByTestId('st-from');
+    this.to = page.getByTestId('st-to');
+    this.note = page.getByTestId('st-note');
+    this.itemProducts = page.getByTestId('st-item-product');
+    this.itemQtys = page.getByTestId('st-item-qty');
+    this.itemAdd = page.getByTestId('st-item-add');
+    this.save = page.getByTestId('st-save');
+    this.send = page.getByTestId('st-send');
+    this.cancel = page.getByTestId('st-cancel');
+    this.receive = page.getByTestId('st-receive');
+    this.error = page.getByTestId('st-error');
+    this.warnings = page.getByTestId('st-warnings');
+    this.receiveModal = page.getByTestId('st-receive-modal');
+    this.receiveQtys = page.getByTestId('st-receive-qty');
+    this.receiveConfirm = page.getByTestId('st-receive-confirm');
+    this.dropdown = page.getByTestId('combobox-dropdown');
+  }
+
+  async goto(id?: number) {
+    await this.page.goto(id ? `/stock-transfers?id=${id}` : '/stock-transfers');
+    await expect(this.root).toBeVisible();
+    if (id) await expect(this.cardTitle).toHaveText(`Перемещение #${id}`);
+  }
+
+  row(id: number): Locator {
+    return this.list.locator(`[data-testid="st-row"][data-id="${id}"]`);
+  }
+
+  async choose(button: Locator, label: string) {
+    await button.click();
+    await expect(this.dropdown).toBeVisible();
+    await this.dropdown.locator('.cb-search').fill(label);
+    await this.dropdown.locator('.cb-opt', { hasText: label }).first().click();
+  }
+
+  async chooseStatusFilter(label: string) {
+    await this.filterStatus.click();
+    await expect(this.dropdown).toBeVisible();
+    await this.dropdown.locator('.cb-opt', { hasText: label }).first().click();
+  }
+
+  /** Строка товара редактора: товар + количество. */
+  async setItem(index: number, productName: string, qty: number | string) {
+    await this.choose(this.itemProducts.nth(index), productName);
+    await this.itemQtys.nth(index).fill(String(qty));
+  }
+
+  viewItem(productId: string): Locator {
+    return this.page.locator(`[data-testid="st-view-item"][data-product-id="${productId}"]`);
+  }
+
+  receiveQty(productId: string): Locator {
+    return this.page.locator(`[data-testid="st-receive-row"][data-product-id="${productId}"]`).getByTestId('st-receive-qty');
+  }
+
+  /** Номер перемещения из заголовка карточки «Перемещение #N». */
+  async currentId(): Promise<number> {
+    const text = (await this.cardTitle.textContent()) ?? '';
+    const m = /#(\d+)/.exec(text);
+    expect(m, `номер в заголовке «${text}»`).toBeTruthy();
+    return Number(m![1]);
+  }
+}
diff --git a/e2e/tests/equipment-warehouses.spec.ts b/e2e/tests/equipment-warehouses.spec.ts
new file mode 100644
index 0000000..b1b0b5e
--- /dev/null
+++ b/e2e/tests/equipment-warehouses.spec.ts
@@ -0,0 +1,231 @@
+import { test, expect, columnByName } from '../fixtures/board';
+import { BoardPage } from '../pages/BoardPage';
+import { OrderCardPage } from '../pages/OrderCardPage';
+import type { AdminApi } from '../fixtures/auth';
+
+// Склад и перемещения оборудования заказа — warehouses подфаза C (docs/features/warehouses/
+// draft-spec.md DS-005/DS-008/DS-009, TS-006, TS-011…TS-014; D55–D59). Общая dev-БД
+// (§TD-6.2): свои клиенты/оборудование/заказы через uniq()+adminApi, заказы удаляет
+// _boardCleanup (журнал перемещений уходит каскадом).
+test.use({ colorScheme: 'light' });
+
+async function setup(adminApi: AdminApi, uniq: (s: string) => string, tag: string, equipmentCount = 1) {
+  const almaty = await adminApi.warehouseByName('Алматы');
+  const moscow = await adminApi.warehouseByName('Москва');
+  const client = await adminApi.createClient({ company_name: uniq(`${tag} клиент`), phones: [{ phone: '9990000301', note: '' }] });
+  const type = await adminApi.createEquipmentType({ name: uniq(`${tag} тип`) });
+  const equipment = [];
+  for (let i = 0; i < equipmentCount; i++) {
+    equipment.push(await adminApi.createEquipment(client.id, { type_id: type.id, model: uniq(`${tag} модель ${i}`), brand: `Brand${tag}`, serial: `SN-${tag}-${i}` }));
+  }
+  const columns = (await adminApi.listColumns()).items;
+  return { almaty, moscow, client, equipment, columns };
+}
+
+test.describe('EW: склад оборудования заказа', () => {
+  test('EW-001 (TS-011): склад приёма → «На складе: Москва»; отправить на Алматы → «В пути»; принять; история из 3 записей', async ({
+    adminPage: page,
+    adminApi,
+    uniq,
+  }) => {
+    const { almaty, moscow, client, equipment, columns } = await setup(adminApi, uniq, 'EW001');
+    const eq = equipment[0];
+    const task = await adminApi.createTask({ title: uniq('EW-001 заказ'), client_id: client.id, column_id: columnByName(columns, 'Новые').id });
+
+    const board = new BoardPage(page);
+    const card = new OrderCardPage(page);
+    await board.goto(`?client_id=${client.id}`);
+    await board.openTaskEdit(task.id);
+    await card.waitOpen();
+
+    await card.chooseCombobox(card.equipmentWarehouse, 'Москва');
+    await card.chooseCombobox(card.equipmentAdd, 'BrandEW001');
+    await expect(card.equipmentRows).toHaveCount(1);
+    await expect(card.equipmentLocation(eq.id)).toHaveText('На складе: Москва');
+    await expect(card.equipmentMovements(eq.id)).toHaveCount(1);
+    await expect(card.equipmentMovements(eq.id).first()).toContainText('Принято на склад Москва');
+    await expect(card.equipmentReceive(eq.id)).toHaveCount(0);
+
+    // модалка выбора склада: текущий склад не предлагается.
+    await card.equipmentSend(eq.id).click();
+    const dialog = page.getByTestId('ui-dialog');
+    await expect(dialog).toBeVisible();
+    const options = await dialog.getByTestId('ui-dialog-select').locator('option').allTextContents();
+    expect(options).toContain('Алматы');
+    expect(options).not.toContain('Москва');
+    await dialog.getByTestId('ui-dialog-select').selectOption({ label: 'Алматы' });
+    await dialog.getByTestId('ui-dialog-ok').click();
+
+    await expect(card.equipmentLocation(eq.id)).toHaveText('В пути: Москва → Алматы');
+    await expect(card.equipmentSend(eq.id)).toHaveCount(0);
+    await expect(card.equipmentMovements(eq.id)).toHaveCount(2);
+
+    await card.equipmentReceive(eq.id).click();
+    await expect(card.equipmentLocation(eq.id)).toHaveText('На складе: Алматы');
+    await expect(card.equipmentMovements(eq.id)).toHaveCount(3);
+    await expect(card.equipmentMovements(eq.id).nth(2)).toContainText('Принято на складе Алматы (из Москва)');
+    expect(await card.equipmentMovements(eq.id).evaluateAll((els) => els.map((e) => e.getAttribute('data-action')))).toEqual([
+      'received',
+      'sent',
+      'arrived',
+    ]);
+
+    const data = await adminApi.getCard(task.id);
+    const row = data.equipment.find((e) => e.equipment_id === eq.id)!;
+    expect(row.status).toBe('at_warehouse');
+    expect(row.warehouse_id).toBe(almaty.id);
+    expect(row.movements.map((m) => m.action)).toEqual(['received', 'sent', 'arrived']);
+    expect(row.movements[1].from_warehouse_id).toBe(moscow.id);
+  });
+
+  test('EW-002 (TS-012): «Отменить отправку» → обратно на исходный склад; устаревшая карточка — «Принять» → 409 с понятным текстом', async ({
+    adminPage: page,
+    adminApi,
+    uniq,
+    allowHttpErrors,
+  }) => {
+    allowHttpErrors((url, status) => url.includes('/equipment/') && url.endsWith('/receive') && status === 409);
+    const { almaty, moscow, client, equipment, columns } = await setup(adminApi, uniq, 'EW002', 2);
+    const [eqCancel, eqStale] = equipment;
+    const task = await adminApi.createTask({ title: uniq('EW-002 заказ'), client_id: client.id, column_id: columnByName(columns, 'Новые').id });
+    await adminApi.addTaskEquipment(task.id, eqCancel.id, almaty.id);
+    await adminApi.addTaskEquipment(task.id, eqStale.id, almaty.id);
+    await adminApi.taskEquipmentAction(task.id, eqCancel.id, 'send', moscow.id);
+    await adminApi.taskEquipmentAction(task.id, eqStale.id, 'send', moscow.id);
+
+    const board = new BoardPage(page);
+    const card = new OrderCardPage(page);
+    await board.goto(`?client_id=${client.id}`);
+    await board.openTaskEdit(task.id);
+    await card.waitOpen();
+    await expect(card.equipmentLocation(eqCancel.id)).toHaveText('В пути: Алматы → Москва');
+
+    // отмена — через подтверждение KT.uiDialog.
+    await card.equipmentCancelTransit(eqCancel.id).click();
+    await card.confirmUiDialog();
+    await expect(card.equipmentLocation(eqCancel.id)).toHaveText('На складе: Алматы');
+    await expect(card.equipmentMovements(eqCancel.id).nth(2)).toContainText('отменена, возврат на Алматы');
+
+    // единицу уже принял кто-то другой (API) — кнопка в открытой карточке устарела → 409.
+    await adminApi.taskEquipmentAction(task.id, eqStale.id, 'receive');
+    await card.equipmentReceive(eqStale.id).click();
+    const dialog = page.getByTestId('ui-dialog');
+    await expect(dialog).toBeVisible();
+    await expect(dialog.getByTestId('ui-dialog-text')).toContainText('не в пути');
+    await dialog.getByTestId('ui-dialog-ok').click();
+
+    const data = await adminApi.getCard(task.id);
+    expect(data.equipment.find((e) => e.equipment_id === eqCancel.id)!.movements.map((m) => m.action)).toEqual(['received', 'sent', 'cancelled']);
+    expect(data.equipment.find((e) => e.equipment_id === eqStale.id)!.movements.filter((m) => m.action === 'arrived')).toHaveLength(1);
+  });
+
+  test('EW-003 (TS-006): склад по умолчанию строки товара — склад оборудования услуги', async ({ adminPage: page, adminApi, uniq }) => {
+    const { moscow, client, equipment, columns } = await setup(adminApi, uniq, 'EW003');
+    const eq = equipment[0];
+    const prodCat = await adminApi.createCategory({ kind: 'product', name: uniq('EW-003 категория товаров') });
+    const svcCat = await adminApi.createCategory({ kind: 'service', name: uniq('EW-003 категория услуг') });
+    const product = await adminApi.createProduct({ category_id: prodCat.id, name: uniq('EW-003 товар'), stock: 5, min_stock: 0 });
+    const service = await adminApi.createService({ category_id: svcCat.id, name: uniq('EW-003 услуга'), price: null, products: [] });
+    const task = await adminApi.createTask({ title: uniq('EW-003 заказ'), client_id: client.id, column_id: columnByName(columns, 'Новые').id });
+    await adminApi.addTaskEquipment(task.id, eq.id, moscow.id);
+    const created = await adminApi.createSubtask(task.id, service.id);
+    const subtaskId = created.card.subtasks[0].id;
+    await adminApi.updateSubtask(subtaskId, { status: 'new', equipment_id: eq.id });
+    const withProduct = await adminApi.createSubtaskProduct(subtaskId, { product_id: product.id, qty: 1 });
+    const productRowId = withProduct.card.subtasks[0].products[0].id;
+    expect(withProduct.card.subtasks[0].products[0].warehouse_id).toBe(moscow.id);
+
+    const board = new BoardPage(page);
+    const card = new OrderCardPage(page);
+    await board.goto(`?client_id=${client.id}`);
+    await board.openTaskEdit(task.id);
+    await card.waitOpen();
+    await expect(card.productWarehouse(productRowId)).toContainText('Москва');
+  });
+
+  test('EW-004 (TS-013): доска — фильтр «Склад» (на складе/едет на склад) и бейдж «в пути»; фильтр в URL переживает reload', async ({
+    adminPage: page,
+    adminApi,
+    uniq,
+  }) => {
+    const { almaty, moscow, client, equipment, columns } = await setup(adminApi, uniq, 'EW004', 3);
+    const col = columnByName(columns, 'Новые').id;
+    const atMoscow = await adminApi.createTask({ title: uniq('EW-004 в Москве'), client_id: client.id, column_id: col });
+    const toMoscow = await adminApi.createTask({ title: uniq('EW-004 едет в Москву'), client_id: client.id, column_id: col });
+    const atAlmaty = await adminApi.createTask({ title: uniq('EW-004 в Алматы'), client_id: client.id, column_id: col });
+    await adminApi.addTaskEquipment(atMoscow.id, equipment[0].id, moscow.id);
+    await adminApi.addTaskEquipment(toMoscow.id, equipment[1].id, almaty.id);
+    await adminApi.taskEquipmentAction(toMoscow.id, equipment[1].id, 'send', moscow.id);
+    await adminApi.addTaskEquipment(atAlmaty.id, equipment[2].id, almaty.id);
+
+    const board = new BoardPage(page);
+    await board.goto(`?client_id=${client.id}`);
+    await expect(board.card(atAlmaty.id)).toBeVisible();
+    await expect(board.inTransitBadge(toMoscow.id)).toBeVisible();
+    await expect(board.inTransitBadge(atMoscow.id)).toHaveCount(0);
+
+    await board.chooseCombobox(board.filterWarehouse, 'Москва');
+    await expect(page).toHaveURL(new RegExp(`warehouse_id=${moscow.id}`));
+    await expect(board.card(atMoscow.id)).toBeVisible();
+    await expect(board.card(toMoscow.id)).toBeVisible();
+    await expect(board.card(atAlmaty.id)).toHaveCount(0);
+
+    await page.reload();
+    await expect(board.card(toMoscow.id)).toBeVisible();
+    await expect(board.card(atAlmaty.id)).toHaveCount(0);
+    await expect(board.filterWarehouse).toContainText('Москва');
+
+    await board.chooseCombobox(board.filterWarehouse, 'Алматы');
+    await expect(board.card(atAlmaty.id)).toBeVisible();
+    await expect(board.card(toMoscow.id)).toHaveCount(0);
+
+    await board.filterReset.click();
+    await expect(page).not.toHaveURL(/warehouse_id=/);
+    await expect(board.card(atMoscow.id)).toBeVisible();
+    await expect(board.card(atAlmaty.id)).toBeVisible();
+  });
+
+  test('EW-005 (TS-014): executor отправляет и принимает оборудование своего заказа', async ({
+    page,
+    adminApi,
+    uniq,
+    makeUser,
+    loginAs,
+  }) => {
+    const { almaty, client, equipment, columns } = await setup(adminApi, uniq, 'EW005');
+    const eq = equipment[0];
+    const exec = await makeUser({ login: uniq('ew005-exec'), name: uniq('EW-005 Исполнитель') });
+    const task = await adminApi.createTask({
+      title: uniq('EW-005 заказ'),
+      client_id: client.id,
+      column_id: columnByName(columns, 'Новые').id,
+      assignee_id: exec.id,
+    });
+    await adminApi.addTaskEquipment(task.id, eq.id, almaty.id);
+
+    await loginAs(page, exec.login, exec.password);
+    const board = new BoardPage(page);
+    const card = new OrderCardPage(page);
+    await board.goto(`?client_id=${client.id}`);
+    await board.openTaskEdit(task.id);
+    await card.waitOpen();
+
+    await card.sendEquipment(eq.id, 'Москва');
+    await expect(card.equipmentLocation(eq.id)).toHaveText('В пути: Алматы → Москва');
+    await card.equipmentReceive(eq.id).click();
+    await expect(card.equipmentLocation(eq.id)).toHaveText('На складе: Москва');
+    await expect(card.equipmentMovements(eq.id).nth(2)).toContainText(exec.name);
+  });
+
+  test('EW-006: история оборудования — склад единицы в каждом заказе', async ({ adminPage: page, adminApi, uniq }) => {
+    const { almaty, moscow, client, equipment, columns } = await setup(adminApi, uniq, 'EW006');
+    const eq = equipment[0];
+    const task = await adminApi.createTask({ title: uniq('EW-006 заказ'), client_id: client.id, column_id: columnByName(columns, 'Новые').id });
