+
+  function fieldMessage(f) {
+    var text = FIELD_TEXT[f.message] || f.message;
+    var m = /^items\[(\d+)\]\.(\w+)$/.exec(f.name);
+    if (m) return 'Строка ' + (Number(m[1]) + 1) + ': ' + text;
+    return (FIELD_LABEL[f.name] || f.name) + ': ' + text;
+  }
+
+  function markFields(fields) {
+    $$('#st-card .is-invalid').forEach(function (n) { n.classList.remove('is-invalid'); });
+    var rows = $$('#st-items-tbody tr');
+    fields.forEach(function (f) {
+      var target = null;
+      var m = /^items\[(\d+)\]\.(\w+)$/.exec(f.name);
+      if (m && rows[Number(m[1])]) {
+        target = m[2] === 'qty_sent' ? $('input', rows[Number(m[1])]) : $('select', rows[Number(m[1])]);
+      } else if (f.name === 'from_warehouse_id') target = $('#st-from');
+      else if (f.name === 'to_warehouse_id') target = $('#st-to');
+      else if (f.name === 'note') target = $('#st-note');
+      if (target) target.classList.add('is-invalid');
+    });
+  }
+
+  function handleError(err) {
+    if (err && err.fields && err.fields.length) {
+      markFields(err.fields);
+      showError(err.fields.map(fieldMessage).join('; '));
+      return;
+    }
+    showError((err && err.message) || 'Не удалось выполнить действие');
+    if (err && err.status === 409 && state.current && !state.current.new) {
+      // перемещение изменилось или уже в другом статусе — показать актуальное состояние
+      var msg = err.message;
+      var id = state.current.id;
+      Promise.all([loadList(), loadTransfer(id)]).then(function () { showError(msg); });
+    }
+  }
+
+  function collectForm() {
+    var items = $$('#st-items-tbody tr').map(function (tr) {
+      var raw = $('input', tr).value.trim();
+      var n = Number(raw);
+      return { product_id: $('select', tr).value, qty_sent: raw === '' || Number.isNaN(n) ? null : n };
+    });
+    return {
+      from_warehouse_id: $('#st-from').value,
+      to_warehouse_id: $('#st-to').value,
+      note: $('#st-note').value,
+      items: items
+    };
+  }
+
+  function after(t, keepWarnings) {
+    state.warnings = keepWarnings && t.warnings ? t.warnings : [];
+    state.current = t;
+    setUrl(t.id);
+    renderCard();
+    if (KT.refreshNavBadge) KT.refreshNavBadge();
+    return loadList();
+  }
+
+  function withBusy(p) {
+    state.busy = true;
