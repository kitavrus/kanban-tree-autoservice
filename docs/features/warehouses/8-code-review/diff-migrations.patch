diff --git a/migrations/0008_warehouses.down.sql b/migrations/0008_warehouses.down.sql
new file mode 100644
index 0000000..29bac69
--- /dev/null
+++ b/migrations/0008_warehouses.down.sql
@@ -0,0 +1,43 @@
+-- Откат складов (TS-001): остаток товара = сумма по складам, минимум/коробка/место — со
+-- склада «Алматы» (иначе первого по position); task_stock схлопывается суммой по товару.
+
+ALTER TABLE stock_movements DROP CONSTRAINT stock_movements_reason_check;
+DELETE FROM stock_movements WHERE reason NOT IN ('task_consume', 'task_return', 'manual');
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_reason_check
+    CHECK (reason IN ('task_consume', 'task_return', 'manual'));
+DROP INDEX IF EXISTS stock_movements_warehouse_id_idx;
+ALTER TABLE stock_movements DROP COLUMN transfer_id, DROP COLUMN warehouse_id;
+
+CREATE TEMP TABLE task_stock_rollup AS
+SELECT task_id, product_id, sum(qty) AS qty FROM task_stock GROUP BY task_id, product_id;
+DELETE FROM task_stock;
+ALTER TABLE task_stock DROP CONSTRAINT task_stock_pkey;
+ALTER TABLE task_stock DROP COLUMN warehouse_id;
+ALTER TABLE task_stock ADD PRIMARY KEY (task_id, product_id);
+INSERT INTO task_stock (task_id, product_id, qty) SELECT task_id, product_id, qty FROM task_stock_rollup;
+DROP TABLE task_stock_rollup;
+
+DROP INDEX IF EXISTS subtask_products_warehouse_id_idx;
+ALTER TABLE subtask_products DROP COLUMN warehouse_id;
+
+ALTER TABLE products
+    ADD COLUMN stock     numeric(12,3) NOT NULL DEFAULT 0,
+    ADD COLUMN min_stock numeric(12,3) NOT NULL DEFAULT 0 CHECK (min_stock >= 0),
+    ADD COLUMN box       text NOT NULL DEFAULT '',
+    ADD COLUMN place     text NOT NULL DEFAULT '';
+
+UPDATE products p SET stock = s.total
+FROM (SELECT product_id, sum(stock) AS total FROM product_stock GROUP BY product_id) s
+WHERE s.product_id = p.id;
+
+UPDATE products p SET min_stock = x.min_stock, box = x.box, place = x.place
+FROM (
+    SELECT DISTINCT ON (ps.product_id) ps.product_id, ps.min_stock, ps.box, ps.place
+    FROM product_stock ps JOIN warehouses w ON w.id = ps.warehouse_id
+    ORDER BY ps.product_id, (w.name = 'Алматы') DESC, w.position, w.id
+) x
+WHERE x.product_id = p.id;
+
+DROP TABLE product_stock;
+DROP FUNCTION default_warehouse_id();
+DROP TABLE warehouses;
diff --git a/migrations/0008_warehouses.up.sql b/migrations/0008_warehouses.up.sql
new file mode 100644
index 0000000..a45f0ab
--- /dev/null
+++ b/migrations/0008_warehouses.up.sql
@@ -0,0 +1,72 @@
+-- Склады (D45–D49, docs/features/warehouses/draft-spec.md): подфаза A — справочник складов,
+-- остатки по складам (product_stock), склад строки товара услуги, stock_movements.warehouse_id.
+-- Существующие остатки/строки/движения → склад «Алматы».
+
+-- DS-001: справочник складов. Уникальность имени без регистра/крайних пробелов, архивные
+-- включены (ADR-007, как equipment_types).
+CREATE TABLE warehouses (
+    id         uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    name       text NOT NULL CHECK (btrim(name) <> '' AND char_length(name) <= 100),
+    position   int NOT NULL CHECK (position >= 1),
+    is_active  boolean NOT NULL DEFAULT true,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    updated_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE UNIQUE INDEX warehouses_name_lower_uq ON warehouses (lower(btrim(name)));
+
+INSERT INTO warehouses (name, position) VALUES ('Алматы', 1), ('Москва', 2);
+
+-- D49: склад по умолчанию = первый активный по position (DS-005). DEFAULT колонок
+-- subtask_products/stock_movements.warehouse_id — для вставок без явного склада (сид,
+-- служебные скрипты); код приложения склад передаёт явно.
+CREATE FUNCTION default_warehouse_id() RETURNS uuid
+    LANGUAGE sql STABLE
+    AS $$ SELECT id FROM warehouses WHERE is_active ORDER BY position, id LIMIT 1 $$;
+
+-- DS-002: остаток по паре товар×склад. Отсутствующая строка = 0 остаток / 0 минимум.
+CREATE TABLE product_stock (
+    product_id   uuid NOT NULL REFERENCES products(id) ON DELETE CASCADE,
+    warehouse_id uuid NOT NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    stock        numeric(12,3) NOT NULL DEFAULT 0,
+    min_stock    numeric(12,3) NOT NULL DEFAULT 0 CHECK (min_stock >= 0),
+    box          text NOT NULL DEFAULT '',
+    place        text NOT NULL DEFAULT '',
+    PRIMARY KEY (product_id, warehouse_id)
+);
+CREATE INDEX product_stock_warehouse_id_idx ON product_stock (warehouse_id);
+
+INSERT INTO product_stock (product_id, warehouse_id, stock, min_stock, box, place)
+SELECT p.id, w.id, p.stock, p.min_stock, p.box, p.place
+FROM products p CROSS JOIN (SELECT id FROM warehouses WHERE name = 'Алматы') w;
+
+ALTER TABLE products
+    DROP COLUMN stock,
+    DROP COLUMN min_stock,
+    DROP COLUMN box,
+    DROP COLUMN place;
+
+-- DS-005: склад строки товара услуги заказа + task_stock по паре товар×склад.
+ALTER TABLE subtask_products ADD COLUMN warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT;
+UPDATE subtask_products SET warehouse_id = (SELECT id FROM warehouses WHERE name = 'Алматы');
+ALTER TABLE subtask_products ALTER COLUMN warehouse_id SET NOT NULL;
+ALTER TABLE subtask_products ALTER COLUMN warehouse_id SET DEFAULT default_warehouse_id();
+CREATE INDEX subtask_products_warehouse_id_idx ON subtask_products (warehouse_id);
+
+ALTER TABLE task_stock ADD COLUMN warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT;
+UPDATE task_stock SET warehouse_id = (SELECT id FROM warehouses WHERE name = 'Алматы');
+ALTER TABLE task_stock ALTER COLUMN warehouse_id SET NOT NULL;
+ALTER TABLE task_stock DROP CONSTRAINT task_stock_pkey;
+ALTER TABLE task_stock ADD PRIMARY KEY (task_id, product_id, warehouse_id);
+
+-- DS-007: склад движения + ссылка на перемещение (таблица stock_transfers — подфаза B,
+-- FK добавится там), расширенный набор reason.
+ALTER TABLE stock_movements ADD COLUMN warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT;
+UPDATE stock_movements SET warehouse_id = (SELECT id FROM warehouses WHERE name = 'Алматы');
+ALTER TABLE stock_movements ALTER COLUMN warehouse_id SET NOT NULL;
+ALTER TABLE stock_movements ALTER COLUMN warehouse_id SET DEFAULT default_warehouse_id();
+ALTER TABLE stock_movements ADD COLUMN transfer_id bigint NULL;
+CREATE INDEX stock_movements_warehouse_id_idx ON stock_movements (warehouse_id);
+ALTER TABLE stock_movements DROP CONSTRAINT stock_movements_reason_check;
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_reason_check CHECK (reason IN (
+    'task_consume', 'task_return', 'manual',
+    'transfer_out', 'transfer_in', 'transfer_loss', 'transfer_return'));
diff --git a/migrations/0009_stock_transfers.down.sql b/migrations/0009_stock_transfers.down.sql
new file mode 100644
index 0000000..8a67644
--- /dev/null
+++ b/migrations/0009_stock_transfers.down.sql
@@ -0,0 +1,7 @@
+-- Откат перемещений товаров: движения transfer_* остаются в журнале (transfer_id обнуляется —
+-- без таблицы ссылка теряет смысл), таблицы перемещений удаляются.
+DROP INDEX IF EXISTS stock_movements_transfer_id_idx;
+ALTER TABLE stock_movements DROP CONSTRAINT IF EXISTS stock_movements_transfer_id_fkey;
+UPDATE stock_movements SET transfer_id = NULL WHERE transfer_id IS NOT NULL;
+DROP TABLE stock_transfer_items;
+DROP TABLE stock_transfers;
diff --git a/migrations/0009_stock_transfers.up.sql b/migrations/0009_stock_transfers.up.sql
new file mode 100644
index 0000000..4f5ef12
--- /dev/null
+++ b/migrations/0009_stock_transfers.up.sql
@@ -0,0 +1,41 @@
+-- Перемещения товаров между складами (подфаза B, docs/features/warehouses/draft-spec.md
+-- DS-006/DS-007, D50–D55). Номер перемещения — сквозной bigserial (#N).
+
+CREATE TABLE stock_transfers (
+    id                bigserial PRIMARY KEY,
+    from_warehouse_id uuid NOT NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    to_warehouse_id   uuid NOT NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    status            text NOT NULL DEFAULT 'requested'
+                      CHECK (status IN ('requested', 'in_transit', 'received', 'cancelled')),
+    note              text NOT NULL DEFAULT '' CHECK (char_length(note) <= 1000),
+    created_by        uuid NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
+    sent_by           uuid NULL REFERENCES users(id) ON DELETE RESTRICT,
+    sent_at           timestamptz NULL,
+    received_by       uuid NULL REFERENCES users(id) ON DELETE RESTRICT,
+    received_at       timestamptz NULL,
+    cancelled_by      uuid NULL REFERENCES users(id) ON DELETE RESTRICT,
+    cancelled_at      timestamptz NULL,
+    created_at        timestamptz NOT NULL DEFAULT now(),
+    updated_at        timestamptz NOT NULL DEFAULT now(),
+    version           int NOT NULL DEFAULT 1,
+    CONSTRAINT stock_transfers_distinct_warehouses CHECK (from_warehouse_id <> to_warehouse_id)
+);
+CREATE INDEX stock_transfers_status_idx ON stock_transfers (status);
+CREATE INDEX stock_transfers_from_warehouse_id_idx ON stock_transfers (from_warehouse_id);
+CREATE INDEX stock_transfers_to_warehouse_id_idx ON stock_transfers (to_warehouse_id);
+
+CREATE TABLE stock_transfer_items (
+    id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    transfer_id  bigint NOT NULL REFERENCES stock_transfers(id) ON DELETE CASCADE,
+    product_id   uuid NOT NULL REFERENCES products(id) ON DELETE RESTRICT,
+    position     int NOT NULL,
+    qty_sent     numeric(12,3) NOT NULL CHECK (qty_sent > 0),
+    qty_received numeric(12,3) NULL CHECK (qty_received >= 0 AND qty_received <= qty_sent),
+    UNIQUE (transfer_id, product_id)
+);
+CREATE INDEX stock_transfer_items_product_id_idx ON stock_transfer_items (product_id);
+
+-- DS-007: ссылка движения на перемещение (колонка добавлена в 0008).
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_transfer_id_fkey
+    FOREIGN KEY (transfer_id) REFERENCES stock_transfers(id) ON DELETE SET NULL;
+CREATE INDEX stock_movements_transfer_id_idx ON stock_movements (transfer_id);
diff --git a/migrations/0010_task_equipment_warehouses.down.sql b/migrations/0010_task_equipment_warehouses.down.sql
new file mode 100644
index 0000000..b10fc18
--- /dev/null
+++ b/migrations/0010_task_equipment_warehouses.down.sql
@@ -0,0 +1,12 @@
+-- Откат склада оборудования заказа: журнал перемещений удаляется, колонки склада/статуса
+-- снимаются (единицы «в пути» теряют маршрут — как и все прочие, склад больше не хранится).
+DROP TABLE task_equipment_movements;
+DROP INDEX IF EXISTS task_equipment_transit_to_warehouse_id_idx;
+DROP INDEX IF EXISTS task_equipment_warehouse_id_idx;
+ALTER TABLE task_equipment
+    DROP CONSTRAINT IF EXISTS task_equipment_location_check,
+    DROP CONSTRAINT IF EXISTS task_equipment_status_check,
+    DROP COLUMN transit_to_warehouse_id,
+    DROP COLUMN transit_from_warehouse_id,
+    DROP COLUMN status,
+    DROP COLUMN warehouse_id;
diff --git a/migrations/0010_task_equipment_warehouses.up.sql b/migrations/0010_task_equipment_warehouses.up.sql
new file mode 100644
index 0000000..7f644c4
--- /dev/null
+++ b/migrations/0010_task_equipment_warehouses.up.sql
@@ -0,0 +1,43 @@
+-- Склад и перемещения оборудования заказа (подфаза C, docs/features/warehouses/draft-spec.md
+-- DS-008, D55–D57). Текущий склад единицы — warehouse_id (NULL только «в пути»); маршрут
+-- в пути — transit_from_warehouse_id → transit_to_warehouse_id (from нужен для отмены).
+
+ALTER TABLE task_equipment
+    ADD COLUMN warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    ADD COLUMN status text NOT NULL DEFAULT 'at_warehouse',
+    ADD COLUMN transit_from_warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    ADD COLUMN transit_to_warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT;
+
+-- Существующие строки → «Алматы» / at_warehouse (как остатки в 0008).
+UPDATE task_equipment SET warehouse_id = (SELECT id FROM warehouses WHERE name = 'Алматы');
+
+-- DEFAULT — для вставок без явного склада (сид, служебные скрипты, D49); код приложения
+-- склад передаёт явно.
+ALTER TABLE task_equipment ALTER COLUMN warehouse_id SET DEFAULT default_warehouse_id();
+
+ALTER TABLE task_equipment ADD CONSTRAINT task_equipment_status_check
+    CHECK (status IN ('at_warehouse', 'in_transit'));
+ALTER TABLE task_equipment ADD CONSTRAINT task_equipment_location_check CHECK (
+    (status = 'at_warehouse' AND warehouse_id IS NOT NULL
+        AND transit_from_warehouse_id IS NULL AND transit_to_warehouse_id IS NULL)
+ OR (status = 'in_transit' AND warehouse_id IS NULL
+        AND transit_from_warehouse_id IS NOT NULL AND transit_to_warehouse_id IS NOT NULL
+        AND transit_from_warehouse_id <> transit_to_warehouse_id));
+
+CREATE INDEX task_equipment_warehouse_id_idx ON task_equipment (warehouse_id);
+CREATE INDEX task_equipment_transit_to_warehouse_id_idx ON task_equipment (transit_to_warehouse_id);
+
+-- Журнал перемещений единицы в рамках заказа. Строка переживает удаление единицы из
+-- заказа (журнал), удаляется вместе с заказом/единицей оборудования.
+CREATE TABLE task_equipment_movements (
+    id                bigserial PRIMARY KEY,
+    task_id           bigint NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
+    equipment_id      uuid NOT NULL REFERENCES equipment(id) ON DELETE CASCADE,
+    action            text NOT NULL CHECK (action IN ('received', 'sent', 'arrived', 'cancelled')),
+    from_warehouse_id uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    to_warehouse_id   uuid NULL REFERENCES warehouses(id) ON DELETE RESTRICT,
+    user_id           uuid NOT NULL REFERENCES users(id) ON DELETE RESTRICT, -- ADR-007: пользователи не удаляются
+    created_at        timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX task_equipment_movements_task_equipment_idx ON task_equipment_movements (task_id, equipment_id, id);
+CREATE INDEX task_equipment_movements_equipment_id_idx ON task_equipment_movements (equipment_id);
