diff --git a/migrations/0020_soft_delete_board_columns.down.sql b/migrations/0020_soft_delete_board_columns.down.sql
new file mode 100644
index 0000000..c0886a9
--- /dev/null
+++ b/migrations/0020_soft_delete_board_columns.down.sql
@@ -0,0 +1,15 @@
+-- Откат части soft-delete-board-columns: отметки удаления колонок стираются — мягко удалённые
+-- колонки снова становятся действующими и встают в конец доски (позиции действующих идут
+-- подряд 1..N, удалённые хранили прежнюю позицию без смысла).
+
+UPDATE columns c SET position = o.rn
+FROM (SELECT id, row_number() OVER (ORDER BY (deleted_at IS NOT NULL), position, id) AS rn FROM columns) o
+WHERE c.id = o.id AND c.position <> o.rn;
+
+DROP INDEX IF EXISTS columns_deleted_at_idx;
+
+ALTER TABLE columns
+    DROP CONSTRAINT IF EXISTS columns_deleted_chk,
+    DROP COLUMN delete_reason,
+    DROP COLUMN deleted_by,
+    DROP COLUMN deleted_at;
diff --git a/migrations/0020_soft_delete_board_columns.up.sql b/migrations/0020_soft_delete_board_columns.up.sql
new file mode 100644
index 0000000..3fbd5c1
--- /dev/null
+++ b/migrations/0020_soft_delete_board_columns.up.sql
@@ -0,0 +1,16 @@
+-- Мягкое удаление — колонки доски (docs/features/soft-delete-board-columns/draft-spec.md §4.1,
+-- часть 3 мастер-спеки soft-delete): DS-019 отметка удаления на колонке, DS-030 «кто, когда,
+-- почему» хранятся вместе, DS-020 причина 1–500 символов. Режим MVP (DS-022): ALTER поверх
+-- 0019; существующие колонки остаются действующими (три поля NULL).
+
+ALTER TABLE columns
+    ADD COLUMN deleted_at timestamptz NULL,
+    ADD COLUMN deleted_by uuid NULL REFERENCES users(id) ON DELETE RESTRICT,
+    ADD COLUMN delete_reason text NULL,
+    ADD CONSTRAINT columns_deleted_chk CHECK (
+        (deleted_at IS NULL AND deleted_by IS NULL AND delete_reason IS NULL)
+        OR (deleted_at IS NOT NULL AND deleted_by IS NOT NULL AND delete_reason IS NOT NULL
+            AND char_length(btrim(delete_reason)) BETWEEN 1 AND 500));
+
+-- Список вкладки «Колонки» раздела «Удалённые»: сортировка по времени удаления (§6.3).
+CREATE INDEX columns_deleted_at_idx ON columns (deleted_at DESC, id) WHERE deleted_at IS NOT NULL;
