+func (s *OrderCardLiveSuite) TestTS020_RestoreTaskOfDeletedColumn() {
+	c := s.newClient("Клиент-Колонка-Удалена")
+	col := s.sdColumn("SD-Уйдёт-" + uuid.NewString()[:8])
+	taskID, _, productID := s.sdTaskWithProduct(c, col, "10", 3)
