+	s.Equal(http.StatusOK, st, "client_id в PUT игнорируется: %s", raw)
+	after := s.get(t.ID)
+	s.Equal(s.clientID, after.ClientID)
+	s.Equal(s.moscow, after.ToWarehouseID)
+	s.Equal(taskID, *after.TaskID)
+}
