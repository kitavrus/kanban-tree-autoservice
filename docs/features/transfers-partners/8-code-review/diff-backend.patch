+// Transfers — документы «Перемещение» заказа (transfers-partners DS-012), новые сверху.
+// Склад — назначения (приём от клиента) либо отправления (возврат клиенту).
+func (r *CardRepo) Transfers(ctx context.Context, taskID int64) ([]CardTransfer, error) {
+	rows, err := r.pool.Query(ctx, `
+		SELECT t.id, t.direction, t.status, coalesce(w.name, ''),
+		       (SELECT count(*) FROM transfer_items i WHERE i.transfer_id = t.id)::int, t.created_at
+		FROM transfers t
+		LEFT JOIN warehouses w ON w.id = coalesce(t.to_warehouse_id, t.from_warehouse_id)
+		WHERE t.task_id = $1 ORDER BY t.id DESC`, taskID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []CardTransfer{}
+	for rows.Next() {
+		var t CardTransfer
+		if err := rows.Scan(&t.ID, &t.Direction, &t.Status, &t.WarehouseName, &t.ItemsCount, &t.CreatedAt); err != nil {
+			return nil, err
+		}
+		out = append(out, t)
+	}
+	return out, rows.Err()
+}
