--- /dev/null
+++ b/internal/features/softdelete/handler.go
@@ -0,0 +1,36 @@
+package softdelete
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+)
+
+// Handler — JSON API раздела «Удалённые» (только admin — гард на группе роутов, DS-003).
+type Handler struct {
+	svc *Service
+}
+
+func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }
+
+// List — GET /api/v1/deleted?kind=&q=&deleted_from=&deleted_to=&deleted_by=&limit=&offset=.
+func (h *Handler) List(c fiber.Ctx) error {
+	resp, err := h.svc.List(c.Context(), ssr.ViewerTimezone(c), ListQuery{
+		Kind: c.Query("kind"), Q: c.Query("q"),
+		DeletedFrom: c.Query("deleted_from"), DeletedTo: c.Query("deleted_to"),
+		DeletedBy: c.Query("deleted_by"), Limit: c.Query("limit"), Offset: c.Query("offset"),
+	})
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
+
+// Summary — GET /api/v1/deleted/summary (лишние параметры игнорируются).
+func (h *Handler) Summary(c fiber.Ctx) error {
+	resp, err := h.svc.Summary(c.Context())
+	if err != nil {
+		return err
+	}
+	return c.JSON(resp)
+}
diff --git a/internal/features/softdelete/kinds.go b/internal/features/softdelete/kinds.go
new file mode 100644
index 0000000..c51f6f8
--- /dev/null
+++ b/internal/features/softdelete/kinds.go
@@ -0,0 +1,64 @@
+package softdelete
+
+import (
+	"context"
+	"strings"
+	"time"
+)
+
+// Kind — вид записей раздела «Удалённые» (значение query-параметра kind, §6.3).
+type Kind string
+
+const (
+	KindTasks             Kind = "tasks"
+	KindTransfers         Kind = "transfers"
+	KindColumns           Kind = "columns"
+	KindClients           Kind = "clients"
+	KindEquipment         Kind = "equipment"
+	KindProducts          Kind = "products"
+	KindServices          Kind = "services"
+	KindCatalogCategories Kind = "catalog-categories"
+	KindEquipmentTypes    Kind = "equipment-types"
+	KindWarehouses        Kind = "warehouses"
+	KindSuppliers         Kind = "suppliers"
+)
+
+// Kinds — реестр видов (DS-001), порядок — порядок вкладок раздела. Вид, чей источник ещё не
+// подключён (его часть мастер-спеки не смержена), отдаёт пустой список и счётчик 0.
+var Kinds = []Kind{
+	KindTasks, KindTransfers, KindColumns, KindClients, KindEquipment, KindProducts,
+	KindServices, KindCatalogCategories, KindEquipmentTypes, KindWarehouses, KindSuppliers,
+}
+
+// IsKind — v входит в реестр.
+func IsKind(v string) bool {
+	for _, k := range Kinds {
+		if string(k) == v {
+			return true
+		}
+	}
+	return false
+}
+
+// CountKey — ключ вида в counts ответа summary (JSON snake_case, §API-1).
+func (k Kind) CountKey() string { return strings.ReplaceAll(string(k), "-", "_") }
+
+// Filter — фильтры списка удалённого, сочетаются по «И». Q — уже экранирован для ILIKE
+// (пусто — без поиска); QNumber — номер из строки поиска («128» / «#128») для видов с
+// номером; DeletedFrom/DeletedTo — границы периода в UTC: [DeletedFrom; DeletedTo).
+type Filter struct {
+	Q           string
+	QNumber     *int64
+	DeletedFrom *time.Time
+	DeletedTo   *time.Time
+	DeletedBy   string
+	Limit       int
+	Offset      int
+}
+
+// Source — источник удалённых записей одного вида. Части 2–6 подключают свои источники через
+// Service.Register; порядок списка — deleted_at по убыванию, затем id.
+type Source interface {
+	List(ctx context.Context, f Filter) ([]Item, int, error)
+	Count(ctx context.Context) (int, error)
+}
diff --git a/internal/features/softdelete/reason.go b/internal/features/softdelete/reason.go
new file mode 100644
index 0000000..986ba22
--- /dev/null
+++ b/internal/features/softdelete/reason.go
@@ -0,0 +1,53 @@
+// Package softdelete — мягкое удаление: общие заготовки всех видов записей (валидатор причины,
+// код NOT_DELETED, реестр видов) и чтение раздела «Удалённые» (GET /api/v1/deleted, страница
+// /deleted). Само удаление и восстановление записи живёт в пакете её вида (заказ — board);
+// softdelete их не импортирует — зависимость односторонняя: вид → softdelete.
+package softdelete
+
+import (
+	"net/http"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// ReasonMax — причина удаления, символов после обрезки крайних пробелов (DS-020).
+const ReasonMax = 500
+
+// Коды ошибок полей (details.fields[].message) — общий словарь проекта.
+const (
+	msgRequired    = "required"
+	msgInvalid     = "invalid"
+	msgTooLong     = "too_long"
+	msgInvalidText = "invalid_text"
+)
+
+// ErrNotDeleted — восстановление записи, которая не удалена (уже восстановлена) — DS-024.
+// Общий для всех видов записей.
+var ErrNotDeleted = errorspkg.New("NOT_DELETED", http.StatusConflict, "Запись уже восстановлена")
+
+// DeleteRequest — тело DELETE /api/v1/{ресурс}/:id (DS-028). Указатель: тело без reason и
+// reason из пробелов дают один ответ — required.
+type DeleteRequest struct {
+	Reason *string `json:"reason"`
+}
+
+// ValidateReason — причина удаления: 1–500 символов после обрезки крайних пробелов, без NUL
+// и битого UTF-8. Возвращает обрезанную причину либо ошибку поля reason (400 VALIDATION).
+func ValidateReason(raw *string) (string, []errorspkg.Field) {
+	reason := ""
+	if raw != nil {
+		reason = strings.TrimSpace(*raw)
+	}
+	switch {
+	case reason == "":
+		return "", []errorspkg.Field{{Name: "reason", Message: msgRequired}}
+	case sqlutil.HasInvalidText(reason):
+		return "", []errorspkg.Field{{Name: "reason", Message: msgInvalidText}}
+	case utf8.RuneCountInString(reason) > ReasonMax:
+		return "", []errorspkg.Field{{Name: "reason", Message: msgTooLong}}
+	}
+	return reason, nil
+}
