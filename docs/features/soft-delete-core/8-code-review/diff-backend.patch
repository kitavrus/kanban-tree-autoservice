+// ---- TS-012 ----
+
+// TS-012 (DS-022, DS-030): миграция 0018 — три поля удаления по умолчанию NULL (заказ
+// действует); CHECK tasks_deleted_chk отклоняет частичное заполнение, пустую и слишком длинную
+// причину; полное заполнение проходит; частичный индекс раздела «Удалённые» создан.
+func (s *OrderCardLiveSuite) TestTS012_MigrationCheck() {
+	ctx := context.Background()
+	c := s.newClient("Клиент-Миграция-Удаления")
+	taskID, _ := s.newTask(c, s.columnID("Новые"))
+	adminID := s.sdScalar(`SELECT id::text FROM users WHERE login = 'card-admin'`)
+
+	s.Equal("true", s.sdScalar(`
+		SELECT (deleted_at IS NULL AND deleted_by IS NULL AND delete_reason IS NULL)::text FROM tasks WHERE id = $1`, taskID))
+	s.Equal("1", s.sdScalar(`SELECT count(*)::text FROM pg_indexes WHERE tablename = 'tasks' AND indexname = 'tasks_deleted_at_idx'`))
+
+	for name, q := range map[string]string{
+		"только deleted_at":        `UPDATE tasks SET deleted_at = now() WHERE id = $1 AND $2::text <> ''`,
+		"только deleted_by":        `UPDATE tasks SET deleted_by = $2::uuid WHERE id = $1`,
+		"только delete_reason":     `UPDATE tasks SET delete_reason = 'x' || left($2::text, 0) WHERE id = $1`,
+		"без deleted_by":           `UPDATE tasks SET deleted_at = now(), delete_reason = 'x' || left($2::text, 0) WHERE id = $1`,
+		"без delete_reason":        `UPDATE tasks SET deleted_at = now(), deleted_by = $2::uuid WHERE id = $1`,
+		"причина из пробелов":      `UPDATE tasks SET deleted_at = now(), deleted_by = $2::uuid, delete_reason = '   ' WHERE id = $1`,
+		"причина длиннее 500":      `UPDATE tasks SET deleted_at = now(), deleted_by = $2::uuid, delete_reason = repeat('я', 501) WHERE id = $1`,
+		"несуществующий удаливший": `UPDATE tasks SET deleted_at = now(), deleted_by = gen_random_uuid(), delete_reason = 'x' || left($2::text, 0) WHERE id = $1`,
+	} {
+		_, err := s.Pool.Exec(ctx, q, taskID, adminID)
+		s.Require().Error(err, name)
+		want := "tasks_deleted_chk"
+		if name == "несуществующий удаливший" {
+			want = "tasks_deleted_by_fkey"
+		}
+		s.Contains(err.Error(), want, name)
+	}
+
+	_, err := s.Pool.Exec(ctx, `
+		UPDATE tasks SET deleted_at = now(), deleted_by = $2::uuid, delete_reason = repeat('я', 500) WHERE id = $1`, taskID, adminID)
+	s.Require().NoError(err, "полное заполнение проходит")
+}
+
+// ---- TS-013 ----
+
+// TS-013 (DS-027, DS-036): служебная уборка DELETE /api/v1/test/purge/tasks/:id (сьюта
+// запущена с TEST_PURGE_ENABLED=true) — прежнее безвозвратное удаление: неотменённый документ
+// → 409 TASK_HAS_TRANSFERS, ничего не удалено; иначе заказ физически удалён с частями и
+// отменёнными документами, товар возвращён на склад; работает и для мягко удалённого заказа.
+// Повтор, неизвестный вид, нечисловой номер → 404 NOT_FOUND. Негатив: исполнитель → 403.
+// Файлы вложений — AttachmentsLiveSuite; «без переменной адреса нет» — BoardLiveSuite.
+func (s *OrderCardLiveSuite) TestTS013_Purge() {
+	almaty := s.warehouseID("Алматы")
+	c := s.newClient("Клиент-Уборка")
+	taskID, subtaskID, productID := s.sdTaskWithProduct(c, s.columnID("Новые"), "10", 4)
+	s.sdMove(taskID, s.columnID("В работе"))
+	s.addLog(subtaskID, "Запись")
+	eq := s.newEquipment(c)
+	s.addEq(taskID, eq, "")
+	doc := s.clientTransfer("client_to_warehouse", taskID, almaty, nil, eq)
+	id := fmt.Sprint(taskID)
+
+	exec, _ := s.sdExecutor()
+	for _, target := range []string{id, "999999999"} {
+		st, raw := s.purge(exec, "tasks", target)
+		s.Equal(http.StatusForbidden, st, string(raw))
+		s.Equal("Нет доступа", s.sdErr(raw).Message)
+	}
+
+	st, raw := s.purge(s.admin, "tasks", id)
+	s.Equal(http.StatusConflict, st, string(raw))
+	s.Equal("TASK_HAS_TRANSFERS", s.sdErr(raw).Code)
+	s.Equal("1", s.sdScalar(`SELECT count(*)::text FROM tasks WHERE id = $1`, taskID), "отказ ничего не удалил")
+	s.Equal("6.000", s.defaultStock(productID))
+
+	for _, tc := range []struct{ kind, id string }{{"clients", c}, {"orders", id}, {"tasks", "abc"}, {"tasks", "0"}, {"tasks", "999999999"}} {
+		st, raw = s.purge(s.admin, tc.kind, tc.id)
+		s.Equal(http.StatusNotFound, st, "%s/%s: %s", tc.kind, tc.id, raw)
+		s.Equal("NOT_FOUND", s.sdErr(raw).Code)
+		s.Equal("Не найдено", s.sdErr(raw).Message)
+	}
+
+	s.transferAction(doc, "cancel")
+	st, raw = s.purge(s.admin, "tasks", id)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	var out struct {
+		ID string `json:"id"`
+	}
+	s.Require().NoError(json.Unmarshal(raw, &out), string(raw))
+	s.Equal(id, out.ID)
+	s.Equal("0|0|0|0|0", s.sdScalar(`
+		SELECT (SELECT count(*) FROM tasks WHERE id = $1)::text || '|' ||
+		       (SELECT count(*) FROM subtasks WHERE task_id = $1)::text || '|' ||
+		       (SELECT count(*) FROM task_equipment WHERE task_id = $1)::text || '|' ||
+		       (SELECT count(*) FROM task_stock WHERE task_id = $1)::text || '|' ||
+		       (SELECT count(*) FROM transfers WHERE id = $2)::text`, taskID, doc.ID),
+		"заказ, его части и отменённый документ удалены физически")
+	s.Equal("10.000", s.defaultStock(productID), "товар возвращён на склад")
+	s.Equal("1", s.sdScalar(`SELECT count(*)::text FROM equipment WHERE id = $1`, eq), "единица остаётся в справочнике")
+
+	st, raw = s.purge(s.admin, "tasks", id)
+	s.Equal(http.StatusNotFound, st, "повтор: %s", raw)
+	s.Equal("NOT_FOUND", s.sdErr(raw).Code)
+
+	// мягко удалённый заказ с отменённым документом убирается так же.
+	softID, _, softProduct := s.sdTaskWithProduct(c, s.columnID("Новые"), "10", 4)
+	s.sdMove(softID, s.columnID("В работе"))
+	eq2 := s.newEquipment(c)
+	s.addEq(softID, eq2, "")
+	cancelled := s.transferAction(s.clientTransfer("client_to_warehouse", softID, almaty, nil, eq2), "cancel")
+	s.mustSoftDelete(softID)
+	s.Equal("1", s.sdScalar(`SELECT count(*)::text FROM transfers WHERE id = $1`, cancelled.ID), "мягкое удаление документ не трогает")
+	st, raw = s.purge(s.admin, "tasks", fmt.Sprint(softID))
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("0|0", s.sdScalar(`
+		SELECT (SELECT count(*) FROM tasks WHERE id = $1)::text || '|' || (SELECT count(*) FROM transfers WHERE id = $2)::text`,
+		softID, cancelled.ID))
+	s.Equal("10.000", s.defaultStock(softProduct), "товар удалённого заказа уже возвращён — второй раз не возвращается")
+}
+
+// ---- TS-033 ----
+
+// TS-033 (DS-003): адреса удаления, восстановления и уборки заказа — исполнителю 403 «Нет
+// доступа» до поиска записи (и для существующего, и для несуществующего номера), запись не
+// меняется. Негатив: без сессии → 401.
+func (s *OrderCardLiveSuite) TestTS033_ExecutorForbidden() {
+	c := s.newClient("Клиент-Права-Удаления")
+	live, _ := s.newTask(c, s.columnID("Новые"))
+	deleted, _ := s.newTask(c, s.columnID("Новые"))
+	s.mustSoftDelete(deleted)
+	exec, _ := s.sdExecutor()
+	anon := s.NewBrowser()
+
+	reason := map[string]any{"reason": "Создан по ошибке"}
+	for _, tc := range []struct {
+		method, path string
+		body         map[string]any
+	}{
+		{http.MethodDelete, taskPath(live, ""), reason},
+		{http.MethodDelete, taskPath(999999999, ""), reason},
+		{http.MethodDelete, "/api/v1/tasks/abc", reason},
+		{http.MethodDelete, taskPath(live, ""), nil}, // роль проверяется раньше причины
+		{http.MethodPost, taskPath(deleted, "/restore"), nil},
+		{http.MethodPost, taskPath(live, "/restore"), nil},
+		{http.MethodPost, taskPath(999999999, "/restore"), nil},
+		{http.MethodDelete, fmt.Sprintf("/api/v1/test/purge/tasks/%d", live), nil},
+		{http.MethodDelete, "/api/v1/test/purge/clients/x", nil},
+	} {
+		var body any
+		if tc.body != nil {
+			body = tc.body
+		}
+		st, raw := exec.Do(tc.method, tc.path, body)
+		s.Equal(http.StatusForbidden, st, "%s %s: %s", tc.method, tc.path, raw)
+		s.Equal("FORBIDDEN", s.sdErr(raw).Code, tc.path)
+		s.Equal("Нет доступа", s.sdErr(raw).Message, tc.path)
+
+		st, _ = anon.Do(tc.method, tc.path, body)
+		s.Equal(http.StatusUnauthorized, st, "без сессии: %s %s", tc.method, tc.path)
+	}
+	s.Equal("false|true", s.sdScalar(`
+		SELECT (SELECT (deleted_at IS NOT NULL)::text FROM tasks WHERE id = $1) || '|' ||
+		       (SELECT (deleted_at IS NOT NULL)::text FROM tasks WHERE id = $2)`, live, deleted), "отказы ничего не изменили")
+}
+
+// ---- TS-049 ----
+
+// TS-049 (DS-035, переходное правило): мягко удалённый заказ по-прежнему удерживает клиента,
+// единицу оборудования и колонку от безвозвратного удаления — 409 CLIENT_HAS_TASKS,
+// EQUIPMENT_USED_IN_TASKS, COLUMN_NOT_EMPTY. Негатив: строки заказа, клиента, единицы и
+// колонки физически на месте.
+func (s *OrderCardLiveSuite) TestTS049_DeletedTaskStillHoldsClientEquipmentColumn() {
+	c := s.newClient("Клиент-Только-Удалённый-Заказ")
+	col := s.sdColumn("SD-Держит-" + uuid.NewString()[:8])
+	taskID, _ := s.newTask(c, col)
+	eq := s.newEquipment(c)
+	s.addEq(taskID, eq, "")
+	s.mustSoftDelete(taskID)
+
+	for _, tc := range []struct{ path, code string }{
+		{"/api/v1/clients/" + c, "CLIENT_HAS_TASKS"},
+		{"/api/v1/equipment/" + eq, "EQUIPMENT_USED_IN_TASKS"},
+		{"/api/v1/columns/" + col, "COLUMN_NOT_EMPTY"},
+	} {
+		st, raw := s.admin.Do(http.MethodDelete, tc.path, nil)
+		s.Equal(http.StatusConflict, st, "%s: %s", tc.path, raw)
+		s.Equal(tc.code, s.sdErr(raw).Code, tc.path)
+	}
+	s.Equal("1|1|1|1", s.sdScalar(`
+		SELECT (SELECT count(*) FROM tasks WHERE id = $1)::text || '|' || (SELECT count(*) FROM clients WHERE id = $2)::text || '|' ||
+		       (SELECT count(*) FROM equipment WHERE id = $3)::text || '|' || (SELECT count(*) FROM columns WHERE id = $4)::text`,
+		taskID, c, eq, col))
+
+	// уборка: служебное удаление заказа освобождает колонку.
+	st, raw := s.purge(s.admin, "tasks", fmt.Sprint(taskID))
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	st, raw = s.admin.Do(http.MethodDelete, "/api/v1/columns/"+col, nil)
+	s.Equal(http.StatusNoContent, st, string(raw))
+}
+
+// ---- TS-052 ----
+
+// TS-052 (DS-039, DS-004): пока заказ удалён, правка его колонки заказ не трогает — включение
+// consumes_stock товар по нему не списывает, а колонку можно сделать финальной, хотя у заказа
+// есть незавершённая услуга. Восстановление такого заказа ставит его в конец первой
+// нефинальной колонки: notices содержит column_replaced с её названием, товар списывается по
+// правилу НОВОЙ колонки. Негатив: заказ без незавершённых услуг восстанавливается в свою
+// финальную колонку, notices пуст.
+func (s *OrderCardLiveSuite) TestTS052_RestoreWhenColumnBecameFinal() {
+	ctx := context.Background()
+	c := s.newClient("Клиент-Колонка-Стала-Финальной")
+	colName := "SD-Финал-" + uuid.NewString()[:8]
+	col := s.sdColumn(colName)
+
+	open, _, productID := s.sdTaskWithProduct(c, col, "10", 3) // услуга new — незавершённая
+	closed, closedSub, closedProduct := s.sdTaskWithProduct(c, col, "10", 2)
+	_, err := s.Pool.Exec(ctx, `UPDATE subtasks SET status = 'done' WHERE id = $1`, closedSub) // фикстура: услуга выполнена
+	s.Require().NoError(err)
+	s.mustSoftDelete(open)
+	s.mustSoftDelete(closed)
+
+	// колонка начинает списывать товар — удалённые заказы не пересчитываются.
+	st, raw := s.sdUpdateColumn(col, colName, false, true)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+	s.Equal("10.000|10.000", s.defaultStock(productID)+"|"+s.defaultStock(closedProduct), "удалённые заказы товар не списывают")
+	s.Equal("0|0", s.taskStockRows(open)+"|"+s.taskStockRows(closed))
+
+	// колонка становится финальной: незавершённая услуга удалённого заказа не мешает.
+	st, raw = s.sdUpdateColumn(col, colName, true, true)
+	s.Require().Equal(http.StatusOK, st, string(raw))
+
+	var firstID, firstName string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`SELECT id::text, name FROM columns WHERE NOT is_final ORDER BY position, id LIMIT 1`).Scan(&firstID, &firstName))
+	lastPos := s.sdScalar(`SELECT coalesce(max(position), 0)::text FROM tasks WHERE column_id = $1 AND deleted_at IS NULL`, firstID)
+
+	out := s.mustRestore(open)
+	s.Require().Len(out.Notices, 1)
+	s.Equal("column_replaced", out.Notices[0].Code)
+	s.Equal("Колонка заказа стала финальной — заказ поставлен в колонку «"+firstName+"»", out.Notices[0].Message)
+	s.Equal(firstID, s.sdScalar(`SELECT column_id::text FROM tasks WHERE id = $1`, open), "заказ в первой нефинальной колонке")
+	s.Equal("true", s.sdScalar(`SELECT (position > $2::numeric)::text FROM tasks WHERE id = $1`, open, lastPos), "в конце колонки")
+	consumes := s.sdScalar(`SELECT consumes_stock::text FROM columns WHERE id = $1`, firstID)
+	wantStock := map[string]string{"true": "7.000", "false": "10.000"}[consumes]
+	s.Equal(wantStock, s.defaultStock(productID), "товар списан по правилу новой колонки (consumes_stock=%s)", consumes)
+	st, card, _ := s.getCard(s.admin, open)
+	s.Require().Equal(http.StatusOK, st)
+	s.Equal(firstID, card.Column.ID)
+
+	// негатив: без незавершённых услуг заказ остаётся в своей (теперь финальной) колонке.
+	out = s.mustRestore(closed)
+	s.Empty(out.Notices)
+	s.Equal(col, s.sdScalar(`SELECT column_id::text FROM tasks WHERE id = $1`, closed))
+	s.Equal("8.000", s.defaultStock(closedProduct), "колонка списывает товар — списан снова")
+
+	// уборка своей колонки.
+	for _, id := range []int64{open, closed} {
+		st, raw = s.purge(s.admin, "tasks", fmt.Sprint(id))
+		s.Require().Equal(http.StatusOK, st, string(raw))
+	}
+	st, raw = s.admin.Do(http.MethodDelete, "/api/v1/columns/"+col, nil)
+	s.Equal(http.StatusNoContent, st, string(raw))
+}
diff --git a/internal/features/board/soft_delete_race_http_live_test.go b/internal/features/board/soft_delete_race_http_live_test.go
new file mode 100644
index 0000000..6108fd2
--- /dev/null
+++ b/internal/features/board/soft_delete_race_http_live_test.go
@@ -0,0 +1,169 @@
+//go:build integration
+
+package board_test
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/kitavrus/kanban-tree/pkg/testutil"
+)
+
+// Гонка «мягкое удаление заказа ↔ запись части заказа» (soft-delete-core DS-026, DS-013;
+// code review, fix-loop 2) — методы AttachmentsLiveSuite (каталог вложений на диске).
+// Журнал работ и вложения не берут заказ под FOR UPDATE, поэтому их запись блокирует строку
+// заказа FOR KEY SHARE с условием «не удалён». Гонка воспроизводится детерминированно, без
+// sleep: тест сам держит блокировку строки заказа в открытой транзакции, дожидается по
+// pg_stat_activity, что запросы сервера встали в ожидание именно этой блокировки, и только
+// потом фиксирует транзакцию.
+
+// lockWaiters — число серверных соединений, ждущих блокировку строки (wait_event_type Lock).
+func (s *AttachmentsLiveSuite) lockWaiters() int {
+	var n int
+	s.Require().NoError(s.Pool.QueryRow(context.Background(),
+		`SELECT count(*) FROM pg_stat_activity WHERE wait_event_type = 'Lock' AND pid <> pg_backend_pid()`).Scan(&n))
+	return n
+}
+
+// raceSubtask — услуга заказа с одной записью журнала (SQL: фикстура); возвращает услугу и запись.
+func (s *AttachmentsLiveSuite) raceSubtask(taskID int64) (subtaskID, logID string) {
+	ctx := context.Background()
+	s.Require().NoError(s.Pool.QueryRow(ctx, `
+		WITH cat AS (INSERT INTO catalog_categories (kind, name) VALUES ('service', 'Race Svc ' || gen_random_uuid()) RETURNING id),
+		     svc AS (INSERT INTO services (category_id, name, price) SELECT id, 'Услуга гонки', 100 FROM cat RETURNING id)
+		INSERT INTO subtasks (task_id, service_id, status, position, price) SELECT $1, id, 'new', 1, 100 FROM svc RETURNING id`,
+		taskID).Scan(&subtaskID))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `
+		INSERT INTO subtask_logs (subtask_id, user_id, text)
+		SELECT $1, id, 'Запись до удаления' FROM users WHERE login = 'att-admin' RETURNING id`, subtaskID).Scan(&logID))
+	return subtaskID, logID
+}
+
+func (s *AttachmentsLiveSuite) raceBrowser() *testutil.Browser {
+	b := s.NewBrowser()
+	b.Login("att-admin", "password1")
+	return b
+}
+
+// Удаление заказа идёт (строка заказа под FOR UPDATE, отметка удаления ещё не зафиксирована) —
+// в это окно приходят правки частей заказа. Каждая обязана дождаться удаления и получить 404
+// своего вида: запись журнала не добавлена, не изменена и не удалена; вложение не удалено и
+// его файл на диске цел; новое вложение не загружено (его файл с диска убран).
+func (s *AttachmentsLiveSuite) TestRace_PartWritesWaitForTaskSoftDelete() {
+	ctx := context.Background()
+	taskID := s.newTask()
+	subtaskID, logID := s.raceSubtask(taskID)
+	kept := s.mustUpload(s.admin, taskID, "остаётся.png", fileOf(pngSig, 100))
+	keptKey := s.storageKey(kept.ID)
+	filesBefore := len(s.diskFiles())
+
+	// «Удаление в полёте»: те же блокировка и UPDATE, что делает TaskService.Delete.
+	tx, err := s.Pool.Begin(ctx)
+	s.Require().NoError(err)
+	defer func() { _ = tx.Rollback(ctx) }()
+	_, err = tx.Exec(ctx, `SELECT id FROM tasks WHERE id = $1 FOR UPDATE`, taskID)
+	s.Require().NoError(err)
+	_, err = tx.Exec(ctx, `
+		UPDATE tasks SET deleted_at = now(), delete_reason = 'гонка', version = version + 1,
+		       deleted_by = (SELECT id FROM users WHERE login = 'att-admin')
+		WHERE id = $1`, taskID)
+	s.Require().NoError(err)
+
+	type result struct {
+		status int
+		raw    []byte
+	}
+	requests := []struct {
+		name, code string
+		do         func(b *testutil.Browser) (int, []byte)
+	}{
+		{"добавление записи", "SUBTASK_NOT_FOUND", func(b *testutil.Browser) (int, []byte) {
+			return b.Do(http.MethodPost, "/api/v1/subtasks/"+subtaskID+"/logs", map[string]any{"text": "Запись в удалённый заказ"})
+		}},
+		{"правка записи", "SUBTASK_LOG_NOT_FOUND", func(b *testutil.Browser) (int, []byte) {
+			return b.Do(http.MethodPut, "/api/v1/subtask-logs/"+logID, map[string]any{"text": "Исправлено после удаления"})
+		}},
+		{"удаление записи", "SUBTASK_LOG_NOT_FOUND", func(b *testutil.Browser) (int, []byte) {
+			return b.Do(http.MethodDelete, "/api/v1/subtask-logs/"+logID, nil)
+		}},
+		{"удаление вложения", "ATTACHMENT_NOT_FOUND", func(b *testutil.Browser) (int, []byte) {
+			return b.Do(http.MethodDelete, "/api/v1/attachments/"+kept.ID, nil)
+		}},
+		{"загрузка вложения", "TASK_NOT_FOUND", func(b *testutil.Browser) (int, []byte) {
+			st, _, raw := s.upload(b, taskID, "в-удалённый.png", fileOf(pngSig, 100))
+			return st, raw
+		}},
+	}
+	browsers := make([]*testutil.Browser, len(requests))
+	for i := range requests {
+		browsers[i] = s.raceBrowser() // вход — до старта гонки
+	}
+	results := make([]result, len(requests))
+	var wg sync.WaitGroup
+	for i := range requests {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			st, raw := requests[i].do(browsers[i])
+			results[i] = result{st, raw}
+		}(i)
+	}
+
+	// все пять запросов стоят в ожидании блокировки строки заказа — ни один не прошёл мимо.
+	s.Eventually(func() bool { return s.lockWaiters() == len(requests) }, 15*time.Second, 20*time.Millisecond,
+		"запросы частей заказа ждут блокировку заказа (ждут: %d из %d)", s.lockWaiters(), len(requests))
+	s.Require().NoError(tx.Commit(ctx))
+	wg.Wait()
+
+	for i, rq := range requests {
+		s.Equal(http.StatusNotFound, results[i].status, "%s: %s", rq.name, results[i].raw)
+		s.Equal(rq.code, s.errCode(results[i].raw), "%s: %s", rq.name, results[i].raw)
+	}
+
+	var logs int
+	var text string
+	s.Require().NoError(s.Pool.QueryRow(ctx,
+		`SELECT count(*), coalesce(min(text), '') FROM subtask_logs WHERE subtask_id = $1`, subtaskID).Scan(&logs, &text))
+	s.Equal(1, logs, "запись в удалённом заказе не появилась и не удалена")
+	s.Equal("Запись до удаления", text, "запись удалённого заказа не изменена")
+	s.Equal(1, s.countRows(taskID), "строка вложения удалённого заказа на месте, новая не добавлена")
+	files := s.diskFiles()
+	s.True(files[keptKey], "файл вложения удалённого заказа цел")
+	s.Len(files, filesBefore, "файл отклонённой загрузки убран с диска")
+}
+
+// Обратный порядок: запись части заказа идёт (строка заказа под FOR KEY SHARE) — удаление
+// заказа обязано дождаться её конца, а не пройти параллельно: FOR UPDATE удаления с KEY SHARE
+// несовместим. После освобождения блокировки заказ удаляется (200).
+func (s *AttachmentsLiveSuite) TestRace_TaskSoftDeleteWaitsForPartWrite() {
+	ctx := context.Background()
+	taskID := s.newTask()
+
+	tx, err := s.Pool.Begin(ctx)
+	s.Require().NoError(err)
+	defer func() { _ = tx.Rollback(ctx) }()
+	_, err = tx.Exec(ctx, `SELECT 1 FROM tasks WHERE id = $1 AND deleted_at IS NULL FOR KEY SHARE`, taskID)
+	s.Require().NoError(err)
+
+	var st int
+	var raw []byte
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		st, raw = s.admin.Do(http.MethodDelete, fmt.Sprintf("/api/v1/tasks/%d", taskID), map[string]any{"reason": "Создан по ошибке"})
+	}()
+
+	s.Eventually(func() bool { return s.lockWaiters() == 1 }, 15*time.Second, 20*time.Millisecond, "удаление заказа ждёт запись части")
+	var deleted bool
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT deleted_at IS NOT NULL FROM tasks WHERE id = $1`, taskID).Scan(&deleted))
+	s.False(deleted, "пока запись части не завершена, заказ не удалён")
+
+	s.Require().NoError(tx.Commit(ctx))
+	<-done
+	s.Equal(http.StatusOK, st, string(raw))
+	s.Require().NoError(s.Pool.QueryRow(ctx, `SELECT deleted_at IS NOT NULL FROM tasks WHERE id = $1`, taskID).Scan(&deleted))
+	s.True(deleted)
+}
