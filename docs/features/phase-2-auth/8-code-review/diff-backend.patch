+	// мусор в параметрах списка — дефолты, не 500
+	st, _ = s.admin.Do(http.MethodGet, "/api/v1/users?limit=-5&offset=-1&sort=password_hash;drop&order=sideways&role=root&is_active=maybe", nil)
+	s.Equal(http.StatusOK, st)
