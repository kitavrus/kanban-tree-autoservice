+
+// RequireAdmin — только admin (после RequireAPI/RequireSSR). Иначе — forbidden
+// (для API — 403 JSON; для страниц вызывающий передаёт рендер 403-страницы).
+func RequireAdmin(forbidden fiber.Handler) fiber.Handler {
