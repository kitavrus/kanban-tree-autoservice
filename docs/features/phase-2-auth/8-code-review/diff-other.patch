+<meta name="csrf-token" content="{{ .Shell.CSRFToken }}">
+</head>
+<body>
+<!-- Без сайдбара: вход и служебные страницы (ошибки) -->
+<div class="app-bare">
+  <button type="button" class="btn btn-sm btn-outline-secondary app-bare-theme" data-theme-toggle data-testid="theme-toggle">◐ Тема</button>
+  {{ template "content" . }}
+</div>
+<script src="/assets/ssr-shared/js/theme.js"></script>
+{{ block "scripts" . }}{{ end }}
+</body>
+</html>
+{{ end }}
