+{{ define "content" }}
+<form class="card app-login" method="post" action="/login" data-testid="login-form" novalidate>
+  <div class="card-body">
+    <div class="app-brand justify-content-center"><span class="app-brand-logo">▦</span> Kanban-tree</div>
+    <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+    <input type="hidden" name="redirect" value="{{ .Redirect }}">
+    {{ if .Error }}<div class="alert alert-danger py-2" role="alert" data-testid="login-error">{{ .Error }}</div>{{ end }}
+    <div class="mb-3">
+      <label for="login" class="form-label">Логин</label>
+      <input id="login" name="login" class="form-control" value="{{ .Login }}" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="50" {{ if not .Login }}autofocus{{ end }}>
+    </div>
+    <div class="mb-4">
+      <label for="password" class="form-label">Пароль</label>
+      <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" maxlength="72" {{ if .Login }}autofocus{{ end }}>
+    </div>
+    <button type="submit" class="btn btn-primary w-100">Войти</button>
+  </div>
+</form>
+{{ end }}
diff --git a/web/ssr/users/templates/pages/form.html b/web/ssr/users/templates/pages/form.html
new file mode 100644
index 0000000..635dc04
--- /dev/null
+++ b/web/ssr/users/templates/pages/form.html
@@ -0,0 +1,48 @@
+{{ define "content" }}
+<form class="card mw-760" method="post" action="{{ if .IsNew }}/users{{ else }}/users/{{ .ID }}{{ end }}" data-testid="user-form" novalidate>
+  <div class="card-body">
+    <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+    {{ if .Error }}<div class="alert alert-danger py-2" role="alert" data-testid="form-error">{{ .Error }}</div>{{ end }}
+    <div class="mb-3">
+      <label for="name" class="form-label">ФИО *</label>
+      <input id="name" name="name" class="form-control{{ if index .Errors "name" }} is-invalid{{ end }}" value="{{ .Name }}" maxlength="200" autocomplete="off">
+      {{ with index .Errors "name" }}<div class="invalid-feedback" data-testid="error-name">{{ . }}</div>{{ end }}
+    </div>
+    <div class="row g-3 mb-3">
+      <div class="col-sm-6">
+        <label for="login" class="form-label">Логин *</label>
+        <input id="login" name="login" class="form-control{{ if index .Errors "login" }} is-invalid{{ end }}" value="{{ .Login }}" maxlength="50" autocomplete="off" autocapitalize="none" spellcheck="false">
+        {{ with index .Errors "login" }}<div class="invalid-feedback" data-testid="error-login">{{ . }}</div>{{ end }}
+      </div>
+      <div class="col-sm-6">
+        <label for="role" class="form-label">Роль</label>
+        <select id="role" name="role" class="form-select{{ if index .Errors "role" }} is-invalid{{ end }}" data-testid="role">
+          <option value="executor"{{ if eq .Role "executor" }} selected{{ end }}>Исполнитель</option>
+          <option value="admin"{{ if eq .Role "admin" }} selected{{ end }}>Администратор</option>
+        </select>
+        {{ with index .Errors "role" }}<div class="invalid-feedback d-block" data-testid="error-role">{{ . }}</div>{{ end }}
+      </div>
+    </div>
+    <div class="row g-3 mb-3">
+      <div class="col-sm-6">
+        <label for="phone" class="form-label">Телефон</label>
+        <input id="phone" name="phone" class="form-control{{ if index .Errors "phone" }} is-invalid{{ end }}" value="{{ .Phone }}" maxlength="50" inputmode="tel" autocomplete="off">
+        {{ with index .Errors "phone" }}<div class="invalid-feedback" data-testid="error-phone">{{ . }}</div>{{ end }}
+      </div>
+      <div class="col-sm-6">
+        <label for="password" class="form-label">{{ if .IsNew }}Пароль *{{ else }}Новый пароль (пусто — не менять){{ end }}</label>
+        <input id="password" name="password" type="password" class="form-control{{ if index .Errors "password" }} is-invalid{{ end }}" maxlength="72" autocomplete="new-password">
+        {{ with index .Errors "password" }}<div class="invalid-feedback" data-testid="error-password">{{ . }}</div>{{ end }}
+      </div>
+    </div>
+    <div class="form-check mb-4">
+      <input class="form-check-input" type="checkbox" id="is_active" name="is_active"{{ if .IsActive }} checked{{ end }}>
+      <label class="form-check-label" for="is_active">Активен (может входить в систему)</label>
+    </div>
+    <div class="d-flex gap-2">
+      <button type="submit" class="btn btn-primary" data-testid="user-save">Сохранить</button>
+      <a href="/users" class="btn btn-outline-secondary">Отмена</a>
+    </div>
+  </div>
+</form>
+{{ end }}
diff --git a/web/ssr/users/templates/pages/list.html b/web/ssr/users/templates/pages/list.html
new file mode 100644
index 0000000..662ee86
--- /dev/null
+++ b/web/ssr/users/templates/pages/list.html
@@ -0,0 +1,46 @@
+{{ define "actions" }}<a href="/users/new" class="btn btn-primary" data-testid="user-add">+ Сотрудник</a>{{ end }}
+{{ define "content" }}
+{{ if .Flash }}<div class="alert alert-success py-2" role="status" data-testid="flash">{{ .Flash }}</div>{{ end }}
+<form class="d-flex flex-wrap gap-2 mb-3" method="get" action="/users" data-testid="users-filters">
+  <input class="form-control" style="max-width:280px" type="search" name="q" value="{{ .Q }}" placeholder="Поиск: ФИО, логин, телефон" aria-label="Поиск" data-testid="filter-q">
+  <select class="form-select" style="max-width:200px" name="role" aria-label="Роль" data-testid="filter-role" onchange="this.form.submit()">
+    <option value="">Все роли</option>
+    <option value="admin"{{ if eq .Role "admin" }} selected{{ end }}>Администратор</option>
+    <option value="executor"{{ if eq .Role "executor" }} selected{{ end }}>Исполнитель</option>
+  </select>
+  <select class="form-select" style="max-width:200px" name="status" aria-label="Статус" data-testid="filter-status" onchange="this.form.submit()">
+    <option value="">Любой статус</option>
+    <option value="active"{{ if eq .Status "active" }} selected{{ end }}>Активные</option>
+    <option value="blocked"{{ if eq .Status "blocked" }} selected{{ end }}>Заблокированные</option>
+  </select>
+  <button class="btn btn-outline-secondary" type="submit">Найти</button>
+  {{ if or .Q .Role .Status }}<a class="btn btn-link" href="/users" data-testid="filter-reset">Сбросить</a>{{ end }}
+</form>
+{{ if .Items }}
+<div class="table-responsive">
+<table class="table table-hover align-middle" data-testid="users-table">
+  <thead><tr><th>Сотрудник</th><th>Логин</th><th>Роль</th><th class="d-none d-md-table-cell">Телефон</th></tr></thead>
+  <tbody>
+  {{ range .Items }}
+    <tr data-testid="user-row" data-login="{{ .Login }}">
+      <td>
+        <div class="d-flex align-items-center gap-2">
+          <span class="app-avatar">{{ initials .Name }}</span>
+          <a href="/users/{{ .ID }}" class="fw-semibold">{{ .Name }}</a>
+          {{ if not .IsActive }}<span class="badge-off" data-testid="user-blocked">заблокирован</span>{{ end }}
+        </div>
+      </td>
+      <td>{{ .Login }}</td>
+      <td>{{ if eq .Role "admin" }}Администратор{{ else }}Исполнитель{{ end }}</td>
+      <td class="d-none d-md-table-cell">{{ .Phone }}</td>
+    </tr>
+  {{ end }}
+  </tbody>
+</table>
+</div>
+<p class="text-body-secondary small" data-testid="users-total">Сотрудников: {{ .Total }}{{ if gt .Total (len .Items) }} — показаны первые {{ len .Items }}, уточните поиск{{ end }}</p>
+{{ else }}
+<div class="empty-state" data-testid="users-empty">{{ if or .Q .Role .Status }}Никого не нашли по фильтрам.{{ else }}Сотрудников пока нет.{{ end }}</div>
+{{ end }}
+<p class="text-body-secondary small mt-3">Администратор: справочники, сотрудники, колонки, оплата, удаление заказов. Исполнитель: доска, создание и редактирование заказов, статусы услуг, вложения.</p>
+{{ end }}
