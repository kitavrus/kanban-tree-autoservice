@@ -0,0 +1,48 @@
+package clients
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+)
+
+// Register — JSON API /api/v1/clients + /api/v1/equipment (чтение — RequireAPI, мутации —
+// +admin; POST /clients/:id/equipment — RequireAPI без admin, D19: исполнитель создаёт
+// оборудование) + SSR-экран /clients + форма единицы оборудования /equipment/:id (только
+// admin, ADR-005/ADR-006). При s == nil SSR-группа не регистрируется (используется в
+// тестах, где рендерер не нужен — эталон equipmenttypes/routes.go).
+func Register(app *fiber.App, api fiber.Router, a *middleware.Auth, h *Handler, s *SSR) {
+	admin := middleware.RequireAdmin(nil)
+	g := api.Group("/clients", a.RequireAPI())
+	g.Get("", h.List)
+	g.Post("", admin, h.Create)
+	g.Get("/:id", h.Get)
+	g.Put("/:id", admin, h.Update)
+	g.Delete("/:id", admin, h.Delete)
+	g.Get("/:id/equipment", h.ListEquipment)
+	g.Post("/:id/equipment", h.CreateEquipment) // D19: без admin-guard
+
+	e := api.Group("/equipment", a.RequireAPI())
+	e.Get("/:id", h.GetEquipment)
+	e.Put("/:id", admin, h.UpdateEquipment)
+	e.Delete("/:id", admin, h.DeleteEquipment)
+
+	if s == nil {
+		return
+	}
+	ssrAdmin := middleware.RequireAdmin(s.status.Forbidden)
+	p := app.Group("/clients", a.RequireSSR(), ssrAdmin)
+	p.Get("", s.list)
+	p.Get("/new", s.formNew)
+	p.Post("", s.create)
+	p.Get("/:id", s.formEdit)
+	p.Post("/:id", s.update)
+	p.Post("/:id/delete", s.remove)
+	p.Get("/:id/equipment/new", s.eqNew)
+	p.Post("/:id/equipment", s.eqCreate)
+
+	q := app.Group("/equipment", a.RequireSSR(), ssrAdmin)
+	q.Get("/:id", s.eqEdit)
+	q.Post("/:id", s.eqUpdate)
+	q.Post("/:id/delete", s.eqRemove)
+}
diff --git a/internal/features/clients/service.go b/internal/features/clients/service.go
new file mode 100644
index 0000000..aef04c2
--- /dev/null
+++ b/internal/features/clients/service.go
@@ -0,0 +1,346 @@
+package clients
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"regexp"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+var (
+	ErrClientNotFound        = errorspkg.New("CLIENT_NOT_FOUND", http.StatusNotFound, "Клиент не найден")
+	ErrEquipmentNotFound     = errorspkg.New("EQUIPMENT_NOT_FOUND", http.StatusNotFound, "Оборудование не найдено")
+	ErrClientVersionConflict = errorspkg.New("CLIENT_VERSION_CONFLICT", http.StatusConflict,
+		"Карточку уже изменил другой пользователь — ваши правки не сохранены")
+)
+
+const (
+	defaultLimit = 50
+	maxLimit     = 200
+	// minSearchDigits — ADR-003: строка поиска трактуется как телефон (сравнение по
+	// цифрам), если после отбрасывания нецифр остаётся ≥3 цифры.
+	minSearchDigits = 3
+
+	// equipmentDefaultLimit/equipmentMaxLimit — оборудование одного клиента, список
+	// не постраничный по UX, но лимит защищает от неограниченной выборки.
+	equipmentDefaultLimit = 200
+	equipmentMaxLimit     = 200
+)
+
+var (
+	// phoneLikeRe — строка похожа на телефонный ввод (цифры/+()-/пробел), не текст.
+	phoneLikeRe = regexp.MustCompile(`^[0-9+()\- ]+$`)
+	nonDigitRe  = regexp.MustCompile(`\D`)
+)
+
+type Service struct {
+	repo *Repo
+}
+
+func NewService(pool *pgxpool.Pool) *Service {
+	return &Service{repo: NewRepo(pool)}
+}
+
+// ListQuery — параметры списка из HTTP-слоя (сырые).
+type ListQuery struct {
+	Q             string
+	Limit, Offset int
+}
+
+func (s *Service) List(ctx context.Context, q ListQuery) (*ClientListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = defaultLimit
+	}
+	limit = min(limit, maxLimit)
+	offset = max(offset, 0)
+
+	query := strings.TrimSpace(q.Q)
+	if sqlutil.HasInvalidText(query) {
+		// NUL-байт / невалидный UTF-8 в q (напр. GET /api/v1/clients?q=%00, доступно и
+		// исполнителю) — не 500: фильтр молча игнорируется, как будто q не задан (200 с
+		// полным списком), а не ошибка формы поиска по адресной строке (code review §TD-4).
+		query = ""
+	}
+	digits, digitsAlt := searchDigits(query)
+	items, total, err := s.repo.ListClients(ctx, ListParams{
+		Q: query, Digits: digits, DigitsAlt: digitsAlt, Limit: limit, Offset: offset,
+	})
+	if err != nil {
+		return nil, err
+	}
+	resp := &ClientListResponse{Items: make([]ClientResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, c := range items {
+		resp.Items[i] = toResponse(c)
+	}
+	return resp, nil
+}
+
+// searchDigits — ADR-003: строка похожа на телефон и содержит ≥3 цифры → цифры для
+// прямого сравнения с БД (`regexp_replace(phone, '\D', '', 'g') LIKE '%<digits>%'`); иначе
+// оба возврата — "". digitsAlt (непусто, только если digits начинается с 7 или 8) — та же
+// строка БЕЗ ведущей цифры, для СИММЕТРИЧНОГО сравнения repo.go: у номера в БД точно так же
+// отбрасывается ведущая 7/8 (`phoneAltDigitsExpr`), поэтому «8999123»/«+7999123» находят
+// друг друга независимо от длины ввода (частичный ввод, не только полный 11-значный номер —
+// code review, регрессия итерации 1: сравнение digits ПОЛНОЙ длины ≥11 ломало короткий
+// частичный ввод с кодом страны, т.к. БД-сторона стриплась всегда, а запрос — только при
+// ≥11 цифрах).
+func searchDigits(q string) (digits, digitsAlt string) {
+	if q == "" || !phoneLikeRe.MatchString(q) {
+		return "", ""
+	}
+	digits = nonDigitRe.ReplaceAllString(q, "")
+	if len(digits) < minSearchDigits {
+		return "", ""
+	}
+	if digits[0] == '7' || digits[0] == '8' {
+		digitsAlt = digits[1:]
+	}
+	return digits, digitsAlt
+}
+
+func (s *Service) Get(ctx context.Context, id string) (*ClientResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrClientNotFound
+	}
+	c, err := s.repo.GetClient(ctx, id)
+	if errors.Is(err, ErrNotFound) {
+		return nil, ErrClientNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toResponse(*c)
+	return &resp, nil
+}
+
+func (s *Service) Create(ctx context.Context, in ClientInput) (*ClientResponse, error) {
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	c, err := s.repo.CreateClient(ctx, in)
+	if err != nil {
+		return nil, err
+	}
+	resp := toResponse(*c)
+	return &resp, nil
+}
+
+// Update — полная замена карточки + набора телефонов; version nil → 400 (ADR-100),
+// version не совпал с текущим → 409 CLIENT_VERSION_CONFLICT (не перезапись).
+func (s *Service) Update(ctx context.Context, id string, version *int64, in ClientInput) (*ClientResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrClientNotFound
+	}
+	in = in.normalize()
+	f := in.validate()
+	if version == nil {
+		f = append(f, errorspkg.Field{Name: "version", Message: msgRequired})
+	}
+	if len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	c, err := s.repo.UpdateClient(ctx, id, *version, in)
+	switch {
+	case errors.Is(err, ErrNotFound):
+		return nil, ErrClientNotFound
+	case errors.Is(err, errVersionConflict):
+		return nil, ErrClientVersionConflict
+	case err != nil:
+		return nil, err
+	}
+	resp := toResponse(*c)
+	return &resp, nil
+}
+
+func (s *Service) Delete(ctx context.Context, id string) error {
+	if uuid.Validate(id) != nil {
+		return ErrClientNotFound
+	}
+	err := s.repo.DeleteClient(ctx, id)
+	if errors.Is(err, ErrNotFound) {
+		return ErrClientNotFound
+	}
+	return err
+}
+
+func toResponse(c Client) ClientResponse {
+	phones := c.Phones
+	if phones == nil {
+		phones = []PhoneDTO{}
+	}
+	return ClientResponse{
+		ID: c.ID, CompanyName: c.CompanyName, Address: c.Address,
+		ContactName: c.ContactName, ContactPosition: c.ContactPosition,
+		Phones: phones, EquipmentCount: c.EquipmentCount, Version: c.Version,
+		CreatedAt: c.CreatedAt, UpdatedAt: c.UpdatedAt,
+	}
+}
+
+// ListEquipment — 404 CLIENT_NOT_FOUND, если клиента нет (проверка до запроса, а не
+// пустой список — design-sql.md `## List Equipment By Client Query`).
+func (s *Service) ListEquipment(ctx context.Context, clientID string, limit, offset int) (*EquipmentListResponse, error) {
+	if uuid.Validate(clientID) != nil {
+		return nil, ErrClientNotFound
+	}
+	exists, err := s.repo.ClientExists(ctx, clientID)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, ErrClientNotFound
+	}
+
+	if limit <= 0 {
+		limit = equipmentDefaultLimit
+	}
+	limit = min(limit, equipmentMaxLimit)
+	offset = max(offset, 0)
+
+	items, total, err := s.repo.ListEquipment(ctx, clientID, limit, offset)
+	if err != nil {
+		return nil, err
+	}
+	resp := &EquipmentListResponse{Items: make([]EquipmentResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, e := range items {
+		resp.Items[i] = toEquipmentResponse(e)
+	}
+	return resp, nil
+}
+
+func (s *Service) GetEquipment(ctx context.Context, id string) (*EquipmentResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrEquipmentNotFound
+	}
+	e, err := s.repo.GetEquipment(ctx, id)
+	if errors.Is(err, ErrNotFound) {
+		return nil, ErrEquipmentNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toEquipmentResponse(*e)
+	return &resp, nil
+}
+
+// CreateEquipment — validate → TypeActive(type_id): not_found/archived → 400 Validation
+// (ADR-004, создание разрешено только с активным типом) → repo.CreateEquipment (клиент
+// удалён параллельно → 404 CLIENT_NOT_FOUND, не 500).
+func (s *Service) CreateEquipment(ctx context.Context, clientID string, in EquipmentInput) (*EquipmentResponse, error) {
+	if uuid.Validate(clientID) != nil {
+		return nil, ErrClientNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	// ADR-004: создание разрешено только с активным типом; type_id уже провалидирован
+	// как корректный uuid — validate() выше.
+	active, err := s.repo.TypeActive(ctx, in.TypeID)
+	switch {
+	case errors.Is(err, ErrNotFound):
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "type_id", Message: "not_found"})
+	case err != nil:
+		return nil, err
+	case !active:
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "type_id", Message: "archived"})
+	}
+
+	e, err := s.repo.CreateEquipment(ctx, clientID, in)
+	switch {
+	case errors.Is(err, errClientGone):
+		return nil, ErrClientNotFound
+	case errors.Is(err, errTypeGone):
+		// тип удалён параллельно между TypeActive-проверкой выше и вставкой — тот же код
+		// поля, что и «тип не существует» до вставки (LOW#1).
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "type_id", Message: "not_found"})
+	case err != nil:
+		return nil, err
+	}
+	resp := toEquipmentResponse(*e)
+	return &resp, nil
+}
+
+// UpdateEquipment — LWW (без version, D28 — версия только у clients). Архивный тип
+// допустим, только если type_id не менялся (ADR-004) — check() читает curTypeID и
+// TypeActive ВНУТРИ tx репозитория (repo.go UpdateEquipment), поэтому смена типа между
+// проверкой и этим вызовом невозможна для одной единицы; type_id-цель проверки (в т.ч.
+// смена на архивный тип) читается вне tx (pool, не tx.QueryRow) и не блокируется —
+// параллельный архив/удаление ЦЕЛЕВОГО типа между check() и UPDATE теоретически возможны
+// (LOW-риск, admin-only): архивный тип на этот момент допускается на UPDATE
+// (SQLSTATE 23503 на type_id — errTypeGone, если тип успели удалить), не FOR UPDATE.
+func (s *Service) UpdateEquipment(ctx context.Context, id string, in EquipmentInput) (*EquipmentResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrEquipmentNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+
+	check := func(curTypeID string) error {
+		if curTypeID == in.TypeID {
+			return nil // тип не меняется — архивный допустим.
+		}
+		active, err := s.repo.TypeActive(ctx, in.TypeID)
+		if errors.Is(err, ErrNotFound) {
+			return errorspkg.Validation(errorspkg.Field{Name: "type_id", Message: "not_found"})
+		}
+		if err != nil {
+			return err
+		}
+		if !active {
+			return errorspkg.Validation(errorspkg.Field{Name: "type_id", Message: "archived"})
+		}
+		return nil
+	}
+
+	e, err := s.repo.UpdateEquipment(ctx, id, in, check)
+	switch {
+	case errors.Is(err, ErrNotFound):
+		return nil, ErrEquipmentNotFound
+	case errors.Is(err, errTypeGone):
+		return nil, errorspkg.Validation(errorspkg.Field{Name: "type_id", Message: "not_found"})
+	case err != nil:
+		return nil, err
+	}
+	resp := toEquipmentResponse(*e)
+	return &resp, nil
+}
+
+func (s *Service) DeleteEquipment(ctx context.Context, id string) (string, error) {
+	if uuid.Validate(id) != nil {
+		return "", ErrEquipmentNotFound
+	}
+	clientID, err := s.repo.DeleteEquipment(ctx, id)
+	if errors.Is(err, ErrNotFound) {
+		return "", ErrEquipmentNotFound
+	}
+	return clientID, err
+}
+
+// TypeOptions — опции формы единицы (ADR-102). currentTypeID == "" — новая единица.
+func (s *Service) TypeOptions(ctx context.Context, currentTypeID string) ([]TypeOption, error) {
+	return s.repo.TypeOptions(ctx, currentTypeID)
+}
+
+func toEquipmentResponse(e Equipment) EquipmentResponse {
+	specs := e.Specs
+	if specs == nil {
+		specs = []SpecDTO{}
+	}
+	return EquipmentResponse{
+		ID: e.ID, ClientID: e.ClientID, TypeID: e.TypeID, TypeName: e.TypeName, TypeIsActive: e.TypeIsActive,
+		Brand: e.Brand, Model: e.Model, SKU: e.SKU, Serial: e.Serial, Specs: specs, Note: e.Note,
+		CreatedAt: e.CreatedAt, UpdatedAt: e.UpdatedAt,
+	}
+}
diff --git a/internal/features/clients/ssr.go b/internal/features/clients/ssr.go
new file mode 100644
index 0000000..41bc2d1
--- /dev/null
+++ b/internal/features/clients/ssr.go
@@ -0,0 +1,589 @@
+package clients
+
+import (
+	"encoding/json"
+	"errors"
+	"strconv"
+
+	"github.com/gofiber/fiber/v3"
+	"github.com/google/uuid"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Root — шаблоны экрана «Клиенты» относительно корня модуля.
+const Root = "web/ssr/clients/templates"
+
+// SSR — экран «Клиенты» (/clients) + карточка клиента: список + формы создания/правки
+// (PRG), удаление (подтверждение), конфликт одновременной правки (ADR-005) + блок
+// «Оборудование клиента» и форма единицы оборудования (Phase 8).
+type SSR struct {
+	svc    *Service
+	r      *ssr.Renderer
+	shell  ssr.ShellBuilder
+	status *ssr.StatusPages
+}
+
+func NewSSR(svc *Service, r *ssr.Renderer, shell ssr.ShellBuilder, status *ssr.StatusPages) *SSR {
+	return &SSR{svc: svc, r: r, shell: shell, status: status}
+}
+
+// ListVM — список клиентов. Фильтр q — в URL (reload/назад/ссылка сохраняют состояние).
+type ListVM struct {
+	Shell ssr.Shell
+	Q     string
+	Flash string
+	Items []ClientResponse
+	Total int
+}
+
+// PhoneRow — строка телефона в form-view (совпадает с PhoneDTO, отдельный тип — вьюмодель
+// формы, не wire-контракт API).
+type PhoneRow struct {
+	Phone string
+	Note  string
+}
+
+// FormVM — форма клиента (создание/правка) + карточка (телефоны 1..N, версия, блок
+// «Оборудование клиента»).
+type FormVM struct {
+	Shell           ssr.Shell
+	IsNew           bool
+	ID              string
+	CompanyName     string
+	Address         string
+	ContactName     string
+	ContactPosition string
+	Phones          []PhoneRow
+	Version         int64
+	EquipmentCount  int
+	Equipment       []EquipmentRow
+	Flash           string            // flash после PRG-редиректа на карточку (created/saved/eq_*)
+	Errors          map[string]string // поле → текст ошибки
+	Error           string            // общая ошибка формы
+	Conflict        bool              // ADR-005: 409 → ссылка «Открыть актуальную версию»
+}
+
+// EquipmentRow — строка блока «Оборудование клиента» в карточке.
+type EquipmentRow struct {
+	ID           string
+	Model        string
+	TypeName     string
+	TypeIsActive bool
+	Serial       string
+}
+
+var flashes = map[string]string{
+	"created":    "Клиент создан",
+	"saved":      "Изменения сохранены",
+	"deleted":    "Клиент удалён",
+	"eq_created": "Оборудование добавлено",
+	"eq_saved":   "Оборудование сохранено",
+	"eq_deleted": "Оборудование удалено",
+}
+
+// list — GET /clients.
+func (h *SSR) list(c fiber.Ctx) error {
+	vm := ListVM{Q: c.Query("q"), Flash: flashes[c.Query("flash")]}
+	resp, err := h.svc.List(c.Context(), ListQuery{Q: vm.Q, Limit: maxLimit})
+	if err != nil {
+		return err
+	}
+	vm.Items, vm.Total = resp.Items, resp.Total
+	vm.Shell = h.shell.Build(c, "Клиенты")
+	return h.r.Page(c, "list", vm)
+}
+
+// formNew — GET /clients/new.
+func (h *SSR) formNew(c fiber.Ctx) error {
+	return h.renderForm(c, fiber.StatusOK, FormVM{IsNew: true, Phones: []PhoneRow{{}}})
+}
+
+// create — POST /clients. Редирект — на карточку созданного клиента (design-go-layers.md
+// §SSR Routes: `/clients/{id}?flash=created`), не на список (code review LOW#3).
+func (h *SSR) create(c fiber.Ctx) error {
+	vm := formFrom(c)
+	vm.IsNew = true
+	cl, err := h.svc.Create(c.Context(), inputFrom(vm))
+	if err != nil {
+		return h.formError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/clients/" + cl.ID + "?flash=created")
+}
+
+// formEdit — GET /clients/:id.
+func (h *SSR) formEdit(c fiber.Ctx) error {
+	cl, err := h.svc.Get(c.Context(), c.Params("id"))
+	if errors.Is(err, ErrClientNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	vm := vmFromResponse(*cl)
+	vm.Flash = flashes[c.Query("flash")]
+	eq, err := h.svc.ListEquipment(c.Context(), cl.ID, 0, 0)
+	if err != nil {
+		return err
+	}
+	vm.Equipment = equipmentRowsOf(eq.Items)
+	return h.renderForm(c, fiber.StatusOK, vm)
+}
+
+func equipmentRowsOf(items []EquipmentResponse) []EquipmentRow {
+	out := make([]EquipmentRow, len(items))
+	for i, e := range items {
+		out[i] = EquipmentRow{ID: e.ID, Model: e.Model, TypeName: e.TypeName, TypeIsActive: e.TypeIsActive, Serial: e.Serial}
+	}
+	return out
+}
+
+// update — POST /clients/:id. Version пуст/битый → nil → сервис вернёт 400 version:
+// required (ADR-100), как на JSON API. Редирект на успехе — карточка (design-go-layers.md
+// §SSR Routes: `/clients/{id}?flash=saved`, code review LOW#3).
+func (h *SSR) update(c fiber.Ctx) error {
+	vm := formFrom(c)
+	vm.ID = c.Params("id")
+
+	var version *int64
+	if raw := c.FormValue("version"); raw != "" {
+		if v, err := strconv.ParseInt(raw, 10, 64); err == nil {
+			version = &v
+			vm.Version = v
+		}
+	}
+
+	_, err := h.svc.Update(c.Context(), vm.ID, version, inputFrom(vm))
+	if errors.Is(err, ErrClientNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		// блок «Оборудование клиента» не должен пропадать при перерисовке формы (422/409) —
+		// раньше vm.Equipment оставался пуст на любой ошибке сохранения (code review LOW#4).
+		if eq, eqErr := h.svc.ListEquipment(c.Context(), vm.ID, 0, 0); eqErr == nil {
+			vm.Equipment = equipmentRowsOf(eq.Items)
+			vm.EquipmentCount = eq.Total
+		}
+		return h.formError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/clients/" + vm.ID + "?flash=saved")
+}
+
+// remove — POST /clients/:id/delete.
+func (h *SSR) remove(c fiber.Ctx) error {
+	id := c.Params("id")
+	err := h.svc.Delete(c.Context(), id)
+	if errors.Is(err, ErrClientNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/clients?flash=deleted")
+}
+
+// --- Оборудование клиента (Phase 8): форма создания/правки единицы, привязанной к
+// клиенту (ADR-102 — TypeOptions читает equipment_types напрямую SQL, без Go-импорта
+// пакета equipmenttypes). ---
+
+// SpecRow — строка характеристики в form-view (совпадает с SpecDTO, вьюмодель формы).
+type SpecRow struct {
+	K string
+	V string
+}
+
+// TypeOptionVM — опция <select> формы единицы; SpecKeysJSON — JSON-массив ключей типа
+// для data-spec-keys (JS подставляет шаблон характеристик при смене типа, ADR-002).
+type TypeOptionVM struct {
+	ID           string
+	Name         string
+	IsActive     bool
+	SpecKeysJSON string
+}
+
+// EquipmentFormVM — форма единицы оборудования (создание/правка).
+type EquipmentFormVM struct {
+	Shell      ssr.Shell
+	IsNew      bool
+	ID         string
+	ClientID   string
+	ClientName string
+	TypeID     string
+	Brand      string
+	Model      string
+	SKU        string
+	Serial     string
+	Note       string
+	Specs      []SpecRow
+	Types      []TypeOptionVM
+	Errors     map[string]string
+	Error      string
+}
+
+// eqNew — GET /clients/:id/equipment/new.
+func (h *SSR) eqNew(c fiber.Ctx) error {
+	clientID := c.Params("id")
+	cl, err := h.svc.Get(c.Context(), clientID)
+	if errors.Is(err, ErrClientNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	vm := EquipmentFormVM{IsNew: true, ClientID: clientID, ClientName: cl.CompanyName, Specs: []SpecRow{{}}}
+	return h.renderEquipmentForm(c, fiber.StatusOK, vm)
+}
+
+// eqCreate — POST /clients/:id/equipment.
+func (h *SSR) eqCreate(c fiber.Ctx) error {
+	clientID := c.Params("id")
+	vm := equipmentFormFrom(c)
+	vm.IsNew = true
+	vm.ClientID = clientID
+	if cl, err := h.svc.Get(c.Context(), clientID); err == nil {
+		vm.ClientName = cl.CompanyName
+	}
+
+	_, err := h.svc.CreateEquipment(c.Context(), clientID, equipmentInputFrom(vm))
+	if errors.Is(err, ErrClientNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return h.equipmentFormError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/clients/" + clientID + "?flash=eq_created")
+}
+
+// eqEdit — GET /equipment/:id.
+func (h *SSR) eqEdit(c fiber.Ctx) error {
+	e, err := h.svc.GetEquipment(c.Context(), c.Params("id"))
+	if errors.Is(err, ErrEquipmentNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	clientName := ""
+	if cl, err := h.svc.Get(c.Context(), e.ClientID); err == nil {
+		clientName = cl.CompanyName
+	}
+	return h.renderEquipmentForm(c, fiber.StatusOK, vmFromEquipment(*e, clientName))
+}
+
+// eqUpdate — POST /equipment/:id (LWW, без version — D28).
+func (h *SSR) eqUpdate(c fiber.Ctx) error {
+	id := c.Params("id")
+	cur, err := h.svc.GetEquipment(c.Context(), id)
+	if errors.Is(err, ErrEquipmentNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+
+	vm := equipmentFormFrom(c)
+	vm.ID = id
+	vm.ClientID = cur.ClientID
+	if cl, gerr := h.svc.Get(c.Context(), cur.ClientID); gerr == nil {
+		vm.ClientName = cl.CompanyName
+	}
+
+	_, err = h.svc.UpdateEquipment(c.Context(), id, equipmentInputFrom(vm))
+	if errors.Is(err, ErrEquipmentNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return h.equipmentFormError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/clients/" + cur.ClientID + "?flash=eq_saved")
+}
+
+// eqRemove — POST /equipment/:id/delete.
+func (h *SSR) eqRemove(c fiber.Ctx) error {
+	clientID, err := h.svc.DeleteEquipment(c.Context(), c.Params("id"))
+	if errors.Is(err, ErrEquipmentNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/clients/" + clientID + "?flash=eq_deleted")
+}
+
+// equipmentFormFrom — поля формы из тела POST, перерисовываются НОРМАЛИЗОВАННЫМ списком
+// характеристик (EquipmentInput.normalize() — та же нормализация, что validate()): индексы
+// `specs[i].k` считаются по нормализованному списку (design-errors.md) — vm.Specs должен
+// быть тем же списком, иначе ошибка индекса рисуется не под той строкой (code review MEDIUM-2).
+func equipmentFormFrom(c fiber.Ctx) EquipmentFormVM {
+	in := EquipmentInput{
+		TypeID: c.FormValue("type_id"),
+		Brand:  c.FormValue("brand"),
+		Model:  c.FormValue("model"),
+		SKU:    c.FormValue("sku"),
+		Serial: c.FormValue("serial"),
+		Note:   c.FormValue("note"),
+		Specs:  specsFrom(c),
+	}.normalize()
+	rows := make([]SpecRow, len(in.Specs))
+	for i, sp := range in.Specs {
+		rows[i] = SpecRow{K: sp.K, V: sp.V}
+	}
+	if len(rows) == 0 {
+		rows = []SpecRow{{}}
+	}
+	return EquipmentFormVM{
+		TypeID: in.TypeID,
+		Brand:  in.Brand,
+		Model:  in.Model,
+		SKU:    in.SKU,
+		Serial: in.Serial,
+		Note:   in.Note,
+		Specs:  rows,
+	}
+}
+
+func specsFrom(c fiber.Ctx) []SpecDTO {
+	ks := c.Request().PostArgs().PeekMulti("spec_k")
+	vs := c.Request().PostArgs().PeekMulti("spec_v")
+	out := make([]SpecDTO, 0, len(ks))
+	for i := range ks {
+		v := ""
+		if i < len(vs) {
+			v = string(vs[i])
+		}
+		out = append(out, SpecDTO{K: string(ks[i]), V: v})
+	}
+	return out
+}
+
+func equipmentInputFrom(vm EquipmentFormVM) EquipmentInput {
+	specs := make([]SpecDTO, len(vm.Specs))
+	for i, sp := range vm.Specs {
+		specs[i] = SpecDTO{K: sp.K, V: sp.V}
+	}
+	return EquipmentInput{
+		TypeID: vm.TypeID, Brand: vm.Brand, Model: vm.Model, SKU: vm.SKU, Serial: vm.Serial,
+		Note: vm.Note, Specs: specs,
+	}
+}
+
+func vmFromEquipment(e EquipmentResponse, clientName string) EquipmentFormVM {
+	rows := make([]SpecRow, len(e.Specs))
+	for i, sp := range e.Specs {
+		rows[i] = SpecRow{K: sp.K, V: sp.V}
+	}
+	if len(rows) == 0 {
+		rows = []SpecRow{{}}
+	}
+	return EquipmentFormVM{
+		ID: e.ID, ClientID: e.ClientID, ClientName: clientName,
+		TypeID: e.TypeID, Brand: e.Brand, Model: e.Model, SKU: e.SKU, Serial: e.Serial,
+		Note: e.Note, Specs: rows,
+	}
+}
+
+// typeOptionsVM — TypeOption (repo) → опции <select> с JSON-шаблоном характеристик.
+func typeOptionsVM(opts []TypeOption) []TypeOptionVM {
+	out := make([]TypeOptionVM, len(opts))
+	for i, o := range opts {
+		keys := o.SpecKeys
+		if keys == nil {
+			keys = []string{}
+		}
+		b, _ := json.Marshal(keys)
+		out[i] = TypeOptionVM{ID: o.ID, Name: o.Name, IsActive: o.IsActive, SpecKeysJSON: string(b)}
+	}
+	return out
+}
+
+// equipmentFormError — ошибки сервиса → форма единицы с текстами (422 валидация; 404 —
+// уже обработан вызывающей стороной до попадания сюда).
+func (h *SSR) equipmentFormError(c fiber.Ctx, vm EquipmentFormVM, err error) error {
+	var app *errorspkg.AppError
+	if !errors.As(err, &app) || app.HTTP >= fiber.StatusInternalServerError {
+		return err
+	}
+	vm.Errors = map[string]string{}
+	for _, f := range app.Fields {
+		vm.Errors[f.Name] = equipmentFieldText(f.Name, f.Message)
+	}
+	if len(app.Fields) == 0 {
+		vm.Error = app.Message
+	}
+	status := app.HTTP
+	if len(app.Fields) > 0 {
+		status = fiber.StatusUnprocessableEntity
+	}
+	return h.renderEquipmentForm(c, status, vm)
+}
+
+// renderEquipmentForm — опции типа читаются заново на каждый рендер (ADR-102): включают
+// vm.TypeID, даже если он архивный (правка существующей единицы без смены типа).
+func (h *SSR) renderEquipmentForm(c fiber.Ctx, status int, vm EquipmentFormVM) error {
+	curTypeID := vm.TypeID
+	if uuid.Validate(curTypeID) != nil {
+		curTypeID = ""
+	}
+	opts, err := h.svc.TypeOptions(c.Context(), curTypeID)
+	if err != nil {
+		return err
+	}
+	vm.Types = typeOptionsVM(opts)
+
+	title := "Оборудование"
+	if vm.IsNew {
+		title = "Новое оборудование"
+	}
+	vm.Shell = h.shell.Build(c, title)
+	c.Status(status)
+	return h.r.Page(c, "equipment-form", vm)
+}
+
+// equipmentFieldText — код ошибки поля → текст под полем (design-errors.md §fieldText,
+// часть equipment).
+func equipmentFieldText(field, code string) string {
+	switch code {
+	case msgRequired:
+		if field == "type_id" {
+			return "Выберите тип"
+		}
+		return "Обязательное поле"
+	case msgTooLong:
+		return "Слишком длинное значение"
+	case msgTooMany:
+		return "Не больше 50 характеристик"
+	case msgInvalid, "not_found":
+		return "Тип не найден"
+	case "archived":
+		return "Тип в архиве — выберите другой"
+	case msgKeyRequired:
+		return "Укажите характеристику"
+	}
+	return "Недопустимое значение"
+}
+
+// formFrom — поля формы из тела POST, перерисовываются НОРМАЛИЗОВАННЫМ списком телефонов
+// (ClientInput.normalize() — та же нормализация, что использует validate()): индексы ошибок
+// `phones[i].phone` считаются по нормализованному списку (design-errors.md), поэтому и
+// vm.Phones должен быть тем же списком — иначе при отбросе пустых строк (напр.
+// ["", "abc"]) ошибка индекса 0 рисуется под неправильной строкой формы (code review MEDIUM-2).
+func formFrom(c fiber.Ctx) FormVM {
+	in := ClientInput{
+		CompanyName:     c.FormValue("company_name"),
+		Address:         c.FormValue("address"),
+		ContactName:     c.FormValue("contact_name"),
+		ContactPosition: c.FormValue("contact_position"),
+		Phones:          phonesFrom(c),
+	}.normalize()
+	rows := make([]PhoneRow, len(in.Phones))
+	for i, p := range in.Phones {
+		rows[i] = PhoneRow{Phone: p.Phone, Note: p.Note}
+	}
+	if len(rows) == 0 {
+		rows = []PhoneRow{{}}
+	}
+	return FormVM{
+		CompanyName:     in.CompanyName,
+		Address:         in.Address,
+		ContactName:     in.ContactName,
+		ContactPosition: in.ContactPosition,
+		Phones:          rows,
+	}
+}
+
+func phonesFrom(c fiber.Ctx) []PhoneDTO {
+	phones := c.Request().PostArgs().PeekMulti("phone")
+	notes := c.Request().PostArgs().PeekMulti("phone_note")
+	out := make([]PhoneDTO, 0, len(phones))
+	for i := range phones {
+		note := ""
+		if i < len(notes) {
+			note = string(notes[i])
+		}
+		out = append(out, PhoneDTO{Phone: string(phones[i]), Note: note})
+	}
+	return out
+}
+
+func inputFrom(vm FormVM) ClientInput {
+	phones := make([]PhoneDTO, len(vm.Phones))
+	for i, p := range vm.Phones {
+		phones[i] = PhoneDTO{Phone: p.Phone, Note: p.Note}
+	}
+	return ClientInput{
+		CompanyName:     vm.CompanyName,
+		Address:         vm.Address,
+		ContactName:     vm.ContactName,
+		ContactPosition: vm.ContactPosition,
+		Phones:          phones,
+	}
+}
+
+func vmFromResponse(cl ClientResponse) FormVM {
+	rows := make([]PhoneRow, len(cl.Phones))
+	for i, p := range cl.Phones {
+		rows[i] = PhoneRow{Phone: p.Phone, Note: p.Note}
+	}
+	if len(rows) == 0 {
+		rows = []PhoneRow{{}}
+	}
+	return FormVM{
+		ID: cl.ID, CompanyName: cl.CompanyName, Address: cl.Address,
+		ContactName: cl.ContactName, ContactPosition: cl.ContactPosition,
+		Phones: rows, Version: cl.Version, EquipmentCount: cl.EquipmentCount,
+	}
+}
+
+// formError — ошибки сервиса → форма с текстами (422 валидация, 409 конфликт версии —
+// эталон users/ssr.go formError; ветка ErrClientVersionConflict — ADR-005).
+func (h *SSR) formError(c fiber.Ctx, vm FormVM, err error) error {
+	var app *errorspkg.AppError
+	if !errors.As(err, &app) || app.HTTP >= fiber.StatusInternalServerError {
+		return err
+	}
+	vm.Errors = map[string]string{}
+	for _, f := range app.Fields {
+		vm.Errors[f.Name] = fieldText(f.Name, f.Message)
+	}
+	switch {
+	case errors.Is(err, ErrClientVersionConflict):
+		vm.Error = ErrClientVersionConflict.Message
+		vm.Conflict = true
+	case len(app.Fields) == 0:
+		vm.Error = app.Message
+	}
+	status := app.HTTP
+	if len(app.Fields) > 0 {
+		status = fiber.StatusUnprocessableEntity
+	}
+	return h.renderForm(c, status, vm)
+}
+
+func (h *SSR) renderForm(c fiber.Ctx, status int, vm FormVM) error {
+	title := "Клиент"
+	if vm.IsNew {
+		title = "Новый клиент"
+	}
+	vm.Shell = h.shell.Build(c, title)
+	c.Status(status)
+	return h.r.Page(c, "form", vm)
+}
+
+// fieldText — код ошибки поля → текст под полем (design-errors.md §fieldText, часть clients).
+func fieldText(field, code string) string {
+	switch code {
+	case msgRequired:
+		if field == "phones" {
+			return "Укажите хотя бы один телефон"
+		}
+		return "Обязательное поле"
+	case msgTooLong:
+		return "Слишком длинное значение"
+	case msgTooMany:
+		return "Не больше 20 телефонов"
+	case msgInvalidFormat:
+		return "Номер должен содержать цифры"
+	}
+	return "Недопустимое значение"
+}
diff --git a/internal/features/clients/validate.go b/internal/features/clients/validate.go
