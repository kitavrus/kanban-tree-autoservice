+func (s *TypesLiveSuite) newType(name string) typeDTO {
+	st, tp, raw := s.create(s.admin, map[string]any{"name": name, "spec_keys": []string{"Мощность", "Напряжение"}})
+	s.Require().Equal(http.StatusCreated, st, string(raw))
+	return tp
+}
