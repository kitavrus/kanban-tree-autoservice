@@ -0,0 +1,194 @@
+package equipmenttypes
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+// Type — тип оборудования (repo-модель).
+type Type struct {
+	ID             string
+	Name           string
+	SpecKeys       []string
+	IsActive       bool
+	EquipmentCount int
+	CreatedAt      time.Time
+	UpdatedAt      time.Time
+}
+
+type Repo struct {
+	pool *pgxpool.Pool
+}
+
+func NewRepo(pool *pgxpool.Pool) *Repo { return &Repo{pool: pool} }
+
+var (
+	ErrNotFound     = pgx.ErrNoRows
+	errNameTaken    = errors.New("equipmenttypes: name taken")
+	errNameArchived = errors.New("equipmenttypes: name archived")
+	errInUse        = errors.New("equipmenttypes: in use")
+)
+
+// listColumns — проекция списка/получения (design-sql.md `## List/Get Equipment Type Query`).
+const listColumns = `t.id, t.name, t.spec_keys, t.is_active, t.created_at, t.updated_at,
+	(SELECT count(*) FROM equipment e WHERE e.type_id = t.id)`
+
+func scanWithCount(row pgx.Row) (*Type, error) {
+	var t Type
+	if err := row.Scan(&t.ID, &t.Name, &t.SpecKeys, &t.IsActive, &t.CreatedAt, &t.UpdatedAt, &t.EquipmentCount); err != nil {
+		return nil, err
+	}
+	return &t, nil
+}
+
+// ListParams — фильтры списка. IncludeArchived — сервис уже применил ADR-004
+// (!isAdmin → false).
+type ListParams struct {
+	Q               string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+func (r *Repo) List(ctx context.Context, p ListParams) ([]Type, int, error) {
+	var conds []string
+	var args []any
+	add := func(cond string, val any) {
+		args = append(args, val)
+		conds = append(conds, fmt.Sprintf(cond, len(args)))
+	}
+	if !p.IncludeArchived {
+		conds = append(conds, "is_active")
+	}
+	if p.Q != "" {
+		add("name ILIKE $%d", "%"+sqlutil.EscapeLike(p.Q)+"%")
+	}
+	where := ""
+	if len(conds) > 0 {
+		where = " WHERE " + strings.Join(conds, " AND ")
+	}
+
+	var total int
+	if err := r.pool.QueryRow(ctx, `SELECT count(*) FROM equipment_types`+where, args...).Scan(&total); err != nil {
+		return nil, 0, err
+	}
+	// id вторым ключом сортировки — стабильный порядок строк с равным именем.
+	q := `SELECT ` + listColumns + ` FROM equipment_types t` + where +
+		fmt.Sprintf(" ORDER BY lower(t.name), t.id LIMIT $%d OFFSET $%d", len(args)+1, len(args)+2)
+	rows, err := r.pool.Query(ctx, q, append(args, p.Limit, p.Offset)...)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer rows.Close()
+	out := []Type{}
+	for rows.Next() {
+		t, err := scanWithCount(rows)
+		if err != nil {
+			return nil, 0, err
+		}
+		out = append(out, *t)
+	}
+	return out, total, rows.Err()
+}
+
+// Get — id уже провалидирован как uuid сервисом.
+func (r *Repo) Get(ctx context.Context, id string) (*Type, error) {
+	return scanWithCount(r.pool.QueryRow(ctx, `SELECT `+listColumns+` FROM equipment_types t WHERE t.id = $1::uuid`, id))
+}
+
+// Create — INSERT; 23505 (equipment_types_name_lower_uq) → errNameTaken/errNameArchived
+// в зависимости от is_active строки-конфликта (ADR-007).
+func (r *Repo) Create(ctx context.Context, in Input) (*Type, error) {
+	var t Type
+	err := r.pool.QueryRow(ctx,
+		`INSERT INTO equipment_types (name, spec_keys) VALUES ($1, $2::text[])
+		 RETURNING id, name, spec_keys, is_active, created_at, updated_at`,
+		in.Name, in.SpecKeys).Scan(&t.ID, &t.Name, &t.SpecKeys, &t.IsActive, &t.CreatedAt, &t.UpdatedAt)
+	if err != nil {
+		return nil, r.mapNameConflict(ctx, in.Name, err)
+	}
+	// Новый тип ещё не может использоваться в оборудовании.
+	t.EquipmentCount = 0
+	return &t, nil
+}
+
+// Update — полная замена карточки типа; ErrNoRows → ErrNotFound (сервис маппит),
+// 23505 → как в Create (конфликт по строке ≠ правимая запись).
+func (r *Repo) Update(ctx context.Context, id string, in Input) (*Type, error) {
+	var t Type
+	err := r.pool.QueryRow(ctx,
+		`UPDATE equipment_types SET name = $2, spec_keys = $3::text[], is_active = $4, updated_at = now()
+		 WHERE id = $1::uuid RETURNING id, name, spec_keys, is_active, created_at, updated_at`,
+		id, in.Name, in.SpecKeys, in.IsActive).Scan(&t.ID, &t.Name, &t.SpecKeys, &t.IsActive, &t.CreatedAt, &t.UpdatedAt)
+	if err != nil {
+		return nil, r.mapNameConflict(ctx, in.Name, err)
+	}
+	cnt, err := r.equipmentCount(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	t.EquipmentCount = cnt
+	return &t, nil
+}
+
+// SetActive — SSR archive/restore, без перезаписи имени.
+func (r *Repo) SetActive(ctx context.Context, id string, active bool) error {
+	tag, err := r.pool.Exec(ctx, `UPDATE equipment_types SET is_active = $2, updated_at = now() WHERE id = $1::uuid`, id, active)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrNotFound
+	}
+	return nil
+}
+
+// Delete — RowsAffected 0 → ErrNotFound; FK-нарушение (equipment_type_id_fkey, RESTRICT)
+// → errInUse. Postgres на явный ON DELETE RESTRICT отдаёт SQLSTATE 23001
+// (restrict_violation), а не 23503 (foreign_key_violation, NO ACTION) — проверяем оба.
+func (r *Repo) Delete(ctx context.Context, id string) error {
+	tag, err := r.pool.Exec(ctx, `DELETE FROM equipment_types WHERE id = $1::uuid`, id)
+	if err != nil {
+		var pgErr *pgconn.PgError
+		if errors.As(err, &pgErr) && (pgErr.Code == "23503" || pgErr.Code == "23001") {
+			return errInUse
+		}
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return ErrNotFound
+	}
+	return nil
+}
+
+func (r *Repo) equipmentCount(ctx context.Context, typeID string) (int, error) {
+	var n int
+	err := r.pool.QueryRow(ctx, `SELECT count(*) FROM equipment WHERE type_id = $1::uuid`, typeID).Scan(&n)
+	return n, err
+}
+
+// mapNameConflict — 23505 (equipment_types_name_lower_uq) → errNameTaken (строка-конфликт
+// активна) | errNameArchived (в архиве); прочие ошибки (в т.ч. pgx.ErrNoRows) — как есть.
+func (r *Repo) mapNameConflict(ctx context.Context, name string, err error) error {
+	var pgErr *pgconn.PgError
+	if !errors.As(err, &pgErr) || pgErr.Code != "23505" {
+		return err
+	}
+	var active bool
+	if scanErr := r.pool.QueryRow(ctx,
+		`SELECT is_active FROM equipment_types WHERE lower(btrim(name)) = lower(btrim($1))`, name).Scan(&active); scanErr != nil {
+		return err
+	}
+	if active {
+		return errNameTaken
+	}
+	return errNameArchived
+}
diff --git a/internal/features/equipmenttypes/routes.go b/internal/features/equipmenttypes/routes.go
new file mode 100644
index 0000000..6c104ed
--- /dev/null
+++ b/internal/features/equipmenttypes/routes.go
@@ -0,0 +1,39 @@
+package equipmenttypes
+
+import (
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/server/middleware"
+)
+
+// Register — JSON API /api/v1/equipment-types (D28: !isAdmin — только чтение активных
+// типов, мутации — admin) + SSR-экран /catalog/equipment-types (только admin,
+// ADR-005/ADR-006). GET /catalog — 303 на список типов (единственный подраздел каталога
+// на эту фазу). При s == nil SSR-группа не регистрируется (используется в тестах,
+// где рендерер не нужен).
+func Register(app *fiber.App, api fiber.Router, a *middleware.Auth, h *Handler, s *SSR) {
+	admin := middleware.RequireAdmin(nil)
+	g := api.Group("/equipment-types", a.RequireAPI())
+	g.Get("", h.List)
+	g.Post("", admin, h.Create)
+	g.Get("/:id", h.Get)
+	g.Put("/:id", admin, h.Update)
+	g.Delete("/:id", admin, h.Delete)
+
+	if s == nil {
+		return
+	}
+	ssrAdmin := middleware.RequireAdmin(s.status.Forbidden)
+	app.Get("/catalog", a.RequireSSR(), ssrAdmin, func(c fiber.Ctx) error {
+		return c.Redirect().Status(fiber.StatusSeeOther).To("/catalog/equipment-types")
+	})
+	p := app.Group("/catalog/equipment-types", a.RequireSSR(), ssrAdmin)
+	p.Get("", s.list)
+	p.Get("/new", s.formNew)
+	p.Post("", s.create)
+	p.Get("/:id", s.formEdit)
+	p.Post("/:id", s.update)
+	p.Post("/:id/archive", s.archive)
+	p.Post("/:id/restore", s.restore)
+	p.Post("/:id/delete", s.remove)
+}
diff --git a/internal/features/equipmenttypes/service.go b/internal/features/equipmenttypes/service.go
new file mode 100644
index 0000000..504d2f5
--- /dev/null
+++ b/internal/features/equipmenttypes/service.go
@@ -0,0 +1,166 @@
+package equipmenttypes
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+	"github.com/kitavrus/kanban-tree/pkg/sqlutil"
+)
+
+var (
+	ErrTypeNotFound  = errorspkg.New("EQUIPMENT_TYPE_NOT_FOUND", http.StatusNotFound, "Тип оборудования не найден")
+	ErrTypeNameTaken = errorspkg.New("EQUIPMENT_TYPE_NAME_TAKEN", http.StatusConflict, "Такой тип уже есть")
+	// ADR-007: отдельный код → клиент показывает CTA «Вернуть из архива» по code, не по тексту.
+	ErrTypeNameArchived = errorspkg.New("EQUIPMENT_TYPE_NAME_ARCHIVED", http.StatusConflict,
+		"Такой тип уже есть в архиве — верните его из архива")
+	ErrTypeInUse = errorspkg.New("EQUIPMENT_TYPE_IN_USE", http.StatusConflict,
+		"Тип используется в оборудовании клиентов — удалить нельзя, отправьте его в архив")
+)
+
+const (
+	// defaultLimit/maxLimit — 500: список типов используется как lookup (комбобокс).
+	defaultLimit = 500
+	maxLimit     = 500
+)
+
+type Service struct {
+	repo *Repo
+}
+
+func NewService(pool *pgxpool.Pool) *Service {
+	return &Service{repo: NewRepo(pool)}
+}
+
+// ListQuery — параметры списка из HTTP-слоя (сырые).
+type ListQuery struct {
+	Q               string
+	IncludeArchived bool
+	Limit, Offset   int
+}
+
+// List — !isAdmin форсирует IncludeArchived=false (ADR-004): исполнитель видит
+// только активные типы, даже если сам попросил include_archived=true.
+func (s *Service) List(ctx context.Context, q ListQuery, isAdmin bool) (*TypeListResponse, error) {
+	limit, offset := q.Limit, q.Offset
+	if limit <= 0 {
+		limit = defaultLimit
+	}
+	limit = min(limit, maxLimit)
+	offset = max(offset, 0)
+	includeArchived := q.IncludeArchived && isAdmin
+
+	query := strings.TrimSpace(q.Q)
+	if sqlutil.HasInvalidText(query) {
+		// NUL-байт / невалидный UTF-8 в q — не 500: фильтр игнорируется (200, как без q),
+		// а не ошибка (code review §TD-4).
+		query = ""
+	}
+	items, total, err := s.repo.List(ctx, ListParams{
+		Q: query, IncludeArchived: includeArchived, Limit: limit, Offset: offset,
+	})
+	if err != nil {
+		return nil, err
+	}
+	resp := &TypeListResponse{Items: make([]TypeResponse, len(items)), Total: total, Limit: limit, Offset: offset}
+	for i, t := range items {
+		resp.Items[i] = toResponse(t)
+	}
+	return resp, nil
+}
+
+func (s *Service) Get(ctx context.Context, id string) (*TypeResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrTypeNotFound
+	}
+	t, err := s.repo.Get(ctx, id)
+	if errors.Is(err, ErrNotFound) {
+		return nil, ErrTypeNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	resp := toResponse(*t)
+	return &resp, nil
+}
+
+func (s *Service) Create(ctx context.Context, in Input) (*TypeResponse, error) {
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	t, err := s.repo.Create(ctx, in)
+	switch {
+	case errors.Is(err, errNameTaken):
+		return nil, ErrTypeNameTaken
+	case errors.Is(err, errNameArchived):
+		return nil, ErrTypeNameArchived
+	case err != nil:
+		return nil, err
+	}
+	resp := toResponse(*t)
+	return &resp, nil
+}
+
+func (s *Service) Update(ctx context.Context, id string, in Input) (*TypeResponse, error) {
+	if uuid.Validate(id) != nil {
+		return nil, ErrTypeNotFound
+	}
+	in = in.normalize()
+	if f := in.validate(); len(f) > 0 {
+		return nil, errorspkg.Validation(f...)
+	}
+	t, err := s.repo.Update(ctx, id, in)
+	switch {
+	case errors.Is(err, ErrNotFound):
+		return nil, ErrTypeNotFound
+	case errors.Is(err, errNameTaken):
+		return nil, ErrTypeNameTaken
+	case errors.Is(err, errNameArchived):
+		return nil, ErrTypeNameArchived
+	case err != nil:
+		return nil, err
+	}
+	resp := toResponse(*t)
+	return &resp, nil
+}
+
+// SetActive — SSR archive/restore (Phase 4), без перезаписи имени.
+func (s *Service) SetActive(ctx context.Context, id string, active bool) error {
+	if uuid.Validate(id) != nil {
+		return ErrTypeNotFound
+	}
+	if err := s.repo.SetActive(ctx, id, active); errors.Is(err, ErrNotFound) {
+		return ErrTypeNotFound
+	} else if err != nil {
+		return err
+	}
+	return nil
+}
+
+func (s *Service) Delete(ctx context.Context, id string) error {
+	if uuid.Validate(id) != nil {
+		return ErrTypeNotFound
+	}
+	err := s.repo.Delete(ctx, id)
+	switch {
+	case errors.Is(err, ErrNotFound):
+		return ErrTypeNotFound
+	case errors.Is(err, errInUse):
+		return ErrTypeInUse
+	default:
+		return err
+	}
+}
+
+func toResponse(t Type) TypeResponse {
+	return TypeResponse{
+		ID: t.ID, Name: t.Name, SpecKeys: t.SpecKeys, IsActive: t.IsActive,
+		EquipmentCount: t.EquipmentCount, CreatedAt: t.CreatedAt, UpdatedAt: t.UpdatedAt,
+	}
+}
diff --git a/internal/features/equipmenttypes/ssr.go b/internal/features/equipmenttypes/ssr.go
new file mode 100644
index 0000000..3b3b0ea
--- /dev/null
+++ b/internal/features/equipmenttypes/ssr.go
@@ -0,0 +1,247 @@
+package equipmenttypes
+
+import (
+	"errors"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/gofiber/fiber/v3"
+
+	"github.com/kitavrus/kanban-tree/internal/ssr"
+	"github.com/kitavrus/kanban-tree/pkg/errorspkg"
+)
+
+// Root — шаблоны экрана «Каталог: типы оборудования» относительно корня модуля.
+const Root = "web/ssr/equipmenttypes/templates"
+
+// SSR — экран «Каталог: типы оборудования» (admin): список + формы создания/правки
+// (PRG), архив/восстановление, удаление свободного типа (AC-011, AC-012).
+type SSR struct {
+	svc    *Service
+	r      *ssr.Renderer
+	shell  ssr.ShellBuilder
+	status *ssr.StatusPages
+}
+
+func NewSSR(svc *Service, r *ssr.Renderer, shell ssr.ShellBuilder, status *ssr.StatusPages) *SSR {
+	return &SSR{svc: svc, r: r, shell: shell, status: status}
+}
+
+// ListVM — список типов. Фильтры (q, archived) — в URL: reload/назад/ссылка сохраняют
+// состояние (AC-011).
+type ListVM struct {
+	Shell    ssr.Shell
+	Q        string
+	Archived bool
+	Flash    string
+	Items    []TypeResponse
+	Total    int
+}
+
+// SpecKeysText — характеристики через запятую для списка («—», если пусто).
+func (t TypeResponse) SpecKeysText() string {
+	if len(t.SpecKeys) == 0 {
+		return "—"
+	}
+	return strings.Join(t.SpecKeys, ", ")
+}
+
+// FormVM — форма типа оборудования (создание/правка).
+type FormVM struct {
+	Shell          ssr.Shell
+	IsNew          bool
+	ID             string
+	Name           string
+	SpecKeys       string // одна строка через запятую — как вводит пользователь
+	IsActive       bool
+	EquipmentCount int
+	Errors         map[string]string // поле → текст ошибки
+	Error          string            // общая ошибка формы (в т.ч. ErrTypeInUse)
+	ArchivedLink   string            // ADR-007: имя занято архивным типом → ссылка «Показать архивные»
+}
+
+var flashes = map[string]string{
+	"created":  "Тип оборудования создан",
+	"saved":    "Изменения сохранены",
+	"archived": "Тип отправлен в архив",
+	"restored": "Тип возвращён из архива",
+	"deleted":  "Тип удалён",
+}
+
+// list — GET /catalog/equipment-types.
+func (h *SSR) list(c fiber.Ctx) error {
+	vm := ListVM{Q: c.Query("q"), Flash: flashes[c.Query("flash")]}
+	vm.Archived, _ = strconv.ParseBool(c.Query("archived"))
+	// SSR-экран доступен только admin (routes.go) — include_archived читаем как есть.
+	resp, err := h.svc.List(c.Context(), ListQuery{Q: vm.Q, IncludeArchived: vm.Archived, Limit: defaultLimit}, true)
+	if err != nil {
+		return err
+	}
+	vm.Items, vm.Total = resp.Items, resp.Total
+	vm.Shell = h.shell.Build(c, "Каталог: типы оборудования")
+	return h.r.Page(c, "list", vm)
+}
+
+// formNew — GET /catalog/equipment-types/new.
+func (h *SSR) formNew(c fiber.Ctx) error {
+	return h.renderForm(c, fiber.StatusOK, FormVM{IsNew: true, IsActive: true})
+}
+
+// create — POST /catalog/equipment-types.
+func (h *SSR) create(c fiber.Ctx) error {
+	vm := formFrom(c)
+	vm.IsNew = true
+	_, err := h.svc.Create(c.Context(), Input{Name: vm.Name, SpecKeys: ParseSpecKeys(vm.SpecKeys), IsActive: true})
+	if err != nil {
+		return h.formError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/catalog/equipment-types?flash=created")
+}
+
+// formEdit — GET /catalog/equipment-types/:id.
+func (h *SSR) formEdit(c fiber.Ctx) error {
+	t, err := h.svc.Get(c.Context(), c.Params("id"))
+	if errors.Is(err, ErrTypeNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	return h.renderForm(c, fiber.StatusOK, FormVM{
+		ID: t.ID, Name: t.Name, SpecKeys: strings.Join(t.SpecKeys, ", "),
+		IsActive: t.IsActive, EquipmentCount: t.EquipmentCount,
+	})
+}
+
+// update — POST /catalog/equipment-types/:id (is_active сохраняется как есть —
+// архивирование/восстановление отдельными маршрутами).
+func (h *SSR) update(c fiber.Ctx) error {
+	vm := formFrom(c)
+	vm.ID = c.Params("id")
+	cur, err := h.svc.Get(c.Context(), vm.ID)
+	if errors.Is(err, ErrTypeNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	vm.IsActive = cur.IsActive
+	vm.EquipmentCount = cur.EquipmentCount
+	_, err = h.svc.Update(c.Context(), vm.ID, Input{Name: vm.Name, SpecKeys: ParseSpecKeys(vm.SpecKeys), IsActive: cur.IsActive})
+	if err != nil {
+		return h.formError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/catalog/equipment-types?flash=saved")
+}
+
+// archive — POST /catalog/equipment-types/:id/archive. Редирект сохраняет фильтр
+// `archived`, с которым была отправлена форма (design-go-layers.md §SSR Routes: «фильтр
+// сохраняется: archived из формы») — НЕ форсирует archived=1 (это восстановление, code
+// review LOW#3).
+func (h *SSR) archive(c fiber.Ctx) error {
+	q := ""
+	if v := c.FormValue("archived"); v != "" {
+		q = "archived=" + url.QueryEscape(v) + "&"
+	}
+	return h.setActive(c, false, "archived", q)
+}
+
+// restore — POST /catalog/equipment-types/:id/restore. Редирект — всегда с archived=1
+// (design-go-layers.md §SSR Routes): восстановленный тип виден в архивном списке, откуда
+// обычно и вызывается «Вернуть».
+func (h *SSR) restore(c fiber.Ctx) error { return h.setActive(c, true, "restored", "archived=1&") }
+
+func (h *SSR) setActive(c fiber.Ctx, active bool, flash, q string) error {
+	id := c.Params("id")
+	err := h.svc.SetActive(c.Context(), id, active)
+	if errors.Is(err, ErrTypeNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		return err
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/catalog/equipment-types?" + q + "flash=" + flash)
+}
+
+// remove — POST /catalog/equipment-types/:id/delete. Используемый тип (409
+// EQUIPMENT_TYPE_IN_USE) → форма перерисовывается с ошибкой и видимой кнопкой «В архив».
+func (h *SSR) remove(c fiber.Ctx) error {
+	id := c.Params("id")
+	err := h.svc.Delete(c.Context(), id)
+	if errors.Is(err, ErrTypeNotFound) {
+		return h.status.NotFound(c)
+	}
+	if err != nil {
+		t, gerr := h.svc.Get(c.Context(), id)
+		if gerr != nil {
+			return err
+		}
+		vm := FormVM{ID: t.ID, Name: t.Name, SpecKeys: strings.Join(t.SpecKeys, ", "), IsActive: t.IsActive, EquipmentCount: t.EquipmentCount}
+		return h.formError(c, vm, err)
+	}
+	return c.Redirect().Status(fiber.StatusSeeOther).To("/catalog/equipment-types?flash=deleted")
+}
+
+func formFrom(c fiber.Ctx) FormVM {
+	return FormVM{Name: c.FormValue("name"), SpecKeys: c.FormValue("spec_keys")}
+}
+
+// formError — ошибки сервиса → форма с текстами (422 валидация, 409 конфликты —
+// эталон users/ssr.go formError).
+func (h *SSR) formError(c fiber.Ctx, vm FormVM, err error) error {
+	var app *errorspkg.AppError
+	if !errors.As(err, &app) || app.HTTP >= fiber.StatusInternalServerError {
+		return err
+	}
+	vm.Errors = map[string]string{}
+	for _, f := range app.Fields {
+		name := f.Name
+		if strings.HasPrefix(name, "spec_keys[") {
+			// SSR-форма — один текстовый инпут (spec_keys через запятую), без построчных
+			// индексов: любая ошибка отдельного ключа сворачивается в общую под полем.
+			name = "spec_keys"
+		}
+		vm.Errors[name] = fieldText(name, f.Message)
+	}
+	switch {
+	case errors.Is(err, ErrTypeNameTaken):
+		vm.Errors["name"] = ErrTypeNameTaken.Message
+	case errors.Is(err, ErrTypeNameArchived):
+		vm.Errors["name"] = ErrTypeNameArchived.Message
+		vm.ArchivedLink = "/catalog/equipment-types?archived=1&q=" + url.QueryEscape(vm.Name)
+	case errors.Is(err, ErrTypeInUse):
+		vm.Error = ErrTypeInUse.Message
+	case len(app.Fields) == 0:
+		vm.Error = app.Message
+	}
+	status := app.HTTP
+	if len(app.Fields) > 0 {
+		status = fiber.StatusUnprocessableEntity
+	}
+	return h.renderForm(c, status, vm)
+}
+
+func (h *SSR) renderForm(c fiber.Ctx, status int, vm FormVM) error {
+	title := "Тип оборудования"
+	if vm.IsNew {
+		title = "Новый тип оборудования"
+	}
+	vm.Shell = h.shell.Build(c, title)
+	c.Status(status)
+	return h.r.Page(c, "form", vm)
+}
+
+// fieldText — код ошибки поля → текст под полем (design-errors.md §fieldText).
+func fieldText(field, code string) string {
+	switch code {
+	case msgRequired:
+		return "Обязательное поле"
+	case msgTooLong:
+		return "Слишком длинное значение"
+	case msgTooMany:
+		return "Не больше 50 характеристик"
+	}
+	_ = field
+	return "Недопустимое значение"
+}
