+      <div id="phones-rows" class="row-list" data-row-list data-row-min="1" data-testid="phones-rows">
+        {{ range $i, $p := .Phones }}
+        <div class="row-list-item" data-testid="phone-row">
+          <div class="flex-grow-1">
+            <input type="text" name="phone" class="form-control{{ if index $.Errors (printf "phones[%d].phone" $i) }} is-invalid{{ end }}" value="{{ $p.Phone }}" placeholder="Телефон" maxlength="32" inputmode="tel" autocomplete="off" data-testid="phone-input">
+            {{ with index $.Errors (printf "phones[%d].phone" $i) }}<div class="invalid-feedback d-block" data-testid="error-phones-{{ $i }}">{{ . }}</div>{{ end }}
+          </div>
+          <input type="text" name="phone_note" class="form-control" value="{{ $p.Note }}" placeholder="Примечание" maxlength="200" autocomplete="off" data-testid="phone-note">
+          <button type="button" class="btn btn-outline-secondary" data-row-del aria-label="Удалить телефон" data-testid="phone-del">×</button>
+        </div>
+        {{ end }}
+        <template data-row-template>
+          <div class="row-list-item" data-testid="phone-row">
+            <div class="flex-grow-1">
+              <input type="text" name="phone" class="form-control" placeholder="Телефон" maxlength="32" inputmode="tel" autocomplete="off" data-testid="phone-input">
+            </div>
+            <input type="text" name="phone_note" class="form-control" placeholder="Примечание" maxlength="200" autocomplete="off" data-testid="phone-note">
+            <button type="button" class="btn btn-outline-secondary" data-row-del aria-label="Удалить телефон" data-testid="phone-del">×</button>
+          </div>
+        </template>
+      </div>
+      <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-row-add="phones-rows" data-testid="phone-add">+ Телефон</button>
+      {{ with index .Errors "phones" }}<div class="text-danger small mt-1" data-testid="error-phones">{{ . }}</div>{{ end }}
+    </div>
+    <div class="d-flex gap-2">
+      <button type="submit" class="btn btn-primary" data-testid="client-save">Сохранить</button>
+      <a href="/clients" class="btn btn-outline-secondary">Отмена</a>
+    </div>
+  </div>
+</form>
+{{ if not .IsNew }}
+<div class="card mw-760 mt-4">
+  <div class="card-body">
+    <div class="d-flex align-items-center mb-3">
+      <h2 class="fs-6 mb-0">Оборудование клиента</h2>
+      <a href="/clients/{{ .ID }}/equipment/new" class="btn btn-outline-secondary btn-sm ms-auto" data-testid="equipment-add">+ Оборудование</a>
+    </div>
+    {{ if .Equipment }}
+    <div class="table-responsive">
+    <table class="table table-hover align-middle" data-testid="equipment-table">
+      <thead>
+        <tr>
+          <th>Модель</th>
+          <th>Тип</th>
+          <th>Серийный номер</th>
+        </tr>
+      </thead>
+      <tbody>
+      {{ range .Equipment }}
+        <tr data-testid="equipment-row" data-model="{{ .Model }}">
+          <td><a href="/equipment/{{ .ID }}" class="fw-semibold">{{ .Model }}</a></td>
+          <td>{{ .TypeName }}{{ if not .TypeIsActive }} <span class="text-body-secondary small">(в архиве)</span>{{ end }}</td>
+          <td>{{ .Serial }}</td>
+        </tr>
+      {{ end }}
+      </tbody>
+    </table>
+    </div>
+    {{ else }}
+    <div class="empty-state" data-testid="equipment-empty">Оборудования пока нет</div>
+    {{ end }}
+  </div>
+</div>
+<form method="post" action="/clients/{{ .ID }}/delete" class="mt-3" data-testid="client-delete-form" data-confirm="Удалить клиента «{{ .CompanyName }}»? Единиц оборудования: {{ .EquipmentCount }}. Отменить нельзя.">
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+  <button type="submit" class="btn btn-link text-danger p-0" data-testid="client-delete">Удалить</button>
+</form>
+{{ end }}
+{{ end }}
+{{ define "scripts" }}
+<script src="/assets/ssr-shared/js/row-list.js"></script>
+{{ end }}
