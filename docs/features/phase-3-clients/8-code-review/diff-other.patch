diff --git a/web/ssr/equipmenttypes/templates/pages/form.html b/web/ssr/equipmenttypes/templates/pages/form.html
new file mode 100644
index 0000000..589912c
--- /dev/null
+++ b/web/ssr/equipmenttypes/templates/pages/form.html
@@ -0,0 +1,45 @@
+{{ define "content" }}
+<form class="card mw-760" method="post" action="{{ if .IsNew }}/catalog/equipment-types{{ else }}/catalog/equipment-types/{{ .ID }}{{ end }}" data-testid="type-form" novalidate>
+  <div class="card-body">
+    <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+    {{ if .Error }}<div class="alert alert-danger py-2" role="alert" data-testid="form-error">{{ .Error }}</div>{{ end }}
+    <div class="mb-3">
+      <label for="name" class="form-label">Название *</label>
+      <input id="name" name="name" class="form-control{{ if index .Errors "name" }} is-invalid{{ end }}" value="{{ .Name }}" maxlength="100" autocomplete="off" data-testid="type-name">
+      {{ with index .Errors "name" }}<div class="invalid-feedback" data-testid="error-name">{{ . }}</div>{{ end }}
+      {{ if .ArchivedLink }}<div class="form-text"><a href="{{ .ArchivedLink }}" data-testid="show-archived-link">Показать архивные</a></div>{{ end }}
+    </div>
+    <div class="mb-4">
+      <label for="spec_keys" class="form-label">Характеристики по умолчанию (через запятую)</label>
+      <input id="spec_keys" name="spec_keys" class="form-control{{ if index .Errors "spec_keys" }} is-invalid{{ end }}" value="{{ .SpecKeys }}" placeholder="Мощность, Хладагент, Объём бака" autocomplete="off" data-testid="type-spec-keys">
+      {{ with index .Errors "spec_keys" }}<div class="invalid-feedback" data-testid="error-spec_keys">{{ . }}</div>{{ end }}
+    </div>
+    <div class="d-flex gap-2">
+      <button type="submit" class="btn btn-primary" data-testid="type-save">Сохранить</button>
+      <a href="/catalog/equipment-types" class="btn btn-outline-secondary">Отмена</a>
+      {{ if not .IsNew }}
+      <button type="submit" form="type-archive-form" class="btn btn-outline-secondary ms-auto" data-testid="type-archive">{{ if .IsActive }}В архив{{ else }}Вернуть{{ end }}</button>
+      {{ end }}
+    </div>
+  </div>
+</form>
+{{ if not .IsNew }}
+<form id="type-archive-form" method="post" action="/catalog/equipment-types/{{ .ID }}/{{ if .IsActive }}archive{{ else }}restore{{ end }}" class="d-none" aria-hidden="true">
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+</form>
+<form method="post" action="/catalog/equipment-types/{{ .ID }}/delete" class="mt-3" data-testid="type-delete-form">
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+  <button type="submit" class="btn btn-link text-danger p-0" data-testid="type-delete" data-confirm="Удалить тип «{{ .Name }}»? Отменить нельзя.">Удалить</button>
+</form>
+{{ end }}
+{{ end }}
+{{ define "scripts" }}
+<script>
+document.querySelectorAll('[data-confirm]').forEach(function (btn) {
+  btn.addEventListener('click', async function (e) {
+    e.preventDefault();
+    if (await KT.uiConfirm(btn.getAttribute('data-confirm'))) btn.closest('form').submit();
+  });
+});
+</script>
+{{ end }}
diff --git a/web/ssr/equipmenttypes/templates/pages/list.html b/web/ssr/equipmenttypes/templates/pages/list.html
new file mode 100644
index 0000000..03ac3c0
--- /dev/null
+++ b/web/ssr/equipmenttypes/templates/pages/list.html
@@ -0,0 +1,43 @@
+{{ define "actions" }}<a href="/catalog/equipment-types/new" class="btn btn-primary" data-testid="type-add">+ Тип оборудования</a>{{ end }}
+{{ define "content" }}
+{{ if .Flash }}<div class="alert alert-success py-2" role="status" data-testid="flash">{{ .Flash }}</div>{{ end }}
+<form class="d-flex flex-wrap align-items-center gap-2 mb-3" method="get" action="/catalog/equipment-types" data-testid="types-filters">
+  <input class="form-control" style="max-width:280px" type="search" name="q" value="{{ .Q }}" placeholder="Поиск по названию" aria-label="Поиск" data-testid="filter-q">
+  <button class="btn btn-outline-secondary" type="submit">Найти</button>
+  <div class="form-check ms-2">
+    <input class="form-check-input" type="checkbox" id="archived" name="archived" value="1"{{ if .Archived }} checked{{ end }} onchange="this.form.submit()" data-testid="filter-archived">
+    <label class="form-check-label" for="archived">Показать архивные</label>
+  </div>
+  {{ if .Q }}<a class="btn btn-link" href="/catalog/equipment-types{{ if .Archived }}?archived=1{{ end }}" data-testid="filter-reset">Сбросить</a>{{ end }}
+</form>
+{{ if .Items }}
+<div class="table-responsive">
+<table class="table table-hover align-middle" data-testid="types-table">
+  <thead><tr><th>Название</th><th>Характеристики</th><th class="d-none d-md-table-cell">Единиц</th><th></th></tr></thead>
+  <tbody>
+  {{ range .Items }}
+    <tr data-testid="type-row" data-name="{{ .Name }}">
+      <td>
+        <a href="/catalog/equipment-types/{{ .ID }}" class="fw-semibold">{{ .Name }}</a>
+        {{ if not .IsActive }}<span class="badge-off" data-testid="type-archived-badge">в архиве</span>{{ end }}
+      </td>
+      <td class="text-body-secondary">{{ .SpecKeysText }}</td>
+      <td class="d-none d-md-table-cell">{{ .EquipmentCount }}</td>
+      <td class="text-end">
+        <form method="post" action="/catalog/equipment-types/{{ .ID }}/{{ if .IsActive }}archive{{ else }}restore{{ end }}" class="d-inline">
+          <input type="hidden" name="_csrf" value="{{ $.Shell.CSRFToken }}">
+          {{ if $.Archived }}<input type="hidden" name="archived" value="1">{{ end }}
+          <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="type-toggle-active">{{ if .IsActive }}В архив{{ else }}Вернуть{{ end }}</button>
+        </form>
+      </td>
+    </tr>
+  {{ end }}
+  </tbody>
+</table>
+</div>
+<p class="text-body-secondary small" data-testid="types-total">Типов: {{ .Total }}</p>
+{{ else }}
+<div class="empty-state" data-testid="types-empty">{{ if or .Q .Archived }}Ничего не нашли по фильтру.{{ else }}Типов пока нет.{{ end }}</div>
+{{ end }}
+<p class="text-body-secondary small mt-3">Характеристики типа подставляются полями при заведении оборудования клиента — остаётся заполнить значения.</p>
+{{ end }}
