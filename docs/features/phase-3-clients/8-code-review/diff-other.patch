diff --git a/web/ssr/_shared/js/row-list.js b/web/ssr/_shared/js/row-list.js
new file mode 100644
index 0000000..7838419
--- /dev/null
+++ b/web/ssr/_shared/js/row-list.js
@@ -0,0 +1,88 @@
+/* KT.rowList — динамические списки строк 1..N (телефоны клиента, характеристики
+   оборудования — ADR-002). Разметка:
+     <div id="phones-rows" data-row-list data-row-min="1">
+       <div>...строка: input[name=...] + [data-row-del]...</div>
+       ...
+       <template data-row-template><div>...пустая строка...</div></template>
+     </div>
+     <button data-row-add="phones-rows">+ Строка</button>
+   data-row-min="N" — ниже этого числа строк последняя строка НЕ удаляется, а очищается
+   (её значения сбрасываются в пустые) — «последняя строка телефонов очищается, не
+   удаляется» (ADR-002). KT.rowList.fill(el, rows) — программно заполнить список
+   массивом объектов {имя_поля: значение}; имя поля = атрибут name инпута строки. */
+(function () {
+  'use strict';
+  var KT = window.KT = window.KT || {};
+
+  function template(list) {
+    return Array.prototype.find.call(list.children, function (el) {
+      return el.tagName === 'TEMPLATE';
+    }) || null;
+  }
+
+  function rowsOf(list) {
+    var tpl = template(list);
+    return Array.prototype.filter.call(list.children, function (el) { return el !== tpl; });
+  }
+
+  function clearRow(row) {
+    row.querySelectorAll('input, textarea, select').forEach(function (el) { el.value = ''; });
+  }
+
+  function bindRow(list, row) {
+    var del = row.querySelector('[data-row-del]');
+    if (!del || del.dataset.rowBound) return;
+    del.dataset.rowBound = '1';
+    del.addEventListener('click', function (e) {
+      e.preventDefault();
+      var min = parseInt(list.getAttribute('data-row-min') || '0', 10);
+      if (rowsOf(list).length <= min) { clearRow(row); return; }
+      row.remove();
+    });
+  }
+
+  function newRow(list) {
+    var tpl = template(list);
+    if (!tpl || !tpl.content) return null;
+    var frag = tpl.content.cloneNode(true);
+    var row = frag.firstElementChild;
+    list.insertBefore(frag, tpl);
+    if (row) bindRow(list, row);
+    return row;
+  }
+
+  function addRow(list) {
+    var row = newRow(list);
+    if (!row) return row;
+    var focusEl = row.querySelector('input, textarea, select');
+    if (focusEl) focusEl.focus();
+    return row;
+  }
+
+  /** fill — очищает список и создаёт по одной строке на элемент rows (объект
+      {имя_поля: значение}); пустой rows — одна пустая строка (нечего удалять до 0). */
+  function fill(list, rows) {
+    rowsOf(list).forEach(function (r) { r.remove(); });
+    (rows && rows.length ? rows : [{}]).forEach(function (data) {
+      var row = newRow(list);
+      if (!row) return;
+      Object.keys(data || {}).forEach(function (k) {
+        var f = row.querySelector('[name="' + k + '"]');
+        if (f) f.value = data[k];
+      });
+    });
+  }
+
+  document.querySelectorAll('[data-row-list]').forEach(function (list) {
+    rowsOf(list).forEach(function (row) { bindRow(list, row); });
+  });
+  document.querySelectorAll('[data-row-add]').forEach(function (btn) {
+    btn.addEventListener('click', function (e) {
+      e.preventDefault();
+      var list = document.getElementById(btn.getAttribute('data-row-add'));
+      if (list) addRow(list);
+    });
+  });
+
+  KT.rowList = { fill: fill, addRow: addRow };
+})();
diff --git a/web/ssr/_shared/js/ui-dialog.js b/web/ssr/_shared/js/ui-dialog.js
index a0a2433..5b110e7 100644
--- a/web/ssr/_shared/js/ui-dialog.js
+++ b/web/ssr/_shared/js/ui-dialog.js
@@ -82,4 +82,32 @@
   KT.uiPrompt = function (title, value) { return uiDialog({ title: title, input: value == null ? '' : String(value) }); };
   KT.uiConfirm = function (text, ok) { return uiDialog({ title: 'Подтверждение', text: text, ok: ok || 'Удалить', danger: true }); };
   KT.uiAlert = function (text, title) { return uiDialog({ title: title || 'Нельзя', text: text, cancel: null }); };
+
+  /* Делегированный submit-обработчик форм (ADR-103, Tech Spec «Двойной submit»):
+       form[data-confirm="текст"] — сабмит перехватывается, показывается KT.uiConfirm;
+       подтвердили → реальный сабмит через HTMLFormElement.prototype.submit (минуя
+       повторную отправку события submit, иначе бесконечный цикл); отменили → ничего
+       не отправляется. form[data-once] — на настоящем сабмите (после возможного
+       confirm) кнопка отправки блокируется, чтобы повторный клик/Enter не отправил
+       форму дважды, пока идёт PRG-редирект. */
+  document.addEventListener('submit', function (e) {
+    var form = e.target;
+    if (!(form instanceof HTMLFormElement)) return;
+
+    if (form.matches('[data-confirm]') && !form.dataset.confirmed) {
+      e.preventDefault();
+      KT.uiConfirm(form.getAttribute('data-confirm')).then(function (ok) {
+        if (!ok) return;
+        form.dataset.confirmed = '1';
+        HTMLFormElement.prototype.submit.call(form);
+      });
+      return;
+    }
+
+    if (form.matches('[data-once]') && !form.dataset.submitted) {
+      form.dataset.submitted = '1';
+      var btn = form.querySelector('button[type="submit"]');
+      if (btn) btn.disabled = true;
+    }
+  });
 })();
diff --git a/web/ssr/clients/templates/pages/equipment-form.html b/web/ssr/clients/templates/pages/equipment-form.html
new file mode 100644
index 0000000..42437cd
--- /dev/null
+++ b/web/ssr/clients/templates/pages/equipment-form.html
@@ -0,0 +1,135 @@
+{{ define "content" }}
+<form class="card mw-760" method="post" action="{{ if .IsNew }}/clients/{{ .ClientID }}/equipment{{ else }}/equipment/{{ .ID }}{{ end }}" data-testid="equipment-form" data-once novalidate>
+  <div class="card-body">
+    <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+    <p class="text-body-secondary small" data-testid="equipment-client-name">{{ .ClientName }}</p>
+    {{ if .Error }}<div class="alert alert-danger py-2" role="alert" data-testid="form-error">{{ .Error }}</div>{{ end }}
+    <div class="mb-3">
+      <label for="type_id" class="form-label">Тип *</label>
+      <select id="type_id" name="type_id" class="form-select{{ if index .Errors "type_id" }} is-invalid{{ end }}" data-testid="equipment-type">
+        <option value=""></option>
+        {{ range .Types }}
+        <option value="{{ .ID }}" data-spec-keys='{{ .SpecKeysJSON }}'{{ if eq .ID $.TypeID }} selected{{ end }}>{{ .Name }}{{ if not .IsActive }} (в архиве){{ end }}</option>
+        {{ end }}
+      </select>
+      {{ with index .Errors "type_id" }}<div class="invalid-feedback d-block" data-testid="error-type_id">{{ . }}</div>{{ end }}
+    </div>
+    <div class="row g-3 mb-3">
+      <div class="col-sm-6">
+        <label for="brand" class="form-label">Производитель</label>
+        <input id="brand" name="brand" class="form-control{{ if index .Errors "brand" }} is-invalid{{ end }}" value="{{ .Brand }}" maxlength="200" autocomplete="off">
+        {{ with index .Errors "brand" }}<div class="invalid-feedback" data-testid="error-brand">{{ . }}</div>{{ end }}
+      </div>
+      <div class="col-sm-6">
+        <label for="model" class="form-label">Модель *</label>
+        <input id="model" name="model" class="form-control{{ if index .Errors "model" }} is-invalid{{ end }}" value="{{ .Model }}" maxlength="200" autocomplete="off">
+        {{ with index .Errors "model" }}<div class="invalid-feedback" data-testid="error-model">{{ . }}</div>{{ end }}
+      </div>
+    </div>
+    <div class="row g-3 mb-3">
+      <div class="col-sm-6">
+        <label for="sku" class="form-label">Артикул / партномер</label>
+        <input id="sku" name="sku" class="form-control{{ if index .Errors "sku" }} is-invalid{{ end }}" value="{{ .SKU }}" maxlength="200" autocomplete="off">
+        {{ with index .Errors "sku" }}<div class="invalid-feedback" data-testid="error-sku">{{ . }}</div>{{ end }}
+      </div>
+      <div class="col-sm-6">
+        <label for="serial" class="form-label">Серийный номер / VIN</label>
+        <input id="serial" name="serial" class="form-control{{ if index .Errors "serial" }} is-invalid{{ end }}" value="{{ .Serial }}" maxlength="200" autocomplete="off">
+        {{ with index .Errors "serial" }}<div class="invalid-feedback" data-testid="error-serial">{{ . }}</div>{{ end }}
+      </div>
+    </div>
+    <div class="mb-4">
+      <label class="form-label">Характеристики</label>
+      <datalist id="spec-keys-datalist"></datalist>
+      <div id="specs-rows" class="row-list" data-row-list data-row-min="0" data-testid="specs-rows">
+        {{ range $i, $s := .Specs }}
+        <div class="row-list-item" data-testid="spec-row">
+          <div class="flex-grow-1">
+            <input type="text" name="spec_k" class="form-control{{ if index $.Errors (printf "specs[%d].k" $i) }} is-invalid{{ end }}" value="{{ $s.K }}" placeholder="Характеристика" list="spec-keys-datalist" maxlength="100" autocomplete="off" data-testid="spec-key">
+            {{ with index $.Errors (printf "specs[%d].k" $i) }}<div class="invalid-feedback d-block" data-testid="error-specs-{{ $i }}">{{ . }}</div>{{ end }}
+          </div>
+          <input type="text" name="spec_v" class="form-control" value="{{ $s.V }}" placeholder="Значение" maxlength="500" autocomplete="off" data-testid="spec-value">
+          <button type="button" class="btn btn-outline-secondary" data-row-del aria-label="Удалить характеристику" data-testid="spec-del">×</button>
+        </div>
+        {{ end }}
+        <template data-row-template>
+          <div class="row-list-item" data-testid="spec-row">
+            <div class="flex-grow-1">
+              <input type="text" name="spec_k" class="form-control" placeholder="Характеристика" list="spec-keys-datalist" maxlength="100" autocomplete="off" data-testid="spec-key">
+            </div>
+            <input type="text" name="spec_v" class="form-control" placeholder="Значение" maxlength="500" autocomplete="off" data-testid="spec-value">
+            <button type="button" class="btn btn-outline-secondary" data-row-del aria-label="Удалить характеристику" data-testid="spec-del">×</button>
+          </div>
+        </template>
+      </div>
+      <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-row-add="specs-rows" data-testid="spec-add">+ Характеристика</button>
+      {{ with index .Errors "specs" }}<div class="text-danger small mt-1" data-testid="error-specs">{{ . }}</div>{{ end }}
+    </div>
+    <div class="mb-4">
+      <label for="note" class="form-label">Примечание</label>
+      <input id="note" name="note" class="form-control{{ if index .Errors "note" }} is-invalid{{ end }}" value="{{ .Note }}" maxlength="1000" autocomplete="off">
+      {{ with index .Errors "note" }}<div class="invalid-feedback" data-testid="error-note">{{ . }}</div>{{ end }}
+    </div>
+    <div class="d-flex gap-2">
+      <button type="submit" class="btn btn-primary" data-testid="equipment-save">Сохранить</button>
+      <a href="/clients/{{ .ClientID }}" class="btn btn-outline-secondary">Отмена</a>
+    </div>
+  </div>
+</form>
+{{ if not .IsNew }}
+<form method="post" action="/equipment/{{ .ID }}/delete" class="mt-3" data-testid="equipment-delete-form" data-confirm="Удалить оборудование «{{ .Model }}»? Отменить нельзя.">
+  <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+  <button type="submit" class="btn btn-link text-danger p-0" data-testid="equipment-delete">Удалить</button>
+</form>
+{{ end }}
+{{ end }}
+{{ define "scripts" }}
+<script src="/assets/ssr-shared/js/row-list.js"></script>
+<script>
+(function () {
+  var typeSel = document.getElementById('type_id');
+  var specsList = document.getElementById('specs-rows');
+  var datalist = document.getElementById('spec-keys-datalist');
+  if (!typeSel || !specsList) return;
+
+  function escAttr(s) { return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;'); }
+
+  function specKeysOf(select) {
+    var opt = select.selectedOptions[0];
+    if (!opt || !opt.dataset.specKeys) return [];
+    try { return JSON.parse(opt.dataset.specKeys) || []; } catch (e) { return []; }
+  }
+
+  function currentRows() {
+    return Array.prototype.map.call(specsList.querySelectorAll('[data-testid="spec-row"]'), function (row) {
+      var k = row.querySelector('[name="spec_k"]'), v = row.querySelector('[name="spec_v"]');
+      return { k: k ? k.value : '', v: v ? v.value : '' };
+    });
+  }
+
+  function updateDatalist(keys) {
+    if (!datalist) return;
+    datalist.innerHTML = keys.map(function (k) { return '<option value="' + escAttr(k) + '">'; }).join('');
+  }
+
+  // ADR-002/AC-009: при выборе/смене типа строки характеристик подставляются шаблоном —
+  // заполненные ЗНАЧЕНИЯ сохраняются, пустые заменяются шаблоном нового типа (эталон —
+  // prototype/index.html openEquipment: `filled = e.specs.filter(p => p.v.trim())` —
+  // отбор по значению, а не по наличию ключа: непустой ключ без значения — тоже пустая
+  // строка и заменяется шаблоном, иначе после смены типа накапливались бы старые ключи
+  // без значений вперемешку с новым шаблоном).
+  typeSel.addEventListener('change', function () {
+    var keys = specKeysOf(typeSel);
+    updateDatalist(keys);
+    var filled = currentRows().filter(function (r) { return r.v.trim(); });
+    var rows = filled.map(function (r) { return { spec_k: r.k, spec_v: r.v }; });
+    keys.forEach(function (k) {
+      if (!filled.some(function (r) { return r.k === k; })) rows.push({ spec_k: k, spec_v: '' });
+    });
+    KT.rowList.fill(specsList, rows);
+  });
+
+  updateDatalist(specKeysOf(typeSel));
+})();
+</script>
+{{ end }}
diff --git a/web/ssr/clients/templates/pages/form.html b/web/ssr/clients/templates/pages/form.html
new file mode 100644
index 0000000..7edda49
