+++ b/web/ssr/clients/templates/pages/form.html
@@ -0,0 +1,108 @@
+{{ define "content" }}
+{{ if .Flash }}<div class="alert alert-success py-2" role="status" data-testid="flash">{{ .Flash }}</div>{{ end }}
+<form class="card mw-760" method="post" action="{{ if .IsNew }}/clients{{ else }}/clients/{{ .ID }}{{ end }}" data-testid="client-form" data-once novalidate>
+  <div class="card-body">
+    <input type="hidden" name="_csrf" value="{{ .Shell.CSRFToken }}">
+    {{ if not .IsNew }}<input type="hidden" name="version" value="{{ .Version }}">{{ end }}
+    {{ if .Error }}
+    <div class="alert alert-danger py-2" role="alert" data-testid="form-error">
+      {{ .Error }}
+      {{ if .Conflict }}<div class="mt-2"><a href="/clients/{{ .ID }}" data-testid="client-conflict-reload">Открыть актуальную версию</a></div>{{ end }}
+    </div>
+    {{ end }}
+    <div class="mb-3">
+      <label for="company_name" class="form-label">Компания *</label>
+      <input id="company_name" name="company_name" class="form-control{{ if index .Errors "company_name" }} is-invalid{{ end }}" value="{{ .CompanyName }}" maxlength="200" autocomplete="off">
+      {{ with index .Errors "company_name" }}<div class="invalid-feedback" data-testid="error-company_name">{{ . }}</div>{{ end }}
+    </div>
+    <div class="mb-3">
+      <label for="address" class="form-label">Адрес</label>
+      <input id="address" name="address" class="form-control{{ if index .Errors "address" }} is-invalid{{ end }}" value="{{ .Address }}" maxlength="500" autocomplete="off">
+      {{ with index .Errors "address" }}<div class="invalid-feedback" data-testid="error-address">{{ . }}</div>{{ end }}
+    </div>
+    <div class="row g-3 mb-3">
+      <div class="col-sm-6">
+        <label for="contact_name" class="form-label">Представитель</label>
+        <input id="contact_name" name="contact_name" class="form-control{{ if index .Errors "contact_name" }} is-invalid{{ end }}" value="{{ .ContactName }}" maxlength="200" autocomplete="off">
+        {{ with index .Errors "contact_name" }}<div class="invalid-feedback" data-testid="error-contact_name">{{ . }}</div>{{ end }}
+      </div>
+      <div class="col-sm-6">
+        <label for="contact_position" class="form-label">Должность</label>
+        <input id="contact_position" name="contact_position" class="form-control{{ if index .Errors "contact_position" }} is-invalid{{ end }}" value="{{ .ContactPosition }}" maxlength="200" autocomplete="off">
+        {{ with index .Errors "contact_position" }}<div class="invalid-feedback" data-testid="error-contact_position">{{ . }}</div>{{ end }}
