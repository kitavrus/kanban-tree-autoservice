{
  "name": "kanban-tree-e2e",
  "private": true,
  "description": "Playwright E2E для SSR-UI (Go html/template + vanilla JS). Единственный npm-пакет проекта.",
  "scripts": {
    "test": "playwright test --project=chromium --headed --workers=1",
    "test:full": "playwright test --project=chromium --headed --workers=1 --retries=1",
    "typecheck": "tsc --noEmit -p .",
    "install-browser": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
