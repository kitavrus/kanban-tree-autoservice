# Скопируй в .env (gitignored) и заполни. Источник имён — internal/config.
DATABASE_URL=postgres://admin:dev@127.0.0.1:5432/app?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
PORT=8080
LOG_LEVEL=debug
# Пусто → трейсинг no-op; Jaeger из monitoring-стека /infra-bootstrap: 127.0.0.1:4318
OTLP_ENDPOINT=
# session-auth (D35): sliding TTL и абсолютный потолок сессии
SESSION_TTL=12h
SESSION_ABSOLUTE_MAX=168h
# true — только за HTTPS (иначе браузер не вернёт cookie)
SESSION_COOKIE_SECURE=false
# защита от перебора: столько неудачных входов по логину за окно → 429
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW=15m
# Реквизиты фирмы для печатных актов (SSR-печать); пусто → блок реквизитов не рендерится
FIRM_NAME=
FIRM_ADDRESS=
FIRM_PHONE=
# Каталог вложений заказов (фото/видео/PDF, фаза 7); относительный путь — от рабочего каталога бинаря
UPLOADS_DIR=./uploads
# Сборщик файлов-сирот UPLOADS_DIR (файл без строки в БД после падения процесса): период
# проходов (0 — выключить, иначе ≥ 1s) и минимальный возраст файла (≥ 1m; моложе — идущая загрузка)
UPLOADS_GC_INTERVAL=6h
UPLOADS_GC_MIN_AGE=1h
# Служебная ФИЗИЧЕСКАЯ уборка тестовых данных автотестами (DELETE /api/v1/test/purge/:kind/:id,
# soft-delete-core DS-027). По умолчанию выключена — адреса нет (404). Раскомментировать ТОЛЬКО
# на локальном/тестовом стенде, по которому гоняют E2E (make e2e); на рабочем стенде не
# включать. Изолированный стенд (make e2e-isolated) включает её сам — scripts/e2e/run.sh.
# TEST_PURGE_ENABLED=true
